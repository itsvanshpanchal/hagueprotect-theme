  {%- assign info_redirect = '/search?view=certified-corporation' -%}
  <section style="font-family:var(--font-family-sans, 'Inter', sans-serif); background:#f7f7f8; padding:80px 20px; min-height:50vh; display:flex; align-items:center; justify-content:center;">
