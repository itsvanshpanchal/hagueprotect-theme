{%- comment -%}
  Custom 404.
  Shopify serves this template for any URL with no matching resource.
  Brand homes still render here when no Admin page exists:
  Missing Admin pages redirect to search alternate templates:
    /pages/faq|faqs              -> /search?view=faq
    /pages/contact|contact-us    -> /search?view=business
    /pages/collabs               -> /search?view=collabs
    /pages/certified-corporation -> /search?view=certified-corporation
    /pages/student-offer         -> /search?view=student-offer
    /pages/hague     -> /search?view=hague
  Path matching uses JS because request.path is often empty/wrong on 404.
{%- endcomment -%}

<script>
  (function () {
    try {
      var path = (window.location.pathname || '').toLowerCase().replace(/\/+$/, '');
      var search = window.location.search || '';

      if (
        path === '/pages/faq' ||
        path === '/pages/faqs' ||
        path === '/faq' ||
        path === '/faqs' ||
        /\/pages\/faqs?$/.test(path)
      ) {
        window.location.replace('/search?view=faq' + search);
        return;
      }

      var pageMap = {
        '/pages/contact': '/search?view=business',
        '/pages/contact-us': '/search?view=business',
        '/pages/collabs': '/search?view=collabs',
        '/pages/certified-corporation': '/search?view=certified-corporation',
        '/pages/certified-corp': '/search?view=certified-corporation',
        '/pages/student-offer': '/search?view=student-offer',
        '/pages/student-offers': '/search?view=student-offer',
        '/pages/hague': '/search?view=hague',
        '/pages/science-and-longevity': '/search?view=hague',
        '/pages/science-longevity': '/search?view=hague',
        '/pages/skin-longevity': '/search?view=hague'
      };

      if (pageMap[path]) {
        window.location.replace(pageMap[path] + search);
        return;
      }

      var policyMap = {
        '/pages/privacy-policy': 'privacy',
        '/pages/privacy': 'privacy',
        '/pages/terms-of-service': 'terms',
        '/pages/terms': 'terms',
        '/pages/terms-and-conditions': 'terms',
        '/pages/refund-policy': 'refunds',
        '/pages/return-policy': 'refunds',
        '/pages/returns': 'refunds',
        '/pages/shipping-policy': 'shipping',
        '/pages/shipping': 'shipping',
        '/pages/saferchoice': 'saferchoice',
        '/pages/safer-choice': 'saferchoice',
        '/pages/policies': 'terms'
      };

      if (policyMap[path]) {
        window.location.replace('/search?view=policies&tab=' + policyMap[path]);
      }
    } catch (e) {}
  })();
</script>

{%- capture req -%}{{ request.path }} {{ canonical_url }} {{ request.path | default: '' }}{%- endcapture -%}
{%- assign req = req | downcase -%}

{%- if req contains 'hague' or req contains 'science-and-longevity' or req contains 'science-longevity' or req contains 'skin-longevity' -%}
  {%- assign science_redirect = '/search?view=hague' -%}
  <meta http-equiv="refresh" content="0;url={{ science_redirect }}">
  <script>window.location.replace({{ science_redirect | json }});</script>

{%- elsif req contains 'pages/faq' or req contains 'pages/faqs' or req contains '/faq' -%}
  {%- assign faq_redirect = '/search?view=faq' -%}
  <section style="font-family:var(--font-family-sans, 'Inter', sans-serif); background:#f7f7f8; padding:80px 20px; min-height:50vh; display:flex; align-items:center; justify-content:center;">
    <div style="max-width:420px; width:100%; text-align:center;">
      <p style="font-size:13px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#FF2B2B; margin:0 0 12px;">Hague Protect</p>
      <h1 style="font-size:28px; font-weight:700; color:#111; margin:0 0 12px; letter-spacing:-0.02em;">Opening FAQs…</h1>
      <p style="font-size:15px; color:#666; margin:0 0 24px; line-height:1.5;">Taking you to the support center.</p>
      <a href="{{ faq_redirect }}" style="display:inline-flex; align-items:center; gap:8px; background:#FF2B2B; color:#fff; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; text-decoration:none; padding:14px 26px; border-radius:100px;">Go to FAQs</a>
    </div>
  </section>
  <meta http-equiv="refresh" content="0;url={{ faq_redirect }}">
  <script>window.location.replace({{ faq_redirect | json }});</script>

{%- elsif req contains 'privacy' or req contains 'terms-of-service' or req contains 'return-policy' or req contains 'refund-policy' or req contains 'shipping-policy' or req contains '/shipping' or req contains 'saferchoice' or req contains 'safer-choice' or req contains 'policies' -%}
  {%- assign policy_tab = 'terms' -%}
  {%- if req contains 'privacy' -%}
    {%- assign policy_tab = 'privacy' -%}
  {%- elsif req contains 'shipping' -%}
    {%- assign policy_tab = 'shipping' -%}
  {%- elsif req contains 'return' or req contains 'refund' -%}
    {%- assign policy_tab = 'refunds' -%}
  {%- elsif req contains 'safer' -%}
    {%- assign policy_tab = 'saferchoice' -%}
  {%- endif -%}
  {%- assign policy_redirect = '/search?view=policies&tab=' | append: policy_tab -%}
  <section style="font-family:var(--font-family-sans, 'Inter', sans-serif); background:#f7f7f8; padding:80px 20px; min-height:50vh; display:flex; align-items:center; justify-content:center;">
    <div style="max-width:420px; width:100%; text-align:center;">
      <p style="font-size:13px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#FF2B2B; margin:0 0 12px;">Hague Protect</p>
      <h1 style="font-size:28px; font-weight:700; color:#111; margin:0 0 12px; letter-spacing:-0.02em;">Opening policies…</h1>
      <p style="font-size:15px; color:#666; margin:0 0 24px; line-height:1.5;">Taking you to the policy page.</p>
      <a href="{{ policy_redirect }}" style="display:inline-flex; align-items:center; gap:8px; background:#FF2B2B; color:#fff; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; text-decoration:none; padding:14px 26px; border-radius:100px;">View policies</a>
    </div>
  </section>
  <meta http-equiv="refresh" content="0;url={{ policy_redirect }}">
  <script>window.location.replace({{ policy_redirect | json }});</script>

{%- elsif req contains 'pages/contact' or req contains 'contact-us' -%}
