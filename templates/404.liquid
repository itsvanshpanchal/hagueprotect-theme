      </form>
      <div style="display:flex; flex-wrap:wrap; gap:10px; justify-content:center;">
        <a href="/search?view=faq" style="display:inline-flex; align-items:center; gap:9px; font-family:inherit; font-size:13px; font-weight:800; letter-spacing:0.08em; text-transform:uppercase; color:#111; background:#fff; border:1px solid rgba(0,0,0,0.15); padding:14px 26px; border-radius:100px; text-decoration:none;">
          View FAQs
        </a>
