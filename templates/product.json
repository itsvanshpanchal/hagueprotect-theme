    "faq": {
      "type": "faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Are Hague Protect formulas safe for my sneakers?",
            "answer": "<p>Yes. Our formulas are pH-balanced and made for premium footwear materials including leather, suede, nubuck, mesh, canvas, and rubber. Always follow the care steps on the product page.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Will this change the color or finish?",
            "answer": "<p>No. Hague Protect systems are designed to clean and protect without stripping color or damaging finishes when used as directed.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How long does delivery take in India?",
            "answer": "<p>Orders placed before 12pm IST on business days usually ship the same day. Delivery across India typically takes 2 to 5 business days depending on your location.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "What if I need help choosing a kit?",
            "answer": "<p>Match the kit to your material, or message us on WhatsApp with a photo of your shoes and we’ll recommend the right care system.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "What is the best product to clean Jordans?",
            "answer": "<p>For Jordans, use the Hague Protect Premium Shoe Cleaner Foam. It is safe on all materials and cleans without altering the colour or texture, keeping Jordans in pristine condition.</p>"
          }
        },
        "faq_6": {
          "type": "faq_item",
          "settings": {
            "question": "Can I put my sneakers in the washing machine?",
            "answer": "<p>No. Machine washing can warp the shape, loosen the glue and damage leather or suede panels. Clean sneakers by hand with a foam cleaner and soft brush instead.</p>"
          }
        }
      },
