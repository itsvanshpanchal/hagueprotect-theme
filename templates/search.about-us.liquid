<!-- ─── SCRIPTS (loaded ONLY on this page) ───────────────────── -->
<script>
(function(){
  /* Lazy-load GSAP + ScrollTrigger + Lenis only on this page */
  const loadScript = (src) => new Promise((resolve, reject) => {
    const s = document.createElement('script');
    s.src = src; s.async = true; s.onload = resolve; s.onerror = reject;
    document.head.appendChild(s);
  });

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.innerWidth <= 768;

  Promise.all([
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js'),
    loadScript('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js')
  ]).then(() => {
    /* Optional: Lenis for desktop smooth scroll */
    if (!isMobile && !prefersReduced) {
      loadScript('https://unpkg.com/lenis@1.1.13/dist/lenis.min.js').then(() => {
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), orientation: 'vertical', smoothWheel: true });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }).catch(() => {}); /* Lenis is optional; page works without it */
    }

    gsap.registerPlugin(ScrollTrigger);
    initAnimations();
  });

  function initAnimations() {
    if (prefersReduced) { showAllImmediately(); return; }

    /* ── SCROLL PROGRESS BAR ── */
    const progressBar = document.getElementById('HpAboutProgress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.width = (window.scrollY / h * 100) + '%';
      }, { passive: true });
    }

    /* ── CUSTOM CURSOR (desktop only) ── */
    if (!isMobile && window.matchMedia('(pointer: fine)').matches) {
      const dot = document.getElementById('HpAboutCursor');
      const ring = document.getElementById('HpAboutCursorRing');
      if (dot && ring) {
        let mx = 0, my = 0, rx = 0, ry = 0;
        document.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; }, { passive: true });
        (function moveCursor() {
          rx += (mx - rx) * 0.15; ry += (my - ry) * 0.15;
          dot.style.transform = 'translate(' + (mx - 4) + 'px,' + (my - 4) + 'px)';
          ring.style.transform = 'translate(' + (rx - 20) + 'px,' + (ry - 20) + 'px)';
          requestAnimationFrame(moveCursor);
        })();
      }
    }

    /* ── 1. HERO ANIMATIONS ── */
    const words = document.querySelectorAll('#HpHeroHeadline .word');
    const eyebrow = document.getElementById('HpHeroEyebrow');
    const heroSub = document.getElementById('HpHeroSub');

    gsap.to(eyebrow, { opacity: 1, y: 0, duration: 0.8, delay: 0.3, ease: 'power3.out' });
    words.forEach((w, i) => {
      gsap.to(w, { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.9, delay: 0.5 + i * 0.12, ease: 'power3.out' });
    });
    gsap.to(heroSub, { opacity: 1, y: 0, duration: 0.8, delay: 1.2, ease: 'power3.out' });

    /* Hero parallax on scroll */
    gsap.to('#HpHeroHeadline', {
      scrollTrigger: { trigger: '.hp-about__hero', start: 'top top', end: 'bottom top', scrub: true },
      y: -80, opacity: 0.3, scale: 0.95
    });

    /* ── 2. ORIGIN STORY (pinned) ── */
    const originLines = document.querySelectorAll('.hp-about__origin-line');
    const originDots = document.querySelectorAll('.hp-about__origin-dot');
    const originBg = document.getElementById('HpOriginBg');
    const bgColors = [
      'radial-gradient(ellipse at 50% 50%, rgba(255,43,43,0.04) 0%, transparent 70%)',
      'radial-gradient(ellipse at 30% 60%, rgba(255,43,43,0.06) 0%, transparent 70%)',
      'radial-gradient(ellipse at 70% 40%, rgba(255,43,43,0.08) 0%, transparent 70%)',
      'radial-gradient(ellipse at 50% 50%, rgba(255,43,43,0.1) 0%, transparent 70%)'
    ];

    if (!isMobile) {
      const originTl = gsap.timeline({
        scrollTrigger: {
          trigger: '#HpAboutOrigin',
          start: 'top top',
          end: 'bottom bottom',
          pin: '#HpOriginPin',
          scrub: 0.8
        }
      });

      originLines.forEach((line, i) => {
        const startPct = i / originLines.length;
        const endPct = (i + 1) / originLines.length;
        originTl.call(() => {
          originLines.forEach((l, j) => { l.classList.toggle('is-active', j === i); });
          originDots.forEach((d, j) => { d.classList.toggle('is-active', j === i); });
          if (originBg) originBg.style.background = bgColors[i] || bgColors[0];
        }, null, startPct);
      });
    } else {
      /* Mobile: simple reveal */
      originLines.forEach((line) => {
        gsap.to(line, {
          scrollTrigger: { trigger: line, start: 'top 80%', toggleActions: 'play none none reverse' },
          color: '#ffffff', duration: 0.5
        });
      });
    }

    /* ── 3. PHILOSOPHY — HORIZONTAL SCROLL (desktop) ── */
    if (!isMobile) {
      const track = document.getElementById('HpPhilosophyTrack');
      const section = document.getElementById('HpAboutPhilosophy');
      if (track && section) {
        const totalScroll = track.scrollWidth - window.innerWidth;
        gsap.to(track, {
          x: -totalScroll,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: () => '+=' + totalScroll,
            pin: true,
            scrub: 1,
            invalidateOnRefresh: true
          }
        });
      }
    }

    /* Philosophy card SVG line-draw on visibility */
    const cards = document.querySelectorAll('[data-pillar]');
    cards.forEach((card) => {
      ScrollTrigger.create({
        trigger: card,
        start: isMobile ? 'top 85%' : 'left 80%',
        onEnter: () => card.classList.add('is-visible'),
        containerAnimation: isMobile ? undefined : gsap.getById && gsap.getById('philoScrub')
      });
      /* Fallback observer for mobile */
      if (isMobile) {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach(e => { if (e.isIntersecting) card.classList.add('is-visible'); });
        }, { threshold: 0.3 });
        obs.observe(card);
      }
    });

    /* ── 4. TEAM SPOTLIGHT ── */
    const teamSlides = document.querySelectorAll('.hp-about__team-slide');
    const teamProgress = document.getElementById('HpTeamProgress');
    const progressDots = document.querySelectorAll('.hp-about__team-progress-dot');

    teamSlides.forEach((slide, i) => {
      ScrollTrigger.create({
        trigger: slide,
        start: 'top 60%',
        end: 'bottom 40%',
        onEnter: () => activateTeamSlide(i),
        onEnterBack: () => activateTeamSlide(i),
        onLeave: () => {},
        onLeaveBack: () => {}
      });
    });

    function activateTeamSlide(idx) {
      teamSlides.forEach((s, i) => {
        s.classList.toggle('is-active', i === idx);
      });
      progressDots.forEach((d, i) => {
        d.classList.toggle('is-active', i === idx);
      });

      const activeSlide = teamSlides[idx];
      if (!activeSlide) return;

      /* Animate member count */
      const count = activeSlide.querySelector('.hp-about__team-member-count');
      if (count) gsap.to(count, { opacity: 1, duration: 0.5, delay: 0.1 });

      /* Animate name chars */
      const nameEl = activeSlide.querySelector('[data-split-name]');
      if (nameEl && !nameEl.dataset.split) {
        const text = nameEl.textContent;
        nameEl.innerHTML = text.split('').map(c => c === ' ' ? ' ' : '<span class="char">' + c + '</span>').join('');
        nameEl.dataset.split = '1';
      }
      const chars = activeSlide.querySelectorAll('.char');
      chars.forEach((c, ci) => {
        gsap.to(c, { opacity: 1, y: 0, scale: 1, duration: 0.5, delay: 0.15 + ci * 0.03, ease: 'power3.out' });
      });

      /* Animate role */
      const role = activeSlide.querySelector('.hp-about__team-role');
      if (role) gsap.to(role, { opacity: 1, duration: 0.5, delay: 0.5 });

      /* Typewriter quote */
      const quoteEl = activeSlide.querySelector('[data-typewriter]');
      if (quoteEl && !quoteEl.dataset.typed) {
        quoteEl.dataset.typed = '1';
        const fullText = quoteEl.getAttribute('data-typewriter');
        quoteEl.innerHTML = '<span class="typewriter-cursor"></span>';
        let ci = 0;
        const typeInterval = setInterval(() => {
          if (ci < fullText.length) {
            quoteEl.innerHTML = '"' + fullText.substring(0, ci + 1) + '"<span class="typewriter-cursor"></span>';
            ci++;
          } else {
            clearInterval(typeInterval);
            setTimeout(() => {
              const cursor = quoteEl.querySelector('.typewriter-cursor');
              if (cursor) cursor.style.display = 'none';
            }, 2000);
          }
        }, 40);
      }

      /* Mouse-follow parallax on portrait (desktop only) */
      if (!isMobile) {
        const portrait = activeSlide.querySelector('.hp-about__team-portrait-img');
        if (portrait && !activeSlide.dataset.parallaxBound) {
          activeSlide.dataset.parallaxBound = '1';
          activeSlide.addEventListener('mousemove', (e) => {
            const rect = activeSlide.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            gsap.to(portrait, { x: x * 20, y: y * 20, duration: 0.6, ease: 'power2.out' });
          });
        }
      }
    }

    /* Show/hide team progress when in team section */
    if (teamProgress) {
      ScrollTrigger.create({
        trigger: '#HpAboutTeam',
        start: 'top 50%',
        end: 'bottom 50%',
        onEnter: () => teamProgress.classList.add('is-visible'),
        onLeave: () => teamProgress.classList.remove('is-visible'),
        onEnterBack: () => teamProgress.classList.add('is-visible'),
        onLeaveBack: () => teamProgress.classList.remove('is-visible')
      });
    }

    /* ── 5. VALUES MARQUEE — pure CSS, no JS needed ── */

    /* ── 6. CTA SECTION — fade reveals ── */
    document.querySelectorAll('.hp-about__reveal').forEach((el) => {
      ScrollTrigger.create({
        trigger: el,
        start: 'top 85%',
        onEnter: () => el.classList.add('is-visible')
      });
    });

    /* Magnetic CTA button (desktop) */
    if (!isMobile) {
      const ctaBtn = document.getElementById('HpCtaBtn');
      if (ctaBtn) {
        ctaBtn.addEventListener('mousemove', (e) => {
          const rect = ctaBtn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          gsap.to(ctaBtn, { x: x * 0.25, y: y * 0.35, duration: 0.3, ease: 'power2.out' });
        });
        ctaBtn.addEventListener('mouseleave', () => {
          gsap.to(ctaBtn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.4)' });
        });
      }
    }
  }

  /* Fallback: show everything immediately if reduced-motion is preferred */
  function showAllImmediately() {
    document.querySelectorAll('.word, .char, .hp-about__reveal, .hp-about__hero-eyebrow, .hp-about__hero-sub, .hp-about__team-member-count, .hp-about__team-role').forEach(el => {
      el.style.opacity = '1'; el.style.transform = 'none'; el.style.filter = 'none';
    });
    document.querySelectorAll('.hp-about__origin-line').forEach(l => l.classList.add('is-active'));
    document.querySelectorAll('[data-pillar]').forEach(c => c.classList.add('is-visible'));
    document.querySelectorAll('[data-typewriter]').forEach(q => {
      q.textContent = '"' + q.getAttribute('data-typewriter') + '"';
    });
  }
})();
</script>
