<!-- ─── SCRIPTS ───────────────────────────────────────────────── -->
<script>
(function(){
  const isMobile = window.innerWidth <= 768;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const loadJS = (src) => new Promise((res, rej) => {
    const s = document.createElement('script');
    s.src = src; s.async = true; s.onload = res; s.onerror = rej;
    document.head.appendChild(s);
  });

  Promise.all([
    loadJS('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js'),
    loadJS('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js')
  ]).then(() => {
    if (!isMobile && !prefersReduced) {
      loadJS('https://unpkg.com/lenis@1.1.13/dist/lenis.min.js').then(() => {
        try {
          const lenis = new Lenis({ duration: 1.1, easing: t => Math.min(1, 1.001 - Math.pow(2, -10 * t)), smoothWheel: true });
          lenis.on('scroll', ScrollTrigger.update);
          gsap.ticker.add(time => lenis.raf(time * 1000));
          gsap.ticker.lagSmoothing(0);
        } catch(e) {}
      }).catch(() => {});
    }
    gsap.registerPlugin(ScrollTrigger);
    if (prefersReduced) { showAll(); return; }
    boot();
  });

  function boot() {
    /* ── Progress bar ── */
    const bar = document.getElementById('HpAboutProgress');
    if (bar) window.addEventListener('scroll', () => {
      bar.style.width = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight) * 100) + '%';
    }, { passive: true });

    /* ── Custom cursor ── */
    if (!isMobile && window.matchMedia('(pointer:fine)').matches) {
      const dot = document.getElementById('HpCursor'), ring = document.getElementById('HpCursorRing');
      if (dot && ring) {
        let mx=0,my=0,rx=0,ry=0;
        document.addEventListener('mousemove', e => { mx=e.clientX; my=e.clientY; }, {passive:true});
        (function loop(){ rx+=(mx-rx)*0.14; ry+=(my-ry)*0.14;
          dot.style.transform='translate('+(mx-4)+'px,'+(my-4)+'px)';
          ring.style.transform='translate('+(rx-22)+'px,'+(ry-22)+'px)';
          requestAnimationFrame(loop);
        })();
      }
    }

    /* ═══ 1. HERO ═══ */
    const eyebrow = document.getElementById('HpHeroEyebrow');
    const words = document.querySelectorAll('#HpHeroHeadline .word');
    const sub = document.getElementById('HpHeroSub');
    const stats = document.getElementById('HpHeroStats');

    gsap.to(eyebrow, { opacity:1, y:0, duration:0.9, delay:0.2, ease:'power3.out' });
    words.forEach((w,i) => gsap.to(w, { opacity:1, y:0, rotateX:0, filter:'blur(0px)', duration:1, delay:0.4+i*0.1, ease:'power3.out' }));
    gsap.to(sub, { opacity:1, y:0, duration:0.9, delay:1, ease:'power3.out' });
    gsap.to(stats, { opacity:1, y:0, duration:0.9, delay:1.3, ease:'power3.out' });

    gsap.to('.hp-about__hero-content', {
      scrollTrigger: { trigger:'.hp-about__hero', start:'top top', end:'bottom top', scrub:true },
      y:-100, opacity:0.2, scale:0.96
    });

    /* ═══ 2. ORIGIN (pinned) ═══ */
    const oLines = document.querySelectorAll('.hp-about__origin-line');
    const oPips = document.querySelectorAll('.hp-about__origin-pip');
    const oAmbient = document.getElementById('HpOriginAmbient');

    if (!isMobile) {
      const oTl = gsap.timeline({ scrollTrigger: { trigger:'#HpAboutOrigin', start:'top top', end:'bottom bottom', pin:'#HpOriginPin', scrub:0.6 }});
      const gradients = [
        'radial-gradient(ellipse at 50% 50%, rgba(255,43,43,0.05) 0%, transparent 60%)',
        'radial-gradient(ellipse at 30% 60%, rgba(255,43,43,0.08) 0%, transparent 60%)',
        'radial-gradient(ellipse at 70% 40%, rgba(255,43,43,0.10) 0%, transparent 60%)',
        'radial-gradient(ellipse at 50% 50%, rgba(255,43,43,0.12) 0%, transparent 60%)'
      ];
      oLines.forEach((l,i) => {
        oTl.call(() => {
          oLines.forEach((x,j) => x.classList.toggle('is-active', j===i));
          oPips.forEach((p,j) => p.classList.toggle('is-active', j===i));
          if (oAmbient) { oAmbient.style.background = gradients[i]; oAmbient.style.opacity = '1'; }
        }, null, i / oLines.length);
      });
    } else {
      oLines.forEach(l => {
        gsap.to(l, { scrollTrigger: { trigger:l, start:'top 80%', toggleActions:'play none none reverse' }, color:'rgba(255,255,255,0.95)', duration:0.5 });
      });
    }

    /* ═══ 3. PHILOSOPHY (horizontal scroll on desktop) ═══ */
    if (!isMobile) {
      const track = document.getElementById('HpPhiloTrack');
      const sec = document.getElementById('HpAboutPhilosophy');
      if (track && sec) {
        const dist = track.scrollWidth - window.innerWidth;
        gsap.to(track, { x: -dist, ease:'none', scrollTrigger: { trigger:sec, start:'top top', end:()=>'+=' + dist, pin:true, scrub:1, invalidateOnRefresh:true }});
      }
    }
    /* Card SVG draw */
    document.querySelectorAll('[data-pillar]').forEach(card => {
      const obs = new IntersectionObserver(entries => { entries.forEach(e => { if(e.isIntersecting) card.classList.add('is-visible'); }); }, {threshold:0.3});
      obs.observe(card);
    });

    /* ═══ 4. TEAM ═══ */
    const slides = document.querySelectorAll('.hp-about__team-slide');
    const dots = document.querySelectorAll('.hp-about__team-dot');
    const dotsWrap = document.getElementById('HpTeamDots');

    slides.forEach((sl,i) => {
      ScrollTrigger.create({ trigger:sl, start:'top 55%', end:'bottom 45%',
        onEnter: () => activateMember(i),
        onEnterBack: () => activateMember(i)
      });
    });

    function activateMember(idx) {
      slides.forEach((s,i) => s.classList.toggle('is-active', i===idx));
      dots.forEach((d,i) => d.classList.toggle('is-active', i===idx));

      const sl = slides[idx]; if (!sl) return;

      /* counter */
      const cnt = sl.querySelector('.hp-about__team-counter');
      if (cnt) gsap.to(cnt, { opacity:1, y:0, duration:0.6, delay:0.05 });

      /* name split */
      const nameEl = sl.querySelector('[data-split-name]');
      if (nameEl && !nameEl.dataset.split) {
        nameEl.innerHTML = nameEl.textContent.split('').map(c => c===' '?' ':'<span class="char">'+c+'</span>').join('');
        nameEl.dataset.split='1';
      }
      sl.querySelectorAll('.char').forEach((c,ci) => gsap.to(c, { opacity:1, y:0, scale:1, filter:'blur(0px)', duration:0.55, delay:0.12+ci*0.025, ease:'power3.out' }));

      /* role */
      const role = sl.querySelector('.hp-about__team-role');
      if (role) gsap.to(role, { opacity:1, duration:0.5, delay:0.45 });

      /* bio */
      const bio = sl.querySelector('.hp-about__team-bio');
      if (bio) gsap.to(bio, { opacity:1, y:0, duration:0.6, delay:0.7 });

      /* typewriter */
      const qEl = sl.querySelector('[data-typewriter]');
      if (qEl && !qEl.dataset.typed) {
        qEl.dataset.typed='1';
        const txt = qEl.getAttribute('data-typewriter');
        qEl.innerHTML = '<span class="tw-cursor"></span>';
        let ci=0;
        const iv = setInterval(()=>{
          if (ci<txt.length) { qEl.innerHTML = '\u201C'+txt.substring(0,ci+1)+'\u201D<span class="tw-cursor"></span>'; ci++; }
          else { clearInterval(iv); setTimeout(()=>{ const cur=qEl.querySelector('.tw-cursor'); if(cur) cur.style.display='none'; },2500); }
        }, 35);
      }

      /* mouse parallax (desktop) */
      if (!isMobile) {
        const portrait = sl.querySelector('.hp-about__team-portrait-placeholder');
        if (portrait && !sl.dataset.pxBound) {
          sl.dataset.pxBound='1';
          sl.addEventListener('mousemove', e => {
            const r=sl.getBoundingClientRect();
            const x=(e.clientX-r.left)/r.width-0.5, y=(e.clientY-r.top)/r.height-0.5;
            gsap.to(portrait, { x:x*24, y:y*16, duration:0.8, ease:'power2.out' });
          });
        }
      }
    }

    /* Team dots visibility */
    if (dotsWrap) {
      ScrollTrigger.create({ trigger:'#HpAboutTeam', start:'top 40%', end:'bottom 40%',
        onEnter:()=>dotsWrap.classList.add('is-visible'),
        onLeave:()=>dotsWrap.classList.remove('is-visible'),
        onEnterBack:()=>dotsWrap.classList.add('is-visible'),
        onLeaveBack:()=>dotsWrap.classList.remove('is-visible')
      });
    }

    /* ═══ 6. REVEAL UTILITY ═══ */
    document.querySelectorAll('.hp-about__reveal').forEach(el => {
      ScrollTrigger.create({ trigger:el, start:'top 88%', onEnter:()=>el.classList.add('is-vis') });
    });

    /* Magnetic CTA (desktop) */
    if (!isMobile) {
      const btn = document.getElementById('HpCtaBtn');
      if (btn) {
        btn.addEventListener('mousemove', e => {
          const r=btn.getBoundingClientRect();
          gsap.to(btn, { x:(e.clientX-r.left-r.width/2)*0.2, y:(e.clientY-r.top-r.height/2)*0.3, duration:0.3, ease:'power2.out' });
        });
        btn.addEventListener('mouseleave', () => gsap.to(btn, { x:0, y:0, duration:0.6, ease:'elastic.out(1,0.4)' }));
      }
    }
  }

  function showAll() {
    document.querySelectorAll('.word,.char,.hp-about__reveal,.hp-about__hero-eyebrow,.hp-about__hero-sub,.hp-about__hero-stats,.hp-about__team-counter,.hp-about__team-role,.hp-about__team-bio')
      .forEach(el => { el.style.opacity='1'; el.style.transform='none'; el.style.filter='none'; });
    document.querySelectorAll('.hp-about__origin-line').forEach(l=>l.classList.add('is-active'));
    document.querySelectorAll('[data-pillar]').forEach(c=>c.classList.add('is-visible'));
    document.querySelectorAll('[data-typewriter]').forEach(q=>{ q.textContent='\u201C'+q.getAttribute('data-typewriter')+'\u201D'; });
  }
})();
</script>
