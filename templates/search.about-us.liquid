<script>
(function(){
  var isMob = window.innerWidth <= 768;
  var noMo  = window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  function ldJS(src){ return new Promise(function(res,rej){ var s=document.createElement('script'); s.src=src; s.async=true; s.onload=res; s.onerror=rej; document.head.appendChild(s); }); }

  Promise.all([
    ldJS('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js'),
    ldJS('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js')
  ]).then(function(){
    if(!isMob && !noMo){
      ldJS('https://unpkg.com/lenis@1.1.13/dist/lenis.min.js').then(function(){
        try{ var l=new Lenis({duration:1.0, easing:function(t){return Math.min(1,1.001-Math.pow(2,-10*t));}, smoothWheel:true}); l.on('scroll',ScrollTrigger.update); gsap.ticker.add(function(t){l.raf(t*1000);}); gsap.ticker.lagSmoothing(0); }catch(e){}
      }).catch(function(){});
    }
    gsap.registerPlugin(ScrollTrigger);
    noMo ? showAll() : boot();
  });

  function boot(){
    /* Progress bar */
    var bar=document.getElementById('v4Bar');
    if(bar) window.addEventListener('scroll',function(){ bar.style.width=(window.scrollY/(document.documentElement.scrollHeight-window.innerHeight)*100)+'%'; },{passive:true});

    /* Cursor */
    if(!isMob && window.matchMedia('(pointer:fine)').matches){
      var dot=document.getElementById('v4Dot'), ring=document.getElementById('v4Ring');
      if(dot && ring){ var mx=0,my=0,rx=0,ry=0;
        document.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;},{passive:true});
        (function loop(){ rx+=(mx-rx)*0.13; ry+=(my-ry)*0.13;
          dot.style.transform='translate('+(mx-3.5)+'px,'+(my-3.5)+'px)';
          ring.style.transform='translate('+(rx-23)+'px,'+(ry-23)+'px)';
          requestAnimationFrame(loop); })();
      }
    }

    /* §1 Hero */
    var label=document.getElementById('v4HeroLabel');
    var words=document.querySelectorAll('#v4H1 .v4w');
    var sub=document.getElementById('v4HeroSub');
    var stats=document.querySelectorAll('.v4-hero__stat');
    if(label) gsap.to(label,{opacity:1,duration:0.9,delay:0.1,ease:'power3.out'});
    words.forEach(function(w,i){ gsap.to(w,{opacity:1,y:0,rotateX:0,filter:'blur(0px)',duration:1.1,delay:0.25+i*0.12,ease:'power4.out'}); });
    if(sub) gsap.to(sub,{opacity:1,y:0,duration:1,delay:0.9,ease:'power3.out'});
    stats.forEach(function(s,i){ gsap.to(s,{opacity:1,y:0,duration:0.7,delay:1.1+i*0.07,ease:'power3.out'}); });

    /* Hero parallax */
    gsap.to('#v4Hero .v4-hero__inner',{
      scrollTrigger:{trigger:'#v4Hero',start:'top top',end:'bottom top',scrub:true},
      y:-90, opacity:0.1, scale:0.96
    });

    /* §2 Manifesto — hover on desktop, scroll-light on mobile */
    var mLines=document.querySelectorAll('.v4-mline');
    if(!isMob){
      mLines.forEach(function(l){
        l.addEventListener('mouseenter',function(){ mLines.forEach(function(x){x.classList.remove('lit');}); l.classList.add('lit'); });
        l.addEventListener('mouseleave',function(){ l.classList.remove('lit'); });
      });
    }
    mLines.forEach(function(l){
      ScrollTrigger.create({trigger:l, start:'top 85%', onEnter:function(){ l.classList.add('in'); if(isMob) l.classList.add('lit'); }});
    });

    /* §3 Cards */
    document.querySelectorAll('[data-card]').forEach(function(c,i){
      ScrollTrigger.create({trigger:c, start:'top 90%',
        onEnter:function(){ setTimeout(function(){c.classList.add('in');}, (i%5)*60); }
      });
    });

    /* §4 Team slides */
    var slides=document.querySelectorAll('.v4-slide');
    var navDots=document.querySelectorAll('.v4-team-nav__dot');
    var typedSet=new Set();

    slides.forEach(function(sl,i){
      ScrollTrigger.create({trigger:sl, start:'top 62%',
        onEnter:function(){activateSlide(i);},
        onEnterBack:function(){activateSlide(i);}
      });
    });
    navDots.forEach(function(d){ d.addEventListener('click',function(){ var idx=parseInt(d.getAttribute('data-nav')); var sl=slides[idx]; if(sl) sl.scrollIntoView({behavior:'smooth',block:'start'}); }); });

    function activateSlide(idx){
      slides.forEach(function(s,i){s.classList.toggle('on',i===idx);});
      navDots.forEach(function(d,i){d.classList.toggle('on',i===idx);});
      var sl=slides[idx]; if(!sl) return;

      var idxEl=sl.querySelector('.v4-slide__idx');
      var nameEl=sl.querySelector('.v4-slide__name-inner');
      var roleEl=sl.querySelector('.v4-slide__role');
      var bioEl=sl.querySelector('.v4-slide__bio');
      var quoteEl=sl.querySelector('.v4-slide__quote');

      if(idxEl) gsap.to(idxEl,{opacity:1,duration:0.5,delay:0.05});
      if(nameEl) gsap.to(nameEl,{opacity:1,y:'0%',duration:0.85,delay:0.1,ease:'power4.out'});
      if(roleEl) gsap.to(roleEl,{opacity:1,duration:0.5,delay:0.42});
      if(bioEl)  gsap.to(bioEl, {opacity:1,y:0,duration:0.7,delay:0.72,ease:'power3.out'});

      if(quoteEl && !typedSet.has(idx)){
        typedSet.add(idx);
        var txt=quoteEl.getAttribute('data-tw')||'';
        quoteEl.innerHTML='<span class="tw"></span>'; var ci=0;
        var iv=setInterval(function(){
          if(ci<txt.length){ quoteEl.innerHTML='\u201C'+txt.slice(0,++ci)+'\u201D<span class="tw"></span>'; }
          else{ clearInterval(iv); setTimeout(function(){ var c=quoteEl.querySelector('.tw'); if(c)c.style.display='none'; },2500); }
        },36);
      }
      if(!isMob){
        var bg=sl.querySelector('.v4-slide__bg');
        if(bg && !sl.getAttribute('data-pxb')){ sl.setAttribute('data-pxb','1');
          sl.addEventListener('mousemove',function(e){
            var r=sl.getBoundingClientRect(), x=(e.clientX-r.left)/r.width-0.5, y=(e.clientY-r.top)/r.height-0.5;
            gsap.to(bg,{x:x*28,y:y*18,duration:0.9,ease:'power2.out'});
          });
        }
      }
    }
    activateSlide(0);

    /* §6 Reveal utility */
    document.querySelectorAll('.v4-up').forEach(function(el){
      ScrollTrigger.create({trigger:el, start:'top 90%', onEnter:function(){el.classList.add('in');}});
    });

    /* Magnetic CTA */
    if(!isMob){ var btn=document.getElementById('v4CtaBtn');
      if(btn){
        btn.addEventListener('mousemove',function(e){ var r=btn.getBoundingClientRect(); gsap.to(btn,{x:(e.clientX-r.left-r.width/2)*0.18,y:(e.clientY-r.top-r.height/2)*0.26,duration:0.3,ease:'power2.out'}); });
        btn.addEventListener('mouseleave',function(){ gsap.to(btn,{x:0,y:0,duration:0.7,ease:'elastic.out(1,0.3)'}); });
      }
    }
  }

  function showAll(){
    document.querySelectorAll('.v4-up,.v4-hero__h1 .v4w,.v4-hero__label,.v4-hero__sub,.v4-hero__stat,.v4-slide__idx,.v4-slide__name-inner,.v4-slide__role,.v4-slide__bio,[data-card]')
      .forEach(function(el){el.style.opacity='1';el.style.transform='none';el.style.filter='none';});
    document.querySelectorAll('.v4-mline').forEach(function(l){l.classList.add('lit','in');});
    document.querySelectorAll('.v4-slide').forEach(function(s,i){if(i===0)s.classList.add('on');});
    document.querySelectorAll('.v4-slide__quote').forEach(function(q){q.textContent='\u201C'+(q.getAttribute('data-tw')||'')+'\u201D';});
  }
})();
</script>
