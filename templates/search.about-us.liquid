<!-- ═══════════════════════════════════════════════════════════════
     HAGUE PROTECT — ABOUT US v4 — SPACING FIXED, NEXT LEVEL
     ═══════════════════════════════════════════════════════════════ -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════════════════════ */
#hpa-v4 {
  --red: #FF2B2B;
  --red-glow: rgba(255,43,43,0.15);
  --red-soft: rgba(255,43,43,0.07);
  --red-border: rgba(255,43,43,0.22);
  --blk: #030303;
  --dark: #0c0c0c;
  --card: rgba(255,255,255,0.03);
  --bdr: rgba(255,255,255,0.06);
  --w100: #ffffff;
  --w85: rgba(255,255,255,0.85);
  --w65: rgba(255,255,255,0.65);
  --w45: rgba(255,255,255,0.45);
  --w20: rgba(255,255,255,0.20);
  --w10: rgba(255,255,255,0.10);
  --w05: rgba(255,255,255,0.05);
  --fd: 'Bebas Neue', sans-serif;
  --fb: 'Outfit', sans-serif;
  --fl: 'Outfit', sans-serif;
  --ex: cubic-bezier(0.16,1,0.3,1);

  /* EXPLICIT SECTION SPACING */
  --sec-pad-v: 120px;
  --sec-pad-h: clamp(24px, 6vw, 100px);
}

/* ══════════════════════════════════════════════════════
   SCOPED RESET — only box-sizing, keep natural flow
══════════════════════════════════════════════════════ */
#hpa-v4,
#hpa-v4 * {
  box-sizing: border-box;
}
#hpa-v4 {
  display: block;
  background: var(--blk);
  color: var(--w100);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-family: var(--fb);
  font-size: 16px;
  line-height: 1.6;
}
/* Explicitly zero out only elements we fully control */
#hpa-v4 h1,
#hpa-v4 h2,
#hpa-v4 h3,
#hpa-v4 p,
#hpa-v4 ul,
#hpa-v4 ol,
#hpa-v4 li,
#hpa-v4 blockquote,
#hpa-v4 figure,
#hpa-v4 div,
#hpa-v4 section,
#hpa-v4 span,
#hpa-v4 button,
#hpa-v4 a {
  margin: 0;
  padding: 0;
  font-size: inherit;
  font-family: inherit;
  font-weight: inherit;
  line-height: inherit;
  color: inherit;
  text-decoration: none;
  list-style: none;
  background: none;
  border: none;
  outline: none;
}
#hpa-v4 em { font-style: normal; color: var(--red); }

/* ══════════════════════════════════════════════════════
   SCROLL PROGRESS + CURSOR
══════════════════════════════════════════════════════ */
.v4-bar {
  position: fixed; top: 0; left: 0; width: 0%; height: 3px;
  background: linear-gradient(90deg, #FF2B2B, #ff6b6b, #FF2B2B);
  background-size: 200%; z-index: 9999; pointer-events: none;
  animation: v4-shimmer 2s linear infinite;
}
@keyframes v4-shimmer { 0%{background-position:0%} 100%{background-position:200%} }

.v4-dot, .v4-ring { display: none; position: fixed; pointer-events: none; border-radius: 50%; }
@media (pointer:fine) and (min-width:1025px) {
  .v4-dot { display: block; width: 7px; height: 7px; background: #fff; top: 0; left: 0; z-index: 99999; mix-blend-mode: difference; }
  .v4-ring { display: block; width: 46px; height: 46px; border: 1px solid rgba(255,43,43,0.45); top: 0; left: 0; z-index: 99998; }
}

/* ══════════════════════════════════════════════════════
   §1 HERO
══════════════════════════════════════════════════════ */
.v4-hero {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 680px;
  background: var(--blk);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 80px;   /* clearance for header */
  padding-bottom: 100px; /* clearance for stats bar */
  padding-left: var(--sec-pad-h);
  padding-right: var(--sec-pad-h);
}
.v4-hero__glow {
  position: absolute; inset: 0; pointer-events: none; z-index: 0;
  background:
    radial-gradient(ellipse 70% 60% at 70% 20%, rgba(255,43,43,0.06) 0%, transparent 55%),
    radial-gradient(circle at 15% 85%, rgba(80,80,255,0.02) 0%, transparent 45%);
}
.v4-hero__grid {
  position: absolute; inset: 0; pointer-events: none; z-index: 0;
  background-image: linear-gradient(var(--w05) 1px, transparent 1px), linear-gradient(90deg, var(--w05) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 72%);
  -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 72%);
}
.v4-hero__bgword {
  position: absolute; right: clamp(20px,5vw,80px); top: 50%; transform: translateY(-50%);
  font-family: var(--fd); font-size: clamp(180px, 26vw, 380px); line-height: 1;
  color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.03);
  pointer-events: none; user-select: none; letter-spacing: -0.04em; z-index: 0;
}
.v4-hero__inner { position: relative; z-index: 2; }

/* Label */
.v4-hero__label {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-family: var(--fl);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.28em;
  color: var(--red);
  margin-bottom: 32px; /* SPACING BELOW LABEL */
  opacity: 0;
}
.v4-hero__label::before { content: ''; display: block; width: 36px; height: 1px; background: var(--red); flex-shrink: 0; }

/* Headline */
.v4-hero__h1 {
  font-family: var(--fd);
  font-size: clamp(68px, 12vw, 180px);
  font-weight: 400;
  text-transform: uppercase;
  line-height: 0.9;
  letter-spacing: -0.01em;
  color: var(--w100);
  margin-bottom: 36px; /* SPACING BELOW HEADLINE */
}
.v4-hero__h1 .v4w { display: inline-block; opacity: 0; transform: translateY(100%) rotateX(18deg); filter: blur(10px); transform-origin: 50% 100%; }
.v4-hero__h1 .v4w--r { color: var(--red); }

/* Sub */
.v4-hero__sub {
  font-family: var(--fb);
  font-size: clamp(15px, 1.6vw, 19px);
  font-weight: 400;
  color: var(--w65);
  line-height: 1.75;
  max-width: clamp(300px, 44vw, 560px);
  opacity: 0;
}

/* Stats */
.v4-hero__stats {
  position: absolute; bottom: 0; left: 0; right: 0; z-index: 3;
  display: flex;
  border-top: 1px solid var(--bdr);
  background: rgba(3,3,3,0.75);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
.v4-hero__stat {
  flex: 1;
  padding: 24px clamp(20px,3vw,48px);
  border-right: 1px solid var(--bdr);
  opacity: 0;
  transform: translateY(16px);
  transition: background 0.3s;
}
.v4-hero__stat:last-child { border-right: none; }
.v4-hero__stat:hover { background: var(--card); }
.v4-hero__stat-n {
  display: block;
  font-family: var(--fd);
  font-size: clamp(32px, 4.5vw, 60px);
  line-height: 1;
  color: var(--w100);
  margin-bottom: 6px; /* SPACING inside stat */
}
.v4-hero__stat-n span { color: var(--red); }
.v4-hero__stat-l {
  display: block;
  font-family: var(--fl);
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--w45);
}

/* Scroll cue */
.v4-hero__cue {
  position: absolute; right: clamp(20px,4vw,56px); bottom: 100px; z-index: 3;
  display: flex; flex-direction: column; align-items: center; gap: 10px;
}
.v4-hero__cue span { font-family: var(--fl); font-size: 9px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--w45); writing-mode: vertical-rl; }
.v4-hero__cue-ln { width: 1px; height: 60px; overflow: hidden; }
.v4-hero__cue-ln::after { content: ''; display: block; width: 1px; height: 100%; background: linear-gradient(to bottom, transparent, var(--red)); animation: v4-cue 2s ease-in-out infinite; }
@keyframes v4-cue { 0%{transform:translateY(-100%)} 60%,100%{transform:translateY(200%)} }

@media (max-width:768px) {
  .v4-hero { padding-bottom: 96px; justify-content: flex-end; padding-top: 120px; }
  .v4-hero__stats { flex-wrap: wrap; }
  .v4-hero__stat { flex: 1 1 50%; border-bottom: 1px solid var(--bdr); }
  .v4-hero__bgword { display: none; }
  .v4-hero__cue { display: none; }
  .v4-hero__h1 { font-size: clamp(54px, 14vw, 100px); margin-bottom: 24px; }
  .v4-hero__label { margin-bottom: 20px; }
}

/* ══════════════════════════════════════════════════════
   SECTION DIVIDER HELPER
══════════════════════════════════════════════════════ */
.v4-section {
  display: block;
  padding-top: var(--sec-pad-v);
  padding-bottom: var(--sec-pad-v);
  padding-left: var(--sec-pad-h);
  padding-right: var(--sec-pad-h);
}
.v4-section--dark { background: var(--dark); border-top: 1px solid var(--bdr); }
.v4-section--black { background: var(--blk); border-top: 1px solid var(--bdr); }

/* Eyebrow label (reusable) */
.v4-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-family: var(--fl);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.28em;
  color: var(--red);
  margin-bottom: 24px; /* SPACING BELOW EYEBROW */
}
.v4-eyebrow::before { content: ''; display: block; width: 36px; height: 1px; background: var(--red); flex-shrink: 0; }

/* Section heading */
.v4-section-h {
  font-family: var(--fd);
  font-size: clamp(40px, 6vw, 80px);
  font-weight: 400;
  text-transform: uppercase;
  line-height: 1.0;
  color: var(--w100);
  margin-bottom: 16px; /* SPACING BELOW SECTION HEADING */
}

/* Section sub-text */
.v4-section-sub {
  font-family: var(--fb);
  font-size: 15px;
  font-weight: 400;
  color: var(--w65);
  line-height: 1.8;
}

/* ══════════════════════════════════════════════════════
   §2 MANIFESTO
══════════════════════════════════════════════════════ */
.v4-manifesto-lines { margin-top: 56px; } /* SPACING above lines */
.v4-mline {
  font-family: var(--fd);
  font-size: clamp(28px, 5vw, 76px);
  font-weight: 400;
  line-height: 1.2;
  text-transform: uppercase;
  color: var(--w20);
  padding-top: 28px;
  padding-bottom: 28px; /* SPACING between lines */
  border-bottom: 1px solid var(--bdr);
  display: flex;
  align-items: flex-start;
  gap: 20px;
  flex-wrap: wrap;
  cursor: default;
  transition: color 0.5s var(--ex);
}
.v4-mline:first-child { border-top: 1px solid var(--bdr); }
.v4-mline-num {
  font-family: var(--fl);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--w20);
  text-transform: uppercase;
  flex-shrink: 0;
  padding-top: 8px;
  min-width: 24px;
  transition: color 0.5s;
}
.v4-mline.lit { color: var(--w100); }
.v4-mline.lit .v4-mline-num { color: var(--red); }
.v4-mline em { color: var(--red); }
@media (max-width:768px) {
  .v4-mline { font-size: clamp(24px, 6.5vw, 42px); padding-top: 22px; padding-bottom: 22px; }
}

/* ══════════════════════════════════════════════════════
   §3 PRINCIPLES
══════════════════════════════════════════════════════ */
.v4-prin-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  flex-wrap: wrap;
  margin-bottom: 56px; /* SPACING below header */
}
.v4-prin-top-right { max-width: 360px; }

.v4-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 18px;
}

/* Card */
.v4-card {
  border-radius: 20px;
  border: 1px solid var(--bdr);
  background: var(--card);
  padding: clamp(32px,4vw,52px);
  position: relative;
  overflow: hidden;
  transition: border-color 0.4s, transform 0.5s var(--ex), box-shadow 0.4s;
  opacity: 0;
  transform: translateY(40px);
  filter: blur(4px);
}
.v4-card.in { opacity: 1; transform: translateY(0); filter: blur(0); transition: opacity 0.8s var(--ex), transform 0.8s var(--ex), filter 0.7s, border-color 0.4s, box-shadow 0.4s; }
.v4-card::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(135deg, rgba(255,43,43,0.05) 0%, transparent 60%); opacity: 0; transition: opacity 0.4s; pointer-events: none; }
.v4-card:hover { border-color: var(--red-border); box-shadow: 0 20px 60px rgba(255,43,43,0.07); transform: translateY(-4px); }
.v4-card:hover::before { opacity: 1; }

/* Grid spans */
.v4-card--a { grid-column: span 5; }
.v4-card--b { grid-column: span 7; display: flex; align-items: center; gap: 32px; }
.v4-card--c { grid-column: span 4; }
.v4-card--d { grid-column: span 4; }
.v4-card--e { grid-column: span 4; background: var(--red); border-color: transparent; }
.v4-card--e::before { background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 60%); }
.v4-card--e:hover { border-color: transparent; box-shadow: 0 20px 60px rgba(255,43,43,0.4); }

@media (max-width:1100px) {
  .v4-card--a, .v4-card--b { grid-column: span 12; }
  .v4-card--b { flex-direction: column; align-items: flex-start; }
  .v4-card--c, .v4-card--d, .v4-card--e { grid-column: span 4; }
}
@media (max-width:768px) {
  .v4-grid { grid-template-columns: 1fr; gap: 14px; }
  .v4-card--a, .v4-card--b, .v4-card--c, .v4-card--d, .v4-card--e { grid-column: span 1; }
  .v4-card--b { flex-direction: column; }
}

/* Card internals — all with explicit margins */
.v4-card__num {
  font-family: var(--fd);
  font-size: clamp(52px, 8vw, 96px);
  font-weight: 400;
  color: var(--w05);
  line-height: 1;
  margin-bottom: 24px; /* SPACING */
  letter-spacing: -0.02em;
}
.v4-card--e .v4-card__num { color: rgba(255,255,255,0.12); }

.v4-card__icon {
  width: 44px;
  height: 44px;
  color: var(--red);
  margin-bottom: 20px; /* SPACING */
  flex-shrink: 0;
}
.v4-card--e .v4-card__icon { color: var(--w100); }

.v4-card__title {
  font-family: var(--fd);
  font-size: clamp(26px, 3vw, 38px);
  font-weight: 400;
  text-transform: uppercase;
  line-height: 1.1;
  color: var(--w100);
  margin-bottom: 14px; /* SPACING */
}
.v4-card--e .v4-card__title { color: var(--w100); }

.v4-card__desc {
  font-family: var(--fb);
  font-size: 14px;
  font-weight: 400;
  color: var(--w65);
  line-height: 1.85;
  max-width: 320px;
}
.v4-card--e .v4-card__desc { color: rgba(255,255,255,0.82); }

/* Wide card b: inner / visual split */
.v4-card--b .v4-card__inner { flex: 0 0 auto; max-width: 380px; }
.v4-card--b .v4-card__vis {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  min-height: 120px;
}
.v4-card--b .v4-card__vis-word {
  font-family: var(--fd);
  font-size: clamp(72px, 11vw, 140px);
  font-weight: 400;
  text-transform: uppercase;
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,255,255,0.07);
  line-height: 1;
  letter-spacing: -0.03em;
  white-space: nowrap;
  animation: v4-float 7s ease-in-out infinite;
}
@keyframes v4-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }

/* ══════════════════════════════════════════════════════
   §4 TEAM
══════════════════════════════════════════════════════ */
.v4-team-intro {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 40px;
  flex-wrap: wrap;
  padding-top: var(--sec-pad-v);
  padding-bottom: 80px;
  padding-left: var(--sec-pad-h);
  padding-right: var(--sec-pad-h);
  background: var(--dark);
  border-top: 1px solid var(--bdr);
}
.v4-team-intro__left { flex: 1; min-width: 260px; }
.v4-team-intro__right { max-width: 340px; }
.v4-team-intro__right .v4-section-sub { font-size: 15px; }

/* Slide */
.v4-slide {
  position: relative;
  width: 100%;
  min-height: 88vh;
  display: flex;
  align-items: stretch;
  border-top: 1px solid var(--bdr);
  overflow: hidden;
  background: var(--dark);
}
.v4-slide__bg {
  position: absolute; inset: 0; z-index: 0;
  transition: filter 1.6s var(--ex);
  filter: grayscale(100%) brightness(0.18);
  transform: scale(1.06);
  will-change: filter, transform;
}
.v4-slide.on .v4-slide__bg { filter: grayscale(35%) brightness(0.28); }

/* Content pane */
.v4-slide__pane {
  position: relative; z-index: 2;
  flex: 0 0 58%;
  padding-top: clamp(60px, 9vh, 110px);
  padding-bottom: clamp(60px, 9vh, 110px);
  padding-left: clamp(36px, 7vw, 120px);
  padding-right: clamp(36px, 5vw, 80px);
  background: linear-gradient(90deg, rgba(3,3,3,0.97) 0%, rgba(3,3,3,0.87) 58%, rgba(3,3,3,0.35) 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Slide index */
.v4-slide__idx {
  font-family: var(--fl);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.25em;
  color: var(--red);
  margin-bottom: 28px; /* SPACING */
  display: flex;
  align-items: center;
  gap: 12px;
  opacity: 0;
}
.v4-slide__idx::after { content: ''; display: block; width: 40px; height: 1px; background: var(--red); flex-shrink: 0; }

/* Name */
.v4-slide__name {
  font-family: var(--fd);
  font-size: clamp(60px, 8.5vw, 118px);
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height: 0.92;
  color: var(--w100);
  margin-bottom: 22px; /* SPACING */
  overflow: hidden;
}
.v4-slide__name-inner { display: block; transform: translateY(110%); opacity: 0; }

/* Role */
.v4-slide__role {
  font-family: var(--fl);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--w65);
  margin-bottom: 36px; /* SPACING */
  opacity: 0;
  display: inline-block;
  position: relative;
  padding-bottom: 8px;
}
.v4-slide__role::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0%; height: 1.5px; background: var(--red); transition: width 1.2s var(--ex) 0.5s; }
.v4-slide.on .v4-slide__role::after { width: 100%; }

/* Quote */
.v4-slide__quote {
  font-family: var(--fb);
  font-size: clamp(17px, 1.9vw, 22px);
  font-weight: 300;
  font-style: italic;
  color: var(--w85);
  line-height: 1.72;
  max-width: 500px;
  margin-bottom: 36px; /* SPACING */
  min-height: 68px;
}
.v4-slide__quote .tw { display: inline-block; width: 2px; height: 1em; background: var(--red); margin-left: 2px; animation: v4-blink 0.75s step-end infinite; vertical-align: text-bottom; }
@keyframes v4-blink { 50%{opacity:0} }

/* Bio */
.v4-slide__bio {
  font-family: var(--fb);
  font-size: 14px;
  font-weight: 400;
  color: var(--w45);
  line-height: 1.85;
  max-width: 460px;
  border-left: 2px solid var(--red-border);
  padding-left: 18px;
  opacity: 0;
  transform: translateY(18px);
}

/* Right ghost number panel */
.v4-slide__num-pane {
  position: relative; z-index: 2;
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(90deg, transparent 0%, rgba(3,3,3,0.35) 100%);
}
.v4-slide__bignum {
  font-family: var(--fd);
  font-size: clamp(150px, 25vw, 360px);
  font-weight: 400;
  color: transparent;
  -webkit-text-stroke: 1px rgba(255,255,255,0.04);
  line-height: 1;
  user-select: none;
}

/* Nav dots */
.v4-team-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  padding-top: 32px;
  padding-bottom: 32px;
  background: var(--dark);
  border-top: 1px solid var(--bdr);
}
.v4-team-nav__dot {
  width: 9px; height: 9px; border-radius: 50%;
  background: var(--w20); border: none; cursor: pointer;
  transition: all 0.35s;
}
.v4-team-nav__dot.on { background: var(--red); transform: scale(1.5); box-shadow: 0 0 12px var(--red-glow); }

@media (max-width:768px) {
