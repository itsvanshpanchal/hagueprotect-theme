.v4-cta__btn::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.14), transparent); transition: left 0.55s; }
.v4-cta__btn:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 18px 52px rgba(255,43,43,0.38); }
.v4-cta__btn:hover::before { left: 100%; }
