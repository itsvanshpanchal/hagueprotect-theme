      <span class="hp-about__marquee-item">Material First</span><span class="hp-about__marquee-sep"> • </span>
      <span class="hp-about__marquee-item is-accent">Zero Compromise</span><span class="hp-about__marquee-sep"> • </span>
      <!-- Duplicate for seamless loop -->
      <span class="hp-about__marquee-item">Safer Choice</span><span class="hp-about__marquee-sep"> • </span>
      <span class="hp-about__marquee-item is-accent">Premium Care</span><span class="hp-about__marquee-sep"> • </span>
      <span class="hp-about__marquee-item">Global Protection</span><span class="hp-about__marquee-sep"> • </span>
      <span class="hp-about__marquee-item is-accent">Skin Longevity</span><span class="hp-about__marquee-sep"> • </span>
      <span class="hp-about__marquee-item">Bioenzyme Powered</span><span class="hp-about__marquee-sep"> • </span>
