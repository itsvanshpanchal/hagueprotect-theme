     HAGUE PROTECT — ABOUT US  ·  Cinematic Scroll Experience v2
     Libraries: GSAP + ScrollTrigger (CDN), Lenis Smooth Scroll
     All scripts load ONLY on this page (not globally).
     ═══════════════════════════════════════════════════════════════ -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ═══════════════════════════════════════
   0. RESET & TOKENS
   ═══════════════════════════════════════ */
.hp-about {
  --accent: #FF2B2B;
  --accent-glow: rgba(255,43,43,0.15);
  --accent-soft: rgba(255,43,43,0.08);
  --bg-black: #050505;
  --bg-charcoal: #0c0c0c;
  --bg-elevated: #111111;
  --bg-card: rgba(255,255,255,0.03);
  --border-subtle: rgba(255,255,255,0.06);
  --border-accent: rgba(255,43,43,0.25);
  --white: #ffffff;
  --white-95: rgba(255,255,255,0.95);
  --white-80: rgba(255,255,255,0.80);
  --white-60: rgba(255,255,255,0.60);
  --white-40: rgba(255,255,255,0.40);
  --white-20: rgba(255,255,255,0.20);
  --white-08: rgba(255,255,255,0.08);
  --font-display: 'Outfit', var(--font-family-heading, 'Inter', sans-serif);
  --font-body: var(--font-family-sans, 'Inter', sans-serif);
  --font-label: var(--font-family-eyebrow, var(--font-family-sans, 'Inter', sans-serif));
  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
  margin: 0; padding: 0;
  background: var(--bg-black);
  color: var(--white);
  overflow-x: hidden;
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.6;
}
.hp-about *, .hp-about *::before, .hp-about *::after { box-sizing: border-box; margin: 0; padding: 0; }
.hp-about em { font-style: italic; color: var(--accent); }

/* ── Scroll Progress ── */
.hp-about__progress { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: linear-gradient(90deg, var(--accent), #ff6b6b); z-index: 9999; will-change: width; pointer-events: none; }

/* ── Custom Cursor (desktop only) ── */
.hp-about__cursor, .hp-about__cursor-ring { display: none; }
@media (pointer: fine) and (min-width: 1025px) {
  .hp-about__cursor { position: fixed; top: 0; left: 0; width: 8px; height: 8px; background: var(--white); border-radius: 50%; pointer-events: none; z-index: 99999; mix-blend-mode: difference; display: block; }
  .hp-about__cursor-ring { position: fixed; top: 0; left: 0; width: 44px; height: 44px; border: 1.5px solid var(--white-40); border-radius: 50%; pointer-events: none; z-index: 99998; display: block; }
}

/* ═══════════════════════════════════════
   1. HERO (100vh full-screen)
   ═══════════════════════════════════════ */
.hp-about__hero {
  position: relative; width: 100%; height: 100vh; min-height: 640px;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; background: var(--bg-black);
}
.hp-about__hero-bg {
  position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(ellipse 100% 80% at 50% 30%, var(--accent-soft) 0%, transparent 60%),
    radial-gradient(circle at 20% 80%, rgba(255,43,43,0.03) 0%, transparent 40%),
    radial-gradient(circle at 80% 20%, rgba(100,100,255,0.02) 0%, transparent 40%);
}
/* Animated grain overlay */
.hp-about__hero-grain {
  position: absolute; inset: -50%; width: 200%; height: 200%;
  opacity: 0.025; z-index: 1; pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  animation: hp-grain-shift 8s steps(10) infinite;
}
@keyframes hp-grain-shift { 0% { transform: translate(0,0); } 100% { transform: translate(-10%,-10%); } }

.hp-about__hero-content { position: relative; z-index: 2; text-align: center; padding: 0 24px; max-width: 1200px; }
.hp-about__hero-eyebrow {
  font-family: var(--font-label); font-size: 13px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.25em; color: var(--accent);
  margin-bottom: 36px; opacity: 0; transform: translateY(24px);
  display: inline-flex; align-items: center; gap: 12px;
}
.hp-about__hero-eyebrow::before, .hp-about__hero-eyebrow::after {
  content: ''; display: block; width: 40px; height: 1px; background: var(--accent);
}
.hp-about__hero-headline {
  font-family: var(--font-display); font-size: clamp(48px, 9vw, 140px);
  font-weight: 900; line-height: 0.92; letter-spacing: -0.04em;
  color: var(--white); text-transform: uppercase;
}
.hp-about__hero-headline .word {
  display: inline-block; opacity: 0; transform: translateY(80px) rotateX(15deg);
  filter: blur(10px); transform-origin: center bottom;
}
.hp-about__hero-sub {
  font-family: var(--font-body); font-size: clamp(16px, 1.8vw, 20px);
  color: var(--white-80); max-width: 600px; margin: 40px auto 0;
  line-height: 1.7; font-weight: 400; opacity: 0; transform: translateY(30px);
}
.hp-about__hero-stats {
  display: flex; justify-content: center; gap: clamp(32px, 6vw, 80px);
  margin-top: 56px; opacity: 0; transform: translateY(30px);
}
.hp-about__hero-stat { text-align: center; }
.hp-about__hero-stat-num {
  font-family: var(--font-display); font-size: clamp(36px, 5vw, 64px);
  font-weight: 800; color: var(--white); line-height: 1;
  background: linear-gradient(135deg, var(--white) 60%, var(--accent));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hp-about__hero-stat-label {
  font-size: 12px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.15em; color: var(--white-60); margin-top: 8px;
}
/* Scroll indicator */
.hp-about__scroll-cue {
  position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
  z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 10px;
}
.hp-about__scroll-cue span { font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--white-40); font-weight: 600; }
.hp-about__scroll-cue-line { width: 1px; height: 52px; position: relative; overflow: hidden; }
.hp-about__scroll-cue-line::after {
  content: ''; position: absolute; top: -100%; left: 0; width: 1px; height: 100%;
  background: linear-gradient(to bottom, transparent, var(--accent));
  animation: hp-scroll-cue 2s ease-in-out infinite;
}
@keyframes hp-scroll-cue { 0% { top: -100%; } 50% { top: 100%; } 100% { top: 100%; } }

/* ═══════════════════════════════════════
   2. ORIGIN STORY (pinned)
   ═══════════════════════════════════════ */
.hp-about__origin { position: relative; min-height: 300vh; background: var(--bg-charcoal); }
.hp-about__origin-pin {
  position: relative; width: 100%; height: 100vh;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.hp-about__origin-ambient {
  position: absolute; inset: 0; z-index: 0; opacity: 0;
  transition: opacity 1s ease;
}
.hp-about__origin-content {
  position: relative; z-index: 1; max-width: 960px; padding: 0 40px; text-align: center;
}
.hp-about__origin-label {
  font-family: var(--font-label); font-size: 12px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent);
  margin-bottom: 48px;
}
.hp-about__origin-line {
  font-family: var(--font-display); font-size: clamp(22px, 3.5vw, 44px);
  font-weight: 600; line-height: 1.4; letter-spacing: -0.01em;
  color: var(--white-20); transition: color 0.7s var(--ease-out-expo), opacity 0.7s;
  margin-bottom: 20px;
}
.hp-about__origin-line.is-active { color: var(--white-95); }
.hp-about__origin-line em { color: var(--accent); font-style: italic; }
/* Progress bar on side */
.hp-about__origin-progress {
  position: absolute; right: 48px; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 10px; z-index: 2;
}
.hp-about__origin-pip {
  width: 3px; height: 24px; border-radius: 2px;
  background: var(--white-08); transition: background 0.5s, height 0.5s;
}
.hp-about__origin-pip.is-active { background: var(--accent); height: 44px; }
@media (max-width: 768px) {
  .hp-about__origin { min-height: auto; padding: 100px 0; }
  .hp-about__origin-pin { height: auto; }
  .hp-about__origin-progress { display: none; }
  .hp-about__origin-line { font-size: clamp(18px, 5vw, 26px); margin-bottom: 32px; }
}

/* ═══════════════════════════════════════
   3. PHILOSOPHY — HORIZONTAL SCROLL
   ═══════════════════════════════════════ */
.hp-about__philosophy { position: relative; overflow: hidden; background: var(--bg-black); }
.hp-about__philosophy-header {
  text-align: center; padding: 100px 24px 0;
}
.hp-about__philosophy-eyebrow {
  font-family: var(--font-label); font-size: 12px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); margin-bottom: 16px;
}
.hp-about__philosophy-heading {
  font-family: var(--font-display); font-size: clamp(32px, 5vw, 60px);
  font-weight: 800; color: var(--white); text-transform: uppercase; letter-spacing: -0.02em;
}
.hp-about__philosophy-track {
  display: flex; width: max-content; padding: 60px 10vw 80px;
  gap: 40px; align-items: stretch; height: 100vh;
}
.hp-about__philosophy-card {
  flex: 0 0 clamp(300px, 28vw, 400px); border-radius: 24px;
  border: 1px solid var(--border-subtle); background: var(--bg-card);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  display: flex; flex-direction: column; align-items: flex-start;
  justify-content: center; padding: 48px 40px; text-align: left;
  transition: border-color 0.5s, transform 0.5s var(--ease-out-expo), box-shadow 0.5s;
  position: relative; overflow: hidden;
}
.hp-about__philosophy-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  opacity: 0; transition: opacity 0.5s;
}
.hp-about__philosophy-card:hover { border-color: var(--border-accent); transform: translateY(-8px); box-shadow: 0 20px 60px rgba(255,43,43,0.06); }
.hp-about__philosophy-card:hover::before { opacity: 1; }
.hp-about__philosophy-num {
  font-family: var(--font-display); font-size: 80px; font-weight: 900;
  color: var(--white-08); line-height: 1; margin-bottom: 24px;
  background: linear-gradient(180deg, var(--white-20) 0%, transparent 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.hp-about__philosophy-icon {
  width: 52px; height: 52px; margin-bottom: 28px; color: var(--accent);
  padding: 12px; border-radius: 14px; background: rgba(255,43,43,0.08);
  display: flex; align-items: center; justify-content: center;
}
.hp-about__philosophy-icon svg { width: 100%; height: 100%; }
.hp-about__philosophy-icon path, .hp-about__philosophy-icon circle,
.hp-about__philosophy-icon line, .hp-about__philosophy-icon polyline {
  stroke-dasharray: 200; stroke-dashoffset: 200; transition: stroke-dashoffset 1.5s var(--ease-out-expo);
}
.hp-about__philosophy-card.is-visible .hp-about__philosophy-icon path,
.hp-about__philosophy-card.is-visible .hp-about__philosophy-icon circle,
.hp-about__philosophy-card.is-visible .hp-about__philosophy-icon line,
.hp-about__philosophy-card.is-visible .hp-about__philosophy-icon polyline { stroke-dashoffset: 0; }
.hp-about__philosophy-title {
  font-family: var(--font-display); font-size: 26px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.02em; margin-bottom: 14px; color: var(--white);
}
.hp-about__philosophy-desc { font-size: 15px; color: var(--white-60); line-height: 1.7; }

@media (max-width: 768px) {
  .hp-about__philosophy { overflow: visible; }
  .hp-about__philosophy-track { flex-direction: column; width: 100%; height: auto; padding: 40px 20px 80px; gap: 24px; }
  .hp-about__philosophy-card { flex: none; width: 100%; }
  .hp-about__philosophy-num { font-size: 56px; }
}

/* ═══════════════════════════════════════
   4. TEAM SPOTLIGHT
   ═══════════════════════════════════════ */
.hp-about__team { position: relative; background: var(--bg-charcoal); }
.hp-about__team-header {
  text-align: center; padding: 120px 24px 60px;
}
.hp-about__team-eyebrow {
  font-family: var(--font-label); font-size: 12px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); margin-bottom: 16px;
}
.hp-about__team-heading {
  font-family: var(--font-display); font-size: clamp(32px, 5vw, 56px);
  font-weight: 800; color: var(--white); text-transform: uppercase;
}

.hp-about__team-slide {
  position: relative; width: 100%; min-height: 100vh;
  display: flex; align-items: center; overflow: hidden;
}
.hp-about__team-portrait { position: absolute; inset: 0; z-index: 0; }
.hp-about__team-portrait-placeholder {
  width: 100%; height: 100%; transition: filter 1.4s var(--ease-out-expo);
  filter: grayscale(100%) brightness(0.25); transform: scale(1.08); will-change: transform, filter;
}
.hp-about__team-slide.is-active .hp-about__team-portrait-placeholder {
  filter: grayscale(30%) brightness(0.35);
}
/* Dark overlay for text readability */
.hp-about__team-overlay {
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(
    90deg,
    rgba(5,5,5,0.92) 0%,
    rgba(5,5,5,0.75) 40%,
    rgba(5,5,5,0.50) 70%,
    rgba(5,5,5,0.35) 100%
  );
}
.hp-about__team-info {
  position: relative; z-index: 2; max-width: 720px;
  padding: 60px clamp(32px, 8vw, 120px);
}
.hp-about__team-counter {
  font-family: var(--font-label); font-size: 13px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent);
  margin-bottom: 24px; opacity: 0; transform: translateY(16px);
  display: flex; align-items: center; gap: 12px;
}
.hp-about__team-counter::after {
  content: ''; display: block; width: 40px; height: 1px; background: var(--accent);
}
.hp-about__team-name {
  font-family: var(--font-display); font-size: clamp(52px, 8vw, 110px);
  font-weight: 900; text-transform: uppercase; letter-spacing: -0.04em;
  line-height: 0.92; margin-bottom: 12px; color: var(--white);
}
.hp-about__team-name .char {
  display: inline-block; opacity: 0;
  transform: translateY(50px) scale(0.85); filter: blur(6px);
}
.hp-about__team-role {
  font-family: var(--font-label); font-size: clamp(13px, 1.3vw, 15px);
  font-weight: 600; text-transform: uppercase; letter-spacing: 0.14em;
  color: var(--white-80); position: relative; display: inline-block;
  padding-bottom: 8px; margin-bottom: 32px; opacity: 0;
}
.hp-about__team-role::after {
  content: ''; position: absolute; bottom: 0; left: 0; width: 0%; height: 2px;
  background: var(--accent); transition: width 1s var(--ease-out-expo) 0.5s;
}
.hp-about__team-slide.is-active .hp-about__team-role::after { width: 100%; }
.hp-about__team-quote {
  font-family: var(--font-body); font-size: clamp(18px, 2.2vw, 24px);
  font-weight: 400; color: var(--white-80); line-height: 1.6;
  font-style: italic; letter-spacing: 0.01em; min-height: 64px; max-width: 540px;
}
.hp-about__team-quote .tw-cursor {
  display: inline-block; width: 2px; height: 1.1em;
  background: var(--accent); margin-left: 3px;
  animation: hp-blink 0.7s step-end infinite; vertical-align: text-bottom;
}
@keyframes hp-blink { 50% { opacity: 0; } }
/* Bio line below quote */
.hp-about__team-bio {
  margin-top: 28px; font-size: 14px; color: var(--white-60);
  line-height: 1.7; max-width: 480px; opacity: 0; transform: translateY(16px);
  border-left: 2px solid var(--accent); padding-left: 16px;
}

/* Team progress dots */
.hp-about__team-dots {
  position: fixed; right: 36px; top: 50%; transform: translateY(-50%);
  z-index: 100; display: flex; flex-direction: column; gap: 14px;
  opacity: 0; pointer-events: none; transition: opacity 0.5s;
}
.hp-about__team-dots.is-visible { opacity: 1; pointer-events: auto; }
.hp-about__team-dot {
  width: 12px; height: 12px; border-radius: 50%;
  border: 2px solid var(--white-20); background: transparent;
  cursor: pointer; transition: all 0.4s var(--ease-out-expo); position: relative;
}
.hp-about__team-dot.is-active { border-color: var(--accent); background: var(--accent); transform: scale(1.25); box-shadow: 0 0 12px var(--accent-glow); }

@media (max-width: 768px) {
  .hp-about__team-slide { min-height: 100vh; padding: 60px 0; }
  .hp-about__team-dots { display: none; }
  .hp-about__team-overlay { background: linear-gradient(180deg, rgba(5,5,5,0.9) 0%, rgba(5,5,5,0.7) 50%, rgba(5,5,5,0.85) 100%); }
}

/* ═══════════════════════════════════════
   5. VALUES MARQUEE
   ═══════════════════════════════════════ */
.hp-about__marquee {
  padding: 64px 0; background: var(--bg-black); overflow: hidden;
  border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);
}
.hp-about__marquee-track { display: flex; width: max-content; animation: hp-marquee 35s linear infinite; }
.hp-about__marquee-item {
  flex-shrink: 0; font-family: var(--font-display);
  font-size: clamp(20px, 3vw, 36px); font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--white-20); white-space: nowrap; padding: 0 clamp(24px, 3vw, 48px);
  transition: color 0.3s;
}
.hp-about__marquee-item.is-accent { color: var(--accent); }
.hp-about__marquee-sep { flex-shrink: 0; font-size: clamp(20px, 3vw, 36px); color: var(--white-08); padding: 0; }
@keyframes hp-marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

/* ═══════════════════════════════════════
   6. CLOSING CTA
   ═══════════════════════════════════════ */
.hp-about__cta {
  position: relative; width: 100%; min-height: 85vh;
  display: flex; align-items: center; justify-content: center;
  text-align: center; padding: 120px 24px; overflow: hidden; background: var(--bg-black);
}
.hp-about__cta-glow {
  position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(ellipse 50% 40% at 50% 60%, var(--accent-glow) 0%, transparent 70%),
    radial-gradient(circle at 30% 30%, rgba(255,43,43,0.04) 0%, transparent 50%);
  animation: hp-glow-drift 10s ease-in-out infinite alternate;
}
@keyframes hp-glow-drift { 0% { opacity: 0.6; } 100% { opacity: 1; } }
.hp-about__cta-content { position: relative; z-index: 1; max-width: 860px; }
.hp-about__cta-eyebrow {
  font-family: var(--font-label); font-size: 12px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent);
  margin-bottom: 24px;
}
.hp-about__cta-heading {
  font-family: var(--font-display); font-size: clamp(36px, 6vw, 80px);
  font-weight: 900; text-transform: uppercase; letter-spacing: -0.03em;
  line-height: 1.0; margin-bottom: 28px; color: var(--white);
}
.hp-about__cta-sub {
  font-size: clamp(16px, 1.6vw, 19px); color: var(--white-60);
  line-height: 1.7; margin-bottom: 52px; max-width: 560px; margin-left: auto; margin-right: auto;
}
.hp-about__cta-btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 20px 56px; font-family: var(--font-display);
  font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
  color: var(--white); background: var(--accent); border: none;
  border-radius: 60px; text-decoration: none; cursor: pointer;
  transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s;
  position: relative; overflow: hidden;
}
.hp-about__cta-btn::after {
  content: ''; position: absolute; inset: 0; border-radius: inherit;
  background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 50%);
  opacity: 0; transition: opacity 0.3s;
}
.hp-about__cta-btn:hover { transform: translateY(-3px) scale(1.04); box-shadow: 0 16px 48px rgba(255,43,43,0.35); }
.hp-about__cta-btn:hover::after { opacity: 1; }
.hp-about__cta-btn svg { width: 16px; height: 16px; transition: transform 0.3s; }
.hp-about__cta-btn:hover svg { transform: translateX(4px); }

/* ═══════════════════════════════════════
   UTILITY: Fade-up reveal
   ═══════════════════════════════════════ */
.hp-about__reveal {
  opacity: 0; transform: translateY(44px); filter: blur(4px);
  transition: opacity 0.9s var(--ease-out-expo), transform 0.9s var(--ease-out-expo), filter 0.9s var(--ease-out-expo);
}
.hp-about__reveal.is-vis { opacity: 1; transform: translateY(0); filter: blur(0); }
.hp-about__reveal[data-delay="1"] { transition-delay: 0.1s; }
.hp-about__reveal[data-delay="2"] { transition-delay: 0.2s; }
.hp-about__reveal[data-delay="3"] { transition-delay: 0.3s; }

/* ═══════════════════════════════════════
   ACCESSIBILITY
   ═══════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  .hp-about__hero-headline .word, .hp-about__team-name .char, .hp-about__reveal,
  .hp-about__hero-eyebrow, .hp-about__hero-sub, .hp-about__hero-stats,
