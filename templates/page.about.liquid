      <span class="agp-eyebrow__pipe">|</span>
      HAGUE PROTECT
      <span class="agp-eyebrow__pipe">|</span>
    </p>
    <p class="agp-hashtag">#NeverStopPlaying</p>
  </div>

  <!-- Headline -->
  <h2 class="agp-headline">Precision Crafted. Globally Trusted.</h2>

  <!-- Globe / Video container -->
  <div class="agp-globe-wrap">
    <!--
      ══════════════════════════════════════
      VIDEO PLACEHOLDER — Upload your video:
      Replace YOUR_VIDEO_URL_HERE with the
      Shopify-hosted video URL after upload.
      ══════════════════════════════════════
    -->
    <video
      class="agp-globe-video"
      src="YOUR_VIDEO_URL_HERE"
      autoplay
