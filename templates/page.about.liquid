{% section 'split-cta' %}

<div class="anb-section">
  <div class="anb-inner">
    <!-- Giant number sits in the same grid cell as the content, behind it -->
    <div class="anb-number" aria-hidden="true">10</div>
    <div class="anb-content">
      <h2 class="anb-headline">
        10 years. A million soles protected.<br>And we&rsquo;re just getting started.
      </h2>
      <p class="anb-subtext">
        Built in India, trusted worldwide. <strong>Hague Protect</strong> has spent a decade crafting science-backed formulas that honour every sneaker &mdash; from track courts to collector shelves.
      </p>
      <a class="anb-btn" href="/collections/all">SHOP NOW</a>
    </div>
  </div>
</div>

<style>
  .anb-section {
    background: #000;
    width: 100%;
    padding: 0;
    margin: 0;
  }

  /* The inner wrapper uses CSS grid with a single cell
     so both .anb-number and .anb-content stack in the same cell */
  .anb-inner {
    display: grid;
    grid-template-areas: "stack";
    place-items: center;
    min-height: 70vh;
    width: 100%;
    overflow: hidden;
  }

  .anb-number {
    grid-area: stack;
    font-size: clamp(220px, 38vw, 560px);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.12);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
    /* Do NOT use position:absolute — let grid stack it */
  }

  .anb-content {
    grid-area: stack;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 40px 24px;
    max-width: 760px;
    width: 100%;
    position: relative; /* just ensures z-index works */
    z-index: 1;
  }

  .anb-headline {
    font-family: 'Inter', 'Darker Grotesque', sans-serif;
    font-size: clamp(24px, 3.8vw, 42px);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    margin: 0;
  }

  .anb-subtext {
    font-family: 'Darker Grotesque', sans-serif;
    font-size: clamp(15px, 1.6vw, 18px);
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    max-width: 540px;
    margin: 0;
  }

  .anb-subtext strong {
    color: #fff;
  }

  .anb-btn {
    display: inline-block;
    margin-top: 8px;
    padding: 14px 40px;
    border: 2px solid #fff;
    border-radius: 50px;
    background: transparent;
    color: #fff;
    font-family: 'Darker Grotesque', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .anb-btn:hover {
    background: #fff;
    color: #000;
  }

  @media screen and (max-width: 768px) {
    .anb-inner {
      min-height: 55vh;
    }
    .anb-number {
      font-size: clamp(140px, 55vw, 260px);
    }
    .anb-headline {
      font-size: clamp(22px, 6vw, 32px);
    }
  }
</style>

