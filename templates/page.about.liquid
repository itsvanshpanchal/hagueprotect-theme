{% section 'split-cta' %}

<div class="anb-section" id="anb-section">
  <div class="anb-inner">
    <!-- Split "1" and "0" into separate spans for independent animation -->
    <div class="anb-number" aria-hidden="true">
      <span class="anb-digit anb-digit--1">1</span><span class="anb-digit anb-digit--0">0</span>
    </div>
    <!-- Text content BELOW the number, fully separate -->
    <div class="anb-content">
      <h2 class="anb-headline">
        10 years. A million soles protected.<br>And we&rsquo;re just getting started.
      </h2>
      <p class="anb-subtext">
        Built in India, trusted worldwide. <strong>Hague Protect</strong> has spent a decade crafting science-backed formulas that honour every sneaker &mdash; from track courts to collector shelves.
      </p>
      <a class="anb-btn" href="/collections/all">SHOP NOW</a>
    </div>
  </div>
</div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@900&display=swap" rel="stylesheet">

<style>
  .anb-section {
    background: #000;
    width: 100%;
    padding: 0;
    margin: 0;
  }

  .anb-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    overflow: hidden;
  }

  /* Wrapper for the two digits side by side */
  .anb-number {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    padding-top: 48px;
    overflow: hidden; /* clips the digits as they travel in */
  }

  .anb-digit {
    font-size: clamp(180px, 32vw, 520px);
    font-family: 'Inter', 'Arial Black', 'Helvetica Neue', sans-serif;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: #8a8a8a;
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
    display: inline-block;
    /* Start hidden — animated via JS adding .anb-animate class */
    opacity: 0;
  }

  /* "1" slides in FROM THE TOP */
  @keyframes anb-slideFromTop {
    0%   { transform: translateY(-120%); opacity: 0; }
    60%  { opacity: 1; }
    100% { transform: translateY(0);    opacity: 1; }
  }

  /* "0" slides in FROM THE BOTTOM */
  @keyframes anb-slideFromBottom {
    0%   { transform: translateY(120%); opacity: 0; }
    60%  { opacity: 1; }
    100% { transform: translateY(0);   opacity: 1; }
  }

  /* Triggered by JS when section enters viewport */
  .anb-section.anb-animate .anb-digit--1 {
    animation: anb-slideFromTop 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.1s;
  }

  .anb-section.anb-animate .anb-digit--0 {
    animation: anb-slideFromBottom 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.15s;
  }

  /* Text sits BELOW the number */
  .anb-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 48px 24px 80px;
    max-width: 760px;
    width: 100%;
  }

  .anb-headline {
    font-family: 'Inter', 'Darker Grotesque', sans-serif;
    font-size: clamp(24px, 3.8vw, 42px);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    margin: 0;
  }

  .anb-subtext {
    font-family: 'Darker Grotesque', sans-serif;
    font-size: clamp(15px, 1.6vw, 18px);
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
    max-width: 540px;
    margin: 0;
  }

  .anb-subtext strong {
    color: #fff;
  }

  .anb-btn {
    display: inline-block;
    margin-top: 8px;
    padding: 14px 40px;
    border: 2px solid #fff;
    border-radius: 50px;
    background: transparent;
    color: #fff;
    font-family: 'Darker Grotesque', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .anb-btn:hover {
    background: #fff;
    color: #000;
  }

  @media screen and (max-width: 768px) {
    .anb-number {
      padding-top: 28px;
    }
    .anb-digit {
      font-size: clamp(100px, 42vw, 180px);
    }
    .anb-content {
      padding: 28px 20px 60px;
    }
    .anb-headline {
      font-size: clamp(20px, 6vw, 30px);
    }
  }
</style>

<script>
  (function () {
    var section = document.getElementById('anb-section');
    if (!section) return;

    var triggered = false;

    function trigger() {
      if (triggered) return;
      triggered = true;
      section.classList.add('anb-animate');
    }

    // Use IntersectionObserver so it fires when the section scrolls into view
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            trigger();
            observer.disconnect();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(section);
    } else {
      // Fallback: fire immediately
      trigger();
    }
  })();
</script>

<!-- ═══════════════════════════════════════════════
     THIRD SECTION — Global Pedigree / Video Globe
     ═══════════════════════════════════════════════ -->
<div class="agp-section">

  <!-- Top bar: eyebrow left + hashtag right -->
  <div class="agp-topbar">
