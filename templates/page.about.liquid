{% section 'split-cta' %}

{% comment %} ═══ SECTION 2: Number Banner ═══ {% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@900&display=swap" rel="stylesheet">

<div class="anb-section" id="anb-section">
  <div class="anb-inner">
    <div class="anb-number" aria-hidden="true">
      <span class="anb-digit anb-digit--1">1</span><span class="anb-digit anb-digit--0">0</span>
    </div>
    <div class="anb-content">
      <h2 class="anb-headline">10 years. A million soles protected.<br>And we&rsquo;re just getting started.</h2>
      <p class="anb-subtext">Built in India, trusted worldwide. <strong>Hague Protect</strong> has spent a decade crafting science-backed formulas that honour every sneaker &mdash; from track courts to collector shelves.</p>
      <a class="anb-btn" href="/collections/all">SHOP NOW</a>
    </div>
  </div>
</div>

<style>
  .anb-section { background:#000; width:100%; padding:0; margin:0; }
  .anb-inner { display:flex; flex-direction:column; align-items:center; width:100%; overflow:hidden; }
  .anb-number { display:flex; justify-content:center; align-items:flex-end; width:100%; padding-top:48px; overflow:hidden; }
  .anb-digit {
    font-size: clamp(180px, 32vw, 520px);
    font-family: 'Inter', 'Arial Black', sans-serif;
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: #8a8a8a;
    user-select: none;
    pointer-events: none;
    display: inline-block;
    opacity: 0;
  }
  @keyframes anb-from-top    { 0%{transform:translateY(-120%);opacity:0} 60%{opacity:1} 100%{transform:translateY(0);opacity:1} }
  @keyframes anb-from-bottom { 0%{transform:translateY(120%);opacity:0}  60%{opacity:1} 100%{transform:translateY(0);opacity:1} }
  .anb-section.anb-animate .anb-digit--1 { animation: anb-from-top    0.9s cubic-bezier(0.22,1,0.36,1) 0.10s forwards; }
  .anb-section.anb-animate .anb-digit--0 { animation: anb-from-bottom 0.9s cubic-bezier(0.22,1,0.36,1) 0.15s forwards; }
  .anb-content { display:flex; flex-direction:column; align-items:center; text-align:center; gap:20px; padding:48px 24px 80px; max-width:760px; width:100%; }
  .anb-headline { font-family:'Inter','Darker Grotesque',sans-serif; font-size:clamp(24px,3.8vw,42px); font-weight:700; color:#fff; line-height:1.25; margin:0; }
  .anb-subtext  { font-family:'Darker Grotesque',sans-serif; font-size:clamp(15px,1.6vw,18px); color:rgba(255,255,255,0.65); line-height:1.7; max-width:540px; margin:0; }
  .anb-subtext strong { color:#fff; }
  .anb-btn { display:inline-block; margin-top:8px; padding:14px 40px; border:2px solid #fff; border-radius:50px; background:transparent; color:#fff; font-family:'Darker Grotesque',sans-serif; font-size:14px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; text-decoration:none; transition:background 0.25s ease,color 0.25s ease; }
  .anb-btn:hover { background:#fff; color:#000; }
  @media(max-width:768px) {
    .anb-digit   { font-size:clamp(100px,42vw,180px); }
    .anb-content { padding:28px 20px 60px; }
    .anb-headline{ font-size:clamp(20px,6vw,30px); }
  }
</style>
<script>
  (function(){
    var s=document.getElementById('anb-section');
    if(!s)return;
    var done=false;
    function run(){if(done)return;done=true;s.classList.add('anb-animate');}
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){run();io.disconnect();}});},{threshold:0.2});
      io.observe(s);
    } else { run(); }
  })();
</script>

{% comment %} ═══ SECTION 3: Global Pedigree / Video Globe ═══ {% endcomment %}
<div class="agp-section">
  <div class="agp-topbar">
    <p class="agp-eyebrow"><span class="agp-pipe">|</span> HAGUE PROTECT <span class="agp-pipe">|</span></p>
    <p class="agp-hashtag">#NeverStopPlaying</p>
  </div>
  <h2 class="agp-headline">Precision Crafted. Globally Trusted.</h2>

  <div class="agp-globe-wrap">
    <video
      class="agp-video"
      autoplay
      loop
      muted
      playsinline
    >
      <source src="{{ 'about-globe.mp4' | asset_url }}" type="video/mp4">
      <source src="{{ 'about-globe.webm' | asset_url }}" type="video/webm">
    </video>
  </div>

  <div class="agp-bottom">
    <h3 class="agp-bottom-headline">GLOBAL PEDIGREE. FOR HOME GAMES.</h3>
    <p class="agp-bottom-text"><em><strong>Indian</strong></em> innovation. <em><strong>German</strong></em>-grade precision. Trusted by sneaker enthusiasts from <em><strong>Mumbai</strong></em>, <em><strong>Delhi</strong></em> and beyond &mdash; for India&rsquo;s most discerning collectors.</p>
  </div>
</div>

<style>
  .agp-section { background:#000; width:100%; padding:72px 24px 80px; display:flex; flex-direction:column; align-items:center; box-sizing:border-box; }
  .agp-topbar  { width:100%; max-width:1200px; display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
  .agp-eyebrow { font-family:'Darker Grotesque',sans-serif; font-size:13px; font-weight:600; letter-spacing:0.22em; text-transform:uppercase; color:rgba(255,255,255,0.7); margin:0; display:flex; align-items:center; gap:10px; }
  .agp-pipe    { color:rgba(255,255,255,0.3); }
  .agp-hashtag { font-family:'Darker Grotesque',sans-serif; font-size:13px; font-weight:600; letter-spacing:0.1em; color:rgba(255,255,255,0.55); margin:0; font-style:italic; }
  .agp-headline{ font-family:'Inter','Darker Grotesque',sans-serif; font-size:clamp(22px,3.2vw,40px); font-weight:700; color:#fff; text-align:center; margin:0 0 56px; line-height:1.2; }
  .agp-globe-wrap { position:relative; width:clamp(250px,40vw,400px); aspect-ratio:1/1; border-radius:50%; overflow:hidden; background:#000; margin-bottom:56px; box-shadow:inset 0 -60px 120px rgba(0,0,0,0.8); }
  .agp-video   { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; border-radius:50%; }
  .agp-placeholder { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; color:rgba(255,255,255,0.3); font-family:'Darker Grotesque',sans-serif; font-size:13px; text-align:center; padding:40px; }
  .agp-video[src]:not([src=""]) ~ .agp-placeholder { display:none; }
  .agp-bottom  { display:flex; flex-direction:column; align-items:center; text-align:center; gap:16px; max-width:680px; }
  .agp-bottom-headline { font-family:'Inter','Darker Grotesque',sans-serif; font-size:clamp(18px,2.4vw,28px); font-weight:800; color:#fff; letter-spacing:0.04em; text-transform:uppercase; margin:0; }
  .agp-bottom-text { font-family:'Darker Grotesque',sans-serif; font-size:clamp(14px,1.5vw,17px); color:rgba(255,255,255,0.6); line-height:1.75; margin:0; }
  .agp-bottom-text strong { color:rgba(255,255,255,0.9); font-style:italic; }
  @media(max-width:768px) {
    .agp-section { padding:48px 20px 60px; }
    .agp-topbar  { flex-direction:column; align-items:center; gap:8px; margin-bottom:16px; }
    .agp-headline{ margin-bottom:36px; }
    .agp-globe-wrap { width:90vw; margin-bottom:36px; }
  }
</style>

{% comment %} ═══ SECTION 4: Beliefs ═══ {% endcomment %}
<div class="ab-beliefs-section">
  <div class="ab-beliefs-inner">
    <h2 class="ab-beliefs-headline">
      Three things we<br>believe about<br>beauty.<br>
      <span class="ab-beliefs-headline-sub">Everything else<br>follows.</span>
    </h2>

    <div class="ab-beliefs-list">
      <div class="ab-belief-item">
        <div class="ab-belief-title">Regenerative science.<br>Not trend science.</div>
        <div class="ab-belief-desc">Longevity is the one true purpose of beauty. The science of how skin renews, repairs, and rebuilds is the only science worth building on.</div>
      </div>
      <div class="ab-belief-item">
        <div class="ab-belief-title">India is the future<br>of beauty.</div>
        <div class="ab-belief-desc">We are an Indian brand that holds itself to a global standard. More money spent on raw materials than on packaging. A limited portfolio built around one system, not a shelf of launches. No trend-chasing, no magic wand claims. The Indian consumer deserves world-class products made here, not world-class products imported and resold. We intend to prove it is possible.</div>
      </div>
      <div class="ab-belief-item">
        <div class="ab-belief-title">Difficult choices over<br>popular ones.</div>
        <div class="ab-belief-desc">We chose the 75 day protocol when 7 days would have been easier to sell. We publish what we put in the formula when opacity would have been easier to defend. We show quantitative clinical data when before/after photography would have been easier to produce. Every difficult choice is a decision about what kind of brand this is.</div>
      </div>
    </div>
  </div>
</div>

<style>
  .ab-beliefs-section { background:#161616; width:100%; padding:100px 24px; display:flex; justify-content:center; }
  .ab-beliefs-inner { max-width:1200px; width:100%; display:flex; flex-direction:column; gap:60px; }
  
  .ab-beliefs-headline { font-family:'Inter','Darker Grotesque',sans-serif; font-size:clamp(40px, 6vw, 85px); font-weight:700; color:#fff; line-height:1.05; margin:0; letter-spacing:-0.03em; }
  .ab-beliefs-headline-sub { font-style:italic; font-weight:400; color:rgba(255,255,255,0.6); display:block; }
  
  .ab-beliefs-list { display:flex; flex-direction:column; border-top:1px solid rgba(255,255,255,0.15); margin-top:20px; }
  .ab-belief-item { display:flex; padding:40px 0; border-bottom:1px solid rgba(255,255,255,0.15); gap:40px; }
  
  .ab-belief-title { flex:0 0 35%; font-family:'Inter',sans-serif; font-size:clamp(16px, 1.4vw, 20px); color:#fff; font-weight:500; line-height:1.4; }
  .ab-belief-desc { flex:1; font-family:'Inter',sans-serif; font-size:clamp(14px, 1vw, 15px); color:rgba(255,255,255,0.7); line-height:1.8; }
  
  @media(max-width:768px) {
    .ab-beliefs-section { padding:60px 20px; }
    .ab-beliefs-inner { gap:40px; }
    .ab-belief-item { flex-direction:column; gap:16px; padding:32px 0; }
    .ab-belief-title { flex:none; }
  }
</style>
