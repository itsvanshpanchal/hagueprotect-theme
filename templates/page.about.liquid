</div>

<style>
  .agp-section { background:#000; width:100%; padding:72px 24px 80px; display:flex; flex-direction:column; align-items:center; box-sizing:border-box; }
  .agp-topbar  { width:100%; max-width:1200px; display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
  .agp-eyebrow { font-family:'Inter',sans-serif; font-size:13px; font-weight:500; letter-spacing:0.22em; text-transform:uppercase; color:rgba(255,255,255,0.7); margin:0; display:flex; align-items:center; gap:10px; }
  .agp-pipe    { color:rgba(255,255,255,0.3); }
  .agp-hashtag { font-family:'Inter',sans-serif; font-size:13px; font-weight:500; letter-spacing:0.1em; color:rgba(255,255,255,0.55); margin:0; font-style:italic; }
  .agp-headline{ font-family:'Inter',sans-serif; font-size:clamp(22px,3.2vw,40px); font-weight:600; color:#fff; text-align:center; margin:0 0 56px; line-height:1.2; }
  .agp-globe-wrap { position:relative; width:clamp(250px,40vw,400px); aspect-ratio:1/1; border-radius:50%; overflow:hidden; background:#000; margin-bottom:56px; box-shadow:inset 0 -60px 120px rgba(0,0,0,0.8); }
