  .agp-placeholder { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; color:rgba(255,255,255,0.3); font-family:'Inter',sans-serif; font-weight:400; font-size:13px; text-align:center; padding:40px; }
  .agp-video[src]:not([src=""]) ~ .agp-placeholder { display:none; }
  .agp-bottom  { display:flex; flex-direction:column; align-items:center; text-align:center; gap:16px; max-width:680px; }
  .agp-bottom-headline { font-family:'Inter',sans-serif; font-size:clamp(18px,2.4vw,28px); font-weight:600; color:#fff; letter-spacing:0.04em; text-transform:uppercase; margin:0; }
  .agp-bottom-text { font-family:'Inter',sans-serif; font-size:clamp(14px,1.5vw,17px); font-weight:400; color:rgba(255,255,255,0.6); line-height:1.75; margin:0; }
