{% schema %}
{
  "name": "About Us Cinematic",
  "templates": ["page", "search"],
  "settings": [
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "text",
      "id": "hero_label",
      "label": "Hero Eyebrow",
      "default": "Hague Protect · Est. 2021 · Amsterdam"
    },
    {
      "type": "textarea",
      "id": "hero_h1",
      "label": "Hero Headline",
      "info": "Wrap word in <span class='w--red'>...</span> for red color",
      "default": "<span class='w'>WE</span><br><span class='w'>GUARD</span><br><span class='w w--red'>THE</span><br><span class='w'>CULTURE.</span>"
    },
    {
      "type": "textarea",
      "id": "hero_sub",
      "label": "Hero Subheadline",
      "default": "Not just sneaker care — a global commitment to the art, identity, and culture that footwear carries. Every pair deserves to endure."
    },
    {
      "type": "header",
      "content": "Manifesto Section"
    },
    {
      "type": "text",
      "id": "manifesto_eyebrow",
      "label": "Manifesto Eyebrow",
      "default": "Our Manifesto"
    },
    {
      "type": "header",
      "content": "Principles Section"
    },
    {
      "type": "text",
      "id": "principles_eyebrow",
      "label": "Principles Eyebrow",
      "default": "How We Work"
    },
    {
      "type": "textarea",
      "id": "principles_heading",
      "label": "Principles Heading",
      "default": "Four Pillars.<br>One Obsession."
    },
    {
      "type": "textarea",
      "id": "principles_sub",
      "label": "Principles Subtext",
      "default": "Every product, every formula, every drop is built on these four non-negotiables. No shortcuts. No compromises."
    },
    {
      "type": "header",
      "content": "Team Section"
    },
    {
      "type": "text",
      "id": "team_eyebrow",
      "label": "Team Eyebrow",
      "default": "The People"
    },
    {
      "type": "textarea",
      "id": "team_heading",
      "label": "Team Heading",
      "default": "The Minds<br>Behind The<br>Mission."
    },
    {
      "type": "textarea",
      "id": "team_sub",
      "label": "Team Subtext",
      "default": "Three people. One obsession. Relentless pursuit of a standard nobody else was willing to set."
    },
    {
      "type": "header",
      "content": "CTA Section"
    },
    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "CTA Eyebrow",
      "default": "Join The Movement"
    },
    {
      "type": "textarea",
      "id": "cta_heading",
      "label": "CTA Heading",
      "default": "Every Sneaker<br>Has a Story."
    },
    {
      "type": "textarea",
      "id": "cta_sub",
      "label": "CTA Subtext",
      "default": "Explore premium, lab-tested sneaker care solutions trusted by 50,000+ enthusiasts worldwide. Zero compromise. Always."
    },
    {
      "type": "text",
      "id": "cta_btn_text",
      "label": "Button Text",
      "default": "Explore All Products"
    },
    {
      "type": "url",
      "id": "cta_btn_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team Member",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Portrait Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "MEMBER<br>NAME"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Chief Technology Officer"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote (Typewriter)",
          "default": "Science should feel invisible — until you see the result."
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio",
          "default": "A materials scientist with 10+ years of formulation experience."
        }
      ]
    },
    {
      "type": "manifesto_line",
      "name": "Manifesto Line",
      "settings": [
        {
          "type": "text",
          "id": "num",
          "label": "Number (e.g. 01)",
          "default": "01"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "Use <em>...</em> for red highlight",
          "default": "It started with a ruined pair of Jordans."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Cinematic",
      "blocks": [
        { "type": "manifesto_line" },
        { "type": "team_member" },
        { "type": "team_member" },
        { "type": "team_member" }
      ]
    }
  ]
}
{% endschema %}

<!-- ═══════════════════════════════════════════════════════════════
     HAGUE PROTECT — ABOUT US PREMIUM SECTION (Editable)
     ═══════════════════════════════════════════════════════════════ -->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════════════════
   ROOT TOKENS
══════════════════════════════════════════════════════ */
:root {
  --hp-red: #FF2B2B;
  --hp-red-glow: rgba(255,43,43,0.18);
  --hp-red-soft: rgba(255,43,43,0.07);
  --hp-black: #030303;
  --hp-dark: #0a0a0a;
  --hp-card: rgba(255,255,255,0.032);
  --hp-border: rgba(255,255,255,0.055);
  --hp-border-red: rgba(255,43,43,0.22);
  --hp-w100: #ffffff;
  --hp-w85: rgba(255,255,255,0.85);
  --hp-w65: rgba(255,255,255,0.65);
  --hp-w40: rgba(255,255,255,0.40);
  --hp-w15: rgba(255,255,255,0.15);
  --hp-w06: rgba(255,255,255,0.06);
  --f-display: 'Bebas Neue', 'Outfit', var(--font-family-heading, sans-serif);
  --f-body: 'Outfit', var(--font-family-sans, sans-serif);
  --f-label: 'Outfit', var(--font-family-eyebrow, sans-serif);
  --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
}

/* ══════════════════════════════════════════════════════
   BASE
══════════════════════════════════════════════════════ */
#hpa { all:initial; display:block; background: var(--hp-black); color: var(--hp-w100); overflow-x: hidden; -webkit-font-smoothing: antialiased; font-family: var(--f-body); }
#hpa *, #hpa *::before, #hpa *::after { box-sizing: border-box; margin: 0; padding: 0; }
#hpa a { color: inherit; text-decoration: none; }
#hpa em { font-style: normal; color: var(--hp-red); }
#hpa strong { color: var(--hp-w100); font-weight: 700; }

/* Scroll progress */
.hpa-bar { position: fixed; top: 0; left: 0; width: 0%; height: 2px; background: linear-gradient(90deg, #FF2B2B, #ff7070, #FF2B2B); background-size: 200%; z-index: 9999; animation: hpa-bar-shimmer 2s linear infinite; pointer-events: none; }
@keyframes hpa-bar-shimmer { 0% { background-position: 0%; } 100% { background-position: 200%; } }

/* Custom cursor */
.hpa-dot, .hpa-ring { display: none; position: fixed; pointer-events: none; border-radius: 50%; top: 0; left: 0; }
@media (pointer:fine) and (min-width:1025px) {
  .hpa-dot { display: block; width: 6px; height: 6px; background: #fff; z-index: 99999; mix-blend-mode: difference; }
  .hpa-ring { display: block; width: 48px; height: 48px; border: 1px solid rgba(255,43,43,0.5); z-index: 99998; }
}

/* ══════════════════════════════════════════════════════
   §1 — HERO: FULL-BLEED TYPOGRAPHIC STATEMENT
══════════════════════════════════════════════════════ */
.hpa-hero {
  position: relative; width: 100%; height: 100vh; min-height: 700px;
  display: flex; flex-direction: column; justify-content: center;
  overflow: hidden; background: var(--hp-black);
  padding: clamp(100px, 15vh, 160px) clamp(24px, 6vw, 100px) clamp(120px, 18vh, 200px);
}
.hpa-hero__glow {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 60% 50% at 80% 20%, rgba(255,43,43,0.06) 0%, transparent 55%),
    radial-gradient(ellipse 40% 30% at 20% 80%, rgba(80,80,255,0.025) 0%, transparent 50%);
}
.hpa-hero__grid {
  position: absolute; inset: 0; z-index: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 75%);
}
.hpa-hero__bg-num {
  position: absolute; right: clamp(20px, 5vw, 80px); top: 50%; transform: translateY(-50%);
  font-family: var(--f-display); font-size: clamp(200px, 28vw, 420px); font-weight: 400;
  color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.04);
  z-index: 0; line-height: 1; user-select: none; pointer-events: none;
  letter-spacing: -0.05em;
}
.hpa-hero__content { position: relative; z-index: 2; }
.hpa-hero__label {
  font-family: var(--f-label); font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.28em; color: var(--hp-red);
  display: inline-flex; align-items: center; gap: 14px; margin-bottom: clamp(20px, 3vh, 36px);
  opacity: 0;
}
.hpa-hero__label::before {
  content: ''; display: block; width: 36px; height: 1px; background: var(--hp-red);
}
.hpa-hero__h1 {
  font-family: var(--f-display); font-size: clamp(64px, 13vw, 200px);
  font-weight: 400; letter-spacing: -0.01em; line-height: 0.88;
  text-transform: uppercase; color: var(--hp-w100);
  margin-bottom: clamp(24px, 4vh, 48px);
}
.hpa-hero__h1 .w { display: inline-block; opacity: 0; transform: translateY(120%) rotateX(20deg); filter: blur(12px); transform-origin: 50% 100%; }
.hpa-hero__h1 .w--red { color: var(--hp-red); }
.hpa-hero__sub {
  font-family: var(--f-body); font-size: clamp(15px, 1.6vw, 19px);
  font-weight: 400; color: var(--hp-w65); line-height: 1.7;
  max-width: clamp(280px, 45vw, 580px); opacity: 0; transform: translateY(24px);
}
.hpa-hero__stats {
  position: absolute; bottom: 0; left: 0; right: 0;
  display: flex; border-top: 1px solid var(--hp-border);
  z-index: 2; background: rgba(3,3,3,0.6); backdrop-filter: blur(8px);
}
.hpa-hero__stat {
  flex: 1; padding: clamp(20px, 3vh, 32px) clamp(24px, 3vw, 48px);
  border-right: 1px solid var(--hp-border);
  opacity: 0; transform: translateY(20px);
  transition: background 0.3s;
}
.hpa-hero__stat:last-child { border-right: none; }
.hpa-hero__stat:hover { background: var(--hp-card); }
.hpa-hero__stat-n {
  font-family: var(--f-display); font-size: clamp(36px, 5vw, 64px);
  font-weight: 400; color: var(--hp-w100); line-height: 1; display: block;
}
.hpa-hero__stat-n span { color: var(--hp-red); }
.hpa-hero__stat-l {
  font-size: 11px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.16em; color: var(--hp-w40); margin-top: 6px; display: block;
}
.hpa-hero__scrollcue {
  position: absolute; right: clamp(24px, 4vw, 60px); bottom: 120px;
  z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.hpa-hero__scrollcue span { font-size: 9px; text-transform: uppercase; letter-spacing: 0.22em; color: var(--hp-w40); writing-mode: vertical-rl; }
.hpa-hero__scrollcue-line { width: 1px; height: 64px; overflow: hidden; }
.hpa-hero__scrollcue-line::after { content: ''; display: block; width: 1px; height: 100%; background: linear-gradient(to bottom, transparent, var(--hp-red)); animation: hpa-scrollcue 2.2s ease-in-out infinite; }
@keyframes hpa-scrollcue { 0%{transform:translateY(-100%)} 50%,100%{transform:translateY(200%)} }
@media (max-width:768px) {
  .hpa-hero { padding-bottom: 90px; }
  .hpa-hero__stats { position: relative; flex-wrap: wrap; }
  .hpa-hero__stat { flex: 1 1 50%; border-bottom: 1px solid var(--hp-border); }
  .hpa-hero__bg-num { display: none; }
  .hpa-hero__scrollcue { display: none; }
}

/* ══════════════════════════════════════════════════════
   §2 — MANIFESTO
══════════════════════════════════════════════════════ */
.hpa-manifesto {
  padding: clamp(140px, 18vh, 240px) clamp(24px, 6vw, 100px) clamp(120px, 15vh, 200px);
  background: var(--hp-dark);
  border-top: 1px solid var(--hp-border);
}
.hpa-manifesto__eyebrow {
  font-family: var(--f-label); font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.28em; color: var(--hp-red);
  margin-bottom: 80px; display: flex; align-items: center; gap: 16px;
}
.hpa-manifesto__eyebrow::before { content: ''; width: 40px; height: 1px; background: var(--hp-red); }
.hpa-manifesto__lines { display: flex; flex-direction: column; gap: 0; }
.hpa-manifesto__line {
  font-family: var(--f-display); font-size: clamp(28px, 5.5vw, 82px);
  font-weight: 400; line-height: 1.15; text-transform: uppercase;
  color: var(--hp-w15); padding: clamp(20px, 3.5vh, 36px) 0;
  border-bottom: 1px solid var(--hp-border); transition: color 0.5s var(--ease-expo);
  cursor: default; display: flex; align-items: center; gap: 28px; flex-wrap: wrap;
}
.hpa-manifesto__line .hpa-manifesto__line-num {
  font-family: var(--f-label); font-size: 11px; font-weight: 700;
  color: var(--hp-w15); letter-spacing: 0.1em; min-width: 28px; flex-shrink: 0;
  transition: color 0.5s;
}
.hpa-manifesto__line.is-lit { color: var(--hp-w100); }
.hpa-manifesto__line.is-lit .hpa-manifesto__line-num { color: var(--hp-red); }
.hpa-manifesto__line em { color: var(--hp-red); font-style: normal; }
@media (max-width:768px) {
  .hpa-manifesto__line { font-size: clamp(22px, 6.5vw, 38px); padding: clamp(16px, 2.5vh, 28px) 0; }
}

/* ══════════════════════════════════════════════════════
   §3 — PRINCIPLES
══════════════════════════════════════════════════════ */
.hpa-principles {
  padding: clamp(140px, 18vh, 240px) clamp(24px, 5vw, 80px) clamp(140px, 18vh, 240px);
  background: var(--hp-black);
}
.hpa-principles__top {
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-bottom: 100px; gap: 40px; flex-wrap: wrap;
}
.hpa-principles__eyebrow { font-family: var(--f-label); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.28em; color: var(--hp-red); margin-bottom: 32px; }
.hpa-principles__heading { font-family: var(--f-display); font-size: clamp(40px, 6vw, 80px); font-weight: 400; text-transform: uppercase; line-height: 1.0; color: var(--hp-w100); margin-bottom: 24px; }
.hpa-principles__sub { font-size: 15px; color: var(--hp-w65); line-height: 1.8; max-width: 360px; align-self: flex-end; }
.hpa-principles__grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; }
.hpa-pc {
  border-radius: 20px; border: 1px solid var(--hp-border);
  background: var(--hp-card); padding: clamp(28px, 4vw, 48px);
  position: relative; overflow: hidden;
  transition: border-color 0.4s, transform 0.5s var(--ease-expo), box-shadow 0.4s;
  opacity: 0; transform: translateY(48px); filter: blur(6px);
}
.hpa-pc.is-in { opacity: 1; transform: translateY(0); filter: blur(0); }
.hpa-pc::before {
  content: ''; position: absolute; inset: 0; border-radius: inherit;
  background: linear-gradient(135deg, rgba(255,43,43,0.05) 0%, transparent 60%);
  opacity: 0; transition: opacity 0.4s;
}
.hpa-pc:hover { border-color: var(--hp-border-red); box-shadow: 0 20px 60px rgba(255,43,43,0.07); }
.hpa-pc:hover::before { opacity: 1; }
.hpa-pc--1 { grid-column: span 5; }
.hpa-pc--2 { grid-column: span 7; display: flex; align-items: center; }
.hpa-pc--3 { grid-column: span 4; }
.hpa-pc--4 { grid-column: span 4; }
.hpa-pc--5 { grid-column: span 4; background: var(--hp-red); border-color: transparent; }
.hpa-pc--5::before { background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 60%); }
.hpa-pc--5:hover { border-color: transparent; box-shadow: 0 20px 60px rgba(255,43,43,0.4); }
@media (max-width:1024px) {
  .hpa-pc--1, .hpa-pc--2 { grid-column: span 12; }
  .hpa-pc--3, .hpa-pc--4, .hpa-pc--5 { grid-column: span 12; }
  .hpa-pc--2 { flex-direction: column; align-items: flex-start; }
}
@media (max-width:768px) {
  .hpa-principles__grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  .hpa-pc--1, .hpa-pc--2 { grid-column: span 2; }
  .hpa-pc--3, .hpa-pc--4, .hpa-pc--5 { grid-column: span 2; }
}
.hpa-pc__num {
  font-family: var(--f-display); font-size: clamp(56px, 8vw, 100px);
  font-weight: 400; color: var(--hp-w06); line-height: 1; margin-bottom: 28px; letter-spacing: -0.02em;
}
.hpa-pc--5 .hpa-pc__num { color: rgba(255,255,255,0.15); }
.hpa-pc__icon { width: 44px; height: 44px; margin-bottom: 20px; color: var(--hp-red); }
.hpa-pc--5 .hpa-pc__icon { color: var(--hp-w100); }
.hpa-pc__title { font-family: var(--f-display); font-size: clamp(26px, 2.8vw, 38px); font-weight: 400; text-transform: uppercase; color: var(--hp-w100); margin-bottom: 16px; line-height: 1.1; }
.hpa-pc--5 .hpa-pc__title { color: var(--hp-w100); }
.hpa-pc__desc { font-size: 14px; color: var(--hp-w65); line-height: 1.85; max-width: 340px; }
.hpa-pc--5 .hpa-pc__desc { color: rgba(255,255,255,0.85); }
.hpa-pc--2 .hpa-pc__inner { max-width: 480px; }
.hpa-pc--2 .hpa-pc__visual { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 160px; }
.hpa-pc--2 .hpa-pc__visual-text {
  font-family: var(--f-display); font-size: clamp(80px, 12vw, 160px); font-weight: 400;
  text-transform: uppercase; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.08);
  line-height: 1; letter-spacing: -0.03em; white-space: nowrap; animation: hpa-float 6s ease-in-out infinite;
}
@keyframes hpa-float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }

/* ══════════════════════════════════════════════════════
   §4 — TEAM
══════════════════════════════════════════════════════ */
.hpa-team { background: var(--hp-dark); }
.hpa-team__intro {
  padding: clamp(140px, 18vh, 220px) clamp(24px, 6vw, 100px) clamp(80px, 12vh, 140px);
  display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap;
  border-bottom: 1px solid var(--hp-border);
}
.hpa-team__eyebrow { font-family: var(--f-label); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.28em; color: var(--hp-red); margin-bottom: 32px; }
.hpa-team__heading { font-family: var(--f-display); font-size: clamp(40px, 7vw, 96px); font-weight: 400; text-transform: uppercase; line-height: 1.0; color: var(--hp-w100); margin-bottom: 24px; }
.hpa-team__intro-sub { font-size: 15px; color: var(--hp-w65); line-height: 1.8; max-width: 340px; align-self: flex-end; }

.hpa-team__slide {
  position: relative; width: 100%; min-height: 90vh; overflow: hidden;
  display: flex; align-items: stretch; border-bottom: 1px solid var(--hp-border);
}
.hpa-team__slide-bg {
  position: absolute; inset: 0; z-index: 0;
  transition: filter 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  filter: grayscale(100%) brightness(0.2); transform: scale(1.06); will-change: filter, transform;
}
.hpa-team__slide-bg img { width: 100%; height: 100%; object-fit: cover; }
.hpa-team__slide.in-view .hpa-team__slide-bg { filter: grayscale(40%) brightness(0.30); }

.hpa-team__panel-left {
  position: relative; z-index: 2; flex: 0 0 58%;
  padding: clamp(60px, 10vh, 120px) clamp(40px, 7vw, 120px);
  background: linear-gradient(90deg, rgba(3,3,3,0.97) 0%, rgba(3,3,3,0.88) 55%, rgba(3,3,3,0.4) 100%);
  display: flex; flex-direction: column; justify-content: center; gap: 0;
}
.hpa-team__idx {
  font-family: var(--f-label); font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.25em; color: var(--hp-red);
  margin-bottom: 28px; display: flex; align-items: center; gap: 12px; opacity: 0;
}
.hpa-team__idx::after { content: ''; display: block; height: 1px; width: 40px; background: var(--hp-red); }
.hpa-team__name {
  font-family: var(--f-display); font-size: clamp(56px, 8vw, 120px);
  font-weight: 400; text-transform: uppercase; letter-spacing: -0.02em;
  line-height: 0.92; color: var(--hp-w100); margin-bottom: 20px; overflow: hidden;
}
.hpa-team__name-inner { display: block; transform: translateY(110%); opacity: 0; }
.hpa-team__role {
  font-family: var(--f-label); font-size: 12px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.2em; color: var(--hp-w65);
  margin-bottom: 40px; opacity: 0; position: relative; display: inline-block; padding-bottom: 8px;
}
.hpa-team__role::after {
  content: ''; position: absolute; bottom: 0; left: 0; width: 0%; height: 1.5px;
  background: var(--hp-red); transition: width 1.2s var(--ease-expo) 0.6s;
}
.hpa-team__slide.in-view .hpa-team__role::after { width: 100%; }
.hpa-team__quote {
  font-family: var(--f-body); font-size: clamp(17px, 1.8vw, 22px);
  font-weight: 300; color: var(--hp-w85); line-height: 1.7; font-style: italic;
  max-width: 520px; min-height: 72px; margin-bottom: 40px;
}
.hpa-team__quote .tw { display: inline-block; width: 2px; height: 1em; background: var(--hp-red); margin-left: 2px; animation: hpa-blink 0.75s step-end infinite; vertical-align: text-bottom; }
@keyframes hpa-blink { 50%{opacity:0} }
.hpa-team__bio {
  font-size: 14px; color: var(--hp-w40); line-height: 1.85; max-width: 460px;
  border-left: 2px solid var(--hp-border-red); padding-left: 20px;
  opacity: 0; transform: translateY(20px);
}
.hpa-team__panel-right {
  position: relative; z-index: 2; flex: 1;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(90deg, transparent 0%, rgba(3,3,3,0.4) 100%);
}
.hpa-team__big-num {
  font-family: var(--f-display); font-size: clamp(160px, 28vw, 400px);
  font-weight: 400; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.05);
  line-height: 1; user-select: none;
}
.hpa-team__nav { display: flex; justify-content: center; gap: 20px; padding: 32px; border-bottom: 1px solid var(--hp-border); }
.hpa-team__nav-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--hp-w15); border: none; cursor: pointer; transition: all 0.3s; }
.hpa-team__nav-dot.on { background: var(--hp-red); transform: scale(1.5); box-shadow: 0 0 14px var(--hp-red-glow); }
@media (max-width:768px) {
  .hpa-team__slide { flex-direction: column; min-height: 100vh; }
  .hpa-team__panel-left { flex: 1; background: linear-gradient(180deg, rgba(3,3,3,0.5) 0%, rgba(3,3,3,0.97) 55%); padding: 40px 24px 56px; }
  .hpa-team__panel-right { display: none; }
  .hpa-team__name { font-size: clamp(48px, 12vw, 72px); margin-bottom: 14px; }
  .hpa-team__role { margin-bottom: 28px; }
  .hpa-team__quote { font-size: clamp(16px, 4.5vw, 20px); margin-bottom: 28px; }
}

/* ══════════════════════════════════════════════════════
   §5 — MARQUEE
══════════════════════════════════════════════════════ */
.hpa-marquee { padding: 48px 0; background: var(--hp-black); border-top: 1px solid var(--hp-border); overflow: hidden; }
.hpa-marquee__row { display: flex; width: max-content; gap: 0; }
.hpa-marquee__row--rev { animation: hpa-mq-rev 40s linear infinite; }
.hpa-marquee__row--fwd { animation: hpa-mq 32s linear infinite; }
@keyframes hpa-mq { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
@keyframes hpa-mq-rev { 0%{transform:translateX(-50%)} 100%{transform:translateX(0)} }
.hpa-marquee__item {
  flex-shrink: 0; font-family: var(--f-display); font-size: clamp(20px, 3vw, 40px);
  font-weight: 400; text-transform: uppercase; letter-spacing: 0.04em;
  color: var(--hp-w15); padding: 0 clamp(24px, 3vw, 48px); white-space: nowrap; line-height: 1.2;
}
.hpa-marquee__item.r { color: var(--hp-red); }
.hpa-marquee__sep { flex-shrink: 0; font-size: clamp(20px, 3vw, 40px); color: var(--hp-border); padding: 0; line-height: 1.2; }

/* ══════════════════════════════════════════════════════
   §6 — CLOSING CTA
══════════════════════════════════════════════════════ */
.hpa-cta {
  position: relative; min-height: 80vh; display: flex; align-items: center; justify-content: center;
  text-align: center; padding: clamp(120px, 18vh, 220px) clamp(24px, 6vw, 80px); background: var(--hp-black); overflow: hidden;
}
.hpa-cta__glow {
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse 70% 60% at 50% 65%, rgba(255,43,43,0.10) 0%, transparent 65%);
  animation: hpa-cta-pulse 7s ease-in-out infinite alternate;
}
@keyframes hpa-cta-pulse { 0%{opacity:0.5; transform:scale(0.95)} 100%{opacity:1; transform:scale(1.05)} }
.hpa-cta__bg-text {
  position: absolute; bottom: -0.1em; left: 50%; transform: translateX(-50%);
  font-family: var(--f-display); font-size: clamp(80px, 18vw, 280px); font-weight: 400; text-transform: uppercase;
  color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.03); white-space: nowrap; pointer-events: none; user-select: none; letter-spacing: -0.04em;
}
.hpa-cta__content { position: relative; z-index: 1; max-width: 820px; }
.hpa-cta__eyebrow { font-family: var(--f-label); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.28em; color: var(--hp-red); margin-bottom: 32px; }
.hpa-cta__h { font-family: var(--f-display); font-size: clamp(40px, 8vw, 110px); font-weight: 400; text-transform: uppercase; line-height: 0.93; color: var(--hp-w100); margin-bottom: 32px; }
.hpa-cta__sub { font-size: clamp(15px, 1.5vw, 18px); color: var(--hp-w65); line-height: 1.7; margin-bottom: 64px; max-width: 520px; margin-left: auto; margin-right: auto; }
.hpa-cta__btn {
  display: inline-flex; align-items: center; gap: 12px; padding: 20px 60px; font-family: var(--f-display); font-size: 20px;
  letter-spacing: 0.06em; text-transform: uppercase; color: var(--hp-w100); background: var(--hp-red);
  border-radius: 4px; cursor: pointer; position: relative; overflow: hidden; transition: transform 0.4s var(--ease-expo), box-shadow 0.4s;
}
.hpa-cta__btn::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent); transition: left 0.6s; }
.hpa-cta__btn:hover { transform: translateY(-4px) scale(1.03); box-shadow: 0 20px 60px rgba(255,43,43,0.40); }
.hpa-cta__btn:hover::before { left: 100%; }
.hpa-cta__btn svg { width: 20px; height: 20px; transition: transform 0.3s; }
.hpa-cta__btn:hover svg { transform: translateX(6px); }

/* UTILITY ANIMATIONS */
.hpa-up { opacity: 0; transform: translateY(48px); filter: blur(4px); transition: opacity 0.9s var(--ease-expo), transform 0.9s var(--ease-expo), filter 0.7s var(--ease-expo); }
.hpa-up.in { opacity:1; transform:translateY(0); filter:blur(0); }
.hpa-up[data-d="1"] { transition-delay: 0.12s; }
.hpa-up[data-d="2"] { transition-delay: 0.22s; }
.hpa-up[data-d="3"] { transition-delay: 0.34s; }
.hpa-up[data-d="4"] { transition-delay: 0.46s; }

@media (prefers-reduced-motion: reduce) {
  .hpa-up, .hpa-hero__h1 .w, .hpa-hero__label, .hpa-hero__sub, .hpa-hero__stat,
  .hpa-team__idx, .hpa-team__name-inner, .hpa-team__role, .hpa-team__bio, .hpa-pc { opacity:1!important; transform:none!important; filter:none!important; transition:none!important; }
  .hpa-marquee__row--fwd, .hpa-marquee__row--rev, .hpa-cta__glow { animation:none!important; }
  .hpa-hero__scrollcue-line::after { animation:none!important; }
}
</style>

<!-- ═══════ HTML ═══════ -->
<div id="hpa">
  <div class="hpa-bar" id="hpaBar"></div>
  <div class="hpa-dot" id="hpaDot"></div>
  <div class="hpa-ring" id="hpaRing"></div>

  <!-- ══ §1 HERO ══ -->
  <section class="hpa-hero" id="hpaHero">
    <div class="hpa-hero__glow"></div>
    <div class="hpa-hero__grid"></div>
    <div class="hpa-hero__bg-num" aria-hidden="true">HP</div>
    <div class="hpa-hero__scrollcue" aria-hidden="true">
      <div class="hpa-hero__scrollcue-line"></div>
      <span>Scroll</span>
    </div>
    <div class="hpa-hero__content">
      <div class="hpa-hero__label" id="hpaHeroLabel">{{ section.settings.hero_label }}</div>
      <h1 class="hpa-hero__h1" id="hpaH1">
        {{ section.settings.hero_h1 }}
      </h1>
      <p class="hpa-hero__sub" id="hpaHeroSub">{{ section.settings.hero_sub }}</p>
    </div>
    <div class="hpa-hero__stats" id="hpaHeroStats">
      <div class="hpa-hero__stat"><span class="hpa-hero__stat-n">50<span>K</span></span><span class="hpa-hero__stat-l">Trusted Customers</span></div>
      <div class="hpa-hero__stat"><span class="hpa-hero__stat-n">40<span>+</span></span><span class="hpa-hero__stat-l">Cities Served</span></div>
      <div class="hpa-hero__stat"><span class="hpa-hero__stat-n">99<span>%</span></span><span class="hpa-hero__stat-l">Satisfaction Rate</span></div>
      <div class="hpa-hero__stat"><span class="hpa-hero__stat-n">02<span>+</span></span><span class="hpa-hero__stat-l">Years in Labs</span></div>
    </div>
  </section>

  <!-- ══ §2 MANIFESTO ══ -->
  <section class="hpa-manifesto" id="hpaManifesto">
    <div class="hpa-manifesto__eyebrow">{{ section.settings.manifesto_eyebrow }}</div>
    <div class="hpa-manifesto__lines" id="hpaManifestoLines">
      {% assign delay = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'manifesto_line' %}
          <div class="hpa-manifesto__line hpa-up" data-d="{{ delay }}">
            <span class="hpa-manifesto__line-num">{{ block.settings.num }}</span>
            {{ block.settings.text }}
          </div>
          {% assign delay = delay | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <!-- ══ §3 PRINCIPLES (Fixed structure for layout) ══ -->
  <section class="hpa-principles" id="hpaPrinciples">
    <div class="hpa-principles__top">
      <div>
        <div class="hpa-principles__eyebrow">{{ section.settings.principles_eyebrow }}</div>
        <h2 class="hpa-principles__heading hpa-up">{{ section.settings.principles_heading }}</h2>
      </div>
      <p class="hpa-principles__sub hpa-up" data-d="1">{{ section.settings.principles_sub }}</p>
    </div>
    <div class="hpa-principles__grid">
      <div class="hpa-pc hpa-pc--1">
        <div class="hpa-pc__num">01</div>
        <div class="hpa-pc__icon"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="12"/><path d="M12 16s1.5 3 4 3 4-3 4-3"/><circle cx="12" cy="13" r="1.5" fill="currentColor"/><circle cx="20" cy="13" r="1.5" fill="currentColor"/></svg></div>
        <h3 class="hpa-pc__title">Cleanse</h3>
        <p class="hpa-pc__desc">Bioenzyme formulations that lift contamination at the molecular level. No harsh acids. No bleach. No damage — ever.</p>
      </div>
      <div class="hpa-pc hpa-pc--2">
        <div class="hpa-pc__inner">
          <div class="hpa-pc__num">02</div>
          <div class="hpa-pc__icon"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3L3 10v12l13 7 13-7V10L16 3z"/><path d="M3 10l13 7m0 0l13-7M16 17v12"/></svg></div>
          <h3 class="hpa-pc__title">Protect</h3>
          <p class="hpa-pc__desc">Nano-shield barrier technology that repels water, salt, UV rays, and environmental damage without altering material feel.</p>
        </div>
        <div class="hpa-pc__visual"><div class="hpa-pc__visual-text" aria-hidden="true">PROTECT</div></div>
      </div>
      <div class="hpa-pc hpa-pc--3">
        <div class="hpa-pc__num">03</div>
        <div class="hpa-pc__icon"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 26l8-11 6 7 4-5 6 9"/><circle cx="24" cy="8" r="5"/><line x1="24" y1="3" x2="24" y2="2"/></svg></div>
        <h3 class="hpa-pc__title">Restore</h3>
        <p class="hpa-pc__desc">Condition, revive, nourish. Bring materials back — not just to how they looked, but how they felt on day one.</p>
      </div>
      <div class="hpa-pc hpa-pc--4">
        <div class="hpa-pc__num">04</div>
        <div class="hpa-pc__icon"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 2C24 9 28 18 28 24a12 12 0 01-24 0C4 18 8 9 16 2z"/><path d="M16 22c3 0 5-2.5 5-5s-5-9-5-9-5 6-5 9 2 5 5 5z"/></svg></div>
        <h3 class="hpa-pc__title">Preserve</h3>
        <p class="hpa-pc__desc">Long-term longevity. We don't just fix shoes — we extend their life, their story, their legacy beyond what's expected.</p>
      </div>
      <div class="hpa-pc hpa-pc--5">
        <div class="hpa-pc__num">HP</div>
        <h3 class="hpa-pc__title">Zero<br>Compromise.</h3>
        <p class="hpa-pc__desc">Every formula is lab-tested against 40+ material types before it reaches your hands. We don't release until it's perfect.</p>
      </div>
    </div>
  </section>

  <!-- ══ §4 TEAM ══ -->
  <section class="hpa-team" id="hpaTeam">
    <div class="hpa-team__intro">
      <div>
        <div class="hpa-team__eyebrow">{{ section.settings.team_eyebrow }}</div>
        <h2 class="hpa-team__heading hpa-up">{{ section.settings.team_heading }}</h2>
      </div>
      <p class="hpa-team__intro-sub hpa-up" data-d="1">{{ section.settings.team_sub }}</p>
    </div>

    {% assign team_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'team_member' %}
        <div class="hpa-team__slide" data-slide="{{ team_count }}" id="hpaSlide{{ team_count }}">
          <div class="hpa-team__slide-bg">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy' }}
            {% else %}
               <!-- Placeholder gradient if no image -->
               <div style="width:100%; height:100%; background: linear-gradient(135deg, #0d1117 0%, #1a2332 40%, #0d1117 100%);"></div>
            {% endif %}
          </div>
          
          <div class="hpa-team__panel-left">
            <div class="hpa-team__idx">0{{ team_count | plus: 1 }}</div>
            <div class="hpa-team__name"><span class="hpa-team__name-inner">{{ block.settings.name }}</span></div>
            <div class="hpa-team__role">{{ block.settings.role }}</div>
            <div class="hpa-team__quote" data-tw="{{ block.settings.quote | escape }}"></div>
            <div class="hpa-team__bio">{{ block.settings.bio }}</div>
          </div>
          <div class="hpa-team__panel-right">
            <div class="hpa-team__big-num" aria-hidden="true">0{{ team_count | plus: 1 }}</div>
          </div>
        </div>
        {% assign team_count = team_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if team_count > 0 %}
      <div class="hpa-team__nav" id="hpaTeamNav">
        {% for i in (1..team_count) %}
          <button class="hpa-team__nav-dot {% if forloop.first %}on{% endif %}" data-nav="{{ forloop.index0 }}" aria-label="Team Member {{ forloop.index }}"></button>
        {% endfor %}
      </div>
    {% endif %}
  </section>

  <!-- ══ §5 MARQUEE ══ -->
  <section class="hpa-marquee" aria-hidden="true">
    <div class="hpa-marquee__row hpa-marquee__row--fwd">
      <span class="hpa-marquee__item">Safer Choice</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item r">Premium Care</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item">Global Protection</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item r">Skin Longevity</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item">Bioenzyme Science</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item r">Lab Tested</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item">Zero Compromise</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item r">Material First</span><span class="hpa-marquee__sep">✦</span>
      <span class="hpa-marquee__item">Safer Choice</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item r">Premium Care</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item">Global Protection</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item r">Skin Longevity</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item">Bioenzyme Science</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item r">Lab Tested</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item">Zero Compromise</span><span class="hpa-marquee__sep">✦</span><span class="hpa-marquee__item r">Material First</span><span class="hpa-marquee__sep">✦</span>
    </div>
  </section>

  <!-- ══ §6 CTA ══ -->
  <section class="hpa-cta" id="hpaCta">
    <div class="hpa-cta__glow"></div>
    <div class="hpa-cta__bg-text" aria-hidden="true">HAGUE</div>
    <div class="hpa-cta__content">
      <div class="hpa-cta__eyebrow hpa-up">{{ section.settings.cta_eyebrow }}</div>
      <h2 class="hpa-cta__h hpa-up" data-d="1">{{ section.settings.cta_heading }}</h2>
      <p class="hpa-cta__sub hpa-up" data-d="2">{{ section.settings.cta_sub }}</p>
      <a href="{{ section.settings.cta_btn_link | default: '/collections/all' }}" class="hpa-cta__btn hpa-up" data-d="3" id="hpaCtaBtn">
        {{ section.settings.cta_btn_text }}
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M12 5l5 5-5 5"/></svg>
      </a>
    </div>
  </section>
</div>

<script>
(function(){
  const isMob = window.innerWidth <= 768;
  const noMotion = window.matchMedia('(prefers-reduced-motion:reduce)').matches;

  function ldJS(src){ return new Promise((res,rej)=>{ const s=document.createElement('script'); s.src=src; s.async=true; s.onload=res; s.onerror=rej; document.head.appendChild(s); }); }

  Promise.all([
    ldJS('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js'),
    ldJS('https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js')
  ]).then(()=>{
    if(!isMob && !noMotion){
      ldJS('https://unpkg.com/lenis@1.1.13/dist/lenis.min.js').then(()=>{
        try {
          const l = new Lenis({duration:1.0, easing:t=>Math.min(1,1.001-Math.pow(2,-10*t)), smoothWheel:true});
          l.on('scroll', ScrollTrigger.update);
          gsap.ticker.add(t=>l.raf(t*1000));
          gsap.ticker.lagSmoothing(0);
        } catch(e){}
      }).catch(()=>{});
    }
    gsap.registerPlugin(ScrollTrigger);
    noMotion ? showAll() : boot();
  });

  function boot(){
    const bar = document.getElementById('hpaBar');
    if(bar) window.addEventListener('scroll',()=>{ bar.style.width=(window.scrollY/(document.documentElement.scrollHeight-window.innerHeight)*100)+'%'; },{passive:true});

    if(!isMob && window.matchMedia('(pointer:fine)').matches){
      const dot=document.getElementById('hpaDot'), ring=document.getElementById('hpaRing');
      if(dot&&ring){ let mx=0,my=0,rx=0,ry=0;
        document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;},{passive:true});
        (function loop(){ rx+=(mx-rx)*0.13; ry+=(my-ry)*0.13;
          dot.style.transform='translate('+(mx-3)+'px,'+(my-3)+'px)';
          ring.style.transform='translate('+(rx-24)+'px,'+(ry-24)+'px)';
          requestAnimationFrame(loop); })();
      }
    }

    const label = document.getElementById('hpaHeroLabel');
    const words = document.querySelectorAll('#hpaH1 .w');
    const sub   = document.getElementById('hpaHeroSub');
    const stats = document.querySelectorAll('.hpa-hero__stat');
    if(label) gsap.to(label,{opacity:1,duration:1,delay:0.1,ease:'power3.out'});
    words.forEach((w,i)=> gsap.to(w,{opacity:1,y:0,rotateX:0,filter:'blur(0px)',duration:1.1,delay:0.25+i*0.12,ease:'power4.out'}));
    if(sub) gsap.to(sub,{opacity:1,y:0,duration:1,delay:0.9,ease:'power3.out'});
    stats.forEach((s,i)=> gsap.to(s,{opacity:1,y:0,duration:0.8,delay:1.2+i*0.08,ease:'power3.out'}));

    gsap.to('#hpaHero .hpa-hero__content',{ scrollTrigger:{trigger:'#hpaHero',start:'top top',end:'bottom top',scrub:true}, y:-80, opacity:0.15, scale:0.97 });

    const mLines = document.querySelectorAll('.hpa-manifesto__line');
    if(!isMob){
      mLines.forEach(l=>{
        l.addEventListener('mouseenter',()=>{ mLines.forEach(x=>x.classList.remove('is-lit')); l.classList.add('is-lit'); });
        l.addEventListener('mouseleave',()=>l.classList.remove('is-lit'));
      });
    }
    mLines.forEach(l=>{
      ScrollTrigger.create({trigger:l,start:'top 85%',onEnter:()=>{ l.classList.add('in'); if(isMob) l.classList.add('is-lit'); }});
    });

    document.querySelectorAll('.hpa-pc').forEach((c,i)=>{
      ScrollTrigger.create({trigger:c,start:'top 88%',
        onEnter:()=>{ setTimeout(()=>c.classList.add('is-in'), i%3 * 80); }
      });
    });

    const slides = document.querySelectorAll('.hpa-team__slide');
    const navDots = document.querySelectorAll('.hpa-team__nav-dot');
    const typedSlides = new Set();

    slides.forEach((sl,i)=>{
      ScrollTrigger.create({trigger:sl,start:'top 60%',
        onEnter:()=>activateSlide(i),
        onEnterBack:()=>activateSlide(i)
      });
    });

    navDots.forEach(d=>d.addEventListener('click',()=>{ const idx=+d.dataset.nav; const sl=slides[idx]; if(sl) sl.scrollIntoView({behavior:'smooth',block:'start'}); }));

    function activateSlide(idx){
      slides.forEach((s,i)=>s.classList.toggle('in-view',i===idx));
      navDots.forEach((d,i)=>d.classList.toggle('on',i===idx));

      const sl = slides[idx]; if(!sl) return;
      const idxEl=sl.querySelector('.hpa-team__idx');
      const nameEl=sl.querySelector('.hpa-team__name-inner');
      const roleEl=sl.querySelector('.hpa-team__role');
      const bioEl=sl.querySelector('.hpa-team__bio');
      const quoteEl=sl.querySelector('.hpa-team__quote');

      if(idxEl) gsap.to(idxEl,{opacity:1,duration:0.5,delay:0.05,ease:'power2.out'});
      if(nameEl) gsap.to(nameEl,{opacity:1,y:'0%',duration:0.8,delay:0.1,ease:'power4.out'});
      if(roleEl) gsap.to(roleEl,{opacity:1,duration:0.5,delay:0.4,ease:'power2.out'});
      if(bioEl)  gsap.to(bioEl, {opacity:1,y:0,duration:0.7,delay:0.7,ease:'power3.out'});

      if(quoteEl && !typedSlides.has(idx)){
        typedSlides.add(idx);
        const txt = quoteEl.getAttribute('data-tw') || '';
        quoteEl.innerHTML='<span class="tw"></span>';
        let ci=0;
        const iv=setInterval(()=>{
          if(ci<txt.length){ quoteEl.innerHTML='\u201C'+txt.slice(0,++ci)+'\u201D<span class="tw"></span>'; }
          else { clearInterval(iv); setTimeout(()=>{ const c=quoteEl.querySelector('.tw'); if(c)c.style.display='none'; },2500); }
        },36);
      }

      if(!isMob){
        const bg=sl.querySelector('.hpa-team__slide-bg');
        if(bg && !sl.dataset.pxb){ sl.dataset.pxb='1';
          sl.addEventListener('mousemove',e=>{
            const r=sl.getBoundingClientRect(), x=(e.clientX-r.left)/r.width-0.5, y=(e.clientY-r.top)/r.height-0.5;
            gsap.to(bg,{x:x*30,y:y*20,duration:1,ease:'power2.out'});
          });
        }
      }
    }
    activateSlide(0);

    document.querySelectorAll('.hpa-up').forEach(el=>{
      ScrollTrigger.create({trigger:el,start:'top 88%',onEnter:()=>el.classList.add('in')});
    });

    if(!isMob){ const btn=document.getElementById('hpaCtaBtn');
      if(btn){
        btn.addEventListener('mousemove',e=>{ const r=btn.getBoundingClientRect();
          gsap.to(btn,{x:(e.clientX-r.left-r.width/2)*0.18, y:(e.clientY-r.top-r.height/2)*0.26, duration:0.3, ease:'power2.out'}); });
        btn.addEventListener('mouseleave',()=>gsap.to(btn,{x:0,y:0,duration:0.7,ease:'elastic.out(1,0.3)'}));
      }
    }
  }

  function showAll(){
    document.querySelectorAll('.hpa-up,.hpa-hero__h1 .w,.hpa-hero__label,.hpa-hero__sub,.hpa-hero__stat,.hpa-team__idx,.hpa-team__name-inner,.hpa-team__role,.hpa-team__bio,.hpa-pc')
      .forEach(el=>{el.style.opacity='1';el.style.transform='none';el.style.filter='none';});
    document.querySelectorAll('.hpa-manifesto__line').forEach(l=>l.classList.add('is-lit','in'));
    document.querySelectorAll('.hpa-team__slide').forEach((s,i)=>{ if(i===0)s.classList.add('in-view'); });
    document.querySelectorAll('.hpa-team__quote').forEach(q=>{ q.textContent='\u201C'+(q.getAttribute('data-tw')||'')+'\u201D'; });
  }
})();
</script>
