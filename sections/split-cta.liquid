{%- liquid
  # Original settings preserved for data retention
  assign unused_button_label = section.settings.button_label
  assign unused_button_link = section.settings.button_link
  
  assign heading = section.settings.heading | default: 'Ready to play the long game?'
  assign subtext = section.settings.subtext
  assign tagline = section.settings.tagline | default: '#NeverStopPlaying'
-%}

{%- style -%}
  /* Scoped styles for the redesigned split-cta */
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    background: none !important;
  }

  .split-cta--redesign {
    background-color: #000000;
    width: 100%;
    min-height: 150vh;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 60px;
    padding-bottom: 450px;
    box-sizing: border-box;
  }

  .split-cta--redesign__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 800px;
    width: 100%;
    padding: 0 24px;
    z-index: 2;
    position: relative;
  }

  .split-cta--redesign__logo {
    margin-bottom: 40px;
    opacity: 0;
    transform: translateY(20px);
  }

  .split-cta--redesign__logo img {
    max-width: 130px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .split-cta--redesign__heading {
    font-size: 50px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 24px 0;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
  }

  .split-cta--redesign__subtext {
    max-width: 650px;
    margin: 0 auto;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    opacity: 0;
    transform: translateY(20px);
  }
  
  .split-cta--redesign__subtext p {
    margin: 0;
  }
  
  .split-cta--redesign__subtext p + p {
    margin-top: 8px;
  }

  .split-cta--redesign__tagline {
    margin-top: 28px;
    font-size: 20px;
    font-weight: bold;
    font-style: italic;
    color: #ffffff;
    opacity: 0;
    transform: translateY(20px);
  }
  
  /* Negative Space */
  .split-cta--redesign__spacer {
    height: 600px;
    width: 100%;
  }

  /* Chevron */
  .split-cta--redesign__chevron {
    position: absolute;
    bottom: 45vh;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    animation: splitCtaBounce 1.8s ease-in-out infinite;
    cursor: pointer;
    color: rgba(255,255,255,0.8);
  }
  
  .split-cta--redesign__chevron svg {
    width: 32px;
    height: 32px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes splitCtaBounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }

  /* Glowing Sphere */
  .split-cta--redesign__sphere {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 75%) rotate(var(--scroll-rotate, 0deg));
    width: 80vw;
    max-width: 800px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    z-index: 1;
    box-shadow: inset 0 -40px 100px rgba(0,0,0,1), inset 0 10px 40px rgba(255,255,255,0.3);
    background: 
      radial-gradient(circle, rgba(0,0,0,0.25) 1px, transparent 1px) 0 0 / 6px 6px,
      radial-gradient(circle, rgba(0,0,0,0.25) 1px, transparent 1px) 3px 3px / 6px 6px,
      radial-gradient(circle at 50% 100%, #000000 0%, rgba(0,0,0,0.9) 35%, transparent 70%),
      radial-gradient(circle at 50% 15%, #ff6b52 0%, #cc4632 25%, #6b1f18 50%, #200a08 75%, #000000 100%);
    will-change: transform;
  }
  
  .split-cta--redesign__sphere-img {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 75%) rotate(var(--scroll-rotate, 0deg));
    width: 80vw;
    max-width: 800px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    z-index: 1;
    object-fit: cover;
    will-change: transform;
  }
  
  /* Animation Classes */
  .split-cta--redesign.is-visible .split-cta--redesign__logo {
    transition: opacity 0.6s ease, transform 0.6s ease;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0ms;
  }
  
  .split-cta--redesign.is-visible .split-cta--redesign__heading {
    transition: opacity 0.6s ease, transform 0.6s ease;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 150ms;
  }
  
  .split-cta--redesign.is-visible .split-cta--redesign__subtext {
    transition: opacity 0.6s ease, transform 0.6s ease;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 300ms;
  }
  
  .split-cta--redesign.is-visible .split-cta--redesign__tagline {
    transition: opacity 0.6s ease, transform 0.6s ease;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 450ms;
  }

  @media screen and (max-width: 768px) {
    .split-cta--redesign__heading {
      font-size: 30px;
    }
    
    .split-cta--redesign__subtext {
      font-size: 15px;
    }
    
    .split-cta--redesign__spacer {
      height: 135px;
    }
    
    .split-cta--redesign__chevron {
      bottom: 35vh;
    }
    
    .split-cta--redesign__sphere, .split-cta--redesign__sphere-img {
      width: 150vw;
      bottom: 0;
      transform: translate(-50%, 50%);
    }
  }
  {%- if page.handle == 'about-us' or template.suffix == 'about' or template.suffix == 'about-us' -%}
    #shopify-section-{{ section.id }} .split-cta--redesign__spacer {
      height: 200px;
    }
    #shopify-section-{{ section.id }} .split-cta--redesign {
      min-height: auto;
      padding-bottom: 250px;
    }
    @media screen and (max-width: 768px) {
      #shopify-section-{{ section.id }} .split-cta--redesign__spacer {
        height: 80px;
      }
      #shopify-section-{{ section.id }} .split-cta--redesign {
        padding-bottom: 150px;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<section class="split-cta--redesign" id="split-cta-{{ section.id }}">
  <div class="split-cta--redesign__content">
    {%- if section.settings.logo_image != blank -%}
      <div class="split-cta--redesign__logo">
        <img src="{{ section.settings.logo_image | image_url: width: 300 }}" alt="{{ section.settings.logo_image.alt | default: 'Logo' | escape }}" loading="lazy" width="{{ section.settings.logo_image.width }}" height="{{ section.settings.logo_image.height }}">
      </div>
    {%- endif -%}

    {%- if heading != blank -%}
      <h2 class="split-cta--redesign__heading">{{ heading | escape | newline_to_br }}</h2>
    {%- endif -%}

    {%- if subtext != blank -%}
      <div class="split-cta--redesign__subtext">{{ subtext }}</div>
    {%- endif -%}

    {%- if tagline != blank -%}
      <div class="split-cta--redesign__tagline">{{ tagline | escape }}</div>
    {%- endif -%}
  </div>

  <div class="split-cta--redesign__spacer"></div>

  <a class="split-cta--redesign__chevron" href="#next-section" aria-label="Scroll down">
    <svg viewBox="0 0 24 24">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </a>

  {%- if section.settings.sphere_image != blank -%}
    <img class="split-cta--redesign__sphere-img" src="{{ section.settings.sphere_image | image_url: width: 2000 }}" alt="{{ section.settings.sphere_image.alt | default: 'Sphere' | escape }}" loading="lazy" width="{{ section.settings.sphere_image.width }}" height="{{ section.settings.sphere_image.height }}">
  {%- else -%}
    <div class="split-cta--redesign__sphere"></div>
  {%- endif -%}
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var section = document.getElementById('split-cta-{{ section.id }}');
    if (!section) return;
    
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    
    observer.observe(section);

    window.addEventListener('scroll', function() {
      var scrollY = window.scrollY || window.pageYOffset;
      section.style.setProperty('--scroll-rotate', (scrollY * 0.6) + 'deg');
    }, { passive: true });
  });
</script>

{% schema %}
{
  "name": "Split CTA",
  "tag": "section",
  "class": "section-split-cta",
  "settings": [
    {
      "type": "header",
      "content": "Redesign Content"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to play the long game?"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>We believe play isn't behind us, it's still the best part of our day.</p><p>Life never stops. Play shouldn't either.</p>"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "#NeverStopPlaying"
    },
    {
      "type": "image_picker",
      "id": "sphere_image",
      "label": "Sphere Image",
      "info": "Upload a spherical image. If left blank, a red CSS radial gradient will be used."
    },
    {
      "type": "header",
      "content": "Legacy Settings (Preserved for data)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label (Unused)",
      "default": "Find my kit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (Unused)"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Legacy Text (Unused)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Legacy Background Color (Unused)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Legacy Text Color (Unused)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Legacy Heading Color (Unused)"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Legacy Button BG (Unused)"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Legacy Button Hover (Unused)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Legacy Button Text (Unused)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Legacy Padding Top (Unused)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Legacy Padding Bottom (Unused)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Split CTA",
      "settings": {}
    }
  ]
}
{% endschema %}
