{%- liquid
  assign cta_heading = section.settings.heading | default: 'Ready to play the long game?'
  assign cta_text = section.settings.text | default: 'The protocol starts with one kit. Tell us your concern and we will point you to the right one.'
  assign cta_label = section.settings.button_label | default: 'Find my kit'
  assign cta_link = section.settings.button_link
  if cta_link == blank
    assign cta_link = routes.all_products_collection_url
  endif

  assign heading_family = section.settings.h2_font_family | default: 'inter_light'
  assign text_family = section.settings.paragraph_font_family | default: 'inter'
  assign button_family = section.settings.button_font_family | default: 'inter_semibold'

  assign heading_weight = section.settings.h2_font_weight | default: '300'
  assign text_weight = section.settings.paragraph_font_weight | default: '400'
  assign button_weight = section.settings.button_font_weight | default: '600'

  assign heading_style = section.settings.h2_font_style | default: 'normal'
  assign text_style = section.settings.paragraph_font_style | default: 'normal'
  assign button_style = section.settings.button_font_style | default: 'normal'

  assign heading_size_desktop = section.settings.h2_font_size_desktop | default: 48
  assign heading_size_mobile = section.settings.h2_font_size_mobile | default: 32
  assign text_size_desktop = section.settings.paragraph_font_size_desktop | default: 16
  assign text_size_mobile = section.settings.paragraph_font_size_mobile | default: 15
  assign button_size = section.settings.button_font_size | default: 12
-%}
{%- capture heading_implied -%}{% render 'hp-font-weight', font_key: heading_family %}{%- endcapture -%}
{%- capture text_implied -%}{% render 'hp-font-weight', font_key: text_family %}{%- endcapture -%}
{%- capture button_implied -%}{% render 'hp-font-weight', font_key: button_family %}{%- endcapture -%}
{%- capture heading_named -%}{% render 'hp-font-is-named-face', font_key: heading_family %}{%- endcapture -%}
{%- capture text_named -%}{% render 'hp-font-is-named-face', font_key: text_family %}{%- endcapture -%}
{%- capture button_named -%}{% render 'hp-font-is-named-face', font_key: button_family %}{%- endcapture -%}
{%- liquid
  assign heading_implied = heading_implied | strip
  assign text_implied = text_implied | strip
  assign button_implied = button_implied | strip
  assign heading_named = heading_named | strip
  assign text_named = text_named | strip
  assign button_named = button_named | strip

  comment
    Honor Theme Editor Weight / Style. Do not overwrite with implied
    font-key weights (inter_light used to force 300 and ignore settings).
  endcomment
  if heading_named != blank
    assign heading_style = 'normal'
  endif
  if text_named != blank
    assign text_style = 'normal'
  endif
  if button_named != blank
    assign button_style = 'normal'
  endif
-%}
{%- capture heading_stack -%}{% render 'hp-font-stack', font_key: heading_family %}{%- endcapture -%}
{%- capture text_stack -%}{% render 'hp-font-stack', font_key: text_family %}{%- endcapture -%}
{%- capture button_stack -%}{% render 'hp-font-stack', font_key: button_family %}{%- endcapture -%}
{%- liquid
  assign heading_stack = heading_stack | strip
  assign text_stack = text_stack | strip
  assign button_stack = button_stack | strip
-%}

{%- style -%}
  {% render 'section-typography-vars', section: section %}

  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .split-cta-{{ section.id }} {
    --split-cta-bg: {{ section.settings.background_color | default: '#FDFCF7' }};
    --split-cta-heading: {{ section.settings.heading_color | default: '#111111' }};
    --split-cta-text: {{ section.settings.text_color | default: '#707070' }};
    --split-cta-btn-bg: {{ section.settings.button_background | default: '#111111' }};
    --split-cta-btn-text: {{ section.settings.button_text_color | default: '#FFFFFF' }};
    background: var(--split-cta-bg);
    border-top: none;
    border-bottom: none;
    /* Match other homepage sections: same left edge gutter on laptop + monitors */
    padding: {{ section.settings.padding_top | default: 56 }}px var(--homepage-section-gutter, 28px) {{ section.settings.padding_bottom | default: 56 }}px var(--homepage-section-gutter, 28px);
    width: 100%;
    max-width: none;
    margin: 0;
    box-sizing: border-box;
    min-height: 0 !important;
    height: auto !important;
  }

  .split-cta-{{ section.id }}__inner {
    max-width: 1200px;
    width: 100%;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 3vw, 48px);
  }

  .split-cta-{{ section.id }}__copy {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 680px;
    text-align: left !important;
    margin-left: 0 !important;
    margin-right: auto !important;
    padding-left: 0 !important;
    transform: none !important;
  }

  .split-cta-{{ section.id }}__heading {
    margin: 0 0 16px;
    color: var(--split-cta-heading);
    font-family: {{ heading_stack }} !important;
    font-size: {{ heading_size_desktop }}px !important;
    font-weight: {{ heading_weight }} !important;
    font-style: {{ heading_style }} !important;
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-align: left !important;
  }

  .split-cta-{{ section.id }}__text {
    margin: 0;
    color: var(--split-cta-text);
    font-family: {{ text_stack }} !important;
    font-size: {{ text_size_desktop }}px !important;
    font-weight: {{ text_weight }} !important;
    font-style: {{ text_style }} !important;
    line-height: 1.55;
    max-width: 520px;
    text-align: left !important;
    margin-left: 0 !important;
    margin-right: auto !important;
  }

  .split-cta-{{ section.id }}__actions {
    flex: 0 0 auto;
    align-self: center;
    margin-left: auto;
    margin-right: 0;
  }

  .split-cta-{{ section.id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 18px 32px;
    background: var(--split-cta-btn-bg);
    color: var(--split-cta-btn-text) !important;
    text-decoration: none !important;
    border: none;
    border-radius: 0;
    font-family: {{ button_stack }} !important;
    font-size: {{ button_size }}px !important;
    font-weight: {{ button_weight }} !important;
    font-style: {{ button_style }} !important;
    letter-spacing: 0.14em;
    text-transform: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .split-cta-{{ section.id }}__button:hover {
    background: {{ section.settings.button_hover_background | default: '#333333' }};
    color: var(--split-cta-btn-text) !important;
  }

  .split-cta-{{ section.id }}__arrow {
    display: inline-block;
    font-size: 1.08em;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .split-cta-{{ section.id }}__button:hover .split-cta-{{ section.id }}__arrow {
    transform: translateX(4px);
  }

  /* Laptop + monitors: keep left edge locked to homepage gutter */
  @media screen and (min-width: 750px) {
    .split-cta-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 56 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px !important;
      padding-left: var(--homepage-section-gutter, 32px) !important;
      padding-right: var(--homepage-section-gutter-right, var(--homepage-section-gutter, 32px)) !important;
      min-height: 0 !important;
      height: auto !important;
    }

    .split-cta-{{ section.id }}__inner {
      max-width: 1200px !important;
      width: 100% !important;
      margin: 0 !important;
    }

    .split-cta-{{ section.id }}__copy {
      text-align: left !important;
      margin-left: 0 !important;
      transform: none !important;
    }
  }

  @media screen and (min-width: 1200px) {
    .split-cta-{{ section.id }}__copy {
      max-width: 640px;
    }

    .split-cta-{{ section.id }}__text {
      max-width: 520px;
    }
  }

  @media screen and (max-width: 749px) {
    body .split-cta-{{ section.id }},
    body #MainContent .split-cta-{{ section.id }},
    body.hp-float-mobile .hp-float-stack .split-cta-{{ section.id }} {
      padding-top: 32px !important;
      padding-bottom: 32px !important;
      padding-left: var(--homepage-section-gutter, 24px) !important;
      padding-right: var(--homepage-section-gutter-right, var(--homepage-section-gutter, 24px)) !important;
      border-top: none !important;
      border-bottom: none !important;
      min-height: 0 !important;
      height: auto !important;
      max-height: none !important;
      display: block !important;
      background: var(--split-cta-bg) !important;
    }

    body .split-cta-{{ section.id }}__inner,
    body #MainContent .split-cta-{{ section.id }}__inner,
    body.hp-float-mobile .hp-float-stack .split-cta-{{ section.id }}__inner {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      justify-content: flex-start !important;
      gap: 0 !important;
      max-width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
    }

    body .split-cta-{{ section.id }}__copy,
    body #MainContent .split-cta-{{ section.id }}__copy,
    body.hp-float-mobile .hp-float-stack .split-cta-{{ section.id }}__copy {
      max-width: 100% !important;
      margin: 0 0 20px 0 !important;
      height: auto !important;
      min-height: 0 !important;
      flex: 0 0 auto !important;
    }

    body .split-cta-{{ section.id }}__heading,
    body #MainContent .split-cta-{{ section.id }}__heading,
    body.hp-float-mobile .hp-float-stack .split-cta-{{ section.id }}__heading {
      font-family: {{ heading_stack }} !important;
      font-size: 32px !important;
      font-weight: 300 !important;
      font-style: normal !important;
      line-height: 1.15 !important;
      letter-spacing: -0.02em !important;
      color: var(--split-cta-heading) !important;
      margin: 0 0 10px 0 !important;
      text-align: left !important;
    }

    body .split-cta-{{ section.id }}__text,
    body #MainContent .split-cta-{{ section.id }}__text,
    body.hp-float-mobile .hp-float-stack .split-cta-{{ section.id }}__text,
    body.template-index #MainContent .shopify-section[id] [class*="split-cta-"][class*="__text"] {
      font-family: {{ text_stack }} !important;
      font-size: 15px !important;
      font-weight: 300 !important;
      font-style: normal !important;
      line-height: 1.45 !important;
      letter-spacing: 0.01em !important;
      color: var(--split-cta-text) !important;
      max-width: 100% !important;
      margin: 0 !important;
      text-align: left !important;
    }

    body .split-cta-{{ section.id }}__actions,
    body #MainContent .split-cta-{{ section.id }}__actions,
    body.hp-float-mobile .hp-float-stack .split-cta-{{ section.id }}__actions {
      margin-left: 0 !important;
      margin-top: 0 !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      flex: 0 0 auto !important;
    }

    body .split-cta-{{ section.id }}__button,
    body #MainContent .split-cta-{{ section.id }}__button,
    body.hp-float-mobile .hp-float-stack .split-cta-{{ section.id }}__button {
      width: 100% !important;
      height: 52px !important;
      min-height: 52px !important;
      max-height: 52px !important;
      padding: 0 24px !important;
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: center !important;
      justify-content: center !important;
      white-space: nowrap !important;
      gap: 10px !important;
      box-sizing: border-box !important;
      background: var(--split-cta-btn-bg) !important;
      color: var(--split-cta-btn-text) !important;
      font-family: {{ button_stack }} !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      letter-spacing: 0.12em !important;
      border-radius: 0 !important;
      flex: 0 0 auto !important;
      align-self: stretch !important;
    }

    body .split-cta-{{ section.id }}__arrow,
    body #MainContent .split-cta-{{ section.id }}__arrow,
    body.hp-float-mobile .hp-float-stack .split-cta-{{ section.id }}__arrow {
      display: inline-block !important;
      font-size: 1.1em !important;
      line-height: 1 !important;
    }
  }

  @media screen and (min-width: 768px) {
    .split-cta-{{ section.id }}__text {
      font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
      font-size: 21px !important;
      font-weight: 400 !important;
      font-style: normal !important;
      line-height: 1.38 !important;
      letter-spacing: 0 !important;
    }
  }

  @media screen and (min-width: 1200px) {
    .split-cta-{{ section.id }}__text {
      font-size: 22px !important;
      line-height: 1.42 !important;
    }
  }
{%- endstyle -%}

<section class="split-cta-{{ section.id }}" aria-label="{{ cta_heading | escape }}" data-no-typewriter>
  <div class="split-cta-{{ section.id }}__inner">
    <div class="split-cta-{{ section.id }}__copy">
      <h2 class="split-cta-{{ section.id }}__heading">{{ cta_heading | escape | newline_to_br }}</h2>
      <p class="split-cta-{{ section.id }}__text hp-body-para">{{ cta_text | escape }}</p>
    </div>

    <div class="split-cta-{{ section.id }}__actions">
      <a href="{{ cta_link }}" class="split-cta-{{ section.id }}__button">
        <span>{{ cta_label | escape }}</span>
        <span class="split-cta-{{ section.id }}__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split CTA",
  "tag": "section",
  "class": "section-split-cta",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to play the long game?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "The protocol starts with one kit. Tell us your concern and we will point you to the right one."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find my kit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Text position (laptop)"
    },
    {
      "type": "range",
      "id": "text_offset_x_desktop",
      "label": "Horizontal",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Move text left (-) or right (+)."
    },
    {
      "type": "range",
      "id": "text_offset_y_desktop",
      "label": "Vertical",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Move text up (-) or down (+)."
    },
    {
      "type": "select",
      "id": "text_align_desktop",
      "label": "Text alignment",
      "options": [
        { "value": "theme_default", "label": "Use theme default" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "theme_default",
      "info": "Aligns titles, eyebrows, and descriptions on laptop/desktop."
    },
    {
      "type": "header",
      "content": "Text position (mobile)"
    },
    {
      "type": "range",
