{%- liquid
  assign cta_heading = section.settings.heading | default: 'Ready to play the long game?'
  assign cta_text = section.settings.text | default: 'The protocol starts with one kit. Tell us your concern and we will point you to the right one.'
  assign cta_label = section.settings.button_label | default: 'Find my kit'
  assign cta_link = section.settings.button_link
  if cta_link == blank
    assign cta_link = routes.all_products_collection_url
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .split-cta-{{ section.id }} {
    --split-cta-bg: {{ section.settings.background_color | default: '#FDFCF7' }};
    --split-cta-heading: {{ section.settings.heading_color | default: '#111111' }};
    --split-cta-text: {{ section.settings.text_color | default: '#707070' }};
    --split-cta-btn-bg: {{ section.settings.button_background | default: '#111111' }};
    --split-cta-btn-text: {{ section.settings.button_text_color | default: '#FFFFFF' }};
    background: var(--split-cta-bg);
    border-top: 1px solid #111111;
    border-bottom: 1px solid #111111;
    padding: {{ section.settings.padding_top | default: 88 }}px max(28px, var(--site-padding, 28px)) {{ section.settings.padding_bottom | default: 88 }}px;
    width: 100%;
    box-sizing: border-box;
  }

  .split-cta-{{ section.id }}__inner {
    max-width: var(--site-max-width, 1320px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(32px, 6vw, 80px);
  }

  .split-cta-{{ section.id }}__copy {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 640px;
  }

  .split-cta-{{ section.id }}__heading {
    margin: 0 0 16px;
    color: var(--split-cta-heading);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: clamp(32px, 4.2vw, 48px);
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .split-cta-{{ section.id }}__text {
    margin: 0;
    color: var(--split-cta-text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: clamp(14px, 1.25vw, 16px);
    font-weight: 400;
    line-height: 1.55;
    max-width: 480px;
  }

  .split-cta-{{ section.id }}__actions {
    flex: 0 0 auto;
  }

  .split-cta-{{ section.id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 18px 32px;
    background: var(--split-cta-btn-bg);
    color: var(--split-cta-btn-text) !important;
    text-decoration: none !important;
    border: none;
    border-radius: 0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .split-cta-{{ section.id }}__button:hover {
    background: {{ section.settings.button_hover_background | default: '#333333' }};
    color: var(--split-cta-btn-text) !important;
  }

  .split-cta-{{ section.id }}__arrow {
    display: inline-block;
    font-size: 13px;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .split-cta-{{ section.id }}__button:hover .split-cta-{{ section.id }}__arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    .split-cta-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | default: 88 | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 88 | times: 0.6 | round }}px;
    }

    .split-cta-{{ section.id }}__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }

    .split-cta-{{ section.id }}__heading {
      font-size: clamp(28px, 8vw, 36px);
      margin-bottom: 12px;
    }

    .split-cta-{{ section.id }}__button {
      width: 100%;
      padding: 16px 24px;
    }
  }
{%- endstyle -%}

<section class="split-cta-{{ section.id }}" aria-label="{{ cta_heading | escape }}">
  <div class="split-cta-{{ section.id }}__inner">
    <div class="split-cta-{{ section.id }}__copy">
      <h2 class="split-cta-{{ section.id }}__heading">{{ cta_heading | escape | newline_to_br }}</h2>
      <p class="split-cta-{{ section.id }}__text">{{ cta_text | escape }}</p>
    </div>

    <div class="split-cta-{{ section.id }}__actions">
      <a href="{{ cta_link }}" class="split-cta-{{ section.id }}__button">
        <span>{{ cta_label | escape | upcase }}</span>
        <span class="split-cta-{{ section.id }}__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split CTA",
  "tag": "section",
  "class": "section-split-cta",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to play the long game?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "The protocol starts with one kit. Tell us your concern and we will point you to the right one."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find my kit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FDFCF7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#707070"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "Split CTA",
      "settings": {
        "heading": "Ready to play the long game?",
        "text": "The protocol starts with one kit. Tell us your concern and we will point you to the right one.",
        "button_label": "Find my kit",
        "background_color": "#FDFCF7",
        "heading_color": "#111111",
        "text_color": "#707070",
        "button_background": "#111111",
        "button_hover_background": "#333333",
        "button_text_color": "#FFFFFF",
        "padding_top": 88,
        "padding_bottom": 88
      }
    }
  ]
}
{% endschema %}
