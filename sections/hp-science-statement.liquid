{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-statement-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .hp-sci-statement-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .hp-sci-statement-{{ section.id }}__title {
    line-height: 1.12;
    margin: 0;
    max-width: 640px;
    color: inherit;
  }

  .hp-sci-statement-{{ section.id }}__title-accent {
  }

  .hp-sci-statement-{{ section.id }}__copy {
  }

  .hp-sci-statement-{{ section.id }}__eyebrow {
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 20px;
  }

  .hp-sci-statement-{{ section.id }}__para {
    line-height: 1.65;
    color: {{ section.settings.body_color }};
    opacity: {{ section.settings.body_opacity | default: 88 | times: 0.01 }};
    margin: 0 0 18px;
  }

  .hp-sci-statement-{{ section.id }}__para:last-child {
    margin-bottom: 0;
  }

  .hp-sci-statement-{{ section.id }}__rule {
    display: block;
    width: 100%;
    height: 1px;
    border: 0;
    margin: clamp(24px, 3vw, 32px) 0;
    background: {{ section.settings.rule_color }};
    opacity: {{ section.settings.rule_opacity | default: 35 | times: 0.01 }};
  }

  .hp-sci-statement-{{ section.id }}__closing {
    line-height: 1.65;
    color: {{ section.settings.closing_color }};
    opacity: {{ section.settings.closing_opacity | default: 100 | times: 0.01 }};
    margin: 0;
  }
  {%- if section.settings.text_offset_x_desktop != 0 or section.settings.text_offset_y_desktop != 0 -%}


  .hp-sci-statement-{{ section.id }}__text-position {
    transform: translate({{ section.settings.text_offset_x_desktop | default: 0 }}px, {{ section.settings.text_offset_y_desktop | default: 0 }}px);
  }
  {%- endif -%}

  @media screen and (max-width: 989px) {
    .hp-sci-statement-{{ section.id }}__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hp-sci-statement-{{ section.id }}__title {
      max-width: none;
      margin-bottom: 8px;
    }
    {%- if section.settings.text_offset_x_mobile != 0 or section.settings.text_offset_y_mobile != 0 -%}
  
    .hp-sci-statement-{{ section.id }}__text-position {
      transform: translate({{ section.settings.text_offset_x_mobile | default: 0 }}px, {{ section.settings.text_offset_y_mobile | default: 0 }}px);
    }
    {%- endif -%}
}

  .hp-sci-statement-{{ section.id }} .hp-sci__inner-fluid {
    max-width: none;
    margin: 0 auto;
    padding-left: calc(var(--hp-sci-rail-w, 18px) + clamp(28px, 4vw, 56px));
    padding-right: calc(var(--hp-sci-rail-w, 18px) + clamp(28px, 4vw, 56px));
    box-sizing: border-box;
  }

  @media screen and (max-width: 989px) {
    .hp-sci-statement-{{ section.id }} .hp-sci__inner-fluid {
      padding-left: clamp(28px, 4vw, 56px);
      padding-right: clamp(28px, 4vw, 56px);
    }
  }

  #shopify-section-{{ section.id }} .hp-sci .hp-sci-statement-{{ section.id }}__title {
    font-size: {{ section.settings.heading_size_desktop | default: 52 }}px !important;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .hp-sci .hp-sci-statement-{{ section.id }}__title {
      font-size: {{ section.settings.heading_size_mobile | default: 24 }}px !important;
    }
  }
  {% render 'hp-science-section-typography-styles', section: section %}

  /* Clean CSS variable override */
  #shopify-section-{{ section.id }} {
    --hp-sci-sec-eyebrow-size: 21px !important;
    --hp-sci-sec-body-size: {{ section.settings.body_size | default: 21 }}px !important;
  }
  
  #shopify-section-{{ section.id }} .hp-sci-statement-{{ section.id }}__para,
  #shopify-section-{{ section.id }} .hp-sci-statement-{{ section.id }}__closing {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
    font-weight: 300 !important;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      --hp-sci-sec-eyebrow-size: 20px !important;
    }
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-statement-{{ section.id }}">
  <div class="hp-sci__inner-fluid">
    <div class="hp-sci-statement-{{ section.id }}__grid hp-sci-statement-{{ section.id }}__text-position">
      <div class="hp-sci-statement-{{ section.id }}__headline">
        {%- if section.settings.heading_line_1 != blank or section.settings.heading_accent != blank -%}
          <h2 class="hp-sci-statement-{{ section.id }}__title">
            {%- if section.settings.heading_line_1 != blank -%}
              <span>{{ section.settings.heading_line_1 }}</span>
            {%- endif -%}
            {%- if section.settings.heading_accent != blank -%}
              <span class="hp-sci-statement-{{ section.id }}__title-accent">{{ section.settings.heading_accent }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
      </div>

      <div class="hp-sci-statement-{{ section.id }}__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-sci-statement-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.paragraph_1 != blank -%}
          <p class="hp-sci-statement-{{ section.id }}__para">{{ section.settings.paragraph_1 }}</p>
        {%- endif -%}

        {%- if section.settings.paragraph_2 != blank -%}
          <p class="hp-sci-statement-{{ section.id }}__para">{{ section.settings.paragraph_2 }}</p>
        {%- endif -%}

        {%- if section.settings.show_rule -%}
          <hr class="hp-sci-statement-{{ section.id }}__rule" aria-hidden="true">
        {%- endif -%}

        {%- if section.settings.closing_paragraph != blank -%}
          <p class="hp-sci-statement-{{ section.id }}__closing">{{ section.settings.closing_paragraph }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science \u2014 Statement",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "header",
      "content": "Text position"
    },
    {
      "type": "range",
      "id": "text_offset_x_desktop",
      "label": "Horizontal offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_desktop",
      "label": "Vertical offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_x_mobile",
      "label": "Horizontal offset \u2014 mobile",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_mobile",
      "label": "Vertical offset \u2014 mobile",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "header",
      "content": "Left headline"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Headline (regular)",
      "default": "The industry has been treating the symptom,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Headline accent (italic)",
      "default": "never the real problem."
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY THE CATEGORY KEEPS FAILING"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "A spot treatment clears the breakout before the barrier rebuilds. A hydration serum deposits moisture without activating the skin's own production. A brightening product suppresses melanin without addressing why it's being overproduced. Each product solves for the visible sign. None of them address the underlying biology that produced it."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "The result is a maintenance loop. The products work while you use them. The moment you stop, the original condition returns. Not because your skin is broken. Because nothing was ever rebuilt."
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show divider line",
      "default": true
    },
    {
      "type": "textarea",
      "id": "closing_paragraph",
      "label": "Closing paragraph (below line)",
      "default": "The real problem was never the spot or the dryness. It was the skin's own ability to repair itself, and nobody was rebuilding that."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Headline color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "closing_color",
      "label": "Closing paragraph color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Divider color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (Desktop)",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (Mobile)",
      "min": 16,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "body_opacity",
      "label": "Body opacity",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 88
    },
    {
      "type": "range",
      "id": "closing_opacity",
      "label": "Closing opacity",
      "min": 60,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "rule_opacity",
      "label": "Divider opacity",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Science \u2014 Statement",
      "settings": {
        "heading_line_1": "The industry has been treating the symptom,",
        "heading_accent": "never the real problem.",
        "eyebrow": "WHY THE CATEGORY KEEPS FAILING"
      }
    }
  ]
}
{% endschema %}
