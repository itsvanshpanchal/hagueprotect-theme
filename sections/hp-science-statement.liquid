{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }
  {% render 'hp-science-section-typography', section: section %}

  .hp-sci-statement-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .hp-sci-statement-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .hp-sci-statement-{{ section.id }}__title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-weight: 400;
    font-size: clamp(30px, 4.2vw, {{ section.settings.title_size }}px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 14ch;
    color: inherit;
  }

  .hp-sci-statement-{{ section.id }}__title-accent {
    font-style: italic;
    font-weight: 400;
  }

  .hp-sci-statement-{{ section.id }}__copy {
    max-width: 42rem;
  }

  .hp-sci-statement-{{ section.id }}__eyebrow {
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 20px;
  }

  .hp-sci-statement-{{ section.id }}__para {
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(15px, 1.45vw, {{ section.settings.body_size }}px);
    line-height: 1.65;
    color: {{ section.settings.body_color }};
    opacity: {{ section.settings.body_opacity | default: 88 | times: 0.01 }};
    margin: 0 0 18px;
  }

  .hp-sci-statement-{{ section.id }}__para:last-child {
    margin-bottom: 0;
  }

  .hp-sci-statement-{{ section.id }}__rule {
    display: block;
    width: 100%;
    height: 1px;
    border: 0;
    margin: clamp(24px, 3vw, 32px) 0;
    background: {{ section.settings.rule_color }};
    opacity: {{ section.settings.rule_opacity | default: 35 | times: 0.01 }};
  }

  .hp-sci-statement-{{ section.id }}__closing {
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(15px, 1.45vw, {{ section.settings.body_size }}px);
    line-height: 1.65;
    color: {{ section.settings.closing_color }};
    opacity: {{ section.settings.closing_opacity | default: 100 | times: 0.01 }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .hp-sci-statement-{{ section.id }}__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hp-sci-statement-{{ section.id }}__title {
      max-width: none;
      margin-bottom: 8px;
    }
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-statement-{{ section.id }}">
  <div class="hp-sci__inner">
    <div class="hp-sci-statement-{{ section.id }}__grid">
      <div class="hp-sci-statement-{{ section.id }}__headline">
        {%- if section.settings.heading_line_1 != blank or section.settings.heading_accent != blank -%}
          <h2 class="hp-sci-statement-{{ section.id }}__title">
            {%- if section.settings.heading_line_1 != blank -%}
              <span>{{ section.settings.heading_line_1 }}</span>
            {%- endif -%}
            {%- if section.settings.heading_accent != blank -%}
              <span class="hp-sci-statement-{{ section.id }}__title-accent">{{ section.settings.heading_accent }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
      </div>

      <div class="hp-sci-statement-{{ section.id }}__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-sci-statement-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.paragraph_1 != blank -%}
          <p class="hp-sci-statement-{{ section.id }}__para">{{ section.settings.paragraph_1 }}</p>
        {%- endif -%}

        {%- if section.settings.paragraph_2 != blank -%}
          <p class="hp-sci-statement-{{ section.id }}__para">{{ section.settings.paragraph_2 }}</p>
        {%- endif -%}

        {%- if section.settings.show_rule -%}
          <hr class="hp-sci-statement-{{ section.id }}__rule" aria-hidden="true">
        {%- endif -%}

        {%- if section.settings.closing_paragraph != blank -%}
          <p class="hp-sci-statement-{{ section.id }}__closing">{{ section.settings.closing_paragraph }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

