{%- style -%}
  /* ─── SECTION WRAPPER ─────────────────────────────────────── */
  .hp-animated-shoe-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
    position: relative;
    width: 100%;
    display: block;
    margin: 0;
    padding: 0;
  }

  /* Seamlessly connect to the footer by hiding the footer's top border */
  .footer-wrapper {
    border-top: none !important;
  }

  /* ─── INNER TRACK (fixed 102px ribbon) ───────────────────── */
  .hp-animated-shoe__track-wrap {
    position: relative;
    width: 100%;
    height: 102px;
  }

  /* ─── GROUND LINE ─────────────────────────────────────────── */
  .hp-animated-shoe__line {
    position: absolute;
    bottom: 30px; /* line sits near bottom of ribbon */
    left: 0;
    right: 0;
    height: 1px;
    background-color: {{ section.settings.line_color }};
    z-index: 1;
  }

  /* ─── DOT TRAIL ───────────────────────────────────────────── */
  .hp-shoe-trail {
    position: absolute;
    bottom: 30px; /* same Y as the ground line */
    left: 0;
    width: 100%;
    height: 1px;
    z-index: 2;
    pointer-events: none;
  }

  .hp-shoe-dot {
    position: absolute;
    bottom: 0;
    transform: translate(-50%, 50%);
    width: 14px;
    height: 5px;
    border-radius: 4px;
    background-color: {{ section.settings.dot_color }};
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  /* ─── SHOE SLIDER: outer handles horizontal slide only ───── */
  .hp-animated-shoe__slider {
    position: absolute;
    bottom: 30px;
    left: 0;
    z-index: 3;
    will-change: transform;
    animation: hpShoeSlide-{{ section.id }} {{ section.settings.animation_duration }}s linear infinite;
  }

  /* Inner wrapper: handles vertical bob only — no transform conflict */
  .hp-animated-shoe__slider-inner {
    display: block;
    will-change: transform;
    animation: hpShoeBob-{{ section.id }} 1.2s ease-in-out infinite;
  }

  @keyframes hpShoeSlide-{{ section.id }} {
    0%   { transform: translateX(-200px); }
    100% { transform: translateX(calc(100vw + 200px)); }
  }

  @keyframes hpShoeBob-{{ section.id }} {
    0%   { transform: translateY(0px); }
    25%  { transform: translateY(-10px); }
    50%  { transform: translateY(0px); }
    75%  { transform: translateY(-6px); }
    100% { transform: translateY(0px); }
  }

  .hp-animated-shoe__image {
    display: block;
    height: 64px; /* fixed height ~63% of 102px ribbon */
    width: auto;
    transform: translateY(0); /* sits on the line: bottom of img aligns to line */
    margin-bottom: 0;
    object-fit: contain;
  }

  @keyframes hpShoeSlide-{{ section.id }} {
    0%   { transform: translateX(-200px); }
    100% { transform: translateX(calc(100vw + 200px)); }
  }

  @media screen and (max-width: 749px) {
    .hp-animated-shoe__image {
      height: 48px;
    }
    .hp-animated-shoe__track-wrap {
      height: 80px;
    }
    .hp-animated-shoe__line,
    .hp-shoe-trail {
      bottom: 18px;
    }
    .hp-animated-shoe__slider {
      bottom: 18px;
    }
    @keyframes hpShoeSlide-{{ section.id }} {
      0%   { transform: translateX(-140px); }
      100% { transform: translateX(calc(100vw + 140px)); }
    }
    @keyframes hpShoeBob-{{ section.id }} {
      0%   { transform: translateY(0px); }
      25%  { transform: translateY(-6px); }
      50%  { transform: translateY(0px); }
      75%  { transform: translateY(-3px); }
      100% { transform: translateY(0px); }
    }
  }
{%- endstyle -%}

<section class="hp-animated-shoe hp-animated-shoe-{{ section.id }}" id="hp-animated-shoe-{{ section.id }}">
  <div class="hp-animated-shoe__track-wrap">

    <div class="hp-animated-shoe__line"></div>

    <div class="hp-shoe-trail" id="hp-shoe-trail-{{ section.id }}">
      <!-- dots injected by JS -->
    </div>

    <div class="hp-animated-shoe__slider" id="hp-animated-shoe__slider-{{ section.id }}">
      <div class="hp-animated-shoe__slider-inner">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 400 }}"
            alt="{{ section.settings.image.alt | escape }}"
            class="hp-animated-shoe__image"
            loading="lazy"
            draggable="false"
          >
        {%- else -%}
          <div style="display:flex;align-items:center;justify-content:center;width:120px;height:64px;background:#e0e0e0;border-radius:4px;font-size:11px;color:#888;">
            Upload Image
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<script>
(function() {
  var SECTION_ID = '{{ section.id }}';
  var DOT_COLOR  = '{{ section.settings.dot_color }}';
  var DOT_SPACING = 30; // px between dots
  var DOT_TRAIL_COUNT = 5; // how many dots glow at once behind the shoe
  var FADE_AFTER = 4; // dot index offset before the oldest fades

  var slider        = document.getElementById('hp-animated-shoe__slider-' + SECTION_ID);
  var trailEl       = document.getElementById('hp-shoe-trail-' + SECTION_ID);
  var sectionEl     = document.getElementById('hp-animated-shoe-' + SECTION_ID);
  if (!slider || !trailEl || !sectionEl) return;

  // Build fixed dot pool
  var POOL_SIZE = 60;
  var dotEls = [];
  for (var i = 0; i < POOL_SIZE; i++) {
    var d = document.createElement('div');
    d.className = 'hp-shoe-dot';
    d.style.left = (i * DOT_SPACING) + 'px';
    trailEl.appendChild(d);
    dotEls.push(d);
  }

  var lastShoeX = -9999;

  function tick() {
    // Get current translateX of the slider
    var mat = window.getComputedStyle(slider).transform;
    var curX = 0;
    if (mat && mat !== 'none') {
      var parts = mat.match(/matrix.*\((.+)\)/);
      if (parts) {
        var vals = parts[1].split(', ');
        curX = parseFloat(vals[4]) || 0;
      }
    }

    // The shoe's trailing edge (left side of shoe)
    var shoeWidth = slider.offsetWidth || 100;
    var heelX = curX; // left edge of shoe = heel position

    // Light up dots that are behind the heel, fade the rest
    dotEls.forEach(function(dot, idx) {
      var dotX = idx * DOT_SPACING;
      var dist = heelX - dotX;
      if (dist >= 0 && dist <= DOT_TRAIL_COUNT * DOT_SPACING) {
        // Inside the glowing trail window
        var intensity = 1 - (dist / (DOT_TRAIL_COUNT * DOT_SPACING));
        dot.style.opacity = (0.3 + intensity * 0.7).toFixed(2);
      } else {
        dot.style.opacity = '0';
      }
    });

    requestAnimationFrame(tick);
  }

  requestAnimationFrame(tick);
})();
</script>

{% schema %}
{
  "name": "Animated Shoe Track",
  "tag": "section",
  "class": "hp-animated-shoe-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Shoe Image",
      "info": "Upload a transparent-background PNG of the sneaker."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Ground Line Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Footstep Dot Color",
      "default": "#2ecc71"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "label": "Animation Duration (seconds)",
      "min": 2,
      "max": 60,
      "step": 1,
      "default": 28,
      "info": "Higher = slower shoe. 28s = medium/slow pace."
    }
  ],
  "presets": [
    {
      "name": "Animated Shoe Track"
    }
  ]
}
{% endschema %}
