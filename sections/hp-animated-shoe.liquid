{%- style -%}
  .hp-animated-shoe-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .hp-animated-shoe__line-container {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hp-animated-shoe__line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background-color: {{ section.settings.line_color }};
    z-index: 1;
    transform: translateY(-50%);
  }

  .hp-animated-shoe__track {
    position: relative;
    width: 100%;
    height: 100px; /* Base height to give it some room */
    display: flex;
    align-items: center;
    z-index: 2;
  }

  .hp-animated-shoe__slider {
    position: absolute;
    left: 0; /* Start at left edge */
    transform: translateX(-100%); /* Start completely off-screen left */
    z-index: 3;
    display: flex;
    align-items: center;
  }

  .hp-animated-shoe__image {
    display: block;
    height: auto;
    width: {{ section.settings.image_width }}px;
    max-width: 90vw;
  }

  .hp-shoe-trail {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
    padding: 0 10%; /* Keep trail within viewport edges a bit */
  }

  .hp-shoe-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ section.settings.dot_color | default: '#2ecc71' }};
    opacity: 0;
    transform: scale(0);
  }

  @media screen and (max-width: 749px) {
    .hp-animated-shoe-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .hp-animated-shoe__image {
      width: {{ section.settings.image_width_mobile }}px;
    }
    .hp-shoe-dot {
      width: 6px;
      height: 6px;
    }
  }
{%- endstyle -%}

<section class="hp-animated-shoe hp-animated-shoe-{{ section.id }}" id="hp-animated-shoe-{{ section.id }}">
  <div class="hp-animated-shoe__line-container">
    <div class="hp-animated-shoe__line"></div>
    
    <div class="hp-shoe-trail" id="hp-shoe-trail-{{ section.id }}">
      <!-- Dots will be injected via JS based on container width -->
    </div>

    <div class="hp-animated-shoe__track">
      <div class="hp-animated-shoe__slider" id="hp-animated-shoe__slider-{{ section.id }}">
        {%- if section.settings.image != blank -%}
          <img 
            src="{{ section.settings.image | image_url: width: 1200 }}" 
            alt="{{ section.settings.image.alt | escape }}" 
            class="hp-animated-shoe__image"
            loading="lazy"
          >
        {%- else -%}
          <div class="hp-animated-shoe__image" style="background: #ccc; height: 100px; display: flex; align-items: center; justify-content: center; opacity: 0.5;">
            Upload Image
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<!-- Load GSAP and ScrollTrigger if not already loaded -->
<script>
  (function() {
    function initShoeAnimation() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initShoeAnimation, 100);
        return;
      }
      
      gsap.registerPlugin(ScrollTrigger);

      const section = document.getElementById('hp-animated-shoe-{{ section.id }}');
      const slider = document.getElementById('hp-animated-shoe__slider-{{ section.id }}');
      const trailContainer = document.getElementById('hp-shoe-trail-{{ section.id }}');
      
      // Calculate how many dots we need based on container width
      const containerWidth = section.offsetWidth;
      const dotSpacing = 40; 
      const numDots = Math.floor(containerWidth / dotSpacing);
      
      // Generate dots
      for(let i=0; i<numDots; i++) {
        const dot = document.createElement('div');
        dot.className = 'hp-shoe-dot';
        trailContainer.appendChild(dot);
      }
      
      const dots = trailContainer.querySelectorAll('.hp-shoe-dot');

      // Create ScrollTrigger Timeline
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "center center",
          end: "+=150%", // Scroll duration
          scrub: 1, // Smooth scrubbing
          pin: true,
          anticipatePin: 1
        }
      });

      // Move the shoe from left off-screen to right off-screen
      // The distance to travel is viewport width + shoe width.
      const shoeWidth = slider.offsetWidth || 250;
      const totalDistance = window.innerWidth + shoeWidth + 100; // Extra buffer
      
      tl.to(slider, {
        x: totalDistance,
        ease: "none",
        duration: 1
      }, 0);

      // Fade/Scale in dots as the shoe passes them
      // We'll distribute the dot animations across the timeline duration (0 to 1)
      if (dots.length > 0) {
        dots.forEach((dot, index) => {
          // Delay based on dot index. Add a slight offset so it appears as shoe passes it
          const progressPoint = (index / numDots) + 0.1;
          
          tl.to(dot, {
            opacity: 1,
            scale: 1,
            duration: 0.1, // Quick pop
            ease: "back.out(2)"
          }, progressPoint);
        });
      }
    }

    // Check for GSAP, dynamically load if needed
    if (typeof gsap === 'undefined') {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js';
      document.head.appendChild(script);
      
      script.onload = function() {
        const stScript = document.createElement('script');
        stScript.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js';
        document.head.appendChild(stScript);
        stScript.onload = initShoeAnimation;
      }
    } else {
      initShoeAnimation();
    }
  })();
</script>

{% schema %}
{
  "name": "Animated Shoe Track",
  "tag": "section",
  "class": "hp-animated-shoe-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Shoe Image",
      "info": "Upload a PNG with transparent background."
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Width (Desktop)",
      "min": 100,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Image Width (Mobile)",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdfcf7"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Horizontal Line Color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Footstep Dot Color",
      "default": "#2ecc71"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (Desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (Desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Animated Shoe Track"
    }
  ]
}
{% endschema %}
