<div class="hpa-section">
  <!-- ══ §5 MARQUEE ══ -->
  <section class="hpa-marquee" aria-hidden="true">
    <div class="hpa-marquee__row hpa-marquee__row--fwd">
      {% for i in (1..3) %}
        {% for block in section.blocks %}
          {% if block.settings.text != blank %}
            <span class="hpa-marquee__item {% if block.settings.is_red %}r{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            <span class="hpa-marquee__sep">✦</span>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "About Us Marquee",
  "settings": [],
  "blocks": [
    {
      "type": "marquee_word",
      "name": "Marquee Word",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Safer Choice"
        },
        {
          "type": "checkbox",
          "id": "is_red",
          "label": "Use Red Color",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Marquee",
      "blocks": [
        { "type": "marquee_word", "settings": { "text": "Safer Choice", "is_red": false } },
        { "type": "marquee_word", "settings": { "text": "Premium Care", "is_red": true } },
        { "type": "marquee_word", "settings": { "text": "Global Protection", "is_red": false } },
        { "type": "marquee_word", "settings": { "text": "Skin Longevity", "is_red": true } },
        { "type": "marquee_word", "settings": { "text": "Bioenzyme Science", "is_red": false } },
        { "type": "marquee_word", "settings": { "text": "Lab Tested", "is_red": true } },
        { "type": "marquee_word", "settings": { "text": "Zero Compromise", "is_red": false } },
        { "type": "marquee_word", "settings": { "text": "Material First", "is_red": true } }
      ]
    }
  ]
}
{% endschema %}
