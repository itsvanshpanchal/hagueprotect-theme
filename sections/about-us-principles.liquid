<div class="hpa-section">
  <!-- ══ §3 PRINCIPLES ══ -->
  <section class="hpa-principles" id="hpaPrinciples">
    <div class="hpa-principles__top">
      <div>
        <div class="hpa-principles__eyebrow">{{ section.settings.principles_eyebrow }}</div>
        <h2 class="hpa-principles__heading hpa-up">{{ section.settings.principles_heading }}</h2>
      </div>
      <p class="hpa-principles__sub hpa-up" data-d="1">{{ section.settings.principles_sub }}</p>
    </div>
    
    <div class="hpa-principles__grid">
      {% for block in section.blocks %}
        <div class="hpa-pc hpa-pc--{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% if forloop.index == 2 %}
            <div class="hpa-pc__inner">
          {% endif %}
          
          <div class="hpa-pc__num">{{ block.settings.num }}</div>
          {% if block.settings.icon_svg != blank %}
            <div class="hpa-pc__icon">{{ block.settings.icon_svg }}</div>
          {% endif %}
          <h3 class="hpa-pc__title">{{ block.settings.title }}</h3>
          <p class="hpa-pc__desc">{{ block.settings.desc }}</p>
          
          {% if forloop.index == 2 %}
            </div>
            <div class="hpa-pc__visual"><div class="hpa-pc__visual-text" aria-hidden="true">{{ block.settings.bg_text }}</div></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "About Us Principles",
  "settings": [
    {
      "type": "text",
      "id": "principles_eyebrow",
      "label": "Principles Eyebrow",
      "default": "How We Work"
    },
    {
      "type": "textarea",
      "id": "principles_heading",
      "label": "Principles Heading",
      "default": "Four Pillars.<br>One Obsession."
    },
    {
      "type": "textarea",
      "id": "principles_sub",
      "label": "Principles Subtext",
      "default": "Every product, every formula, every drop is built on these four non-negotiables. No shortcuts. No compromises."
    }
  ],
  "blocks": [
    {
      "type": "principle_card",
      "name": "Principle Card",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "num",
          "label": "Number or Text",
          "default": "01"
        },
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon SVG"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "default": "Cleanse"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description",
          "default": "Bioenzyme formulations that lift contamination at the molecular level. No harsh acids. No bleach. No damage — ever."
        },
        {
          "type": "text",
          "id": "bg_text",
          "label": "Background Text (Card 2 only)",
          "default": "PROTECT"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Principles",
      "blocks": [
        { "type": "principle_card", "settings": { "num": "01", "title": "Cleanse", "icon_svg": "<svg viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"16\" cy=\"16\" r=\"12\"/><path d=\"M12 16s1.5 3 4 3 4-3 4-3\"/><circle cx=\"12\" cy=\"13\" r=\"1.5\" fill=\"currentColor\"/><circle cx=\"20\" cy=\"13\" r=\"1.5\" fill=\"currentColor\"/></svg>" } },
        { "type": "principle_card", "settings": { "num": "02", "title": "Protect", "bg_text": "PROTECT", "icon_svg": "<svg viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 3L3 10v12l13 7 13-7V10L16 3z\"/><path d=\"M3 10l13 7m0 0l13-7M16 17v12\"/></svg>" } },
        { "type": "principle_card", "settings": { "num": "03", "title": "Restore", "icon_svg": "<svg viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 26l8-11 6 7 4-5 6 9\"/><circle cx=\"24\" cy=\"8\" r=\"5\"/><line x1=\"24\" y1=\"3\" x2=\"24\" y2=\"2\"/></svg>" } },
        { "type": "principle_card", "settings": { "num": "04", "title": "Preserve", "icon_svg": "<svg viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 2C24 9 28 18 28 24a12 12 0 01-24 0C4 18 8 9 16 2z\"/><path d=\"M16 22c3 0 5-2.5 5-5s-5-9-5-9-5 6-5 9 2 5 5 5z\"/></svg>" } },
        { "type": "principle_card", "settings": { "num": "HP", "title": "Zero<br>Compromise.", "desc": "Every formula is lab-tested against 40+ material types before it reaches your hands. We don't release until it's perfect.", "icon_svg": "" } }
      ]
    }
  ]
}
{% endschema %}
