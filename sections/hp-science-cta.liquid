{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cta_link = section.settings.button_link
  if cta_link == blank
    assign cta_link = routes.all_products_collection_url
  endif
  assign secondary_link = section.settings.secondary_link
  if secondary_link == blank
    assign secondary_link = routes.all_products_collection_url
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-cta-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .hp-sci-cta-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .hp-sci-cta-{{ section.id }}__title-main {
    display: block;
    line-height: 1.08;
    margin: 0 0 4px;
    color: #ffffff !important;
  }

  .hp-sci-cta-{{ section.id }}__title-sub {
    display: block;
    line-height: 1.08;
    margin: 0;
    color: #ffffff !important;
  }

  .hp-sci-cta-{{ section.id }}__panel {
    max-width: 42ch;
    padding-top: clamp(8px, 1vw, 16px);
  }

  .hp-sci-cta-{{ section.id }}__body {
    line-height: 1.65;
    margin: 0 0 clamp(24px, 3vw, 32px);
    color: {{ section.settings.body_color }} !important;
  }

  .hp-sci-cta-{{ section.id }}__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 168px;
    padding: 14px 28px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }} !important;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    margin-bottom: 16px;
    transition: opacity 0.2s ease;
  }

  .hp-sci-cta-{{ section.id }}__btn:hover {
    opacity: 0.88;
  }

  .hp-sci-cta-{{ section.id }}__secondary {
    display: inline-block;
    color: #ffffff !important;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hp-sci-cta-{{ section.id }}__secondary:hover {
    opacity: 0.82;
  }
  {%- if section.settings.text_offset_x_desktop != 0 or section.settings.text_offset_y_desktop != 0 -%}


  .hp-sci-cta-{{ section.id }}__text-position {
    transform: translate({{ section.settings.text_offset_x_desktop | default: 0 }}px, {{ section.settings.text_offset_y_desktop | default: 0 }}px);
  }
  {%- endif -%}

  @media screen and (max-width: 989px) {
    .hp-sci-cta-{{ section.id }}__grid {
      grid-template-columns: 1fr;
    }

    .hp-sci-cta-{{ section.id }}__panel {
      max-width: none;
      padding-top: 0;
    }
    {%- if section.settings.text_offset_x_mobile != 0 or section.settings.text_offset_y_mobile != 0 -%}
  
    .hp-sci-cta-{{ section.id }}__text-position {
      transform: translate({{ section.settings.text_offset_x_mobile | default: 0 }}px, {{ section.settings.text_offset_y_mobile | default: 0 }}px);
    }
    {%- endif -%}
}
  {% render 'hp-science-section-typography-styles', section: section %}
{%- endstyle -%}

<section class="hp-sci hp-sci-cta-{{ section.id }}">
  <div class="hp-sci__inner">
    <div class="hp-sci-cta-{{ section.id }}__grid hp-sci-cta-{{ section.id }}__text-position">
      <div class="hp-sci-cta-{{ section.id }}__headline">
        {%- if section.settings.heading_line_1 != blank -%}
          <span class="hp-sci-cta-{{ section.id }}__title-main">{{ section.settings.heading_line_1 }}</span>
        {%- endif -%}
        {%- if section.settings.heading_line_2 != blank -%}
          <span class="hp-sci-cta-{{ section.id }}__title-sub">{{ section.settings.heading_line_2 }}</span>
        {%- endif -%}
      </div>

      <div class="hp-sci-cta-{{ section.id }}__panel">
        {%- if section.settings.body != blank -%}
          <p class="hp-sci-cta-{{ section.id }}__body">{{ section.settings.body }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="hp-sci-cta-{{ section.id }}__btn" href="{{ cta_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="hp-sci-cta-{{ section.id }}__secondary" href="{{ secondary_link }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science \u2014 CTA bar",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "header",
      "content": "Text position"
    },
    {
      "type": "range",
      "id": "text_offset_x_desktop",
      "label": "Horizontal offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_desktop",
      "label": "Vertical offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_x_mobile",
      "label": "Horizontal offset \u2014 mobile",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_mobile",
      "label": "Vertical offset \u2014 mobile",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "The science earns the timeline."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (italic)",
      "default": "75 days is enough."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "You've read the argument. The biology is not complicated. Your skin knows how to do this. It just needs the right live signals, at clinically meaningful concentrations, for long enough to matter."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "FIND MY SERUM"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "See the three serums"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#a8894a"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Science \u2014 CTA bar"
    }
  ]
}
{% endschema %}
