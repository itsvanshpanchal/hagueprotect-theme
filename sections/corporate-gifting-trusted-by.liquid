{%- liquid
  assign logo_max_width = section.settings.logo_max_width | default: 140
  assign logo_max_height = section.settings.logo_max_height | default: 48
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign container_radius = section.settings.container_radius | default: 24
  assign container_bg = section.settings.container_background | default: '#f0f0f0'
  assign logo_count = 9
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-left: 0 !important;
    padding-right: 0 !important;
    max-width: none !important;
  }

  #shopify-section-{{ section.id }} .corp-trusted {
    padding: clamp(64px, 8vw, 96px) 0;
    background: {{ section.settings.section_background | default: '#ffffff' }};
  }

  #shopify-section-{{ section.id }} .corp-trusted__container {
    max-width: none !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 clamp(32px, 6vw, 80px) !important;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .corp-trusted__heading {
    margin: 0 0 clamp(28px, 4vw, 40px);
    text-align: left;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
    font-size: {{ section.settings.heading_size | default: 52 }}px !important;
    font-weight: 300 !important;
    font-style: normal !important;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: none;
    color: {{ section.settings.heading_color | default: '#111111' }} !important;
  }

  #shopify-section-{{ section.id }} .corp-trusted__panel {
    background: {{ container_bg }};
    border-radius: {{ container_radius }}px;
    padding: clamp(36px, 5vw, 56px) clamp(24px, 4vw, 48px) clamp(28px, 4vw, 40px);
  }

  #shopify-section-{{ section.id }} .corp-trusted__grid {
    display: grid;
    grid-template-columns: repeat({{ columns_desktop }}, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px) clamp(20px, 3vw, 32px);
    align-items: center;
    justify-items: center;
  }

  #shopify-section-{{ section.id }} .corp-trusted__logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: {{ logo_max_height | plus: 16 }}px;
    padding: 8px;
  }

  #shopify-section-{{ section.id }} .corp-trusted__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: {{ logo_max_width }}px;
    max-height: {{ logo_max_height }}px;
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .corp-trusted__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, {{ logo_max_width }}px);
    min-height: {{ logo_max_height }}px;
    border: 1px dashed rgba(17, 17, 17, 0.18);
    border-radius: 8px;
    color: rgba(17, 17, 17, 0.35);
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    padding: 12px;
  }

  #shopify-section-{{ section.id }} .corp-trusted__footer {
    margin: clamp(28px, 4vw, 40px) 0 0;
    text-align: center;
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: {{ section.settings.footer_size | default: 18 }}px !important;
    font-weight: 400 !important;
    line-height: 1.2;
    color: {{ section.settings.footer_color | default: '#9a9a9a' }} !important;
  }

  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .corp-trusted__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 560px) {
    #shopify-section-{{ section.id }} .corp-trusted__grid {
      grid-template-columns: 1fr;
    }
  }

  #shopify-section-{{ section.id }} .corp-trusted__logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
{%- endstyle -%}

<section class="corp-trusted" data-no-typewriter="true" data-corp-trusted-section="true">
  <div class="corp-trusted__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="corp-trusted__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="corp-trusted__panel">
      <div class="corp-trusted__grid">
        {%- for i in (1..logo_count) -%}
          {%- liquid
            assign logo_image = blank
            assign logo_link = blank
            assign logo_label = 'Logo ' | append: i

            case i
              when 1
                assign logo_image = section.settings.logo_1_image
                assign logo_link = section.settings.logo_1_link
              when 2
                assign logo_image = section.settings.logo_2_image
                assign logo_link = section.settings.logo_2_link
              when 3
                assign logo_image = section.settings.logo_3_image
                assign logo_link = section.settings.logo_3_link
              when 4
                assign logo_image = section.settings.logo_4_image
                assign logo_link = section.settings.logo_4_link
              when 5
                assign logo_image = section.settings.logo_5_image
                assign logo_link = section.settings.logo_5_link
              when 6
                assign logo_image = section.settings.logo_6_image
                assign logo_link = section.settings.logo_6_link
              when 7
                assign logo_image = section.settings.logo_7_image
                assign logo_link = section.settings.logo_7_link
              when 8
                assign logo_image = section.settings.logo_8_image
                assign logo_link = section.settings.logo_8_link
              when 9
                assign logo_image = section.settings.logo_9_image
                assign logo_link = section.settings.logo_9_link
            endcase

            if section.blocks.size > 0
              for block in section.blocks
                if forloop.index == i
                  if block.settings.image != blank
                    assign logo_image = block.settings.image
                  endif
                  if block.settings.link != blank
                    assign logo_link = block.settings.link
                  endif
                  if block.settings.label != blank
                    assign logo_label = block.settings.label
                  endif
                endif
              endfor
            endif
          -%}

          <div class="corp-trusted__logo-wrap" id="corp-trusted-logo-{{ section.id }}-{{ i }}">
            {%- if logo_image != blank -%}
              {%- if logo_link != blank -%}
                <a href="{{ logo_link }}" class="corp-trusted__logo-link" aria-label="{{ logo_image.alt | default: logo_label | escape }}">
              {%- endif -%}
              <img
                class="corp-trusted__logo"
                src="{{ logo_image | image_url: width: 600 }}"
                alt="{{ logo_image.alt | default: logo_label | escape }}"
                width="{{ logo_image.width }}"
                height="{{ logo_image.height }}"
                loading="lazy"
                style="max-width: {{ logo_max_width }}px; max-height: {{ logo_max_height }}px;"
              >
              {%- if logo_link != blank -%}
                </a>
              {%- endif -%}
            {%- else -%}
              <div class="corp-trusted__placeholder">
                {{ logo_label }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.footer_text != blank -%}
        <p class="corp-trusted__footer">{{ section.settings.footer_text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

