{%- liquid
  assign logo_max_width = section.settings.logo_max_width | default: 140
  assign logo_max_height = section.settings.logo_max_height | default: 48
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign container_radius = section.settings.container_radius | default: 24
  assign container_bg = section.settings.container_background | default: '#f0f0f0'
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .corp-trusted {
    padding: clamp(64px, 8vw, 96px) 0;
    background: {{ section.settings.section_background | default: '#ffffff' }};
  }

  #shopify-section-{{ section.id }} .corp-trusted__container {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 0 max(20px, var(--site-padding, 24px));
  }

  #shopify-section-{{ section.id }} .corp-trusted__heading {
    margin: 0 0 clamp(28px, 4vw, 40px);
    text-align: center;
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: {{ section.settings.heading_size | default: 20 }}px !important;
    font-weight: 700 !important;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: {{ section.settings.heading_color | default: '#111111' }} !important;
  }

  #shopify-section-{{ section.id }} .corp-trusted__panel {
    background: {{ container_bg }};
    border-radius: {{ container_radius }}px;
    padding: clamp(36px, 5vw, 56px) clamp(24px, 4vw, 48px) clamp(28px, 4vw, 40px);
  }

  #shopify-section-{{ section.id }} .corp-trusted__grid {
    display: grid;
    grid-template-columns: repeat({{ columns_desktop }}, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 48px) clamp(20px, 3vw, 32px);
    align-items: center;
    justify-items: center;
  }

  #shopify-section-{{ section.id }} .corp-trusted__logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: {{ logo_max_height | plus: 16 }}px;
    padding: 8px;
  }

  #shopify-section-{{ section.id }} .corp-trusted__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: {{ logo_max_width }}px;
    max-height: {{ logo_max_height }}px;
    object-fit: contain;
    object-position: center;
  }

  #shopify-section-{{ section.id }} .corp-trusted__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, {{ logo_max_width }}px);
    min-height: {{ logo_max_height }}px;
    border: 1px dashed rgba(17, 17, 17, 0.18);
    border-radius: 8px;
    color: rgba(17, 17, 17, 0.35);
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    padding: 12px;
  }

  #shopify-section-{{ section.id }} .corp-trusted__footer {
    margin: clamp(28px, 4vw, 40px) 0 0;
    text-align: center;
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: {{ section.settings.footer_size | default: 18 }}px !important;
    font-weight: 400 !important;
    line-height: 1.2;
    color: {{ section.settings.footer_color | default: '#9a9a9a' }} !important;
  }

  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .corp-trusted__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 560px) {
    #shopify-section-{{ section.id }} .corp-trusted__grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<section class="corp-trusted" data-no-typewriter="true">
  <div class="corp-trusted__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="corp-trusted__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="corp-trusted__panel">
      {%- if section.blocks.size > 0 -%}
        <div class="corp-trusted__grid">
          {%- for block in section.blocks -%}
            <div class="corp-trusted__logo-wrap" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="corp-trusted__logo-link" aria-label="{{ block.settings.image.alt | default: block.settings.label | default: 'Partner logo' | escape }}">
              {%- endif -%}

              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign block_logo_width = block.settings.logo_width | default: logo_max_width
                  assign block_logo_height = block.settings.logo_height | default: logo_max_height
                -%}
                <img
                  class="corp-trusted__logo"
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                  style="max-width: {{ block_logo_width }}px; max-height: {{ block_logo_height }}px;"
                >
              {%- else -%}
                <div class="corp-trusted__placeholder">
                  {{ block.settings.label | default: 'Upload logo' }}
                </div>
              {%- endif -%}

              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="corp-trusted__grid">
          {%- for i in (1..9) -%}
            <div class="corp-trusted__logo-wrap">
              <div class="corp-trusted__placeholder">Logo {{ i }}</div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.footer_text != blank -%}
        <p class="corp-trusted__footer">{{ section.settings.footer_text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Corporate Trusted By",
  "enabled_on": {
    "templates": [
      "search.corporate-gifting",
      "page.corporate"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by teams with taste"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Logo panel"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "container_background",
      "label": "Panel background",
      "default": "#f0f0f0"
    },
    {
      "type": "range",
      "id": "container_radius",
      "label": "Panel corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Default logo max width",
      "min": 60,
      "max": 280,
      "step": 4,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Default logo max height",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "and more..."
    },
    {
      "type": "range",
      "id": "footer_size",
      "label": "Footer text size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "footer_color",
      "label": "Footer text color",
      "default": "#9a9a9a"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Placeholder label",
          "info": "Shown in the editor when no image is uploaded."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo max width",
          "min": 60,
          "max": 280,
          "step": 4,
          "unit": "px",
          "default": 140
        },
        {
          "type": "range",
          "id": "logo_height",
          "label": "Logo max height",
          "min": 20,
          "max": 120,
          "step": 2,
          "unit": "px",
          "default": 48
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Corporate Trusted By",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
