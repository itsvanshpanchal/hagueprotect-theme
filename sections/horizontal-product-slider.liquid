    {
      "type": "color",
      "id": "heading_line2_color",
      "label": "Heading second line color",
      "default": "#6b6b6b"
    },
    {
      "type": "header",
      "content": "Heading accent word (script)"
    },
    {
      "type": "paragraph",
      "content": "Font and size for the highlighted last word only (e.g. Care, Material, Story, Best, Media). Leave font on theme default to use Theme settings > Typography."
    },
    {
      "type": "select",
      "id": "heading_accent_font_family",
      "label": "Accent word font",
      "options": [
        {
          "value": "theme_default",
          "label": "Use theme Typography setting"
        },
        {
          "value": "luthon_southard_script",
          "label": "Luthon Southard Script"
        },
        {
          "value": "luthon_southard_serif",
          "label": "Luthon Southard Serif"
        },
        {
          "value": "jacques_gilles",
          "label": "Jacques Gilles"
        },
        {
          "value": "calisto_mt",
          "label": "Calisto MT Regular"
        },
        {
          "value": "calisto_mt_italic",
          "label": "Calisto MT Italic"
        },
        {
          "value": "calisto_mt_bold",
          "label": "Calisto MT Bold"
        },
        {
          "value": "bahnschrift",
          "label": "Bahnschrift Regular"
        },
        {
          "value": "bahnschrift_semibold",
