{%- liquid
  assign hp_heading_desktop = section.settings.h2_font_size_desktop | default: 52
  assign hp_heading_mobile = section.settings.h2_font_size_mobile | default: 24
  assign hp_accent_desktop = section.settings.heading_accent_font_size_desktop | default: 52
  assign hp_accent_mobile = section.settings.heading_accent_font_size_mobile | default: 40
  assign hp_accent_color = section.settings.heading_accent_color | default: settings.heading_accent_color | default: '#c9a227'
  assign hp_accent_weight = section.settings.heading_accent_font_weight | default: settings.font_heading_accent_weight | default: '400'
  assign glass_max_w = section.settings.glass_panel_max_width | default: 1100
  assign glass_pad = section.settings.glass_panel_padding | default: 40
  assign glass_title_d = section.settings.glass_title_size_desktop | default: 15
  assign glass_title_m = section.settings.glass_title_size_mobile | default: 12
  assign glass_para_d = section.settings.glass_para_size_desktop | default: 15
  assign glass_para_m = section.settings.glass_para_size_mobile | default: 12
  assign glass_eyebrow_sz = section.settings.glass_eyebrow_size | default: 19
  assign glass_link_sz = section.settings.glass_link_size | default: 16
  assign glass_eyebrow_color = section.settings.glass_eyebrow_color | default: '#a8894a'
  assign glass_title_spacing_d = section.settings.glass_title_spacing_desktop | default: 28
  assign glass_title_spacing_m = section.settings.glass_title_spacing_mobile | default: 10
-%}
{%- style -%}
  {% render 'section-typography-vars', section: section %}

  #shopify-section-{{ section.id }} {
    --hp-fam-rail-width: 340px;
    --hp-fam-rail-gap: 72px;
    --hp-fam-rail-clearance: calc(var(--hp-fam-rail-width) + var(--hp-fam-rail-gap));
    --hp-glass-max-width: {{ glass_max_w }}px;
    --hp-glass-pad: {{ glass_pad }}px;
    --hp-glass-title-size: {{ glass_title_d }}px;
    --hp-glass-title-size-mobile: {{ glass_title_m }}px;
    --hp-glass-para-size: {{ glass_para_d }}px;
    --hp-glass-para-size-mobile: {{ glass_para_m }}px;
    --hp-glass-eyebrow-size: {{ glass_eyebrow_sz }}px;
    --hp-glass-link-size: {{ glass_link_sz }}px;
    --hp-glass-eyebrow-color: {{ glass_eyebrow_color }};
    --hp-glass-title-spacing: {{ glass_title_spacing_d }}px;
  }

  /* Match Tell Your Story: exact heading + accent sizes */
  #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading,
  #shopify-section-{{ section.id }} .hp-fam-sec__heading,
  #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-line,
  #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-line,
  #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair .hp-heading-line,
  #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair .hp-heading-line {
    font-family: var(--font-family-h2, var(--font-family-heading)) !important;
    font-weight: var(--font-weight-h2, 300) !important;
    font-style: var(--font-style-h2, normal) !important;
    font-size: {{ hp_heading_desktop }}px !important;
    line-height: 1.05 !important;
    color: #ffffff !important;
    text-transform: none !important;
    margin-bottom: {{ section.settings.heading_subheading_spacing_desktop | default: 22 }}px !important;
  }

  #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-accent,
  #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-accent {
    display: inline !important;
    font-family: 'Inter', sans-serif !important;
    font-weight: 300 !important;
    font-style: italic !important;
    font-size: inherit !important;
    color: #c8c8c8 !important;
    -webkit-text-fill-color: #c8c8c8 !important;
    -webkit-text-stroke: 0;
    paint-order: normal;
    -webkit-font-smoothing: antialiased;
    text-transform: none !important;
    letter-spacing: 0.01em !important;
    white-space: nowrap !important;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair {
      display: inline !important;
      flex-direction: row !important;
      white-space: nowrap !important;
    }

    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack {
      display: block !important;
      margin-top: -18px !important;
    }

    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair .hp-heading-line,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack .hp-heading-line,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-accent,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack .hp-heading-accent {
      display: inline !important;
    }
  }

  @media screen and (max-width: 989px) {
    #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading,
    #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-line,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-line,
    #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair .hp-heading-line,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair .hp-heading-line {
      font-size: {{ hp_heading_mobile }}px !important;
      margin-bottom: {{ section.settings.heading_subheading_spacing_mobile | default: 10 }}px !important;
    }

    #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-accent,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-accent {
      font-size: inherit !important;
    }
  }


  #shopify-section-{{ section.id }} {
    background: linear-gradient(to bottom, {{ section.settings.bg_color | default: '#ff1e43' }} 76%, {{ section.settings.bg_color_bottom | default: '#000000' }} 76%);
    position: relative;
    overflow: hidden;
  }

  .hp-fam-sec {
    position: relative;
    padding: clamp(28px, 4.5vw, 48px) 0 clamp(40px, 5vw, 64px) 0;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Tall monitors: fill the viewport so the next section doesn't peek underneath */
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .hp-fam-sec,
    .hp-fam-sec {
      justify-content: flex-start !important;
      padding-top: 80px !important;
    }

    #shopify-section-{{ section.id }} .hp-fam-sec__tabs,
    .hp-fam-sec__tabs {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .hp-fam-sec__heading,
    .hp-fam-sec__heading {
      margin-bottom: {{ section.settings.heading_subheading_spacing_desktop | default: 10 }}px !important;
    }
  }

  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }},
    .hp-fam-sec {
      min-height: 100vh;
      min-height: 100dvh;
    }

    .hp-fam-sec {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding-top: 80px;
      padding-bottom: clamp(48px, 6vh, 80px);
    }
  }

  .hp-fam-sec__container {
    max-width: var(--site-max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--homepage-section-gutter, 8px);
    position: relative;
    box-sizing: border-box;
    z-index: 2;
  }

  @media screen and (min-width: 1200px) {
    /* Beat homepage layout gutter rules (theme-layout-css uses !important) */
    body.template-index #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__container,
    #shopify-section-{{ section.id }} .hp-fam-sec__container {
      padding-right: max(var(--homepage-section-gutter-right, var(--homepage-section-gutter, 48px)), 400px) !important;
    }

    body.template-index #MainContent #shopify-section-{{ section.id }} .hp-fam-sec--has-glass .hp-fam-sec__container,
    #shopify-section-{{ section.id }} .hp-fam-sec--has-glass .hp-fam-sec__container {
      padding-right: max(var(--homepage-section-gutter-right, var(--homepage-section-gutter, 48px)), var(--hp-fam-rail-clearance, 412px)) !important;
    }

    body.template-index #MainContent #shopify-section-{{ section.id }} .hp-fam-sec--has-glass .hp-fam-sec__glass-panel,
    #shopify-section-{{ section.id }} .hp-fam-sec--has-glass .hp-fam-sec__glass-panel {
      width: 100%;
      max-width: min(
        var(--hp-glass-max-width, 1100px),
        100%,
        calc(100vw - var(--homepage-section-gutter, 48px) - var(--hp-fam-rail-clearance, 412px))
      ) !important;
      margin-right: 0;
      box-sizing: border-box;
    }
  }

  .hp-fam-sec__heading {
    font-size: var(--section-heading-size) !important;
    font-family: var(--font-family-h2, var(--font-family-heading)) !important;
    font-weight: var(--font-weight-h2, 300) !important;
    font-style: var(--font-style-h2, normal) !important;
    text-transform: none !important;
    color: #f3f2f2;
    margin: 0 0 {{ section.settings.heading_subheading_spacing_desktop | default: 22 }}px 0 !important;
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 700px;
  }

  #shopify-section-{{ section.id }} .hp-fam-sec__heading,
  #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-line,
  #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair .hp-heading-line,
  #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-typewriter-text {
    font-family: var(--font-family-h2, var(--font-family-heading)) !important;
    font-weight: var(--font-weight-h2, 300) !important;
    font-style: var(--font-style-h2, normal) !important;
    font-size: inherit !important;
  }

  .hp-fam-sec__heading::first-letter,
  .hp-fam-sec__heading .hp-typewriter-text,
  .hp-fam-sec__heading .hp-typewriter-cursor {
    text-transform: none !important;
  }

  .hp-fam-sec__heading .hp-heading-line {
    display: inline !important;
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    font-style: inherit !important;
    letter-spacing: inherit !important;
    line-height: inherit !important;
    text-transform: none !important;
    color: inherit !important;
  }

  .hp-fam-sec__heading .hp-heading-line--with-accent {
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .hp-fam-sec__heading .hp-heading-pair {
      display: inline !important;
      flex-direction: row !important;
      white-space: nowrap !important;
    }
    
    .hp-fam-sec__heading .hp-heading-pair--stack {
      display: block !important;
      margin-top: -40px !important;
    }

    .hp-fam-sec__heading > .hp-heading-line--1,
    .hp-fam-sec__heading .hp-heading-pair .hp-heading-line,
    .hp-fam-sec__heading .hp-heading-pair--stack .hp-heading-line {
      display: inline !important;
    }

    .hp-fam-sec__heading .hp-heading-accent,
    .hp-fam-sec__heading .hp-heading-pair--stack .hp-heading-accent {
      display: inline !important;
    }
  }

  .hp-fam-sec__heading .hp-heading-line--1::first-letter {
    text-transform: none !important;
  }

  .hp-fam-sec__heading .hp-heading-accent {
    display: inline !important;
    font-family: 'Inter', sans-serif !important;
    font-weight: 300 !important;
    font-style: italic !important;
    color: #c8c8c8 !important;
    -webkit-text-fill-color: #c8c8c8 !important;
    -webkit-text-stroke: 0;
    paint-order: normal;
    -webkit-font-smoothing: antialiased;
    font-size: inherit !important;
    text-transform: none !important;
    letter-spacing: 0.01em !important;
    white-space: nowrap !important;
  }

  .hp-fam-sec__heading .hp-typewriter-text,
  .hp-fam-sec__heading > span[aria-hidden="true"] {
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    font-style: inherit !important;
    letter-spacing: inherit !important;
    line-height: inherit !important;
    text-transform: none !important;
    color: inherit !important;
  }

  /* CATEGORY TABS */
  .hp-fam-sec__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
    align-items: center;
  }

  .hp-fam-sec__tab {
    background: transparent;
    border: none;
    padding: 10px 20px;
    border-radius: 100px;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-family-sans);
    font-size: var(--section-label-size, 13px);
    font-weight: var(--font-weight-sans, 700);
    font-style: var(--font-style-sans, normal);
    text-transform: none;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    outline: none;
    text-decoration: none;
    display: inline-block;
  }

  .hp-fam-sec__tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .hp-fam-sec__tab.is-active {
    background: #000000;
    color: #ffffff;
  }

  /* Intro panel — transparent, no card box */
  .hp-fam-sec__glass-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    width: 100%;
    text-align: left !important;
    max-width: min(var(--hp-glass-max-width, 1100px), 100%);
    margin: 0 0 clamp(28px, 3.5vw, 44px);
    padding: 0 0 var(--hp-glass-pad, 40px) 0;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-sizing: border-box;
  }

  .hp-fam-sec__glass-panel--linked {
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .hp-fam-sec__glass-panel--linked:hover {
    box-shadow: none;
    transform: none;
    opacity: 0.92;
  }

  .hp-fam-sec__glass-panel--linked .hp-fam-sec__glass-link {
    position: relative;
    z-index: 1;
  }

  .hp-fam-sec__glass-col {
    min-width: 0;
  }

  .hp-fam-sec__glass-eyebrow {
    margin: 0 0 16px;
    font-family: 'Inter', sans-serif !important;
    font-size: 15px !important;
    font-weight: 300 !important;
    font-style: normal !important;
    line-height: 1.35 !important;
    letter-spacing: 0.14em !important;
    text-transform: lowercase !important;
    color: #2ecc71 !important;
  }

  .hp-fam-sec__glass-eyebrow::first-letter {
    text-transform: uppercase !important;
  }

  .hp-fam-sec__glass-title {
    margin: 0 0 var(--hp-glass-title-spacing, 28px) !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 15px !important;
    font-weight: 300 !important;
    font-style: normal !important;
    line-height: 1.3 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    color: #ffffff !important;
  }

  .hp-fam-sec__glass-para {
    margin: 0;
    font-family: 'Inter', sans-serif !important;
    font-size: 15px !important;
    font-weight: 300 !important;
    font-style: normal !important;
    line-height: 1.3 !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    color: #ffffff !important;
  }

  .hp-fam-sec__glass-rule {
    display: block;
    width: 100%;
    height: 0;
    margin: 19px 0;
    padding: 0;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  .hp-fam-sec__glass-col--detail .hp-fam-sec__glass-eyebrow {
    margin-bottom: 12px;
  }

  .hp-fam-sec__glass-link {
    display: inline-block;
    margin: 12px 0 0;
    font-family: 'Inter', sans-serif !important;
    font-size: 15px !important;
    font-weight: 300 !important;
    font-style: normal !important;
    line-height: 1.4 !important;
    letter-spacing: 0.14em !important;
    text-transform: lowercase !important;
    color: #2ecc71 !important;
    text-decoration: none !important;
    border: 1px solid #2ecc71;
    border-radius: 50px;
    padding: 10px 24px;
    transition: all 0.3s ease;
  }

  .hp-fam-sec__glass-link::first-letter {
    text-transform: uppercase !important;
  }

  .hp-fam-sec__glass-link:hover {
    background-color: #2ecc71;
    color: #ffffff !important;
  }

  @media screen and (max-width: 989px) {
    .hp-fam-sec__glass-panel {
      grid-template-columns: 1fr;
      gap: 24px;
      max-width: 100%;
      margin-bottom: 22px;
      padding: 0 0 calc(var(--hp-glass-pad, 40px) * 0.72) 0;
    }

    .hp-fam-sec__glass-title {
      font-size: 13px !important;
      margin-bottom: {{ glass_title_spacing_m }}px !important;
    }

    .hp-fam-sec__glass-para {
      font-size: 13px !important;
    }
  }

  @media screen and (max-width: 749px) {
    .hp-fam-sec__glass-panel {
      gap: 20px;
      margin-bottom: 18px;
      padding: 0 0 calc(var(--hp-glass-pad, 40px) * 0.55) 0;
    }

    .hp-fam-sec__glass-eyebrow {
      margin-bottom: 12px;
      font-size: 14px !important;
    }

    .hp-fam-sec__glass-rule {
      margin: 16px 0;
    }

    .hp-fam-sec__glass-link {
      font-size: 14px !important;
    }
  }

  /* LAYOUT */
  .hp-fam-sec__main-flex {
    width: 100%;
  }

  .hp-fam-sec__slider-left {
    width: 100%;
  }

  /* SLIDERS */
  .hp-fam-sec__slider-wrap {
    position: relative;
    width: 100%;
    margin-top: 10px;
  }

  .hp-fam-sec__slider {
    display: none;
    gap: clamp(20px, 4vw, 40px);
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    padding: 0 0 0 0;
    margin-bottom: 0;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    align-items: flex-end;
  }

  .hp-fam-sec__slider.is-active {
    display: flex;
  }

  .hp-fam-sec__slider:active {
    cursor: grabbing;
  }

  .hp-fam-sec__slider.is-dragging .hp-fam-sec__card {
    pointer-events: none;
    cursor: grabbing;
  }

  .hp-fam-sec__slider::-webkit-scrollbar {
    display: none;
  }

  .hp-fam-sec__slider {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* CARD */
  .hp-fam-sec__card {
    flex: 0 0 clamp(280px, 36vw, 420px);
    background: transparent;
    border: none;
    overflow: visible;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    align-self: flex-end;
    transition: transform 0.3s ease;
    margin: 0;
    padding: 0;
    user-drag: none;
    -webkit-user-drag: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .hp-fam-sec__card:hover {
    transform: translateY(-8px);
  }

  .hp-fam-sec__image {
    width: 100%;
    height: auto;
    max-height: clamp(350px, 55vh, 580px);
    object-fit: contain;
    display: block;
    pointer-events: none;
    margin-bottom: 0;
    user-drag: none;
    -webkit-user-drag: none;
    transform: translateY({{ section.settings.image_offset | default: 0 }}px);
  }

  @media screen and (min-width: 1400px) {
    .hp-fam-sec__image {
      max-height: clamp(420px, 58vh, 720px);
    }

    .hp-fam-sec__card {
      flex: 0 0 clamp(300px, 28vw, 460px);
    }
  }

  @media screen and (min-width: 1800px) {
    .hp-fam-sec__image {
      max-height: clamp(480px, 62vh, 820px);
    }
  }

  /* PREMIUM FLOATING RAIL */
  .premium-floating-rail {
    position: absolute;
    right: max(16px, calc((100% - var(--site-max-width, 1320px)) / 2 + 8px));
    top: 0;
    bottom: 0;
    width: min(340px, 28vw);
    max-width: 360px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  @media screen and (min-width: 1200px) and (max-width: 1399px) {
    #shopify-section-{{ section.id }} {
      --hp-fam-rail-width: 300px;
      --hp-fam-rail-clearance: calc(var(--hp-fam-rail-width) + var(--hp-fam-rail-gap));
    }

    .premium-floating-rail {
      right: 16px;
      width: 300px;
    }

    body.template-index #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__container,
    #shopify-section-{{ section.id }} .hp-fam-sec__container {
      padding-right: max(var(--homepage-section-gutter-right, var(--homepage-section-gutter, 48px)), 340px) !important;
    }

    body.template-index #MainContent #shopify-section-{{ section.id }} .hp-fam-sec--has-glass .hp-fam-sec__container,
    #shopify-section-{{ section.id }} .hp-fam-sec--has-glass .hp-fam-sec__container {
      padding-right: max(var(--homepage-section-gutter-right, var(--homepage-section-gutter, 48px)), var(--hp-fam-rail-clearance, 372px)) !important;
    }
  }

  .rail-mask {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    pointer-events: auto;
  }

  .rail-mask::-webkit-scrollbar {
    display: none;
  }

  .rail-track {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 100px 0;
    will-change: transform;
  }

  .rail-card {
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: var(--homepage-corner, 20px);
    padding: 0;
    width: 100%;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    overflow: hidden;
    position: relative;
  }

  .rail-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
  }

  .rail-card-img {
    width: 100%;
    height: 240px;
    background: #ffffff;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rail-card-img img {
    width: 90%;
    height: 90%;
    object-fit: contain;
    background: #ffffff;
    transition: transform 0.6s ease;
  }

  .rail-badge-bestseller {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #e5533d;
    color: #fff;
    padding: 6px 12px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    z-index: 2;
  }

  .rail-card-info {
    padding: 20px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rail-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .rail-rating-badge {
    background: #2ecc71;
    color: #000;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .rail-rating-count {
    color: #666;
    font-size: 13px;
    font-weight: 600;
  }

  .rail-card-title {
    color: #111111;
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    line-height: 1.2;
    font-family: var(--font-family-sans);
  }

  .rail-subtitle {
    color: #888;
    font-size: 14px;
    font-weight: 600;
    margin: 0;
  }

  .rail-elite-care {
    color: #111;
    font-size: 14px;
    font-weight: 700;
    margin: 4px 0;
  }

  .rail-price-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 8px 0;
  }

  .rail-price-compare {
    color: #bbb;
    text-decoration: line-through;
    font-size: 14px;
    font-weight: 600;
  }

  .rail-price-current {
    color: #111;
    font-size: 24px;
    font-weight: 800;
  }

  .rail-card-atc {
    background: #000;
    color: #fff;
    border: none;
    width: 100%;
    padding: 16px;
    border-radius: var(--homepage-corner, 20px);
    font-size: 16px;
    font-weight: 800;
    text-transform: none;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s;
    margin-top: 8px;
  }

  .rail-card-atc:hover {
    background: #333;
    transform: scale(1.02);
  }

  /* Mobile / tablet: horizontal product cards (desktop 1200px+ unchanged) */
  .hp-fam-sec__mobile-rail-wrap {
    display: none;
    width: 100%;
    position: relative;
  }

  .hp-fam-sec__mobile-nav {
    display: none;
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    z-index: 5;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.95);
    color: #111;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .hp-fam-sec__mobile-nav svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .hp-fam-sec__mobile-nav--prev {
    left: 4px;
  }

  .hp-fam-sec__mobile-nav--next {
    right: 4px;
  }

  .hp-fam-sec__mobile-slider {
    display: none;
    --hp-fam-card-gap: 12px;
    gap: var(--hp-fam-card-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    overscroll-behavior-y: auto;
    padding: 4px max(16px, var(--homepage-section-gutter, 16px)) 12px;
    padding-right: max(16px, var(--homepage-section-gutter, 16px));
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .hp-fam-sec__mobile-slider.is-active {
    display: flex;
  }

  .hp-fam-sec__mobile-slider::-webkit-scrollbar {
    display: none;
  }

  .hp-fam-sec__mobile-slider:active {
    cursor: grabbing;
  }

  .hp-fam-sec__mobile-slider.is-dragging .rail-card {
    pointer-events: none;
  }

  /* One inset product card at a time on mobile/tablet — not edge-to-edge oversized */
  .hp-fam-sec__mobile-slider .rail-card {
    flex: 0 0 min(86vw, 340px);
    width: min(86vw, 340px);
    min-width: min(86vw, 340px);
    max-width: min(86vw, 340px);
    scroll-snap-align: center;
    scroll-snap-stop: always;
    box-sizing: border-box;
  }

  .hp-fam-sec__mobile-slider .rail-card-img {
    height: 180px;
    background: #ffffff !important;
  }

  .hp-fam-sec__mobile-slider .rail-card-title {
    font-size: 18px;
  }

  .hp-fam-sec__mobile-slider .rail-rating-badge {
    font-size: 12px;
    padding: 3px 8px;
  }

  .hp-fam-sec__mobile-slider .rail-rating-count {
    font-size: 12px;
  }

  .hp-fam-sec__mobile-slider .rail-price-current {
    font-size: 22px;
  }

  .hp-fam-sec__mobile-slider .rail-card-atc {
    padding: 14px;
    font-size: 14px;
  }

  @media screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} {
      background: {{ section.settings.bg_color | default: '#ff1e43' }} !important;
    }

    .hp-fam-sec__slider-left--desktop {
      display: none !important;
    }

    .hp-fam-sec__mobile-rail-wrap {
      display: block;
      padding-bottom: 0 !important;
      width: 100%;
      overflow: visible;
    }

    .hp-fam-sec__mobile-nav {
      display: inline-flex;
    }

    .premium-floating-rail {
      display: none !important;
    }
  }

  @media screen and (min-width: 1200px) {
    .hp-fam-sec__mobile-rail-wrap {
      display: none !important;
    }
  }

  @media screen and (max-width: 749px) {
    .hp-fam-sec {
      padding: 28px 0 24px;
      min-height: 0;
      display: block;
      box-sizing: border-box;
    }

    .hp-fam-sec__container {
      padding: 0 var(--homepage-section-gutter, 6px);
      min-height: 0;
      display: block;
    }

    .hp-fam-sec__main-flex {
      min-height: 0;
      display: block;
    }

    .hp-fam-sec__heading {
      margin-bottom: 8px !important;
      font-size: var(--hp-bs-mobile-heading-size, {{ hp_heading_mobile }}px) !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 4px !important;
      row-gap: 4px !important;
      line-height: 1.05 !important;
      letter-spacing: 0.03em !important;
      white-space: normal !important;
    }

    #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading > .hp-heading-line--1,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading > .hp-heading-line--1 {
      display: block !important;
      width: auto !important;
      white-space: nowrap !important;
    }

    #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: baseline !important;
      white-space: nowrap !important;
      gap: 6px !important;
      row-gap: 0 !important;
      max-width: 100% !important;
    }

    #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack .hp-heading-line,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack .hp-heading-line,
    #MainContent #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack .hp-heading-accent,
    #shopify-section-{{ section.id }} .hp-fam-sec__heading .hp-heading-pair--stack .hp-heading-accent {
      display: inline !important;
      width: auto !important;
      white-space: nowrap !important;
      margin-left: 0 !important;
      vertical-align: baseline !important;
    }

    .hp-fam-sec__tabs {
      display: none !important;
    }

    .hp-fam-sec__mobile-rail-wrap {
      margin-right: 0;
      padding-bottom: 0 !important;
      margin-top: 0;
      overflow: hidden;
      flex: 0 0 auto;
      min-height: 360px;
      height: auto;
      display: block;
      position: relative;
    }

    .hp-fam-sec__mobile-slider.is-active {
      display: flex;
    }

    .hp-fam-sec__mobile-slider {
      --hp-fam-card-gap: 0px;
      gap: 0;
      padding: 0 !important;
      scroll-snap-type: x mandatory;
      overflow-x: auto;
      overflow-y: hidden;
      align-items: stretch;
      flex: 0 0 auto;
      min-height: 360px;
      height: auto;
      max-height: none;
    }

    .hp-fam-sec__mobile-slider .rail-card {
      height: auto;
      min-height: 0;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
      max-width: 100%;
      padding: 0 max(16px, var(--homepage-section-gutter, 16px));
      box-sizing: border-box;
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }

    .hp-fam-sec__mobile-slider .rail-card-img {
      flex: 0 0 auto;
      height: 200px;
      min-height: 200px;
      max-height: 200px;
    }

    .hp-fam-sec__mobile-slider .rail-card-info {
      flex: 0 0 auto;
      padding: 14px 16px 16px;
      gap: 6px;
    }

    .hp-fam-sec__mobile-slider .rail-rating-row {
      margin-bottom: 0;
    }

    .hp-fam-sec__mobile-slider .rail-elite-care {
      display: none;
    }

    .hp-fam-sec__mobile-slider .rail-price-row {
      margin: 4px 0 0;
    }

    .hp-fam-sec__mobile-slider .rail-card-atc {
      margin-top: 4px;
      padding: 12px;
    }

    .hp-fam-sec__mobile-nav {
      top: 42%;
    }

    #shopify-section-{{ section.id }} .hp-fam-sec__mobile-slider .rail-card,
    .hp-fam-sec__mobile-slider .rail-card {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
      max-width: 100%;
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }

    .hp-fam-sec__mobile-nav {
      width: 36px;
      height: 36px;
      z-index: 10;
    }

    .hp-fam-sec__mobile-nav--prev {
      left: 4px;
    }

    .hp-fam-sec__mobile-nav--next {
      right: 4px;
      z-index: 10;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-fam-sec__mobile-slider {
      scroll-behavior: auto;
    }
  }

  .hp-fam-sec__video-bg {
    position: absolute;
    /* Bleed past edges to kill subpixel/hairline gaps */
    top: -2px;
    right: -2px;
    bottom: -2px;
    left: -2px;
    width: auto;
    height: auto;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
    opacity: calc({{ section.settings.video_opacity | default: 100 }} / 100);
  }
  .hp-fam-sec__video-bg video,
  .hp-fam-sec__video-bg .hp-fam-sec__video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    transform: translate(-50%, -50%);
    object-fit: cover;
    object-position: center center;
    z-index: 1;
  }
  .hp-fam-sec__video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, 
      {{ section.settings.bg_color | default: '#ff1e43' | color_modify: 'alpha', 0.4 }} 0%, 
      {{ section.settings.bg_color_bottom | default: '#000000' | color_modify: 'alpha', 0.85 }} 85%
    );
    z-index: 2;
    pointer-events: none;
    opacity: calc({{ section.settings.overlay_opacity | default: 100 }} / 100);
  }
{%- endstyle -%}

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

{%- liquid
  assign rail_collection_handle = section.settings.rail_collection
  if rail_collection_handle != blank
    assign default_rail_products = collections[rail_collection_handle].products
  else
    assign default_rail_products = collections.all.products
  endif
-%}

<div class="hp-fam-sec{% if section.settings.show_glass_panel %} hp-fam-sec--has-glass{% endif %}" id="fam-{{ section.id }}">
  {%- if section.settings.enable_video_bg -%}
    <div class="hp-fam-sec__video-bg">
      {%- if section.settings.video_bg != blank -%}
        {{ section.settings.video_bg | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false }}
      {%- elsif section.settings.video_bg_filename != blank -%}
        <video autoplay loop muted playsinline preload="auto" class="hp-fam-sec__video">
          <source src="{{ section.settings.video_bg_filename | asset_url }}" type="video/mp4">
        </video>
      {%- endif -%}
      <div class="hp-fam-sec__video-overlay"></div>
    </div>
  {%- endif -%}
  <div class="hp-fam-sec__container">
    {%- if section.settings.heading != blank -%}
      {%- liquid
        assign hp_h1 = section.settings.heading | strip
        assign hp_h2 = section.settings.heading_line2 | default: 'Premium' | strip
        assign hp_accent_text = section.settings.heading_accent_word | default: 'Best' | strip

        if hp_h2 != blank
          assign hp_tail_phrase = hp_h2 | append: ' ' | append: hp_accent_text
          if hp_h1 contains hp_tail_phrase
            assign hp_h1 = hp_h1 | replace: hp_tail_phrase, '' | strip
          elsif hp_h1 contains hp_h2
            assign hp_h1 = hp_h1 | replace: hp_h2, '' | strip
            if hp_accent_text != blank and hp_h1 contains hp_accent_text
              assign hp_h1 = hp_h1 | replace: hp_accent_text, '' | strip
            endif
          elsif hp_accent_text != blank and hp_h1 contains hp_accent_text
            assign hp_h1 = hp_h1 | replace: hp_accent_text, '' | strip
          endif
        endif
      -%}
      <h2 class="hp-fam-sec__heading" data-no-typewriter>
        <span class="hp-heading-line hp-heading-line--1">{{ hp_h1 }}</span>
        <span class="hp-heading-pair hp-heading-pair--stack" style="gap: 8px !important;">
          <span class="hp-heading-line hp-heading-line--2" style="font-family: 'Inter', sans-serif !important; font-weight: 300 !important; font-style: italic !important; color: #c8c8c8 !important;">{{ hp_h2 | strip }}</span>
          <span class="hp-heading-accent" style="font-family: 'Inter', sans-serif !important; font-weight: 300 !important; font-style: italic !important; color: #c8c8c8 !important; -webkit-text-fill-color: #c8c8c8 !important; text-transform: none !important;">{{ hp_accent_text | strip }}</span>
        </span>
      </h2>
    {%- endif -%}

    {%- if section.settings.show_glass_panel -%}
      <div
        class="hp-fam-sec__glass-panel{% if section.settings.glass_link_url != blank %} hp-fam-sec__glass-panel--linked{% endif %}"
        id="hp-glass-panel-{{ section.id }}"
        {% if section.settings.glass_link_url != blank %}
          data-hp-glass-link="{{ section.settings.glass_link_url }}"
          role="link"
          tabindex="0"
        {% endif %}
      >
        {%- if section.settings.glass_eyebrow_left != blank or section.settings.glass_title != blank -%}
          <div class="hp-fam-sec__glass-col hp-fam-sec__glass-col--intro">
            {%- if section.settings.glass_eyebrow_left != blank -%}
              <p class="hp-fam-sec__glass-eyebrow">{{ section.settings.glass_eyebrow_left }}</p>
            {%- endif -%}
            {%- if section.settings.glass_title != blank -%}
              <h3 class="hp-fam-sec__glass-title">{{ section.settings.glass_title }}</h3>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="hp-fam-sec__glass-col hp-fam-sec__glass-col--detail">
          {%- if section.settings.glass_para_top != blank -%}
            <p class="hp-fam-sec__glass-para">{{ section.settings.glass_para_top }}</p>
          {%- endif -%}
          <span class="hp-fam-sec__glass-rule" aria-hidden="true"></span>
          {%- if section.settings.glass_eyebrow_right != blank -%}
            <p class="hp-fam-sec__glass-eyebrow" style="color: #2ecc71 !important;">{{ section.settings.glass_eyebrow_right }}</p>
          {%- endif -%}
          {%- if section.settings.glass_para_bottom != blank -%}
            <p class="hp-fam-sec__glass-para">{{ section.settings.glass_para_bottom }}</p>
          {%- endif -%}
          <span class="hp-fam-sec__glass-rule" aria-hidden="true"></span>
          {%- if section.settings.glass_link_label != blank -%}
            <a
              class="hp-fam-sec__glass-link"
              href="{{ section.settings.glass_link_url | default: '#' }}"
              style="color: #2ecc71 !important;"
            >
              {{ section.settings.glass_link_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="hp-fam-sec__tabs">
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' or block.type == 'custom_images' -%}
            <button
              class="hp-fam-sec__tab {% if forloop.first %}is-active{% endif %}"
              data-target="slider-{{ block.id }}"
              data-mobile-target="mobile-slider-{{ block.id }}"
            >
              {%- if block.type == 'collection' -%}
                {%- assign collection = block.settings.collection -%}
                {{ block.settings.title | default: collection.title | default: 'Collection' }}
              {%- else -%}
                {{ block.settings.title | default: 'Custom' }}
              {%- endif -%}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="hp-fam-sec__main-flex">
      <div class="hp-fam-sec__slider-left hp-fam-sec__slider-left--desktop">
        <div class="hp-fam-sec__slider-wrap">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'collection' or block.type == 'custom_images' -%}
                <div class="hp-fam-sec__slider {% if forloop.first %}is-active{% endif %}" id="slider-{{ block.id }}">
                  
                  {%- if block.type == 'custom_images' -%}
                    {%- for i in (1..6) -%}
                      {%- capture img_id -%}image_{{ i }}{%- endcapture -%}
                      {%- capture url_id -%}url_{{ i }}{%- endcapture -%}
                      {%- if block.settings[img_id] != blank -%}
                        <a href="{{ block.settings[url_id] | default: '#' }}" class="hp-fam-sec__card">
                          <img src="{{ block.settings[img_id] | image_url: width: 800 }}"
                                alt="Product"
                                class="hp-fam-sec__image"
                                loading="lazy"
                                draggable="false">
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- elsif block.type == 'collection' -%}
                    {%- assign collection = block.settings.collection -%}
                    {%- if collection != blank and collection.products.size > 0 -%}
                      {%- for product in collection.products limit: section.settings.products_to_show -%}
                        <a href="{{ product.url }}" class="hp-fam-sec__card">
                          {%- if product.featured_media != blank -%}
                            <img src="{{ product.featured_media | image_url: width: 800 }}"
                                 alt="{{ product.title | escape }}"
                                 class="hp-fam-sec__image"
                                 loading="lazy"
                                 draggable="false">
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'hp-fam-sec__image' }}
                          {%- endif -%}
                        </a>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for i in (1..4) -%}
                        <div class="hp-fam-sec__card">
                          {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                          {{ 'product-' | append: current | placeholder_svg_tag: 'hp-fam-sec__image' }}
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div class="hp-fam-sec__slider is-active">
              {%- for i in (1..4) -%}
                <div class="hp-fam-sec__card">
                  {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                  {{ 'product-' | append: current | placeholder_svg_tag: 'hp-fam-sec__image' }}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} MOBILE: one product at a time + chevrons {%- endcomment -%}
      <div class="hp-fam-sec__mobile-rail-wrap" data-hp-mobile-carousel>
        <button type="button" class="hp-fam-sec__mobile-nav hp-fam-sec__mobile-nav--prev" data-hp-mobile-prev aria-label="Previous product">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="hp-fam-sec__mobile-nav hp-fam-sec__mobile-nav--next" data-hp-mobile-next aria-label="Next product">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' or block.type == 'custom_images' -%}
              <div class="hp-fam-sec__mobile-slider {% if forloop.first %}is-active{% endif %}" id="mobile-slider-{{ block.id }}">
                {%- if block.type == 'collection' -%}
                  {%- assign tab_collection = block.settings.collection -%}
                  {%- if tab_collection != blank and tab_collection.products.size > 0 -%}
                    {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
                      {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
                    {%- endfor -%}
                  {%- else -%}
                    {%- for product in default_rail_products limit: section.settings.products_to_show -%}
                      {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
                    {%- endfor -%}
                  {%- endif -%}
                {%- else -%}
                  {%- for product in default_rail_products limit: section.settings.products_to_show -%}
                    {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
                  {%- endfor -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="hp-fam-sec__mobile-slider is-active" id="mobile-slider-default-{{ section.id }}">
            {%- for product in default_rail_products limit: section.settings.products_to_show -%}
              {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} FLOATING RAIL LAYER (desktop only) {%- endcomment -%}
  <div class="premium-floating-rail">
    <div class="rail-mask">
      <div class="rail-track" id="railTrack-{{ section.id }}">
        {%- for product in default_rail_products limit: 10 -%}
          {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const section = document.getElementById('fam-{{ section.id }}');
    if (!section) return;

    const bgVideo = section.querySelector('.hp-fam-sec__video-bg video');
    if (bgVideo) {
      bgVideo.muted = true;
      bgVideo.setAttribute('playsinline', '');
      const tryPlay = function() {
        const playPromise = bgVideo.play();
        if (playPromise && typeof playPromise.catch === 'function') {
          playPromise.catch(function() {});
        }
      };
      tryPlay();
      bgVideo.addEventListener('loadeddata', tryPlay, { once: true });
      document.addEventListener('visibilitychange', function() {
        if (!document.hidden) tryPlay();
      });
    }

    const glassPanel = section.querySelector('.hp-fam-sec__glass-panel--linked[data-hp-glass-link]');
    if (glassPanel) {
      const glassUrl = glassPanel.getAttribute('data-hp-glass-link');
      const goToScience = function(event) {
        if (event.target.closest('a')) return;
        if (glassUrl) window.location.href = glassUrl;
      };
      glassPanel.addEventListener('click', goToScience);
      glassPanel.addEventListener('keydown', function(event) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          if (glassUrl) window.location.href = glassUrl;
        }
      });
    }

    const tabs = section.querySelectorAll('.hp-fam-sec__tab');
    const sliders = section.querySelectorAll('.hp-fam-sec__slider');
    const mobileSliders = section.querySelectorAll('.hp-fam-sec__mobile-slider');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('is-active'));
        sliders.forEach(s => s.classList.remove('is-active'));
        mobileSliders.forEach(s => s.classList.remove('is-active'));
        tab.classList.add('is-active');

        const targetSlider = section.querySelector(`#${tab.getAttribute('data-target')}`);
        if (targetSlider) targetSlider.classList.add('is-active');

        const mobileTarget = tab.getAttribute('data-mobile-target');
        if (mobileTarget) {
          const targetMobile = section.querySelector(`#${mobileTarget}`);
          if (targetMobile) targetMobile.classList.add('is-active');
        }
      });
    });

    function bindHorizontalDrag(slider, desktopOnly) {
      if (desktopOnly && window.matchMedia('(max-width: 1199px)').matches) return;

      let isDown = false;
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let scrollLeft = 0;
      let activePointerId = null;

      function endDrag() {
        isDown = false;
        isDragging = false;
        activePointerId = null;
        slider.style.scrollBehavior = 'smooth';
        slider.classList.remove('is-dragging');
      }

      slider.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        if (e.pointerType === 'touch') return;
        isDown = true;
        isDragging = false;
        activePointerId = e.pointerId;
        startX = e.pageX;
        startY = e.pageY;
        scrollLeft = slider.scrollLeft;
      });

      slider.addEventListener('pointerup', (e) => {
        if (activePointerId !== e.pointerId) return;
        if (isDragging) slider.releasePointerCapture(e.pointerId);
        endDrag();
      });

      slider.addEventListener('pointercancel', (e) => {
        if (activePointerId !== e.pointerId) return;
        if (isDragging) slider.releasePointerCapture(e.pointerId);
        endDrag();
      });

      slider.addEventListener('pointermove', (e) => {
        if (!isDown || activePointerId !== e.pointerId) return;

        const dx = e.pageX - startX;
        const dy = e.pageY - startY;

        if (!isDragging) {
          if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
          if (Math.abs(dy) > Math.abs(dx)) {
            endDrag();
            return;
          }
          isDragging = true;
          slider.style.scrollBehavior = 'auto';
          slider.classList.add('is-dragging');
          slider.setPointerCapture(e.pointerId);
        }

        e.preventDefault();
        slider.scrollLeft = scrollLeft - dx * 1.5;
      });
    }

    sliders.forEach((slider) => bindHorizontalDrag(slider, false));
    mobileSliders.forEach((slider) => bindHorizontalDrag(slider, true));

    /* Mobile carousel: one card, chevrons, 3s auto-rotate + manual swipe */
    (function initMobileCarousel() {
      const wrap = section.querySelector('[data-hp-mobile-carousel]');
      if (!wrap) return;

      const prevBtn = wrap.querySelector('[data-hp-mobile-prev]');
      const nextBtn = wrap.querySelector('[data-hp-mobile-next]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobileLayout = function() {
        return window.matchMedia('(max-width: 1199px)').matches;
      };

      function getActiveSlider() {
        return wrap.querySelector('.hp-fam-sec__mobile-slider.is-active') || wrap.querySelector('.hp-fam-sec__mobile-slider');
      }

      function getCards(slider) {
        return slider ? Array.prototype.slice.call(slider.querySelectorAll('.rail-card')) : [];
      }

      function getIndex(slider) {
        const cards = getCards(slider);
        if (!cards.length) return 0;
        const left = slider.scrollLeft;
        let best = 0;
        let bestDist = Infinity;
        cards.forEach(function(card, i) {
          const dist = Math.abs(card.offsetLeft - left);
          if (dist < bestDist) {
            bestDist = dist;
            best = i;
          }
        });
        return best;
      }

      function goTo(slider, index, behavior) {
        const cards = getCards(slider);
        if (!cards.length) return;
        const i = ((index % cards.length) + cards.length) % cards.length;
        const card = cards[i];
        if (!card) return;
        slider.scrollTo({ left: card.offsetLeft, behavior: behavior || 'smooth' });
      }

      function step(dir) {
        const slider = getActiveSlider();
        if (!slider) return;
        goTo(slider, getIndex(slider) + dir, 'smooth');
        bumpAuto();
      }

      let autoTimer = null;

      function stopAuto() {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      function startAuto() {
        stopAuto();
        if (reduceMotion || !isMobileLayout()) return;
        autoTimer = setInterval(function() {
          const slider = getActiveSlider();
          if (!slider || document.hidden) return;
          goTo(slider, getIndex(slider) + 1, 'smooth');
        }, 3000);
      }

      function bumpAuto() {
        stopAuto();
        startAuto();
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          step(-1);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          step(1);
        });
      }

      mobileSliders.forEach(function(slider) {
        slider.addEventListener('pointerdown', function() { bumpAuto(); }, { passive: true });
        slider.addEventListener('touchstart', function() { bumpAuto(); }, { passive: true });
        slider.addEventListener('scroll', function() {
          /* keep auto running; user swipe just resets cadence via touch */
        }, { passive: true });
      });

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          bumpAuto();
        });
      });

      document.addEventListener('visibilitychange', function() {
        if (document.hidden) stopAuto();
        else startAuto();
      });

      window.addEventListener('resize', function() {
        if (isMobileLayout()) startAuto();
        else stopAuto();
      }, { passive: true });

      startAuto();
    })();
  })();
</script>


