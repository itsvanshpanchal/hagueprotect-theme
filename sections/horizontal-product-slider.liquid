{%- style -%}
  {% render 'section-typography-vars', section: section %}


  #shopify-section-{{ section.id }} {
    background: linear-gradient(to bottom, {{ section.settings.bg_color | default: '#ff1e43' }} 76%, {{ section.settings.bg_color_bottom | default: '#000000' }} 76%);
    position: relative;
    overflow-x: hidden;
    overflow-x: clip;
    max-width: 100%;
  }

  .hp-fam-sec {
    position: relative;
    padding: 0;
    margin: 0;
    width: 100%;
    box-sizing: border-box;
    overflow: visible;
  }

  /* Pinned animation stage — ~100vh visible, heading static, slides clip inside */
  #shopify-section-{{ section.id }} .hp-fam-stage {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    max-height: 100vh;
    max-height: 100dvh;
    box-sizing: border-box;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4.5vw, 48px) 0 0 0;
  }

  #shopify-section-{{ section.id }} .hp-fam-stage__layout {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .hp-fam-stage__static {
    position: relative;
    z-index: 5;
    flex: 0 0 auto;
    width: 100%;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .hp-fam-stage__viewport {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    touch-action: pan-y;
  }

  #shopify-section-{{ section.id }} .hp-fam-sec__main-flex {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .hp-fam-sec__slider-left,
  #shopify-section-{{ section.id }} .hp-fam-sec__slider-wrap,
  #shopify-section-{{ section.id }} .hp-fam-sec__mobile-rail-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Avoid nested scroll fighting the pinned scrub animation */
  #shopify-section-{{ section.id }} .rail-mask {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack__panel {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack__panel.is-active {
    display: block;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: transform;
    background-color: {{ section.settings.bg_color | default: '#ff1e43' }};
  }

  #shopify-section-{{ section.id }} .hp-fam-stack__slide--1 {
    z-index: 1;
    transform: translate3d(0, 0, 0);
  }

  #shopify-section-{{ section.id }} .hp-fam-stack__slide--2 {
    z-index: 2;
    transform: translate3d(0, 100%, 0);
  }

  #shopify-section-{{ section.id }} .hp-fam-stack__row {
    display: flex;
    gap: clamp(20px, 4vw, 40px);
    align-items: flex-end;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--desktop .hp-fam-stack__row .hp-fam-sec__card {
    flex: 1 1 0;
    min-width: 0;
    max-width: clamp(280px, 36vw, 420px);
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .hp-fam-stack__row {
    --hp-fam-card-gap: 12px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hp-fam-card-gap);
    align-items: end;
    align-content: end;
    padding: 4px 0 12px;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .hp-fam-stack__row .rail-card {
    width: 100%;
    max-width: none;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .hp-fam-stack__row:has(.rail-card:only-child) {
    grid-template-columns: minmax(0, 1fr);
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .rail-card-img {
    height: 200px;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .rail-card-title {
    font-size: 18px;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .rail-rating-badge {
    font-size: 12px;
    padding: 3px 8px;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .rail-rating-count {
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .rail-price-current {
    font-size: 22px;
  }

  #shopify-section-{{ section.id }} .hp-fam-stack--mobile .rail-card-atc {
    padding: 14px;
    font-size: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .hp-fam-stage {
      height: auto;
      max-height: none;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .hp-fam-stage__viewport,
    #shopify-section-{{ section.id }} .hp-fam-sec__main-flex,
    #shopify-section-{{ section.id }} .hp-fam-stack,
    #shopify-section-{{ section.id }} .hp-fam-stack__panel.is-active {
      position: relative;
      inset: auto;
      height: auto;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .hp-fam-stack__slide--1,
    #shopify-section-{{ section.id }} .hp-fam-stack__slide--2 {
      position: relative;
      inset: auto;
      height: auto;
      transform: none !important;
    }

    #shopify-section-{{ section.id }} .hp-fam-stack__slide--2 {
      margin-top: 24px;
    }
  }

  .hp-fam-sec__container {
    max-width: var(--site-max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0 var(--homepage-section-gutter, 8px);
    position: relative;
    box-sizing: border-box;
    z-index: 2;
  }

  .hp-fam-sec__heading {
    font-size: var(--section-heading-size);
    font-family: 'Bahnschrift', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
    font-weight: 400 !important;
    font-style: normal !important;
    text-transform: none !important;
    color: #ffffff;
    margin: 0 0 32px 0;
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 700px;
  }

  .hp-fam-sec__heading::first-letter,
  .hp-fam-sec__heading .hp-typewriter-text,
  .hp-fam-sec__heading .hp-typewriter-cursor {
    text-transform: none !important;
  }

  .hp-fam-sec__heading .hp-heading-line {
    display: block;
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    font-style: inherit !important;
    letter-spacing: inherit !important;
    line-height: inherit !important;
    text-transform: none !important;
    color: inherit !important;
  }

  .hp-fam-sec__heading .hp-heading-line--with-accent {
    white-space: normal;
  }

  .hp-fam-sec__heading .hp-heading-pair .hp-heading-line {
    display: inline !important;
  }

  .hp-fam-sec__heading .hp-heading-line--1::first-letter {
    text-transform: none !important;
  }

  .hp-fam-sec__heading .hp-heading-accent {
    display: inline !important;
    font-family: 'Luthon Southard Script', 'Brush Script MT', cursive !important;
    font-weight: var(--font-weight-heading-accent, 400) !important;
    font-style: var(--font-style-heading-accent, normal) !important;
    color: var(--section-heading-accent-color, #c9a227) !important;
    -webkit-text-fill-color: var(--section-heading-accent-color, #c9a227) !important;
    font-size: var(--heading-accent-size, 1.2em) !important;
    text-transform: none !important;
    letter-spacing: 0.01em !important;
  }

  .hp-fam-sec__heading .hp-typewriter-text,
  .hp-fam-sec__heading > span[aria-hidden="true"] {
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    font-style: inherit !important;
    letter-spacing: inherit !important;
    line-height: inherit !important;
    text-transform: none !important;
    color: inherit !important;
  }

  /* CATEGORY TABS */
  .hp-fam-sec__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
    align-items: center;
  }

  .hp-fam-sec__tab {
    background: transparent;
    border: none;
    padding: 10px 20px;
    border-radius: 100px;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-family-sans);
    font-size: var(--section-label-size, 13px);
    font-weight: var(--font-weight-sans, 700);
    font-style: var(--font-style-sans, normal);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    outline: none;
    text-decoration: none;
    display: inline-block;
  }

  .hp-fam-sec__tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  .hp-fam-sec__tab.is-active {
    background: #000000;
    color: #ffffff;
  }

  /* LAYOUT */
  .hp-fam-sec__main-flex {
    width: 100%;
  }

  .hp-fam-sec__slider-left {
    width: 100%;
  }

  /* SLIDERS */
  .hp-fam-sec__slider-wrap {
    position: relative;
    width: 100%;
    margin-top: 10px;
  }

  .hp-fam-sec__slider {
    display: none;
    gap: clamp(20px, 4vw, 40px);
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    padding: 0 0 0 0;
    margin-bottom: 0;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    align-items: flex-end;
  }

  .hp-fam-sec__slider.is-active {
    display: flex;
  }

  .hp-fam-sec__slider:active {
    cursor: grabbing;
  }

  .hp-fam-sec__slider.is-dragging .hp-fam-sec__card {
    pointer-events: none;
    cursor: grabbing;
  }

  .hp-fam-sec__slider::-webkit-scrollbar {
    display: none;
  }

  .hp-fam-sec__slider {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* CARD */
  .hp-fam-sec__card {
    flex: 0 0 clamp(280px, 36vw, 420px);
    background: transparent;
    border: none;
    overflow: visible;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    align-self: flex-end;
    transition: transform 0.3s ease;
    margin: 0;
    padding: 0;
    user-drag: none;
    -webkit-user-drag: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .hp-fam-sec__card:hover {
    transform: translateY(-8px);
  }

  .hp-fam-sec__image {
    width: 100%;
    height: auto;
    max-height: clamp(350px, 55vh, 580px);
    object-fit: contain;
    display: block;
    pointer-events: none;
    margin-bottom: 0;
    user-drag: none;
    -webkit-user-drag: none;
    transform: translateY({{ section.settings.image_offset | default: 0 }}px);
  }

  /* PREMIUM FLOATING RAIL */
  .premium-floating-rail {
    position: absolute;
    right: 40px;
    top: 0;
    bottom: 0;
    width: 340px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }

  .rail-mask {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);
    pointer-events: auto;
  }

  .rail-mask::-webkit-scrollbar {
    display: none;
  }

  .rail-track {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 100px 0;
    will-change: transform;
  }

  .rail-card {
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: var(--homepage-corner, 20px);
    padding: 0;
    width: 100%;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    overflow: hidden;
    position: relative;
  }

  .rail-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0,0,0,0.1);
  }

  .rail-card-img {
    width: 100%;
    height: 240px;
    background: #f5f5f7;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rail-card-img img {
    width: 90%;
    height: 90%;
    object-fit: contain;
    transition: transform 0.6s ease;
  }

  .rail-badge-bestseller {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #e5533d;
    color: #fff;
    padding: 6px 12px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    z-index: 2;
  }

  .rail-card-info {
    padding: 20px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .rail-rating-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .rail-rating-badge {
    background: #2ecc71;
    color: #000;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .rail-rating-count {
    color: #666;
    font-size: 13px;
    font-weight: 600;
  }

  .rail-card-title {
    color: #111111;
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    line-height: 1.2;
    font-family: var(--font-family-sans);
  }

  .rail-subtitle {
    color: #888;
    font-size: 14px;
    font-weight: 600;
    margin: 0;
  }

  .rail-elite-care {
    color: #111;
    font-size: 14px;
    font-weight: 700;
    margin: 4px 0;
  }

  .rail-price-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 8px 0;
  }

  .rail-price-compare {
    color: #bbb;
    text-decoration: line-through;
    font-size: 14px;
    font-weight: 600;
  }

  .rail-price-current {
    color: #111;
    font-size: 24px;
    font-weight: 800;
  }

  .rail-card-atc {
    background: #000;
    color: #fff;
    border: none;
    width: 100%;
    padding: 16px;
    border-radius: var(--homepage-corner, 20px);
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s;
    margin-top: 8px;
  }

  .rail-card-atc:hover {
    background: #333;
    transform: scale(1.02);
  }

  /* Mobile / tablet: horizontal product cards (desktop 1200px+ unchanged) */
  .hp-fam-sec__mobile-rail-wrap {
    display: none;
    width: 100%;
  }

  .hp-fam-sec__mobile-slider {
    display: none;
    --hp-fam-card-gap: 12px;
    gap: var(--hp-fam-card-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    touch-action: auto;
    overscroll-behavior-x: contain;
    overscroll-behavior-y: auto;
    padding: 4px 0 12px;
    padding-right: calc((100% - var(--hp-fam-card-gap)) / 3);
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .hp-fam-sec__mobile-slider.is-active {
    display: flex;
  }

  .hp-fam-sec__mobile-slider::-webkit-scrollbar {
    display: none;
  }

  .hp-fam-sec__mobile-slider:active {
    cursor: grabbing;
  }

  .hp-fam-sec__mobile-slider.is-dragging .rail-card {
    pointer-events: none;
  }

  .hp-fam-sec__mobile-slider .rail-card {
    flex: 0 0 calc((100% - var(--hp-fam-card-gap)) / 1.5);
    min-width: 0;
    max-width: none;
    scroll-snap-align: start;
    scroll-snap-stop: normal;
  }

  .hp-fam-sec__mobile-slider .rail-card-img {
    height: 200px;
  }

  .hp-fam-sec__mobile-slider .rail-card-title {
    font-size: 18px;
  }

  .hp-fam-sec__mobile-slider .rail-rating-badge {
    font-size: 12px;
    padding: 3px 8px;
  }

  .hp-fam-sec__mobile-slider .rail-rating-count {
    font-size: 12px;
  }

  .hp-fam-sec__mobile-slider .rail-price-current {
    font-size: 22px;
  }

  .hp-fam-sec__mobile-slider .rail-card-atc {
    padding: 14px;
    font-size: 14px;
  }

  @media screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} {
      background: {{ section.settings.bg_color | default: '#ff1e43' }} !important;
    }

    .hp-fam-sec__slider-left--desktop {
      display: none !important;
    }

    .hp-fam-sec__mobile-rail-wrap {
      display: block;
      padding-bottom: 0;
      width: 100%;
      overflow: hidden;
    }

    .premium-floating-rail {
      display: none !important;
    }
  }

  @media screen and (min-width: 1200px) {
    .hp-fam-sec__mobile-rail-wrap {
      display: none !important;
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .hp-fam-stage {
      padding: 32px 0 0 0;
    }

    .hp-fam-sec {
      padding: 0;
    }

    .hp-fam-sec__container {
      padding: 0 var(--homepage-section-gutter, 6px);
    }

    .hp-fam-sec__heading {
      margin-bottom: 20px;
      font-size: var(--section-heading-size);
    }

    .hp-fam-sec__tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 6px;
      margin-bottom: 20px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      touch-action: auto;
      overscroll-behavior-x: contain;
      gap: 8px;
      scroll-snap-type: x proximity;
    }

    .hp-fam-sec__tabs::-webkit-scrollbar {
      display: none;
    }

    .hp-fam-sec__tab {
      flex: 0 0 auto;
      padding: 8px 16px;
      font-size: 12px;
      scroll-snap-align: start;
    }

    .hp-fam-sec__mobile-rail-wrap {
      margin-right: calc(-1 * var(--homepage-section-gutter, 6px));
      padding-bottom: 28px;
    }

    .hp-fam-sec__mobile-slider {
      --hp-fam-card-gap: 12px;
      gap: var(--hp-fam-card-gap);
      padding-bottom: 8px;
      padding-right: var(--homepage-section-gutter, 6px);
    }

    .hp-fam-sec__mobile-slider .rail-card {
      flex: 0 0 calc((100% - var(--hp-fam-card-gap)) / 1.5);
      scroll-snap-align: start;
    }
  }

  .hp-fam-sec__video-bg {
    position: absolute;
    /* Bleed 2px past edges to kill subpixel/hairline gaps (esp. left) */
    top: 0;
    right: -2px;
    bottom: 0;
    left: -2px;
    width: auto;
    height: auto;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
    opacity: calc({{ section.settings.video_opacity | default: 100 }} / 100);
  }
  .hp-fam-sec__video-bg video,
  .hp-fam-sec__video-bg .hp-fam-sec__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    transform: none;
    object-fit: cover;
    object-position: center center;
    z-index: 1;
  }
  .hp-fam-sec__video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, 
      {{ section.settings.bg_color | default: '#ff1e43' | color_modify: 'alpha', 0.4 }} 0%, 
      {{ section.settings.bg_color_bottom | default: '#000000' | color_modify: 'alpha', 0.85 }} 85%
    );
    z-index: 2;
    pointer-events: none;
    opacity: calc({{ section.settings.overlay_opacity | default: 100 }} / 100);
  }
{%- endstyle -%}

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

{%- liquid
  assign rail_collection_handle = section.settings.rail_collection
  if rail_collection_handle != blank
    assign default_rail_products = collections[rail_collection_handle].products
  else
    assign default_rail_products = collections.all.products
  endif
-%}

<div class="hp-fam-sec" id="fam-{{ section.id }}">
  <div class="hp-fam-stage" data-hp-fam-stage>
    {%- if section.settings.enable_video_bg -%}
      <div class="hp-fam-sec__video-bg">
        {%- if section.settings.video_bg != blank -%}
          {{ section.settings.video_bg | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false }}
        {%- elsif section.settings.video_bg_filename != blank -%}
          <video autoplay loop muted playsinline preload="auto" class="hp-fam-sec__video">
            <source src="{{ section.settings.video_bg_filename | asset_url }}" type="video/mp4">
          </video>
        {%- endif -%}
        <div class="hp-fam-sec__video-overlay"></div>
      </div>
    {%- endif -%}

    <div class="hp-fam-sec__container hp-fam-stage__layout">
      <div class="hp-fam-stage__static">
        {%- if section.settings.heading != blank -%}
          <h2 class="hp-fam-sec__heading">{% render 'section-heading-text', text: section.settings.heading, line2: section.settings.heading_line2, line2_color: section.settings.heading_line2_color, accent_last_word: true, accent_color: section.settings.heading_accent_color %}</h2>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="hp-fam-sec__tabs">
            {%- for block in section.blocks -%}
              {%- if block.type == 'collection' or block.type == 'custom_images' -%}
                <button
                  class="hp-fam-sec__tab {% if forloop.first %}is-active{% endif %}"
                  type="button"
                  data-target="stack-desktop-{{ block.id }}"
                  data-mobile-target="stack-mobile-{{ block.id }}"
                >
                  {%- if block.type == 'collection' -%}
                    {%- assign collection = block.settings.collection -%}
                    {{ block.settings.title | default: collection.title | default: 'Collection' | upcase }}
                  {%- else -%}
                    {{ block.settings.title | default: 'Custom' | upcase }}
                  {%- endif -%}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="hp-fam-stage__viewport" data-hp-fam-viewport>
        <div class="hp-fam-sec__main-flex">
          {%- comment -%} DESKTOP: two absolute stacked slides {%- endcomment -%}
          <div class="hp-fam-sec__slider-left hp-fam-sec__slider-left--desktop">
            <div class="hp-fam-sec__slider-wrap">
              <div class="hp-fam-stack hp-fam-stack--desktop" data-hp-fam-stack="desktop">
                {%- if section.blocks.size > 0 -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'collection' or block.type == 'custom_images' -%}
                      {%- liquid
                        assign stack_total = 0
                        if block.type == 'custom_images'
                          for i in (1..6)
                            assign img_key = 'image_' | append: i
                            if block.settings[img_key] != blank
                              assign stack_total = stack_total | plus: 1
                            endif
                          endfor
                        else
                          assign collection = block.settings.collection
                          if collection != blank and collection.products.size > 0
                            assign stack_total = collection.products.size
                            if stack_total > section.settings.products_to_show
                              assign stack_total = section.settings.products_to_show
                            endif
                          else
                            assign stack_total = 4
                          endif
                        endif
                        assign slide1_count = stack_total | plus: 1 | divided_by: 2
                        if slide1_count < 1
                          assign slide1_count = 1
                        endif
                      -%}
                      <div
                        class="hp-fam-stack__panel {% if forloop.first %}is-active{% endif %}"
                        id="stack-desktop-{{ block.id }}"
                        {{ block.shopify_attributes }}
                      >
                        <div class="hp-fam-stack__slide hp-fam-stack__slide--1">
                          <div class="hp-fam-stack__row">
                            {%- if block.type == 'custom_images' -%}
                              {%- assign img_idx = 0 -%}
                              {%- for i in (1..6) -%}
                                {%- assign img_key = 'image_' | append: i -%}
                                {%- assign url_key = 'url_' | append: i -%}
                                {%- if block.settings[img_key] != blank -%}
                                  {%- assign img_idx = img_idx | plus: 1 -%}
                                  {%- if img_idx <= slide1_count -%}
                                    <a href="{{ block.settings[url_key] | default: '#' }}" class="hp-fam-sec__card">
                                      <img src="{{ block.settings[img_key] | image_url: width: 800 }}"
                                           alt="Product"
                                           class="hp-fam-sec__image"
                                           loading="lazy"
                                           draggable="false">
                                    </a>
                                  {%- endif -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- elsif block.type == 'collection' -%}
                              {%- assign collection = block.settings.collection -%}
                              {%- if collection != blank and collection.products.size > 0 -%}
                                {%- for product in collection.products limit: slide1_count -%}
                                  <a href="{{ product.url }}" class="hp-fam-sec__card">
                                    {%- if product.featured_media != blank -%}
                                      <img src="{{ product.featured_media | image_url: width: 800 }}"
                                           alt="{{ product.title | escape }}"
                                           class="hp-fam-sec__image"
                                           loading="lazy"
                                           draggable="false">
                                    {%- else -%}
                                      {{ 'product-1' | placeholder_svg_tag: 'hp-fam-sec__image' }}
                                    {%- endif -%}
                                  </a>
                                {%- endfor -%}
                              {%- else -%}
                                {%- for i in (1..slide1_count) -%}
                                  <div class="hp-fam-sec__card">
                                    {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                                    {{ 'product-' | append: current | placeholder_svg_tag: 'hp-fam-sec__image' }}
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}
                            {%- endif -%}
                          </div>
                        </div>
                        <div class="hp-fam-stack__slide hp-fam-stack__slide--2">
                          <div class="hp-fam-stack__row">
                            {%- if block.type == 'custom_images' -%}
                              {%- assign img_idx = 0 -%}
                              {%- for i in (1..6) -%}
                                {%- assign img_key = 'image_' | append: i -%}
                                {%- assign url_key = 'url_' | append: i -%}
                                {%- if block.settings[img_key] != blank -%}
                                  {%- assign img_idx = img_idx | plus: 1 -%}
                                  {%- if img_idx > slide1_count -%}
                                    <a href="{{ block.settings[url_key] | default: '#' }}" class="hp-fam-sec__card">
                                      <img src="{{ block.settings[img_key] | image_url: width: 800 }}"
                                           alt="Product"
                                           class="hp-fam-sec__image"
                                           loading="lazy"
                                           draggable="false">
                                    </a>
                                  {%- endif -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- elsif block.type == 'collection' -%}
                              {%- assign collection = block.settings.collection -%}
                              {%- assign slide2_limit = stack_total | minus: slide1_count -%}
                              {%- if collection != blank and collection.products.size > 0 and slide2_limit > 0 -%}
                                {%- for product in collection.products offset: slide1_count limit: slide2_limit -%}
                                  <a href="{{ product.url }}" class="hp-fam-sec__card">
                                    {%- if product.featured_media != blank -%}
                                      <img src="{{ product.featured_media | image_url: width: 800 }}"
                                           alt="{{ product.title | escape }}"
                                           class="hp-fam-sec__image"
                                           loading="lazy"
                                           draggable="false">
                                    {%- else -%}
                                      {{ 'product-1' | placeholder_svg_tag: 'hp-fam-sec__image' }}
                                    {%- endif -%}
                                  </a>
                                {%- endfor -%}
                              {%- elsif slide2_limit > 0 -%}
                                {%- for i in (1..slide2_limit) -%}
                                  <div class="hp-fam-sec__card">
                                    {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                                    {{ 'product-' | append: current | placeholder_svg_tag: 'hp-fam-sec__image' }}
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- else -%}
                  <div class="hp-fam-stack__panel is-active" id="stack-desktop-default-{{ section.id }}">
                    <div class="hp-fam-stack__slide hp-fam-stack__slide--1">
                      <div class="hp-fam-stack__row">
                        {%- for i in (1..2) -%}
                          <div class="hp-fam-sec__card">
                            {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                            {{ 'product-' | append: current | placeholder_svg_tag: 'hp-fam-sec__image' }}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                    <div class="hp-fam-stack__slide hp-fam-stack__slide--2">
                      <div class="hp-fam-stack__row">
                        {%- for i in (1..2) -%}
                          <div class="hp-fam-sec__card">
                            {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                            {{ 'product-' | append: current | placeholder_svg_tag: 'hp-fam-sec__image' }}
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>

          {%- comment -%} MOBILE: same absolute stack with existing rail cards {%- endcomment -%}
          <div class="hp-fam-sec__mobile-rail-wrap">
            <div class="hp-fam-stack hp-fam-stack--mobile" data-hp-fam-stack="mobile">
              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'collection' or block.type == 'custom_images' -%}
                    {%- liquid
                      assign mobile_products = default_rail_products
                      if block.type == 'collection'
                        assign tab_collection = block.settings.collection
                        if tab_collection != blank and tab_collection.products.size > 0
                          assign mobile_products = tab_collection.products
                        endif
                      endif
                      assign mobile_total = mobile_products.size
                      if mobile_total > section.settings.products_to_show
                        assign mobile_total = section.settings.products_to_show
                      endif
                      if mobile_total > 4
                        assign mobile_total = 4
                      endif
                      assign mobile_slide1 = mobile_total | plus: 1 | divided_by: 2
                      if mobile_slide1 < 1
                        assign mobile_slide1 = 1
                      endif
                      if mobile_slide1 > 2
                        assign mobile_slide1 = 2
                      endif
                      assign mobile_slide2 = mobile_total | minus: mobile_slide1
                      if mobile_slide2 > 2
                        assign mobile_slide2 = 2
                      endif
                    -%}
                    <div
                      class="hp-fam-stack__panel {% if forloop.first %}is-active{% endif %}"
                      id="stack-mobile-{{ block.id }}"
                    >
                      <div class="hp-fam-stack__slide hp-fam-stack__slide--1">
                        <div class="hp-fam-stack__row">
                          {%- for product in mobile_products limit: mobile_slide1 -%}
                            {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
                          {%- endfor -%}
                        </div>
                      </div>
                      <div class="hp-fam-stack__slide hp-fam-stack__slide--2">
                        <div class="hp-fam-stack__row">
                          {%- if mobile_slide2 > 0 -%}
                            {%- for product in mobile_products offset: mobile_slide1 limit: mobile_slide2 -%}
                              {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
                            {%- endfor -%}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- liquid
                  assign mobile_total = default_rail_products.size
                  if mobile_total > section.settings.products_to_show
                    assign mobile_total = section.settings.products_to_show
                  endif
                  if mobile_total > 4
                    assign mobile_total = 4
                  endif
                  assign mobile_slide1 = mobile_total | plus: 1 | divided_by: 2
                  if mobile_slide1 < 1
                    assign mobile_slide1 = 1
                  endif
                  if mobile_slide1 > 2
                    assign mobile_slide1 = 2
                  endif
                  assign mobile_slide2 = mobile_total | minus: mobile_slide1
                  if mobile_slide2 > 2
                    assign mobile_slide2 = 2
                  endif
                -%}
                <div class="hp-fam-stack__panel is-active" id="stack-mobile-default-{{ section.id }}">
                  <div class="hp-fam-stack__slide hp-fam-stack__slide--1">
                    <div class="hp-fam-stack__row">
                      {%- for product in default_rail_products limit: mobile_slide1 -%}
                        {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
                      {%- endfor -%}
                    </div>
                  </div>
                  <div class="hp-fam-stack__slide hp-fam-stack__slide--2">
                    <div class="hp-fam-stack__row">
                      {%- if mobile_slide2 > 0 -%}
                        {%- for product in default_rail_products offset: mobile_slide1 limit: mobile_slide2 -%}
                          {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
                        {%- endfor -%}
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} FLOATING RAIL LAYER (desktop only) — static inside pinned stage {%- endcomment -%}
    <div class="premium-floating-rail">
      <div class="rail-mask">
        <div class="rail-track" id="railTrack-{{ section.id }}">
          {%- for product in default_rail_products limit: 10 -%}
            {% render 'hp-fam-rail-card', product: product, rating_value: section.settings.rating_value, rating_count: section.settings.rating_count %}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const section = document.getElementById('fam-{{ section.id }}');
    if (!section) return;

    const stage = section.querySelector('[data-hp-fam-stage]');
    const STACK_NS = 'hpFamStack-{{ section.id }}';

    const bgVideo = section.querySelector('.hp-fam-sec__video-bg video');
    if (bgVideo) {
      bgVideo.muted = true;
      bgVideo.setAttribute('playsinline', '');
      const tryPlay = function() {
        const playPromise = bgVideo.play();
        if (playPromise && typeof playPromise.catch === 'function') {
          playPromise.catch(function() {});
        }
      };
      tryPlay();
      bgVideo.addEventListener('loadeddata', tryPlay, { once: true });
      document.addEventListener('visibilitychange', function() {
        if (!document.hidden) tryPlay();
      });
    }

    const tabs = section.querySelectorAll('.hp-fam-sec__tab');
    const stackPanels = section.querySelectorAll('.hp-fam-stack__panel');

    function setActivePanels(desktopId, mobileId) {
      stackPanels.forEach(function(panel) {
        const isMatch = panel.id === desktopId || panel.id === mobileId;
        panel.classList.toggle('is-active', isMatch);
      });
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        setActivePanels(tab.getAttribute('data-target'), tab.getAttribute('data-mobile-target'));
        window.requestAnimationFrame(function() {
          initStackScroll(true);
        });
      });
    });

    function prefersReducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function getActiveStack() {
      const isMobile = window.matchMedia('(max-width: 1199px)').matches;
      const root = section.querySelector(
        isMobile ? '.hp-fam-stack--mobile' : '.hp-fam-stack--desktop'
      );
      if (!root) return null;
      const panel = root.querySelector('.hp-fam-stack__panel.is-active') || root.querySelector('.hp-fam-stack__panel');
      if (!panel) return null;
      const slide1 = panel.querySelector('.hp-fam-stack__slide--1');
      const slide2 = panel.querySelector('.hp-fam-stack__slide--2');
      if (!slide1 || !slide2) return null;
      const slide2HasContent = slide2.querySelector('.hp-fam-sec__card, .rail-card');
      if (!slide2HasContent) return null;
      return { root: root, panel: panel, slide1: slide1, slide2: slide2 };
    }

    function killStackScroll() {
      if (typeof ScrollTrigger === 'undefined') return;
      const existing = ScrollTrigger.getById(STACK_NS);
      if (existing) {
        if (existing.animation) existing.animation.kill();
        existing.kill(true);
      }
      if (typeof gsap === 'undefined') return;
      section.querySelectorAll('.hp-fam-stack__slide--2').forEach(function(el) {
        gsap.set(el, { clearProps: 'transform' });
      });
    }

    function initStackScroll(force) {
      if (!stage) return;
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      if (prefersReducedMotion()) {
        killStackScroll();
        return;
      }

      gsap.registerPlugin(ScrollTrigger);
      killStackScroll();

      const stack = getActiveStack();
      if (!stack) return;

      // Slide 1 stays frozen underneath. Only Slide 2 moves.
      gsap.set(stack.slide2, { yPercent: 100, force3D: true });

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          id: STACK_NS,
          trigger: stage,
          start: 'top top',
          end: function() {
            // ~175vh scrub distance + brief hold (~15vh)
            return '+=' + Math.round(window.innerHeight * 1.9);
          },
          pin: true,
          pinSpacing: true,
          scrub: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          fastScrollEnd: true,
          preventOverlaps: true
        }
      });

      // Overlay only: Slide 2 travels from below (100%) to cover Slide 1 (0%)
      tl.to(stack.slide2, {
        yPercent: 0,
        ease: 'none',
        duration: 1,
        force3D: true
      }, 0);
      // Brief hold at fully covered state before unpin
      tl.to({}, { duration: 0.08 });

      if (force) ScrollTrigger.refresh();
    }

    function boot() {
      initStackScroll(false);
      if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    window.addEventListener('load', function() {
      if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
    });

    let resizeTimer = null;
    window.addEventListener('resize', function() {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(function() {
        initStackScroll(true);
      }, 180);
    });

    document.addEventListener('shopify:section:load', function(event) {
      if (!event.target || !event.target.contains(section)) return;
      initStackScroll(true);
    });
  })();
</script>


{% schema %}
{
  "name": "Horizontal Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Our Premium Best"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading — second line",
      "info": "Optional. Shown under the main heading in a different color (sentence case)."
