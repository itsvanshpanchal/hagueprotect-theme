{%- liquid
  assign hero_label_desktop = section.settings.eyebrow_font_size_desktop | default: settings.font_eyebrow_size_desktop | default: 18
  assign hero_label_mobile = section.settings.eyebrow_font_size_mobile | default: settings.font_eyebrow_size_mobile | default: 17
-%}
{%- style -%}
  {% render 'section-typography-vars', section: section %}

  .hero-bottom-tiles-wrapper {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 0 40px 80px;
    z-index: 10;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero-bottom-tiles-heading {
    font-family: var(--font-family-sans);
    font-size: 11px;
    font-weight: 500;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0;
  }
  .hero-bottom-tiles-grid {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-bottom-tile {
    display: flex;
    align-items: center;
    background: #000000;
    padding: 12px;
    gap: 15px;
    flex: 0 0 auto;
    width: 300px;
    line-height: 1.3;
  }
  .hero-bottom-tile__image-wrapper {
    width: 70px;
    height: 70px;
    flex-shrink: 0;
    background: #fff;
    border-radius: 2px;
    overflow: hidden;
  }
  .hero-bottom-tile__image-wrapper svg {
    width: 100%;
    height: 100%;
    fill: #ccc;
  }
  .hero-bottom-tile__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hero-bottom-tile__title {
    font-family: var(--font-family-sans);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.02em;
    line-height: 1.2;
    transition: opacity 0.2s;
  }
  .hero-bottom-tile__title:hover {
    opacity: 0.8;
  }
  .hero-bottom-tile__subtitle {
    font-family: var(--font-family-sans);
    font-size: 12px;
    font-weight: 400;
    color: #a0a0a0;
    margin: 0;
    line-height: 1.3;
  }
  @media screen and (max-width: 768px) {
    .hero-bottom-tiles-wrapper {
      display: none;
      padding: 0 20px 60px;
    }
    .hero-bottom-tiles-grid {
      flex-direction: column;
    }
  }

  /* Hero heading — Poppins Light, tight lines, large — matches inspiration */
  #MainContent #shopify-section-{{ section.id }} h1.hero-fullscreen__heading,
  #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading,
  #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading .hp-typewriter-text,
  #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading > span[aria-hidden="true"],
  #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading .hero-heading-line,
  #shopify-section-{{ section.id }} h1.hero-fullscreen__heading,
  #shopify-section-{{ section.id }} .hero-fullscreen__heading,
  #shopify-section-{{ section.id }} .hero-fullscreen__heading .hp-typewriter-text,
  #shopify-section-{{ section.id }} .hero-fullscreen__heading > span[aria-hidden="true"],
  #shopify-section-{{ section.id }} .hero-fullscreen__heading .hero-heading-line {

    line-height: 0.93 !important;
    letter-spacing: -0.02em !important;
    color: #ffffff !important;
  }

  /* Line 3 override — italic + grey, must come after the rule above */
  #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading .hero-heading-line--3,
  #shopify-section-{{ section.id }} .hero-fullscreen__heading .hero-heading-line--3 {
    font-style: italic !important;
    color: #b0b0b0 !important;
    font-weight: 300 !important;
  }

  /* Tagline (FROM BEAT TO HEAT) — Darker Grotesque Regular; stroke on mobile only */
  #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__subheading,
  #shopify-section-{{ section.id }} .hero-fullscreen__subheading,
  #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__eyebrow,
  #shopify-section-{{ section.id }} .hero-fullscreen__eyebrow {
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: {{ hero_label_desktop }}px !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-synthesis: none !important;
    -webkit-text-stroke: 0 !important;
    text-shadow: none !important;
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  @media screen and (max-width: 989px) {
    /* Mobile hero heading */
    #MainContent #shopify-section-{{ section.id }} h1.hero-fullscreen__heading,
    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading,
    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading .hp-typewriter-text,
    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading > span[aria-hidden="true"],
    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading .hero-heading-line,
    #shopify-section-{{ section.id }} h1.hero-fullscreen__heading,
    #shopify-section-{{ section.id }} .hero-fullscreen__heading,
    #shopify-section-{{ section.id }} .hero-fullscreen__heading .hp-typewriter-text,
    #shopify-section-{{ section.id }} .hero-fullscreen__heading > span[aria-hidden="true"],
    #shopify-section-{{ section.id }} .hero-fullscreen__heading .hero-heading-line {

      line-height: 0.93 !important;
      letter-spacing: -0.02em !important;
      color: #ffffff !important;
    }

    /* Mobile line 3 override */
    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__heading .hero-heading-line--3,
    #shopify-section-{{ section.id }} .hero-fullscreen__heading .hero-heading-line--3 {
      font-style: italic !important;
      color: #b0b0b0 !important;
      font-weight: 300 !important;
    }

    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__subheading,
    #shopify-section-{{ section.id }} .hero-fullscreen__subheading,
    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__eyebrow,
    #shopify-section-{{ section.id }} .hero-fullscreen__eyebrow {
      font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
      font-size: {{ hero_label_mobile }}px !important;
      font-weight: 400 !important;
      font-style: normal !important;
      font-synthesis: none !important;
      -webkit-text-stroke: 0.45px currentColor !important;
      paint-order: stroke fill !important;
      text-shadow: none !important;
      -webkit-font-smoothing: antialiased !important;
      -moz-osx-font-smoothing: grayscale !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff !important;
    }
  }

  .hero-fullscreen {
    height: 100vh;
    min-height: 600px;
    width: 100%;
    max-width: 100vw;
    position: relative;
    display: block;
    color: #ffffff;
    overflow-x: hidden;
    overflow-y: hidden;
    box-sizing: border-box;
  }

  .hero-fullscreen__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .hero-fullscreen__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.desktop_image_position | default: 'center center' }};
    display: block;
    filter: brightness(1.18) contrast(1.04) saturate(1.08);
  }

  .hero-fullscreen__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.desktop_image_position | default: 'center center' }};
    display: block;
    filter: brightness(1.18) contrast(1.04) saturate(1.08);
  }

  .hero-fullscreen__bg-video.desktop-video {
    display: block;
  }
  .hero-fullscreen__bg-video.mobile-video {
    display: none;
  }

  .hero-fullscreen__bg picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Overlay disabled Ã¢â‚¬â€ show hero image without dark shadow */
  .hero-fullscreen__overlay {
    display: none;
  }

  .hero-fullscreen__content {
    position: absolute;
    z-index: 3;
    left: var(--hero-content-x, 5%);
    top: var(--hero-content-y, 18%);
    transform: translate(var(--hero-content-tx, 0), 0);
    width: max-content;
    max-width: 90vw;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: var(--hero-content-items, flex-start);
    gap: 0;
    box-sizing: border-box;
    text-align: var(--hero-content-align, left);
  }

  .hero-fullscreen__eyebrow {
    display: block;
    margin: 0 0 var(--section-label-to-title-gap, 12px) 0;
  }

  .hero-fullscreen__heading {

    line-height: 0.92 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0 !important;
    letter-spacing: -0.02em !important;
    color: #ffffff !important;
    margin: 0;
    width: 100%;
    max-width: 100%;
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: manual;
    text-transform: none !important;
    text-align: var(--hero-content-align, left) !important;
    align-self: stretch;
    -webkit-font-smoothing: antialiased;
  }

  .hero-fullscreen__heading .hero-heading-line {
    display: block;
    text-transform: none !important;
    color: inherit;
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: inherit !important;
    font-style: inherit !important;
    letter-spacing: inherit !important;
    line-height: inherit !important;
  }

  .hero-fullscreen__heading .hero-heading-line--1::first-letter {
    text-transform: none !important;
  }

  .hero-fullscreen__heading .hero-heading-line--3 {
    color: #b0b0b0 !important;
    font-style: italic !important;
    font-weight: 300 !important;
    text-indent: 0;
  }

  .hero-fullscreen__heading .hp-typewriter-cursor {
    background-color: var(--color-primary, #ff2b2b);
  }

  .hero-fullscreen__subheading {
    max-width: none;
    width: 100%;
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: var(--section-label-size, 18px) !important;
    font-weight: 400 !important;
    font-style: normal !important;
    font-synthesis: none !important;
    -webkit-text-stroke: 0 !important;
    text-shadow: none !important;
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
    letter-spacing: 0.14em !important;
    line-height: 1.5 !important;
    text-transform: uppercase !important;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    margin: var(--section-subheading-spacing-top, 12px) 0 0 0 !important;
    padding: 0;
    text-align: var(--hero-content-align, left) !important;
    align-self: stretch;
  }

  .hero-fullscreen__actions {
    display: flex;
    justify-content: var(--hero-content-actions, flex-start);
    width: 100%;
    margin-top: 20px;
  }

  .hero-fullscreen__btn {
    box-shadow: 0 16px 36px rgba(255, 43, 43, 0.35);
    font-size: 16px;
    padding: 18px 48px;
    background-color: var(--color-primary);
    color: #ffffff;
  }

  .hero-fullscreen__btn:hover {
    background-color: #e21c1c;
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(255, 43, 43, 0.5);
  }

  /* Desktop / laptop: typing animation */
  @media screen and (min-width: 750px) {
    .hero-fullscreen__heading {
      text-align: var(--hero-content-align, left);
      max-width: 100%;
    }

    .hero-fullscreen__subheading {
      text-align: var(--hero-content-align, left);
      margin-left: 0;
      margin-right: auto;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .hp-float-pin {
      background-color: #111111 !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .hero-fullscreen {
      position: relative !important;
      width: 100% !important;
      max-width: 100vw !important;
      height: 100vh !important;
      min-height: 0 !important;
      max-height: none !important;
      aspect-ratio: auto !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: hidden !important;
      background: #111111 !important;
    }

    .hero-fullscreen--mobile-art {
      height: 100vh !important;
      min-height: 0 !important;
      max-height: none !important;
      aspect-ratio: auto !important;
      background: #111111 !important;
    }

    .hero-fullscreen__content {
      left: var(--hero-content-x-mobile, 5%);
      top: var(--hero-content-y-mobile, 12%);
      transform: translate(var(--hero-content-tx-mobile, 0), 0);
      align-items: var(--hero-content-items-mobile, flex-start);
      text-align: var(--hero-content-align-mobile, left);
      max-width: calc(100% - (var(--homepage-section-gutter, 6px) * 2));
      width: 100%;
      padding: 0;
      gap: 0;
      z-index: 2;
    }

    .hero-fullscreen__content .hero-fullscreen__actions {
      justify-content: var(--hero-content-actions-mobile, center);
      margin-top: 12px;
    }

    .hero-fullscreen__bg {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      line-height: 0 !important;
      background: #111111 !important;
      display: block !important;
    }

    .hero-fullscreen__bg picture {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    .hero-fullscreen__bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-width: 0;
      min-height: 0;
      object-fit: fill;
      object-position: center center;
      display: block;
    }

    /*
     * Desktop (landscape) video shown on mobile:
     * Position absolute to allow stretching
     */
    .hero-fullscreen__bg-video {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      object-fit: fill !important;
      object-position: center center !important;
      background: #111111 !important;
      display: block !important;
    }

    /* When both desktop + mobile videos are uploaded: hide desktop, show mobile */
    .hero-fullscreen__bg-video.desktop-video {
      display: none !important;
    }
    /*
     * Portrait or dedicated mobile video
     */
    .hero-fullscreen__bg-video.mobile-video {
      display: block !important;
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 0 !important;
      object-fit: fill !important;
      object-position: center center !important;
      background: #111111 !important;
    }

    /* Cover for mobile-art (dedicated portrait image) */
    .hero-fullscreen--mobile-art .hero-fullscreen__bg-img {
      object-fit: cover;
      object-position: center center;
    }

    .hero-fullscreen__heading {
      line-height: 0.92 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 0 !important;
      letter-spacing: -0.02em !important;
      text-transform: none !important;
      padding: 0;
      text-align: var(--hero-content-align-mobile, left) !important;
      width: 100%;
    }

    .hero-fullscreen__subheading {
      max-width: 100%;
      padding: 0;
      text-align: var(--hero-content-align-mobile, left) !important;
    }

    .hero-fullscreen__btn {
      padding: 16px 32px;
      font-size: 15px;
      width: 100%;
      max-width: 280px;
    }
  }

  @media screen and (max-width: 380px) {
    .hero-fullscreen__heading {
      font-size: 40px !important;
    }

    .hero-fullscreen__bg-img,
    .hero-fullscreen--mobile-art .hero-fullscreen__bg-img {
      object-fit: cover;
      object-position: center 18%;
    }
  }

  /* Mobile eyebrow — honor Theme Editor Size on phone */
  @media screen and (max-width: 989px) {
    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__subheading,
    #shopify-section-{{ section.id }} .hero-fullscreen__subheading,
    #MainContent #shopify-section-{{ section.id }} .hero-fullscreen__eyebrow,
    #shopify-section-{{ section.id }} .hero-fullscreen__eyebrow {
      font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
      font-size: {{ hero_label_mobile }}px !important;
      font-weight: 400 !important;
      font-style: normal !important;
      font-synthesis: none !important;
      -webkit-text-stroke: 0.45px currentColor !important;
      paint-order: stroke fill !important;
      text-shadow: none !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
    }
  }
{%- endstyle -%}

{%- liquid
  assign desktop_banner = section.settings.image
  assign has_dedicated_mobile = false
  if section.settings.image_mobile != blank
    assign mobile_banner = section.settings.image_mobile
    assign has_dedicated_mobile = true
  else
    assign mobile_banner = section.settings.image
  endif
  if desktop_banner == blank and mobile_banner != blank
    assign desktop_banner = mobile_banner
  endif
  assign hero_img_class = 'hero-fullscreen__bg-img'

  assign content_x = section.settings.content_position_x | default: 5
  assign content_y = section.settings.content_position_y | default: 18
  assign content_align = section.settings.content_align | default: 'left'
  assign content_x_mobile = section.settings.content_position_x_mobile | default: 50
  assign content_y_mobile = section.settings.content_position_y_mobile | default: 12
  assign content_align_mobile = section.settings.content_align_mobile | default: 'left'

  case content_align
    when 'center'
      assign content_tx = '-50%'
      assign content_items = 'center'
      assign content_actions = 'center'
    when 'right'
      assign content_tx = '-100%'
      assign content_items = 'flex-end'
      assign content_actions = 'flex-end'
    else
      assign content_tx = '0'
      assign content_items = 'flex-start'
      assign content_actions = 'flex-start'
  endcase

  case content_align_mobile
    when 'center'
      assign content_tx_mobile = '-50%'
      assign content_items_mobile = 'center'
      assign content_actions_mobile = 'center'
    when 'right'
      assign content_tx_mobile = '-100%'
      assign content_items_mobile = 'flex-end'
      assign content_actions_mobile = 'flex-end'
    else
      assign content_tx_mobile = '0'
      assign content_items_mobile = 'flex-start'
      assign content_actions_mobile = 'flex-start'
  endcase

  assign hero_style = '--hero-content-x: ' | append: content_x | append: '%; --hero-content-y: ' | append: content_y | append: '%; --hero-content-tx: ' | append: content_tx | append: '; --hero-content-align: ' | append: content_align | append: '; --hero-content-items: ' | append: content_items | append: '; --hero-content-actions: ' | append: content_actions | append: '; --hero-content-x-mobile: ' | append: content_x_mobile | append: '%; --hero-content-y-mobile: ' | append: content_y_mobile | append: '%; --hero-content-tx-mobile: ' | append: content_tx_mobile | append: '; --hero-content-align-mobile: ' | append: content_align_mobile | append: '; --hero-content-items-mobile: ' | append: content_items_mobile | append: '; --hero-content-actions-mobile: ' | append: content_actions_mobile | append: ';'
  if has_dedicated_mobile and mobile_banner.width and mobile_banner.height
    assign hero_style = hero_style | append: ' --hero-mobile-aspect: ' | append: mobile_banner.width | append: ' / ' | append: mobile_banner.height | append: ';'
  endif
-%}

<section
  class="hero-fullscreen{% if has_dedicated_mobile %} hero-fullscreen--mobile-art{% endif %}"
  aria-label="HAGUEPROTECT Fullscreen Hero Section"
  style="{{ hero_style }}"
>
  <div class="hero-fullscreen__bg">
    {%- if section.settings.video_background != blank -%}
      {%- if section.settings.video_background_mobile != blank -%}
        <video autoplay loop muted playsinline poster="{{ section.settings.video_background.preview_image | image_url: width: 1200 }}" class="hero-fullscreen__bg-video desktop-video">
          {% for source in section.settings.video_background.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
        <video autoplay loop muted playsinline poster="{{ section.settings.video_background_mobile.preview_image | image_url: width: 800 }}" class="hero-fullscreen__bg-video mobile-video">
          {% for source in section.settings.video_background_mobile.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
      {%- else -%}
        <video autoplay loop muted playsinline poster="{{ section.settings.video_background.preview_image | image_url: width: 1200 }}" class="hero-fullscreen__bg-video">
          {% for source in section.settings.video_background.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
      {%- endif -%}
    {%- elsif desktop_banner != blank -%}
      <picture>
        {%- if mobile_banner != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_banner | image_url: width: 400 }} 400w,
              {{ mobile_banner | image_url: width: 600 }} 600w,
              {{ mobile_banner | image_url: width: 800 }} 800w,
              {{ mobile_banner | image_url: width: 1000 }} 1000w,
              {{ mobile_banner | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {%- if has_dedicated_mobile -%}
          {{
            desktop_banner
            | image_url: width: 2800
            | image_tag:
              class: hero_img_class,
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 2000, 2800',
              sizes: '(min-width: 750px) 100vw, 100vw',
              alt: ''
          }}
        {%- else -%}
          {{
            desktop_banner
            | image_url: width: 2800
            | image_tag:
              class: hero_img_class,
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 2000, 2800',
              sizes: '(min-width: 750px) 100vw, 0px',
              alt: ''
          }}
        {%- endif -%}
      </picture>
    {%- endif -%}
  </div>
  <div class="hero-fullscreen__overlay"></div>


  

</section>

<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var heading = section.querySelector('.hero-fullscreen__heading');
    if (!heading) return;
    var lines = Array.prototype.slice.call(heading.querySelectorAll('.hero-heading-line'));
    if (!lines.length) return;

    /* Respect reduced-motion: leave the fully-styled heading in place. */
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var data = lines.map(function (el) { return { el: el, text: el.textContent || '' }; });

    function run() {
      if (heading.dataset.heroTyped) return;
      heading.dataset.heroTyped = 'true';

      /* Reserve the final height so nothing below jumps while typing. */
      heading.style.minHeight = heading.offsetHeight + 'px';
      data.forEach(function (d) { d.el.textContent = ''; });

      var cursor = document.createElement('span');
      cursor.className = 'hp-typewriter-cursor';
      cursor.setAttribute('aria-hidden', 'true');

      var li = 0, ci = 0, speed = 55, linePause = 180;

      function tick() {
        var d = data[li];
        d.el.textContent = d.text.substring(0, ci);
        d.el.appendChild(cursor);

        if (ci < d.text.length) {
          ci += 1;
          window.setTimeout(tick, speed);
        } else if (li < data.length - 1) {
          li += 1;
          ci = 0;
          window.setTimeout(tick, linePause);
        }
        /* Finished: cursor stays blinking on the last line. */
      }

      tick();
    }

    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { run(); obs.disconnect(); }
        });
      }, { threshold: 0.35 });
      obs.observe(heading);
    } else {
      run();
    }
  })();
</script>

