{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}
{% render 'hp-science-typography-vars', section: section %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-typography-{{ section.id }}__note {
    display: none;
    margin: 0;
    padding: 14px var(--hp-sci-gutter, 28px);
    background: rgba(168, 137, 74, 0.12);
    border-bottom: 1px solid rgba(168, 137, 74, 0.35);
    color: #a8894a;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.45;
    text-align: center;
  }

  .shopify-design-mode .hp-sci-typography-{{ section.id }}__note {
    display: block;
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-typography-{{ section.id }}" aria-hidden="true">
  <p class="hp-sci-typography-{{ section.id }}__note">
    Typography &amp; spacing settings here apply to the whole Science Longevity page (desktop + mobile). Other sections keep their content settings.
  </p>
</section>

{% schema %}
{
  "name": "Science — Typography",
  "tag": "section",
  "class": "hp-science-typography-section",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Control page-wide text sizes, font weights, letter spacing, line height, horizontal gutters, and default section padding for desktop and mobile."
    },
    {
      "type": "header",
      "content": "Lead headings (hero, info grid, statement, etc.)"
    },
    {
      "type": "range",
      "id": "lead_heading_size_desktop",
      "label": "Lead heading size — desktop",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "lead_heading_size_mobile",
      "label": "Lead heading size — mobile",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "lead_heading_line_height",
      "label": "Lead heading line height",
      "min": 100,
      "max": 150,
      "step": 2,
      "unit": "%",
      "default": 112,
      "info": "Percentage value (112 = 1.12 line height)."
    },
    {
      "type": "header",
      "content": "Base headings (h2, h3, card titles)"
    },
    {
      "type": "range",
      "id": "base_heading_size_desktop",
      "label": "Base heading size — desktop",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "base_heading_size_mobile",
      "label": "Base heading size — mobile",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "base_heading_line_height",
      "label": "Base heading line height",
      "min": 100,
      "max": 150,
      "step": 2,
      "unit": "%",
      "default": 120
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading / column title size — desktop",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading / column title size — mobile",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Body text size — desktop",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body text size — mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_line_height",
      "label": "Body line height",
      "min": 130,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 155
    },
    {
      "type": "header",
      "content": "Eyebrows & labels"
    },
    {
      "type": "range",
      "id": "eyebrow_size_desktop",
      "label": "Eyebrow size — desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "label": "Eyebrow size — mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "label": "Eyebrow letter spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "info": "Value × 0.01em (12 = 0.12em)."
    },
    {
      "type": "range",
      "id": "eyebrow_title_gap_desktop",
      "label": "Space below eyebrow — desktop",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_title_gap_mobile",
      "label": "Space below eyebrow — mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Stat numbers (info grid)"
    },
    {
      "type": "range",
      "id": "stat_number_size_desktop",
      "label": "Stat number size — desktop",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "stat_number_size_mobile",
      "label": "Stat number size — mobile",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Font weights"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "300"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "Subheading font weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Eyebrow font weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "body_font_weight",
      "label": "Body font weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "heading_font_style",
      "label": "Heading style",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "italic", "label": "Italic" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": -10,
      "max": 10,
      "step": 1,
      "default": -2,
      "info": "Value × 0.01em (-2 = -0.02em)."
    },
    {
      "type": "header",
      "content": "Layout & spacing"
    },
    {
      "type": "range",
      "id": "horizontal_gutter_desktop",
      "label": "Horizontal page gutter — desktop",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "horizontal_gutter_mobile",
      "label": "Horizontal page gutter — mobile",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "override_section_padding",
      "label": "Override section vertical padding",
      "default": false,
      "info": "When enabled, applies the padding below to all Science sections instead of each section's own padding settings."
    },
    {
      "type": "range",
      "id": "section_padding_top_desktop",
      "label": "Section padding top — desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Section padding top — mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "section_padding_bottom_desktop",
      "label": "Section padding bottom — desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Section padding bottom — mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Science — Typography"
    }
  ]
}
{% endschema %}
