{%- style -%}
  {% render 'section-typography-vars', section: section %}


  .hp-dna-{{ section.id }} {
    --hp-dna-accent: {{ section.settings.accent_color }};
    --hp-dna-text: #ffffff;
    --hp-dna-badge: {{ section.settings.icon_badge_size }}px;
    --hp-dna-glow: {{ section.settings.glow_intensity | divided_by: 100.0 }};
    background-color: #000000;
    color: #ffffff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: var(--font-family-sans, 'Inter', system-ui, -apple-system, sans-serif);
    overflow: hidden;
  }

  @keyframes hp-dna-float-{{ section.id }} {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -5px, 0); }
  }

  @keyframes hp-dna-accent-pulse-{{ section.id }} {
    0%, 100% { opacity: 0.82; }
    50% { opacity: 1; }
  }

  @keyframes hp-dna-glow-breathe-{{ section.id }} {
    0%, 100% { opacity: calc(var(--hp-dna-glow) * 0.55); transform: scale(0.96); }
    50% { opacity: calc(var(--hp-dna-glow) * 0.9); transform: scale(1.04); }
  }

  .hp-dna-{{ section.id }} .hp-dna__container {
    max-width: {{ section.settings.container_width | default: settings.site_max_width | default: 1440 }}px;
    margin: 0 auto;
    padding: 0 var(--homepage-section-gutter, 8px);
  }

  .hp-dna-{{ section.id }} .hp-dna__heading {
    font-family: var(--font-family-h2, var(--font-family-heading));
    font-size: var(--section-heading-size);
    font-weight: var(--font-weight-h2, 800);
    font-style: var(--font-style-h2, normal);
    text-align: var(--section-heading-align, left);
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: 1.25;
    margin: 0 0 clamp(48px, 6vw, 72px);
    color: var(--hp-dna-text);
  }

  .hp-dna-{{ section.id }} .hp-dna__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 48px);
  }

  .hp-dna-{{ section.id }} .hp-dna__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    box-sizing: border-box;
    border: 1px solid #ffffff;
    background-color: #000000;
    padding: clamp(24px, 2.2vw, 32px) clamp(18px, 1.8vw, 24px);
  }

  .hp-dna-{{ section.id }} .hp-dna__heading .hp-heading-line--2 {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  .hp-dna-{{ section.id }} .hp-dna__icon-wrap {
    margin-bottom: 28px;
    flex-shrink: 0;
  }

  .hp-dna-{{ section.id }} .hp-dna__icon-badge {
    position: relative;
    width: var(--hp-dna-badge);
    height: var(--hp-dna-badge);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
    transform: translateZ(0);
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hp-dna-{{ section.id }} .hp-dna__icon-glow {
    display: none;
  }

  .hp-dna-{{ section.id }} .hp-dna__icon-float {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
  }

  {%- if section.settings.enable_float -%}
  .hp-dna-{{ section.id }} .hp-dna__icon-float {
    animation: hp-dna-float-{{ section.id }} 5.5s ease-in-out infinite;
  }

  .hp-dna-{{ section.id }} .hp-dna__item:nth-child(1) .hp-dna__icon-float { animation-delay: 0s; }
  .hp-dna-{{ section.id }} .hp-dna__item:nth-child(2) .hp-dna__icon-float { animation-delay: 0.8s; }
  .hp-dna-{{ section.id }} .hp-dna__item:nth-child(3) .hp-dna__icon-float { animation-delay: 1.6s; }
  .hp-dna-{{ section.id }} .hp-dna__item:nth-child(4) .hp-dna__icon-float { animation-delay: 2.4s; }
  {%- endif -%}

  .hp-dna-{{ section.id }} .hp-dna__svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .hp-dna-{{ section.id }} .hp-dna__svg-accent,
  .hp-dna-{{ section.id }} .hp-dna__svg-accent-fill {
    filter: drop-shadow(0 0 4px rgba(255, 43, 43, 0.55));
    animation: hp-dna-accent-pulse-{{ section.id }} 3.5s ease-in-out infinite;
  }

  .hp-dna-{{ section.id }} .hp-dna__item:nth-child(1) .hp-dna__svg-accent { animation-delay: 0s; }
  .hp-dna-{{ section.id }} .hp-dna__item:nth-child(2) .hp-dna__svg-accent { animation-delay: 0.6s; }
  .hp-dna-{{ section.id }} .hp-dna__item:nth-child(3) .hp-dna__svg-accent { animation-delay: 1.2s; }
  .hp-dna-{{ section.id }} .hp-dna__item:nth-child(4) .hp-dna__svg-accent { animation-delay: 1.8s; }

  .hp-dna-{{ section.id }} .hp-dna__icon-badge img,
  .hp-dna-{{ section.id }} .hp-dna__icon-badge video,
  .hp-dna-{{ section.id }} .hp-dna__icon-custom {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 2;
    display: block;
  }

  .hp-dna-{{ section.id }} .hp-dna__icon-custom--gif {
    pointer-events: none;
    /* Ensure GIFs render at native pixel boundaries for sharpness */
    will-change: contents;
    transform: translateZ(0) scale(1.0);
    filter: contrast(1.1) saturate(1.15) brightness(1.05);
  }

  {%- if section.settings.enable_hover -%}
  @media (hover: hover) and (pointer: fine) {
    .hp-dna-{{ section.id }} .hp-dna__icon-badge:hover {
      transform: scale(1.06);
    }

    .hp-dna-{{ section.id }} .hp-dna__icon-badge:hover .hp-dna__svg-accent {
      filter: drop-shadow(0 0 8px rgba(255, 43, 43, 0.85));
    }
  }
  {%- endif -%}

  .hp-dna-{{ section.id }} .hp-dna__item-title {
    font-size: var(--section-subheading-size, 15px) !important;
    font-weight: var(--font-weight-sans, 700) !important;
    font-family: var(--font-family-sans, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif) !important;
    font-style: var(--font-style-sans, normal) !important;
    text-transform: none !important;
    letter-spacing: 0.05em !important;
    line-height: 1.35 !important;
    margin: 0 0 14px;
    color: var(--hp-dna-text);
  }

  .hp-dna-{{ section.id }} .hp-dna__item-text {
    font-size: var(--body-font-size, 14px) !important;
    font-weight: var(--font-weight-sans, 400) !important;
    font-family: var(--font-family-sans, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif) !important;
    font-style: var(--font-style-sans, normal) !important;
    line-height: 1.55 !important;
    margin: 0;
    color: #ffffff;
    opacity: 1;
    max-width: 280px;
    text-transform: none !important;
  }

  @media screen and (max-width: 1024px) {
    .hp-dna-{{ section.id }} .hp-dna__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 32px;
    }
  }

  @media screen and (min-width: 768px) {
    .hp-dna-{{ section.id }} .hp-dna__item-text {
      font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
      font-size: 21px !important;
      font-weight: 400 !important;
      font-style: normal !important;
      line-height: 1.38 !important;
      letter-spacing: 0 !important;
    }
  }

  @media screen and (min-width: 1200px) {
    .hp-dna-{{ section.id }} .hp-dna__item-text {
      font-size: 22px !important;
      line-height: 1.42 !important;
    }
  }

  /* Large screens — tighten vertical padding so the section doesn't feel empty */
  @media screen and (min-width: 1024px) {
    .hp-dna-{{ section.id }} {
      padding-top: clamp(48px, 4.5vw, 64px);
      padding-bottom: clamp(40px, 4vw, 56px);
    }

    .hp-dna-{{ section.id }} .hp-dna__heading {
      margin-bottom: clamp(32px, 3.5vw, 48px);
    }
  }

  /* Mobile only — horizontal swipe carousel */
  @media screen and (max-width: 749px) {
    .hp-dna-{{ section.id }} {
      --hp-dna-badge: {{ section.settings.icon_badge_size | times: 0.92 | round }}px;
      overflow: visible;
    }

    .hp-dna-{{ section.id }} .hp-dna__container {
      padding-left: var(--homepage-section-gutter, 16px);
      padding-right: 0;
    }

    .hp-dna-{{ section.id }} .hp-dna__heading {
      padding-right: var(--homepage-section-gutter, 16px);
      margin-bottom: 28px;
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
      white-space: normal !important;
      overflow: visible !important;
      transform: none !important;
      text-align: left !important;
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .hp-dna-{{ section.id }} .hp-dna__heading .hp-heading-line,
    .hp-dna-{{ section.id }} .hp-dna__heading .hp-heading-pair,
    .hp-dna-{{ section.id }} .hp-dna__heading .hp-heading-pair .hp-heading-line,
    .hp-dna-{{ section.id }} .hp-dna__heading .hp-heading-accent {
      display: block !important;
      white-space: normal !important;
      overflow-wrap: break-word !important;
      word-break: break-word !important;
      max-width: 100% !important;
    }

    .hp-dna-{{ section.id }} .hp-dna__heading .hp-heading-line--2 {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
      font-size: 24px !important;
      font-weight: 300 !important;
      font-style: normal !important;
      font-synthesis: none !important;
      line-height: 1.05 !important;
      letter-spacing: 0.03em !important;
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff !important;
      margin-top: 4px !important;
    }

    .hp-dna-{{ section.id }} .hp-dna__grid {
      display: flex;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: 14px;
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      scroll-padding-left: var(--homepage-section-gutter, 16px);
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      padding: 4px var(--homepage-section-gutter, 16px) 12px;
      margin: 0;
      scrollbar-width: none;
      -ms-overflow-style: none;
      grid-template-columns: none;
    }

    .hp-dna-{{ section.id }} .hp-dna__grid::-webkit-scrollbar {
      display: none;
      height: 0;
    }

    .hp-dna-{{ section.id }} .hp-dna__item {
      flex: 0 0 min(78vw, 300px);
      width: min(78vw, 300px);
      max-width: min(78vw, 300px);
      scroll-snap-align: start;
      scroll-snap-stop: always;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 20px 18px;
      background-color: #000000;
      border: 1px solid #ffffff;
      border-radius: 16px;
      box-shadow: none;
      overflow: visible;
    }

    .hp-dna-{{ section.id }} .hp-dna__icon-wrap {
      margin-bottom: 12px;
      flex: 0 0 auto;
      display: flex;
      visibility: visible;
      opacity: 1;
    }

    .hp-dna-{{ section.id }} .hp-dna__icon-badge,
    .hp-dna-{{ section.id }} .hp-dna__icon-float {
      display: flex;
      visibility: visible;
      opacity: 1;
    }

    .hp-dna-{{ section.id }} .hp-dna__icon-badge img,
    .hp-dna-{{ section.id }} .hp-dna__icon-custom,
    .hp-dna-{{ section.id }} .hp-dna__svg {
      display: block;
      visibility: visible;
      opacity: 1;
      max-width: 100%;
      height: auto;
    }

    .hp-dna-{{ section.id }} .hp-dna__icon-float {
      animation: none;
      transform: none;
    }

    .hp-dna-{{ section.id }} .hp-dna__item-title,
    .hp-dna-{{ section.id }} .hp-dna__item-text {
      position: relative;
      z-index: 2;
      background: transparent !important;
      border: 0 !important;
      outline: none !important;
      box-shadow: none !important;
      max-width: 100%;
      padding: 0 !important;
    }

    .hp-dna-{{ section.id }} .hp-dna__item-copy {
      background: transparent !important;
      border: 0 !important;
      outline: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .hp-dna-{{ section.id }} .hp-dna__icon-glow {
      display: none !important;
    }

    .hp-dna-{{ section.id }} .hp-dna__item-text {
      font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
      font-size: 20px !important;
      font-weight: 400 !important;
      font-style: normal !important;
      line-height: 1.05 !important;
      letter-spacing: 0 !important;
      max-width: none;
    }

    .hp-dna-{{ section.id }} .hp-dna__dots {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 18px;
      padding-right: var(--homepage-section-gutter, 16px);
      line-height: 0;
    }

    .hp-dna-{{ section.id }} .hp-dna__dot {
      -webkit-appearance: none;
      appearance: none;
      display: block;
      box-sizing: border-box;
      width: 8px !important;
      height: 8px !important;
      min-width: 8px !important;
      min-height: 8px !important;
      max-width: 8px !important;
      max-height: 8px !important;
      margin: 0;
      padding: 0 !important;
      border: 0 !important;
      border-radius: 50% !important;
      flex: 0 0 8px;
      aspect-ratio: 1 / 1;
      line-height: 0;
      font-size: 0;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.35);
      cursor: pointer;
      transform: none;
      transition: background-color 0.2s ease, width 0.2s ease, border-radius 0.2s ease, max-width 0.2s ease;
    }

    .hp-dna-{{ section.id }} .hp-dna__dot.is-active {
      width: 18px !important;
      min-width: 18px !important;
      max-width: 18px !important;
      height: 8px !important;
      min-height: 8px !important;
      max-height: 8px !important;
      flex: 0 0 18px;
      border-radius: 999px !important;
      background: var(--hp-dna-accent, #FF2B2B);
      transform: none;
    }
  }

  @media screen and (min-width: 750px) {
    .hp-dna-{{ section.id }} .hp-dna__dots {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-dna-{{ section.id }} .hp-dna__icon-float,
    .hp-dna-{{ section.id }} .hp-dna__icon-glow,
    .hp-dna-{{ section.id }} .hp-dna__svg-accent {
      animation: none !important;
    }

    .hp-dna-{{ section.id }} .hp-dna__grid {
      scroll-behavior: auto;
    }
  }
{%- endstyle -%}

<section
  class="hp-dna-{{ section.id }} section-spacing"
  aria-label="{{ section.settings.heading | escape }}"
  data-hp-dna-section="{{ section.id }}"
  data-no-typewriter
>
  <div class="hp-dna__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="hp-dna__heading">
        {% render 'section-heading-text', text: section.settings.heading, line2: section.settings.heading_line2, line2_color: section.settings.heading_line2_color %}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="hp-dna__grid" data-hp-dna-track role="list">
        {%- for block in section.blocks -%}
          <div class="hp-dna__item" role="listitem" {{ block.shopify_attributes }}>
            <div class="hp-dna__icon-wrap">
              <div
                class="hp-dna__icon-badge"
                aria-hidden="true"
              >
                <span class="hp-dna__icon-float">
                  {%- if block.settings.custom_video != blank -%}
                    {{ block.settings.custom_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'hp-dna__icon-custom hp-dna__icon-custom--video' }}
                  {%- elsif block.settings.icon != blank -%}
                    {%- liquid
                      assign custom_icon = block.settings.icon
                      assign icon_src = custom_icon.src | default: '' | downcase
                      assign is_raw_format = false
                      if icon_src contains '.gif' or icon_src contains '.webp'
                        assign is_raw_format = true
                      endif
                    -%}
                    {%- if is_raw_format -%}
                      <img
                        src="{{ custom_icon | image_url }}"
                        class="hp-dna__icon-custom hp-dna__icon-custom--gif"
                        loading="lazy"
                        alt=""
                        width="{{ custom_icon.width }}"
                        height="{{ custom_icon.height }}"
                      >
                    {%- else -%}
                      {{
                        custom_icon
                        | image_url: width: 320
                        | image_tag:
                          class: 'hp-dna__icon-custom',
                          loading: 'lazy',
                          alt: '',
                          width: 80,
                          height: 80
                      }}
                    {%- endif -%}
                  {%- else -%}
                    {% render 'hp-dna-icon',
                      preset: block.settings.icon_preset,
                      accent_color: section.settings.accent_color,
                      text_color: section.settings.text_color,
                      index: forloop.index
                    %}
                  {%- endif -%}
                </span>
              </div>
            </div>

            <div class="hp-dna__item-copy">
              {%- if block.settings.title != blank -%}
                <h3 class="hp-dna__item-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="hp-dna__item-text hp-body-para">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="hp-dna__dots" data-hp-dna-dots aria-hidden="true">
          {%- for block in section.blocks -%}
            <button type="button" class="hp-dna__dot{% if forloop.first %} is-active{% endif %}" data-hp-dna-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-hp-dna-section="{{ section.id }}"]');
    if (!root) return;

    var track = root.querySelector('[data-hp-dna-track]');
    var dots = root.querySelectorAll('[data-hp-dna-dot]');
    if (!track || !itemsReady(track)) return;

    var mq = window.matchMedia('(max-width: 749px)');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    var items = track.querySelectorAll('.hp-dna__item');
    var ticking = false;
    var index = 0;
    var timer = null;
    var resumeTimer = null;
    var paused = false;
    var AUTO_MS = 3500;
    var RESUME_MS = 5000;

    function itemsReady(el) {
      return el && el.querySelectorAll('.hp-dna__item').length > 1;
    }

    function padLeft() {
      return parseFloat(getComputedStyle(track).paddingLeft) || 0;
    }

    function setActive(i) {
      index = i;
      dots.forEach(function (dot, di) {
        dot.classList.toggle('is-active', di === i);
      });
    }

    function goTo(i, behavior) {
      if (!items.length) return;
      var next = ((i % items.length) + items.length) % items.length;
      var target = items[next];
      if (!target) return;
      track.scrollTo({
        left: target.offsetLeft - padLeft(),
        behavior: behavior || 'smooth'
      });
      setActive(next);
    }

    function updateFromScroll() {
      if (!mq.matches || !items.length) return;
      var trackRect = track.getBoundingClientRect();
      var best = 0;
      var bestDist = Infinity;
      items.forEach(function (item, i) {
        var rect = item.getBoundingClientRect();
        var dist = Math.abs(rect.left - trackRect.left - 8);
        if (dist < bestDist) {
          bestDist = dist;
          best = i;
        }
      });
      setActive(best);
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        updateFromScroll();
        ticking = false;
      });
    }

    function stopAuto() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function startAuto() {
      stopAuto();
      if (!mq.matches || reduceMotion.matches || paused || items.length < 2) return;
      timer = setInterval(function () {
        if (!mq.matches || document.hidden || paused) return;
        goTo(index + 1, 'smooth');
      }, AUTO_MS);
    }

    function pauseAuto() {
      paused = true;
      stopAuto();
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(function () {
        paused = false;
        startAuto();
      }, RESUME_MS);
    }

    track.addEventListener('scroll', onScroll, { passive: true });
    track.addEventListener('pointerdown', pauseAuto, { passive: true });
    track.addEventListener('touchstart', pauseAuto, { passive: true });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        if (!mq.matches) return;
        pauseAuto();
        var i = Number(dot.getAttribute('data-hp-dna-dot') || 0);
        goTo(i, 'smooth');
      });
    });

    function onViewportChange() {
      updateFromScroll();
      if (mq.matches) startAuto();
      else stopAuto();
    }

    if (mq.addEventListener) mq.addEventListener('change', onViewportChange);
    else if (mq.addListener) mq.addListener(onViewportChange);

    if (reduceMotion.addEventListener) {
      reduceMotion.addEventListener('change', onViewportChange);
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopAuto();
      else if (!paused) startAuto();
    });

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          var visible = entries.some(function (e) { return e.isIntersecting; });
          if (!visible) {
            stopAuto();
          } else if (!paused) {
            startAuto();
          }
        },
        { threshold: 0.25 }
      );
      io.observe(root);
    }

    updateFromScroll();
    startAuto();
  })();
