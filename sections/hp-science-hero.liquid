{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-hero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .hp-sci-hero-{{ section.id }}__copy {
    text-align: {{ section.settings.text_alignment | default: 'left' }};
    padding-left: calc(var(--hp-sci-rail-w, 18px) + clamp(28px, 4vw, 56px));
  }

  .hp-sci-hero-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }

  .hp-sci-hero-{{ section.id }}__title {
    line-height: 1.06;
    color: inherit;
  }

  .hp-sci-hero-{{ section.id }}__title-line {
    display: block;
  }

  .hp-sci-hero-{{ section.id }}__title-line--muted {
    color: #c8c8c8;
  }

  .hp-sci-hero-{{ section.id }}__media {
    width: 100%;
  }
  {%- if section.settings.text_offset_x_desktop != 0 or section.settings.text_offset_y_desktop != 0 -%}


  .hp-sci-hero-{{ section.id }}__text-position {
    transform: translate({{ section.settings.text_offset_x_desktop | default: 0 }}px, {{ section.settings.text_offset_y_desktop | default: 0 }}px);
  }
  {%- endif -%}

  @media screen and (max-width: 989px) {
    .hp-sci-hero-{{ section.id }}__grid {
      grid-template-columns: 1fr;
    }

    .hp-sci-hero-{{ section.id }}__title {
    }

    .hp-sci-hero-{{ section.id }}__copy {
      order: 1;
      padding-left: 0;
    }
    {%- if section.settings.text_offset_x_mobile != 0 or section.settings.text_offset_y_mobile != 0 -%}

    .hp-sci-hero-{{ section.id }}__text-position {
      transform: translate({{ section.settings.text_offset_x_mobile | default: 0 }}px, {{ section.settings.text_offset_y_mobile | default: 0 }}px);
    }
    {%- endif -%}

    .hp-sci-hero-{{ section.id }}__media {
      order: 2;
    }
  }
  {% render 'hp-science-section-typography-styles', section: section %}
{%- endstyle -%}

<section class="hp-sci hp-sci-hero-{{ section.id }}">
  <div class="hp-sci__inner">
    <div class="hp-sci-hero-{{ section.id }}__grid">
      <div class="hp-sci-hero-{{ section.id }}__copy hp-sci-hero-{{ section.id }}__text-position">
        <div class="hp-sci-hero-{{ section.id }}__copy-inner">
          {%- if section.settings.eyebrow != blank -%}
            <p class="hp-sci__eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank or section.settings.heading_line_3 != blank or section.settings.heading_line_4 != blank -%}
            <h1 class="hp-sci__title hp-sci-hero-{{ section.id }}__title">
              {%- if section.settings.heading_line_1 != blank -%}
                <span class="hp-sci-hero-{{ section.id }}__title-line">{{ section.settings.heading_line_1 }}</span>
              {%- endif -%}
              {%- if section.settings.heading_line_2 != blank -%}
                <span class="hp-sci-hero-{{ section.id }}__title-line">{{ section.settings.heading_line_2 }}</span>
              {%- endif -%}
              {%- if section.settings.heading_line_3 != blank -%}
                <span class="hp-sci-hero-{{ section.id }}__title-line hp-sci-hero-{{ section.id }}__title-line--muted">{{ section.settings.heading_line_3 }}</span>
              {%- endif -%}
              {%- if section.settings.heading_line_4 != blank -%}
                <span class="hp-sci-hero-{{ section.id }}__title-line hp-sci-hero-{{ section.id }}__title-line--muted">{{ section.settings.heading_line_4 }}</span>
              {%- endif -%}
            </h1>
          {%- endif -%}
        </div>
      </div>
      <div class="hp-sci-hero-{{ section.id }}__media">
        {% render 'hp-science-media',
          image: section.settings.image,
          video: section.settings.video,
          animation_url: section.settings.animation_url,
          show_placeholder: section.settings.show_media_placeholder,
          placeholder_label: section.settings.placeholder_label,
          min_height: 0,
          aspect_ratio: '1 / 1'
        %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science \u2014 Hero",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "header",
      "content": "Text position"
    },
    {
      "type": "range",
      "id": "text_offset_x_desktop",
      "label": "Horizontal offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_desktop",
      "label": "Vertical offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_x_mobile",
      "label": "Horizontal offset \u2014 mobile",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_mobile",
      "label": "Vertical offset \u2014 mobile",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE SCIENCE"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Your skin knows"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "how to fix itself."
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading line 3",
      "default": "Most products"
    },
    {
      "type": "text",
      "id": "heading_line_4",
      "label": "Heading line 4",
      "default": "interrupt it."
    },
    {
      "type": "header",
      "content": "Hero media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (overrides image)"
    },
    {
      "type": "url",
      "id": "animation_url",
      "label": "Animation file URL (Lottie JSON)"
    },
    {
      "type": "checkbox",
      "id": "show_media_placeholder",
      "label": "Show placeholder when media is empty",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "Upload hero animation or image"
    },
    {
      "type": "range",
      "id": "media_min_height_desktop",
      "label": "Media min height (desktop)",
      "min": 240,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "media_min_height_mobile",
      "label": "Media min height (mobile)",
      "min": 180,
      "max": 480,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Title size (desktop)",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title size (mobile)",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Science \u2014 Hero"
    }
  ]
}
{% endschema %}
