{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }
  {% render 'hp-science-section-typography', section: section %}

  .hp-sci-hero-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .hp-sci-hero-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    min-height: clamp(420px, 58vh, 720px);
  }

  .hp-sci-hero-{{ section.id }}__title {
    font-size: clamp(32px, 4.5vw, {{ section.settings.title_size_desktop }}px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: inherit;
  }

  .hp-sci-hero-{{ section.id }}__title-line {
    display: block;
  }

  .hp-sci-hero-{{ section.id }}__title-line--muted {
    color: #c8c8c8;
  }

  .hp-sci-hero-{{ section.id }}__media {
    min-height: clamp(280px, 42vh, 560px);
  }

  @media screen and (max-width: 989px) {
    .hp-sci-hero-{{ section.id }}__grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hp-sci-hero-{{ section.id }}__title {
      font-size: clamp(32px, 4.5vw, {{ section.settings.title_size_mobile }}px);
    }

    .hp-sci-hero-{{ section.id }}__copy {
      order: 1;
    }

    .hp-sci-hero-{{ section.id }}__media {
      order: 2;
      min-height: {{ section.settings.media_min_height_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-hero-{{ section.id }}">
  <div class="hp-sci__inner">
    <div class="hp-sci-hero-{{ section.id }}__grid">
      <div class="hp-sci-hero-{{ section.id }}__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-sci__eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank or section.settings.heading_line_3 != blank or section.settings.heading_line_4 != blank -%}
          <h1 class="hp-sci__title hp-sci-hero-{{ section.id }}__title">
            {%- if section.settings.heading_line_1 != blank -%}
              <span class="hp-sci-hero-{{ section.id }}__title-line">{{ section.settings.heading_line_1 }}</span>
            {%- endif -%}
            {%- if section.settings.heading_line_2 != blank -%}
              <span class="hp-sci-hero-{{ section.id }}__title-line">{{ section.settings.heading_line_2 }}</span>
            {%- endif -%}
            {%- if section.settings.heading_line_3 != blank -%}
              <span class="hp-sci-hero-{{ section.id }}__title-line hp-sci-hero-{{ section.id }}__title-line--muted">{{ section.settings.heading_line_3 }}</span>
            {%- endif -%}
            {%- if section.settings.heading_line_4 != blank -%}
              <span class="hp-sci-hero-{{ section.id }}__title-line hp-sci-hero-{{ section.id }}__title-line--muted">{{ section.settings.heading_line_4 }}</span>
            {%- endif -%}
          </h1>
        {%- endif -%}
      </div>
      <div class="hp-sci-hero-{{ section.id }}__media">
        {% render 'hp-science-media',
          image: section.settings.image,
          video: section.settings.video,
          animation_url: section.settings.animation_url,
          show_placeholder: section.settings.show_media_placeholder,
          placeholder_label: section.settings.placeholder_label,
          min_height: section.settings.media_min_height_desktop
        %}
      </div>
    </div>
  </div>
</section>

