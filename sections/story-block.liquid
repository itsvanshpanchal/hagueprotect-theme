{%- liquid
  assign story_heading_mobile = 24
  assign story_accent_mobile = section.settings.heading_accent_font_size_mobile | default: settings.font_heading_accent_size_mobile | default: 40
  assign story_accent_color = section.settings.heading_accent_color | default: settings.heading_accent_color | default: '#c9a227'
-%}
{%- style -%}
  {% render 'section-typography-vars', section: section %}

  .story-banner-wrapper-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
    background-color: #ffffff;
    padding: {{ section.settings.padding_top | default: 0 }}px 0 {{ section.settings.padding_bottom | default: 40 }}px 0;
    box-sizing: border-box;
  }

  .story-banner-wrapper-{{ section.id }} .story-banner {
    width: 100%;
    margin: 0;
    position: relative;
    max-width: none;
    aspect-ratio: 1440 / 560;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius | default: 20 }}px;
    background-color: #f6f6f6;
  }

  .story-banner-wrapper-{{ section.id }} .story-banner__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.text_vertical_position | default: 'center' }};
    align-items: {% case section.settings.text_align %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
    gap: 6px;
    padding: clamp(28px, 4.5vw, 48px) var(--homepage-section-gutter, 8px) clamp(24px, 5vw, 56px);
    text-align: {{ section.settings.text_align | default: 'left' }};
    pointer-events: none;
    overflow: visible;
    {%- if section.settings.show_text_shadow -%}
      text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
    {%- endif -%}
  }

  /* Keep heading+para inside the banner — never clip with negative offset */
  .story-banner-wrapper-{{ section.id }} .section-heading-stack {
    transform: translate(
      var(--section-text-offset-x, 0px),
      max(-12px, var(--section-text-offset-y, 0px))
    ) !important;
  }

  {%- liquid
    assign story_align_mobile = section.settings.text_align_mobile | default: section.settings.text_align | default: 'left'
    assign story_vert_mobile = section.settings.text_vertical_position_mobile | default: section.settings.text_vertical_position | default: 'center'
  -%}
  @media screen and (max-width: 749px) {
    .story-banner-wrapper-{{ section.id }} .story-banner__content {
      justify-content: {{ story_vert_mobile }};
      align-items: {% case story_align_mobile %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
      text-align: {{ story_align_mobile }};
    }
  }

  .story-banner-wrapper-{{ section.id }} .story-banner__content > * {
    pointer-events: auto;
    max-width: {{ section.settings.text_max_width | default: 720 }}px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    /* Keep desktop copy in the top-left — do not span across center product art */
    .story-banner-wrapper-{{ section.id }} .story-banner__content > .section-heading-stack {
      max-width: min({{ section.settings.text_max_width | default: 720 }}px, 42vw);
      width: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .story-banner-wrapper-{{ section.id }} .story-banner__content > .section-heading-stack {
      max-width: min(92vw, 980px);
      width: auto;
    }
  }

