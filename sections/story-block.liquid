  assign mobile_img = section.settings.image_mobile | default: section.settings.image
  assign banner_eyebrow = section.settings.eyebrow
  assign banner_heading = section.settings.heading
  assign banner_subheading = section.settings.subheading
  assign banner_paragraph = section.settings.paragraph

  if product != blank
    assign show_section = false

    if assigned_product != blank and assigned_product.handle == product.handle
      assign show_section = true
    endif

    for block in section.blocks
      if block.type == 'product_banner' and block.settings.product_select != blank
        assign block_product = block.settings.product_select
        if block_product.handle == product.handle
          assign show_section = true
          if block.settings.image != blank
            assign banner_img = block.settings.image
            assign mobile_img = block.settings.image_mobile | default: block.settings.image
          endif
          if block.settings.eyebrow != blank
            assign banner_eyebrow = block.settings.eyebrow
          endif
          if block.settings.heading != blank
            assign banner_heading = block.settings.heading
          endif
          if block.settings.subheading != blank
            assign banner_subheading = block.settings.subheading
          endif
          if block.settings.paragraph != blank
            assign banner_paragraph = block.settings.paragraph
          endif
          break
        endif
      endif
    endfor

    if product.metafields.custom.story_banner_desktop != blank
      assign banner_img = product.metafields.custom.story_banner_desktop
      assign mobile_img = product.metafields.custom.story_banner_mobile | default: product.metafields.custom.story_banner_desktop
      assign show_section = true
    endif
  elsif assigned_product != blank
    assign show_section = false
  endif

  if request.design_mode and assigned_product == blank and product != blank
    assign show_section = true
  endif

  assign has_text = false
  if banner_eyebrow != blank or banner_heading != blank or banner_subheading != blank or banner_paragraph != blank
    assign has_text = true
  endif
-%}

{%- if show_section -%}
<div class="story-banner-wrapper story-banner-wrapper-{{ section.id }}">
  <div class="story-banner">
    {%- if banner_img != blank -%}
      <picture>
        {%- if mobile_img != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_img | image_url: width: 800 }}">
        {%- endif -%}
        <img 
          src="{{ banner_img | image_url: width: 1920 }}"
          srcset="{{ banner_img | image_url: width: 1000 }} 1000w, {{ banner_img | image_url: width: 1440 }} 1440w, {{ banner_img | image_url: width: 1920 }} 1920w, {{ banner_img | image_url: width: 2560 }} 2560w"
          sizes="100vw"
          alt="{{ banner_img.alt | default: banner_heading | default: product.title | default: shop.name | escape }} story banner"
          class="story-banner__image" 
          width="{{ banner_img.width }}"
          height="{{ banner_img.height }}"
          loading="eager"
          fetchpriority="high"
        >
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'story-banner__image' }}
    {%- endif -%}

    {%- if has_text -%}
      <div class="story-banner__content">
        {%- if banner_eyebrow != blank or banner_heading != blank or banner_paragraph != blank -%}
          <div class="section-heading-stack">
            {%- if banner_eyebrow != blank -%}
              <span class="story-banner__eyebrow">{{ banner_eyebrow }}</span>
            {%- endif -%}
            {%- if banner_heading != blank -%}
              {%- liquid
                assign story_line1 = banner_heading | strip
                assign story_line2 = section.settings.heading_line2 | strip
                assign story_accent_count = section.settings.heading_accent_word_count | default: 2
                assign story_accent_text = ''
                assign story_use_split_markup = false

                if story_line2 != blank
                  assign story_use_split_markup = true
                  assign story_accent_text = story_line2
                else
                  assign story_words = story_line1 | split: ' '
                  if story_words.size > story_accent_count
                    assign story_main_count = story_words.size | minus: story_accent_count
                    assign story_main_words = story_words | slice: 0, story_main_count
                    assign story_accent_words = story_words | slice: story_main_count, story_accent_count
                    assign story_line1 = story_main_words | join: ' '
                    assign story_accent_text = story_accent_words | join: ' '
                    assign story_use_split_markup = true
                  endif
                endif
              -%}
              <div class="story-banner__heading" role="heading" aria-level="2">
                {%- if story_use_split_markup and story_accent_text != blank -%}
                  <span class="hp-heading-line hp-heading-line--1">{{ story_line1 }}</span>
                  <span class="hp-heading-pair hp-heading-pair--stack">
                    <span class="hp-heading-line hp-heading-line--2" style="font-style: italic !important; color: #b0b0b0 !important; -webkit-text-fill-color: #b0b0b0 !important;">{{ story_accent_text }}</span>
                  </span>
                {%- else -%}
                  {% render 'section-heading-text', text: story_line1, line2: '', line2_color: section.settings.heading_line2_color, accent_last_word: true, accent_last_count: story_accent_count, accent_color: story_accent_color %}
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if banner_paragraph != blank -%}
              <p class="story-banner__paragraph hp-body-para">{{ banner_paragraph }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if banner_subheading != blank -%}
          <div class="story-banner__subheading" role="heading" aria-level="3">{% render 'section-heading-text', text: banner_subheading, line2: '', line2_color: section.settings.heading_line2_color %}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

