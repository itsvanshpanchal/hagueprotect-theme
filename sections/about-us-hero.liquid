{{ 'about-us-premium.css' | asset_url | stylesheet_tag }}

<div class="hpa-section">
  <div class="hpa-bar" id="hpaBar"></div>
  <div class="hpa-dot" id="hpaDot"></div>
  <div class="hpa-ring" id="hpaRing"></div>

  <!-- ══ §1 HERO ══ -->
  <section class="hpa-hero" id="hpaHero">
    <div class="hpa-hero__glow"></div>
    <div class="hpa-hero__grid"></div>
    <div class="hpa-hero__bg-num" aria-hidden="true">HP</div>
    <div class="hpa-hero__scrollcue" aria-hidden="true">
      <div class="hpa-hero__scrollcue-line"></div>
      <span>Scroll</span>
    </div>
    <div class="hpa-hero__content">
      <div class="hpa-hero__label" id="hpaHeroLabel">{{ section.settings.hero_label }}</div>
      <h1 class="hpa-hero__h1" id="hpaH1">
        {{ section.settings.hero_h1 }}
      </h1>
      <p class="hpa-hero__sub" id="hpaHeroSub">{{ section.settings.hero_sub }}</p>
    </div>
    
    {% if section.blocks.size > 0 %}
    <div class="hpa-hero__stats" id="hpaHeroStats">
      {% for block in section.blocks %}
        <div class="hpa-hero__stat" {{ block.shopify_attributes }}>
          <span class="hpa-hero__stat-n">{{ block.settings.stat_num }}<span>{{ block.settings.stat_suffix }}</span></span>
          <span class="hpa-hero__stat-l">{{ block.settings.stat_label }}</span>
        </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>
</div>

<script src="{{ 'about-us-premium.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "About Us Hero",
  "settings": [
    {
      "type": "text",
      "id": "hero_label",
      "label": "Hero Eyebrow",
      "default": "Hague Protect · Est. 2021 · Amsterdam"
    },
    {
      "type": "textarea",
      "id": "hero_h1",
      "label": "Hero Headline",
      "info": "Wrap word in <span class='w--red'>...</span> for red color",
      "default": "<span class='w'>WE</span><br><span class='w'>GUARD</span><br><span class='w w--red'>THE</span><br><span class='w'>CULTURE.</span>"
    },
    {
      "type": "textarea",
      "id": "hero_sub",
      "label": "Hero Subheadline",
      "default": "Not just sneaker care — a global commitment to the art, identity, and culture that footwear carries. Every pair deserves to endure."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "stat_num",
          "label": "Number",
          "default": "50"
        },
        {
          "type": "text",
          "id": "stat_suffix",
          "label": "Suffix (Red)",
          "default": "K"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label",
          "default": "Trusted Customers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Hero",
      "blocks": [
        { "type": "stat", "settings": { "stat_num": "50", "stat_suffix": "K", "stat_label": "Trusted Customers" } },
        { "type": "stat", "settings": { "stat_num": "40", "stat_suffix": "+", "stat_label": "Cities Served" } },
        { "type": "stat", "settings": { "stat_num": "99", "stat_suffix": "%", "stat_label": "Satisfaction Rate" } },
        { "type": "stat", "settings": { "stat_num": "02", "stat_suffix": "+", "stat_label": "Years in Labs" } }
      ]
    }
  ]
}
{% endschema %}
