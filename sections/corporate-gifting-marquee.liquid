{%- liquid
  assign bg_color = section.settings.background_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#111111'
  assign show_label = section.settings.show_label
  if request.page_type == 'index' and section.settings.label != blank
    assign show_label = true
  endif
  assign row_gap = section.settings.row_gap | default: 0
-%}

<style>
  /* Homepage only — pull marquee up over sticky-card seam (does not change story banner) */
  {% if request.page_type == 'index' %}
  #shopify-section-{{ section.id }} {
    padding: 0 !important;
    margin-right: 0 !important;
    margin-bottom: 0 !important;
    margin-left: 0 !important;
    margin-top: -32px !important;
    border: none !important;
    overflow: visible !important;
    position: relative !important;
    z-index: 25 !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      margin-top: -36px !important;
    }
  }
  {% endif %}

  #shopify-section-{{ section.id }} > .hp-float-pin {
    padding: 0 !important;
    margin: 0 !important;
    min-height: 0 !important;
    height: auto !important;
    max-height: none !important;
  }
</style>

{{ 'corp-gifting-marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} > .hp-float-pin {
    background-color: {{ bg_color }} !important;
    padding: 0 !important;
    min-height: 0 !important;
    height: auto !important;
    max-height: none !important;
    display: block !important;
  }

  {% if request.page_type == 'index' %}
  #shopify-section-{{ section.id }} {
    margin-right: 0 !important;
    margin-bottom: 0 !important;
    margin-left: 0 !important;
    margin-top: -32px !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      margin-top: -36px !important;
    }
  }
  {% else %}
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} > .hp-float-pin {
    margin: 0 !important;
  }
  {% endif %}

  #shopify-section-{{ section.id }} > .hp-float-pin {
    margin: 0 !important;
    line-height: 0 !important;
  }

  #shopify-section-{{ section.id }} .corp-marquee {
    --corp-marquee-bg: {{ bg_color }};
    --corp-marquee-text: {{ text_color }};
    --corp-marquee-row-gap: {{ row_gap }}px;
    --corp-marquee-pad-top: 0px;
    --corp-marquee-pad-bottom: 8px;
    margin: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 8px !important;
    padding-inline: 0 !important;
    border-top: none !important;
    border-bottom: none !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    align-content: flex-start !important;
    gap: var(--corp-marquee-row-gap, 4px) !important;
    line-height: 1 !important;
  }

  #shopify-section-{{ section.id }} .corp-marquee__track-wrap {
    padding: 0 !important;
    margin: 0 !important;
    height: var(--corp-marquee-font-size, 22px);
    max-height: var(--corp-marquee-font-size, 22px);
    align-items: flex-end;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .corp-marquee__track-wrap:first-child {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  #shopify-section-{{ section.id }} .corp-marquee__track {
    align-items: flex-end;
  }

  #shopify-section-{{ section.id }} .corp-marquee__label {
    display: block !important;
    margin: 0 !important;
    padding: 8px 24px 10px !important;
    line-height: 1.3 !important;
    text-align: center !important;
    font-family: 'Inter', sans-serif !important;
    font-size: clamp(12px, 1.15vw, 14px) !important;
    font-weight: 500 !important;
    letter-spacing: 0.22em !important;
    text-transform: uppercase !important;
    color: rgba(17, 17, 17, 0.72) !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .corp-marquee__label {
      padding: 7px 16px 8px !important;
      font-size: 12px !important;
      letter-spacing: 0.18em !important;
    }
  }

  #shopify-section-{{ section.id }} .corp-marquee__item {
    padding: 0 !important;
    margin: 0 !important;
    line-height: 0.85 !important;
    font-family: 'Inter', sans-serif !important;
    font-weight: 300 !important;
  }
{%- endstyle -%}

{%- liquid
  assign has_marquee_blocks = false
  for block in section.blocks
    if block.type == 'marquee_text' and block.settings.text != blank
      assign has_marquee_blocks = true
      break
    endif
  endfor
-%}

<section class="corp-marquee corp-marquee--outline-style corp-marquee--compact corp-marquee--flush-seam" aria-label="{{ section.settings.label | default: 'Corporate gifting services' | escape }}" data-no-typewriter="true">
  {%- if show_label and section.settings.label != blank -%}
    <p class="corp-marquee__label">
      {{ section.settings.label }}
    </p>
  {%- endif -%}

  {%- comment -%} Row 1 — scrolls left {%- endcomment -%}
  <div class="corp-marquee__track-wrap">
    <div class="corp-marquee__track">
      {%- if has_marquee_blocks == false -%}
        {%- assign row1_items = 'Employee Welcome Kits,Client Appreciation,Festival Hampers,Conference Swag,CEO Gifts,Team Milestones,Retail Partners,Custom Inserts' | split: ',' -%}
        {%- for i in (1..2) -%}
          {%- for item in row1_items -%}
            {%- assign use_outline = false -%}
            {%- assign mod = forloop.index0 | modulo: 2 -%}
            {%- if mod == 1 -%}
              {%- assign use_outline = true -%}
            {%- endif -%}
            <span class="corp-marquee__item{% if use_outline %} corp-marquee__item--outline{% endif %}">{{ item | strip | upcase }}</span>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'marquee_text' and block.settings.text != blank -%}
              {%- assign block_row = block.settings.row -%}
              {%- if block_row == 'top' or block_row == 'middle' -%}
              {%- assign item_outline = block.settings.outline -%}
              {%- if item_outline != true and block.settings.accent -%}
                {%- assign item_outline = true -%}
              {%- endif -%}
              <span class="corp-marquee__item{% if item_outline %} corp-marquee__item--outline{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text | upcase }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Row 2 — scrolls right {%- endcomment -%}
  <div class="corp-marquee__track-wrap">
    <div class="corp-marquee__track corp-marquee__track--reverse">
      {%- if has_marquee_blocks == false -%}
        {%- assign row2_items = 'Logo Embossing,Gift Wrapping,Pan-India Delivery,Invoice & GST,Co-Branded Packaging,Bulk Pricing,Dedicated Manager,Sample Kits' | split: ',' -%}
        {%- for i in (1..2) -%}
          {%- for item in row2_items -%}
            {%- assign use_outline = false -%}
            {%- assign mod = forloop.index0 | modulo: 2 -%}
            {%- if mod == 0 -%}
              {%- assign use_outline = true -%}
            {%- endif -%}
            <span class="corp-marquee__item{% if use_outline %} corp-marquee__item--outline{% endif %}">{{ item | strip | upcase }}</span>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'marquee_text' and block.settings.row == 'bottom' and block.settings.text != blank -%}
              {%- assign item_outline = block.settings.outline -%}
              {%- if item_outline != true and block.settings.accent -%}
                {%- assign item_outline = true -%}
              {%- endif -%}
              <span class="corp-marquee__item{% if item_outline %} corp-marquee__item--outline{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text | upcase }}</span>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- if template == 'search.corporate-gifting' or template.suffix == 'corporate' or page.handle == 'corporate' -%}
  {%- assign corp_occasions_id = 'corp-occasions-' | append: section.id -%}
  <style>
    #{{ corp_occasions_id }}.corp-occasions {
      position: relative;
      z-index: 2;
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
    }

    #{{ corp_occasions_id }} .corp-occasions__title-line1 {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
      font-size: clamp(34px, 4.8vw, 56px);
      font-weight: 700 !important;
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: #111111 !important;
    }

    #{{ corp_occasions_id }} .corp-occasions__title-line2 {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
      font-size: clamp(24px, 3.2vw, 40px);
      font-weight: 300 !important;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: #111111 !important;
    }

    #{{ corp_occasions_id }} .corp-occasions__grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(16px, 2.2vw, 28px);
    }

    #{{ corp_occasions_id }} .corp-occasions__card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      text-decoration: none;
      color: inherit;
    }

    #{{ corp_occasions_id }} .corp-occasions__media {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: 20px;
      overflow: hidden;
      background: linear-gradient(145deg, #f3f3f3, #e8e8e8);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    }

    #{{ corp_occasions_id }} .corp-occasions__placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(17, 17, 17, 0.28);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    #{{ corp_occasions_id }} .corp-occasions__label {
      margin: 18px 0 0;
      font-family: 'Inter', sans-serif !important;
      font-size: clamp(18px, 2vw, 22px);
      font-weight: 700 !important;
      color: #111111 !important;
      line-height: 1.2;
    }

    #{{ corp_occasions_id }} .corp-occasions__caption {
      margin: 8px 0 0;
      font-family: var(--font-family-heading-accent, 'Luthon Southard Script', cursive);
      font-size: clamp(15px, 1.8vw, 18px);
      line-height: 1.35;
      color: #2563eb !important;
    }

    @media screen and (max-width: 1024px) {
      #{{ corp_occasions_id }} .corp-occasions__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px 20px;
      }
    }

    @media screen and (max-width: 560px) {
      #{{ corp_occasions_id }} .corp-occasions__grid {
        grid-template-columns: 1fr;
        max-width: 360px;
        margin: 0 auto;
      }

      #{{ corp_occasions_id }} .corp-occasions__header {
        text-align: center;
        margin-left: auto;
        margin-right: auto;
      }
    }
  </style>

  <section class="corp-occasions" id="{{ corp_occasions_id }}" data-no-typewriter="true">
    <div class="corp-occasions__container" style="max-width: var(--site-max-width); margin: 0 auto; padding: clamp(72px, 9vw, 110px) max(20px, var(--site-padding, 24px)); background: #ffffff;">
      <header class="corp-occasions__header" style="max-width: 720px; margin: 0 0 clamp(40px, 5vw, 56px);">
        <h2 class="corp-occasions__title" style="margin: 0; display: flex; flex-direction: column; gap: 4px;">
          <span class="corp-occasions__title-line1">Gifts people keep.</span>
          <span class="corp-occasions__title-line2">Not re-gift.</span>
        </h2>
      </header>

      <div class="corp-occasions__grid">
        <div class="corp-occasions__card">
          <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Corporate</div></div>
          <p class="corp-occasions__label">Corporate</p>
        </div>
        <div class="corp-occasions__card">
          <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Weddings</div></div>
          <p class="corp-occasions__label">Weddings</p>
        </div>
        <div class="corp-occasions__card">
          <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Celebrations</div></div>
          <p class="corp-occasions__label">Celebrations</p>
          <p class="corp-occasions__caption">(Birthday, Housewarming, Anniversary)</p>
        </div>
        <div class="corp-occasions__card">
          <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Collaborations</div></div>
          <p class="corp-occasions__label">Collaborations</p>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Corporate Marquee",
  "max_blocks": 30,
  "enabled_on": {
    "templates": [
      "index",
      "search.corporate-gifting",
      "page.corporate"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label above marquee",
      "default": "Trusted for every shoe — built to last"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label above marquee",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap between rows",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text position (laptop)"
