{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-commit-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .hp-sci-commit-{{ section.id }}__intro {
    max-width: 52ch;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .hp-sci-commit-{{ section.id }}__heading {
    margin: 0 0 clamp(20px, 3vw, 28px);
    line-height: 1.12;
  }

  .hp-sci-commit-{{ section.id }}__subtext {
    line-height: 1.65;
    margin: 0;
    color: {{ section.settings.subtext_color }};
  }

  .hp-sci-commit-{{ section.id }}__heading,
  .hp-sci-commit-{{ section.id }}__subtext,
  .hp-sci-commit-{{ section.id }}__day,
  .hp-sci-commit-{{ section.id }}__card-title,
  .hp-sci-commit-{{ section.id }}__card-text,
  .hp-sci-commit-{{ section.id }}__card-text p {
    color: #ffffff !important;
  }

  .hp-sci-commit-{{ section.id }}__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 14px);
    align-items: end;
  }

  .hp-sci-commit-{{ section.id }}__card {
    background: {{ section.settings.card_background }};
    color: {{ section.settings.card_text_color }};
    padding: clamp(24px, 3vw, 32px) clamp(18px, 2vw, 24px);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .hp-sci-commit-{{ section.id }}__card:nth-child(1) {
    min-height: clamp(260px, 28vw, 320px);
  }

  .hp-sci-commit-{{ section.id }}__card:nth-child(2) {
    min-height: clamp(300px, 32vw, 360px);
  }

  .hp-sci-commit-{{ section.id }}__card:nth-child(3) {
    min-height: clamp(340px, 36vw, 400px);
  }

  .hp-sci-commit-{{ section.id }}__card:nth-child(4) {
    min-height: clamp(380px, 40vw, 440px);
  }

  .hp-sci-commit-{{ section.id }}__day {
    margin: 0 0 14px;
  }

  .hp-sci-commit-{{ section.id }}__card-title {
    line-height: 1.15;
    margin: 0 0 16px;
  }

  .hp-sci-commit-{{ section.id }}__card-text {
    line-height: 1.6;
    margin: 0;
  }

  .hp-sci-commit-{{ section.id }}__card-text strong,
  .hp-sci-commit-{{ section.id }}__card-text b {
  }

  .hp-sci-commit-{{ section.id }}__graph-wrap {
    background: {{ section.settings.graph_background }};
    color: {{ section.settings.graph_text_color }};
    padding: clamp(32px, 5vw, 56px);
    margin-top: clamp(48px, 6vw, 72px);
  }

  .hp-sci-commit-{{ section.id }}__graph-title {
    margin: 0 0 8px;
  }

  .hp-sci-commit-{{ section.id }}__graph-sub {
    opacity: 0.75;
    margin: 0 0 24px;
  }

  .hp-sci-commit-{{ section.id }}__graph-media {
    min-height: {{ section.settings.graph_min_height }}px;
  }


  .hp-sci-commit-{{ section.id }}__text-position {
    transform: translate({{ section.settings.text_offset_x_desktop | default: 0 }}px, {{ section.settings.text_offset_y_desktop | default: 0 }}px);
  }

  @media screen and (max-width: 989px) {
    .hp-sci-commit-{{ section.id }}__cards {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .hp-sci-commit-{{ section.id }}__card:nth-child(n) {
      min-height: 240px;
    }
  
    .hp-sci-commit-{{ section.id }}__text-position {
      transform: translate({{ section.settings.text_offset_x_mobile | default: 0 }}px, {{ section.settings.text_offset_y_mobile | default: 0 }}px);
    }
}

  @media screen and (max-width: 599px) {
    .hp-sci-commit-{{ section.id }}__cards {
      grid-template-columns: 1fr;
    }
  }
  {% render 'hp-science-section-typography-styles', section: section %}
{%- endstyle -%}

<section class="hp-sci hp-sci-commit-{{ section.id }}">
  <div class="hp-sci__inner">
    <div class="hp-sci-commit-{{ section.id }}__intro hp-sci-commit-{{ section.id }}__text-position">
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-sci-commit-{{ section.id }}__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="hp-sci-commit-{{ section.id }}__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="hp-sci-commit-{{ section.id }}__cards">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'phase' -%}
            <article class="hp-sci-commit-{{ section.id }}__card" {{ block.shopify_attributes }}>
              {%- if block.settings.day_range != blank -%}
                <p class="hp-sci-commit-{{ section.id }}__day">{{ block.settings.day_range }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="hp-sci-commit-{{ section.id }}__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="hp-sci-commit-{{ section.id }}__card-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </article>
          {%- elsif block.type == 'column' -%}
            <article class="hp-sci-commit-{{ section.id }}__card" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <p class="hp-sci-commit-{{ section.id }}__day">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="hp-sci-commit-{{ section.id }}__card-text">{{ block.settings.text }}</div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <article class="hp-sci-commit-{{ section.id }}__card">
          <p class="hp-sci-commit-{{ section.id }}__day">Day 1 – 14</p>
          <h3 class="hp-sci-commit-{{ section.id }}__card-title">Calibration</h3>
          <div class="hp-sci-commit-{{ section.id }}__card-text"><p>Your skin is adjusting, and you start to feel a surface-level softness. The least any serum should do is make skin soft. We treat this as the starting line, not the finish.</p></div>
        </article>
        <article class="hp-sci-commit-{{ section.id }}__card">
          <p class="hp-sci-commit-{{ section.id }}__day">Day 14 – 28</p>
          <h3 class="hp-sci-commit-{{ section.id }}__card-title">First signals</h3>
          <div class="hp-sci-commit-{{ section.id }}__card-text"><p>Texture begins to change. <strong>Hydration</strong> holds longer and skin starts to look plumper, the foundation of glass skin. The people around you may notice before you do.</p></div>
        </article>
        <article class="hp-sci-commit-{{ section.id }}__card">
          <p class="hp-sci-commit-{{ section.id }}__day">Day 28 – 60</p>
          <h3 class="hp-sci-commit-{{ section.id }}__card-title">The shift</h3>
          <div class="hp-sci-commit-{{ section.id }}__card-text"><p>Pigmentation lifts. Breakout frequency reduces. Barrier resilience improves. The change is happening below the surface, in the <strong>structure</strong> itself.</p></div>
        </article>
        <article class="hp-sci-commit-{{ section.id }}__card">
          <p class="hp-sci-commit-{{ section.id }}__day">Day 60 – 75</p>
          <h3 class="hp-sci-commit-{{ section.id }}__card-title">Longevity</h3>
          <div class="hp-sci-commit-{{ section.id }}__card-text"><p>This is not the end. It's the baseline. Skin that functions as designed, maintaining from a structurally different starting point. The goal of regenerative science: a result that holds.</p></div>
        </article>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_graph_section -%}
    <div class="hp-sci-commit-{{ section.id }}__graph-wrap">
      <div class="hp-sci__inner">
        {%- if section.settings.graph_heading != blank -%}
          <h3 class="hp-sci-commit-{{ section.id }}__graph-title">{{ section.settings.graph_heading }}</h3>
        {%- endif -%}
        {%- if section.settings.graph_subheading != blank -%}
          <p class="hp-sci-commit-{{ section.id }}__graph-sub">{{ section.settings.graph_subheading }}</p>
        {%- endif -%}
        <div class="hp-sci-commit-{{ section.id }}__graph-media">
          {% render 'hp-science-media',
            image: section.settings.graph_image,
            video: section.settings.graph_video,
            animation_url: section.settings.graph_animation_url,
            show_placeholder: section.settings.show_graph_placeholder,
            placeholder_label: section.settings.graph_placeholder_label,
            min_height: section.settings.graph_min_height
          %}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

