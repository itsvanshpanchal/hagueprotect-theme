    {
      "type": "header",
      "content": "Optional graph"
    },
    {
      "type": "checkbox",
      "id": "show_graph_section",
      "label": "Show graph section",
      "default": false
    },
    {
      "type": "text",
      "id": "graph_heading",
      "label": "Graph heading",
      "default": "Slow start. Permanent gain."
    },
    {
      "type": "text",
      "id": "graph_subheading",
      "label": "Graph subheading",
      "default": "Results compound as your skin adapts to the protocol."
    },
    {
      "type": "image_picker",
      "id": "graph_image",
      "label": "Graph image"
    },
    {
      "type": "video",
      "id": "graph_video",
      "label": "Graph video / animation"
    },
    {
      "type": "url",
      "id": "graph_animation_url",
      "label": "Graph animation URL"
    },
    {
      "type": "checkbox",
      "id": "show_graph_placeholder",
      "label": "Show graph placeholder when empty",
      "default": true
    },
    {
      "type": "text",
      "id": "graph_placeholder_label",
      "label": "Graph placeholder label",
      "default": "Upload results graph or animation"
    },
    {
      "type": "range",
      "id": "graph_min_height",
      "label": "Graph min height",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "color",
      "id": "graph_background",
      "label": "Graph section background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "graph_text_color",
      "label": "Graph section text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Timeline phase",
      "settings": [
        {
          "type": "text",
          "id": "day_range",
          "label": "Day range",
          "default": "Day 1 – 14"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Phase title",
          "default": "Calibration"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text",
          "default": "<p>Your skin is adjusting, and you start to feel a surface-level softness. The least any serum should do is make skin soft. We treat this as the starting line, not the finish.</p>"
        }
