{%- style -%}
  .hp-the-arrival-{{ section.id }} {
    position: relative;
    background-color: {{ section.settings.bg_color }};
    color: #111;
    padding: 100px 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    font-family: var(--font-body-family, sans-serif);
  }

  /* ─── TOP LEFT INDICATOR ─── */
  .hp-arrival__indicator {
    position: absolute;
    top: 40px;
    left: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
  }
  .hp-arrival__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: {{ section.settings.glow_color }};
    box-shadow: 0 0 8px {{ section.settings.glow_color }};
  }

  /* ─── BACKGROUND WATERMARK 001 ─── */
  .hp-arrival__watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 45vw; /* Massive text */
    font-weight: 400;
    line-height: 1;
    color: rgba(0, 0, 0, 0.03);
    z-index: 0;
    pointer-events: none;
    white-space: nowrap;
    letter-spacing: -2vw;
    /* Crops the bottom half of the text for the flat cut-off effect */
    clip-path: inset(0 0 45% 0);
  }

  /* ─── CONCENTRIC CIRCLES ─── */
  .hp-arrival__circles {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
    pointer-events: none;
  }
  .hp-arrival__circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }
  .hp-arrival__circle--1 { width: 450px; height: 450px; }
  .hp-arrival__circle--2 { width: 700px; height: 700px; }
  .hp-arrival__circle--3 { width: 1000px; height: 1000px; }

  /* ─── MAIN VISUAL (GLOW + IMAGE) ─── */
  .hp-arrival__visual-wrap {
    position: relative;
    z-index: 2;
    margin-bottom: 40px;
    margin-top: 40px;
    /* Base styles (will be animated via JS scroll) */
    opacity: 0;
    transform: scale(0.8);
    /* No transition here so it scrubs instantly with scroll */
  }
  .hp-arrival__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: {{ section.settings.glow_color }};
    filter: blur(80px);
    opacity: 0.8;
    z-index: 1;
  }
  .hp-arrival__image-mask {
    position: relative;
    z-index: 2;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    overflow: hidden;
    /* subtle inner shadow to blend edges slightly */
    box-shadow: inset 0 0 10px rgba(0,0,0,0.05);
  }
  .hp-arrival__image-mask img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hp-arrival__placeholder {
    width: 100%;
    height: 100%;
    background-color: #e5e3dc;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
    font-size: 14px;
  }

  /* ─── TYPOGRAPHY BOTTOM ─── */
  .hp-arrival__text-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .hp-arrival__heading {
    font-size: 42px;
    font-weight: 400;
    margin: 0 0 12px 0;
    color: #111;
  }
  .hp-arrival__subheading {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 4px;
    color: rgba(0, 0, 0, 0.4);
    text-transform: uppercase;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hp-the-arrival-{{ section.id }} {
      padding: 80px 20px;
    }
    .hp-arrival__indicator {
      top: 20px;
      left: 20px;
    }
    .hp-arrival__watermark {
      font-size: 60vw;
    }
    .hp-arrival__glow, .hp-arrival__image-mask {
      width: 280px;
      height: 280px;
    }
    .hp-arrival__heading {
      font-size: 28px;
    }
  }
{%- endstyle -%}

<section class="hp-the-arrival-{{ section.id }}">
  
  <!-- Watermark and Circles -->
  <div class="hp-arrival__watermark">001</div>
  <div class="hp-arrival__circles">
    <div class="hp-arrival__circle hp-arrival__circle--1"></div>
    <div class="hp-arrival__circle hp-arrival__circle--2"></div>
    <div class="hp-arrival__circle hp-arrival__circle--3"></div>
  </div>

  <!-- Top Left Indicator -->
  <div class="hp-arrival__indicator">
    <div class="hp-arrival__dot"></div>
    <span>{{ section.settings.indicator_text }}</span>
  </div>

  <!-- Main Visual -->
  <div class="hp-arrival__visual-wrap">
    <div class="hp-arrival__glow"></div>
    <div class="hp-arrival__image-mask">
      {%- if section.settings.image -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- else -%}
        <div class="hp-arrival__placeholder">Upload Shoebox Image</div>
      {%- endif -%}
    </div>
  </div>

  <!-- Text -->
  <div class="hp-arrival__text-content">
    <h2 class="hp-arrival__heading">{{ section.settings.heading }}</h2>
    <p class="hp-arrival__subheading">{{ section.settings.subheading }}</p>
  </div>

</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var section = document.querySelector('.hp-the-arrival-{{ section.id }}');
  if (!section) return;
  var visualWrap = section.querySelector('.hp-arrival__visual-wrap');
  var watermark = section.querySelector('.hp-arrival__watermark');

  // Attach a single scroll listener to handle both effects scrubbed to scroll
  window.addEventListener('scroll', function() {
    var rect = section.getBoundingClientRect();
    
    // Only process if the section is somewhat in the viewport
    if (rect.top < window.innerHeight && rect.bottom > 0) {
      
      // 1. Scrubbed Fade & Scale for the Main Visual (Circle/Shoe)
      if (visualWrap) {
        // Start animation when section enters bottom of screen
        var startScroll = window.innerHeight; 
        // End animation when section is near the middle of the screen
        var endScroll = window.innerHeight * 0.4; 
        
        var progress = (startScroll - rect.top) / (startScroll - endScroll);
        progress = Math.max(0, Math.min(1, progress)); // clamp 0-1
        
        var scale = 0.8 + (progress * 0.2); // scales from 0.8 to 1.0
        
        visualWrap.style.opacity = progress.toFixed(3);
        visualWrap.style.transform = 'scale(' + scale.toFixed(3) + ')';
      }

      // 2. Parallax effect for the "001" background text
      if (watermark) {
        var scrollProgress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
        // Calculate Y offset (moves from ~ +100px to -100px based on scroll)
        var yOffset = (scrollProgress - 0.5) * -200; 
        watermark.style.transform = 'translate(-50%, calc(-50% + ' + yOffset + 'px))';
      }
    }
  });
});
</script>

{% schema %}
{
  "name": "The Arrival",
  "tag": "section",
  "class": "hp-arrival-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F3ED"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Neon Glow Color",
      "default": "#ccff00"
    },
    {
      "type": "text",
      "id": "indicator_text",
      "label": "Top Left Indicator",
      "default": "03 — THE ARRIVAL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Shoe Box Image",
      "info": "Upload a square image. It will be cropped into a circle automatically."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SRIGEN 001 — “VOLT”"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FIRST AND FINAL COLORWAY"
    }
  ],
  "presets": [
    {
      "name": "The Arrival"
    }
  ]
}
{% endschema %}
