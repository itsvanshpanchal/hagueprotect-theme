{%- style -%}
  .hp-the-arrival-{{ section.id }} {
    position: relative;
    background-color: {{ section.settings.bg_color }};
    height: 250vh; /* Creates scrollable space for the animation */
    font-family: var(--font-body-family, sans-serif);
  }

  .hp-arrival__sticky {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #111;
  }

  /* ─── TOP LEFT INDICATOR ─── */
  .hp-arrival__indicator {
    position: absolute;
    top: 40px;
    left: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
  }
  .hp-arrival__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: {{ section.settings.glow_color }};
    box-shadow: 0 0 8px {{ section.settings.glow_color }};
  }

  /* ─── BACKGROUND WATERMARK 001 ─── */
  .hp-arrival__watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -30%);
    font-size: 45vw; /* Massive text */
    font-weight: 400;
    line-height: 1;
    color: #555555; /* Dark grey color */
    z-index: 0;
    pointer-events: none;
    white-space: nowrap;
    letter-spacing: -2vw;
  }


  .hp-arrival__circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid #555555; /* Dark grey border */
  }
  .hp-arrival__circle--1 { width: 450px; height: 450px; }

  /* ─── MAIN VISUAL (GLOW + IMAGE) ─── */
  .hp-arrival__visual-wrap {
    position: relative;
    z-index: 2;
    margin-bottom: 40px;
    margin-top: 40px;
    /* Base styles (will be animated via JS scroll) */
    opacity: 0; /* Starts completely disappeared */
    transform: scale(2.0);
    will-change: transform, opacity;
  }
  .hp-arrival__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: {{ section.settings.glow_color }};
    filter: blur(80px);
    opacity: 0.8;
    z-index: 1;
  }
  .hp-arrival__image-mask {
    position: relative;
    z-index: 2;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    overflow: hidden;
    /* subtle inner shadow to blend edges slightly */
    box-shadow: inset 0 0 10px rgba(0,0,0,0.05);
  }
  .hp-arrival__image-mask img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hp-arrival__placeholder {
    width: 100%;
    height: 100%;
    background-color: #e5e3dc;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
    font-size: 14px;
  }

  /* ─── TYPOGRAPHY BOTTOM ─── */
  .hp-arrival__text-content {
    position: relative;
    z-index: 2;
    text-align: center;
    opacity: 0;
    transform: translateY(60px);
    will-change: transform, opacity;
  }
  .hp-arrival__heading {
    font-size: 42px;
    font-weight: 400;
    margin: 0 0 12px 0;
    color: #111;
  }
  .hp-arrival__subheading {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 4px;
    color: rgba(0, 0, 0, 0.4);
    text-transform: uppercase;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hp-arrival__indicator {
      top: 20px;
      left: 20px;
    }
    .hp-arrival__watermark {
      font-size: 60vw;
    }
    .hp-arrival__glow, .hp-arrival__image-mask {
      width: 280px;
      height: 280px;
    }
    .hp-arrival__heading {
      font-size: 28px;
    }
  }
{%- endstyle -%}

<section class="hp-the-arrival-{{ section.id }}">
  <div class="hp-arrival__sticky">
    <!-- Watermark and Circles -->
    <div class="hp-arrival__watermark">001</div>


    <!-- Top Left Indicator -->
    <div class="hp-arrival__indicator">
      <div class="hp-arrival__dot"></div>
      <span>{{ section.settings.indicator_text }}</span>
    </div>

    <!-- Main Visual -->
    <div class="hp-arrival__visual-wrap">
      <div class="hp-arrival__circle hp-arrival__circle--1"></div>
      <div class="hp-arrival__glow"></div>
      <div class="hp-arrival__image-mask">
        {%- if section.settings.image -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          <div class="hp-arrival__placeholder">Upload Shoebox Image</div>
        {%- endif -%}
      </div>
    </div>

    <!-- Text -->
    <div class="hp-arrival__text-content">
      <h2 class="hp-arrival__heading">{{ section.settings.heading }}</h2>
      <p class="hp-arrival__subheading">{{ section.settings.subheading }}</p>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var section = document.querySelector('.hp-the-arrival-{{ section.id }}');
  if (!section) return;
  var stickyEl = section.querySelector('.hp-arrival__sticky');
  var visualWrap = section.querySelector('.hp-arrival__visual-wrap');
  var watermark = section.querySelector('.hp-arrival__watermark');
  var textContent = section.querySelector('.hp-arrival__text-content');

  // We will lerp (smooth) the progress value
  var targetProgress = 0;
  var currentProgress = 0;
  var isPinned = false;
  var hasScrolledPast = false;

  function updateTargetProgress() {
    var rect = section.getBoundingClientRect();
    var maxScroll = rect.height - window.innerHeight;
    
    // Check pinning state for layout
    if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
      if (!isPinned) {
        stickyEl.style.position = 'fixed';
        stickyEl.style.top = '0px';
        stickyEl.style.bottom = 'auto';
        stickyEl.style.zIndex = '9';
        isPinned = true;
      }
      hasScrolledPast = false;
      // Target progress is based on actual scroll position
      targetProgress = Math.abs(rect.top) / maxScroll;
      targetProgress = Math.max(0, Math.min(1, targetProgress));

    } else if (rect.top > 0) {
      if (isPinned || hasScrolledPast) {
        stickyEl.style.position = 'absolute';
        stickyEl.style.top = '0px';
        stickyEl.style.bottom = 'auto';
        stickyEl.style.zIndex = '2';
        isPinned = false;
        hasScrolledPast = false;
      }
      targetProgress = 0; // Above section
    } else if (rect.bottom < window.innerHeight) {
      if (isPinned || !hasScrolledPast) {
        stickyEl.style.position = 'absolute';
        stickyEl.style.top = 'auto';
        stickyEl.style.bottom = '0px';
        stickyEl.style.zIndex = '2';
        isPinned = false;
        hasScrolledPast = true;
      }
      targetProgress = 1; // Below section
    }
  }

  function renderLoop() {
    // Lerp formula: current = current + (target - current) * easing
    // 0.08 provides a very buttery smooth trailing effect
    currentProgress += (targetProgress - currentProgress) * 0.08;

    // 1. Shoebox scales DOWN from 2.0 to 1.0 smoothly, and fades in from 0
    if (visualWrap) {
      var scale = 2.0 - (currentProgress * 1.0);
      visualWrap.style.transform = 'scale(' + scale.toFixed(4) + ')';
      
      // Fade in quickly in the first 25% of scroll, so if scrolled up to 0, it completely disappears
      var visualOpacity = Math.min(1, currentProgress * 4); 
      visualWrap.style.opacity = visualOpacity.toFixed(3);
    }

    // 2. Text fades in and slides up (finishing early at ~40% scroll)
    if (textContent) {
      var textProgress = Math.min(1, currentProgress * 2.5);
      var textTranslate = 60 - (textProgress * 60);
      textContent.style.opacity = textProgress.toFixed(3);
      textContent.style.transform = 'translateY(' + textTranslate.toFixed(2) + 'px)';
    }
    
    // 3. Parallax for Watermark '001'
    if (watermark) {
      var yOffset = -30 - (currentProgress * 40);
      watermark.style.transform = 'translate(-50%, ' + yOffset.toFixed(2) + '%)';
    }

    // Loop forever
    window.requestAnimationFrame(renderLoop);
  }

  // Update target on scroll
  window.addEventListener('scroll', updateTargetProgress, { passive: true });
  
  // Kickoff
  updateTargetProgress();
  window.requestAnimationFrame(renderLoop);
});
</script>

{% schema %}
{
  "name": "The Arrival",
  "tag": "section",
  "class": "hp-arrival-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F3ED"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Neon Glow Color",
      "default": "#ccff00"
    },
    {
      "type": "text",
      "id": "indicator_text",
      "label": "Top Left Indicator",
      "default": "03 — THE ARRIVAL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Shoe Box Image",
      "info": "Upload a square image. It will be cropped into a circle automatically."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SRIGEN 001 — “VOLT”"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FIRST AND FINAL COLORWAY"
    }
  ],
  "presets": [
    {
      "name": "The Arrival"
    }
  ]
}
{% endschema %}
