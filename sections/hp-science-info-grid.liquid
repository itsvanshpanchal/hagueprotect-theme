{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-grid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .hp-sci-grid-{{ section.id }}__layout {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }

  .hp-sci-grid-{{ section.id }}__rail {
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }

  .hp-sci-grid-{{ section.id }}__rail-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    text-transform: uppercase;
    color: {{ section.settings.rail_color }};
    white-space: nowrap;
    margin: 0;
  }

  .hp-sci-grid-{{ section.id }}__heading {
    line-height: 1.06;
    margin: 0 0 clamp(48px, 7vw, 88px);
    max-width: 14ch;
  }

  .hp-sci-grid-{{ section.id }}__heading-line {
    display: block;
  }

  .hp-sci-grid-{{ section.id }}__heading-accent {
  }

  .hp-sci-grid-{{ section.id }}__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px) clamp(32px, 4vw, 56px);
  }

  .hp-sci-grid-{{ section.id }}__num {
    line-height: 1;
    margin: 0 0 clamp(18px, 2.5vw, 28px);
    color: inherit;
  }

  .hp-sci-grid-{{ section.id }}__col-title {
    margin: 0 0 14px;
    line-height: 1.15;
  }

  .hp-sci-grid-{{ section.id }}__col-text {
    line-height: 1.6;
    margin: 0;
    max-width: 42ch;
    color: {{ section.settings.body_color }};
  }


  .hp-sci-grid-{{ section.id }}__text-position {
    transform: translate({{ section.settings.text_offset_x_desktop | default: 0 }}px, {{ section.settings.text_offset_y_desktop | default: 0 }}px);
  }

  @media screen and (max-width: 989px) {
    .hp-sci-grid-{{ section.id }}__layout {
      grid-template-columns: 1fr;
    }

    .hp-sci-grid-{{ section.id }}__rail {
      justify-content: flex-start;
    }

    .hp-sci-grid-{{ section.id }}__rail-text {
      writing-mode: horizontal-tb;
      transform: none;
    }
  
    .hp-sci-grid-{{ section.id }}__text-position {
      transform: translate({{ section.settings.text_offset_x_mobile | default: 0 }}px, {{ section.settings.text_offset_y_mobile | default: 0 }}px);
    }
}

  @media screen and (max-width: 640px) {
    .hp-sci-grid-{{ section.id }}__cols {
      grid-template-columns: 1fr;
    }
  }
  {% render 'hp-science-section-typography-styles', section: section %}
{%- endstyle -%}

<section class="hp-sci hp-sci-grid-{{ section.id }}">
  <div class="hp-sci__inner">
    <div class="hp-sci-grid-{{ section.id }}__layout">
      {%- if section.settings.sidebar_label != blank -%}
        <div class="hp-sci-grid-{{ section.id }}__rail" aria-hidden="true">
          <p class="hp-sci-grid-{{ section.id }}__rail-text">{{ section.settings.sidebar_label }}</p>
        </div>
      {%- endif -%}

      <div class="hp-sci-grid-{{ section.id }}__main hp-sci-grid-{{ section.id }}__text-position">
        {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
          <h2 class="hp-sci-grid-{{ section.id }}__heading">
            {%- if section.settings.heading_line_1 != blank -%}
              <span class="hp-sci-grid-{{ section.id }}__heading-line">{{ section.settings.heading_line_1 }}</span>
            {%- endif -%}
            {%- if section.settings.heading_line_2 != blank or section.settings.heading_accent != blank -%}
              <span class="hp-sci-grid-{{ section.id }}__heading-line">
                {{- section.settings.heading_line_2 -}}
                {%- if section.settings.heading_accent != blank -%}
                  <span class="hp-sci-grid-{{ section.id }}__heading-accent">{{ section.settings.heading_accent }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        <div class="hp-sci-grid-{{ section.id }}__cols">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <article class="hp-sci-grid-{{ section.id }}__col" {{ block.shopify_attributes }}>
                {%- if block.settings.number != blank -%}
                  <p class="hp-sci-grid-{{ section.id }}__num">{{ block.settings.number }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="hp-sci-grid-{{ section.id }}__col-title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="hp-sci-grid-{{ section.id }}__col-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </article>
            {%- endfor -%}
          {%- else -%}
            <article class="hp-sci-grid-{{ section.id }}__col">
              <p class="hp-sci-grid-{{ section.id }}__num">01</p>
              <h3 class="hp-sci-grid-{{ section.id }}__col-title">Cell renewal slows</h3>
              <p class="hp-sci-grid-{{ section.id }}__col-text">At 25, skin renews itself every 28 days. By 40, that cycle has stretched to 45–60 days. The same biology is there. It just needs fewer interruptions and more support to keep pace.</p>
            </article>
            <article class="hp-sci-grid-{{ section.id }}__col">
              <p class="hp-sci-grid-{{ section.id }}__num">02</p>
              <h3 class="hp-sci-grid-{{ section.id }}__col-title">Collagen production drops</h3>
              <p class="hp-sci-grid-{{ section.id }}__col-text">After 25, collagen production falls by roughly 1% per year. The structural protein that keeps skin firm isn't disappearing. Your body is producing less of it. That's a signal problem, not a structural one.</p>
            </article>
            <article class="hp-sci-grid-{{ section.id }}__col">
              <p class="hp-sci-grid-{{ section.id }}__num">03</p>
              <h3 class="hp-sci-grid-{{ section.id }}__col-title">The barrier weakens</h3>
              <p class="hp-sci-grid-{{ section.id }}__col-text">Your skin barrier is a lipid matrix: ceramides, fatty acids, cholesterol in specific ratios. When that matrix is disrupted by over-actives, the skin loses water faster than it produces it. Most actives make this worse.</p>
            </article>
            <article class="hp-sci-grid-{{ section.id }}__col">
              <p class="hp-sci-grid-{{ section.id }}__num">04</p>
              <h3 class="hp-sci-grid-{{ section.id }}__col-title">Chronic inflammation builds</h3>
              <p class="hp-sci-grid-{{ section.id }}__col-text">Low-grade, invisible inflammation is the root of almost every visible skin concern: spots, uneven tone, sensitivity, premature ageing. The industry addresses the symptoms. Longevity science addresses the source.</p>
            </article>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

