{%- style -%}
  {% render 'section-typography-vars', section: section %}

  .fc-heading .hp-heading-line--2,
  body.template-index #MainContent .fc-heading .hp-heading-line--2 {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    font-weight: 300 !important;
    font-style: oblique 15deg !important;
    font-synthesis: style !important;
  }

  :root {
    --fc-bg: #fdfeff;
    --fc-card-bg: #fdfeff;
    --fc-border: #D1D2D4;
    --fc-border-hover: #B8B9BB;
    --fc-text: #111111;
    --fc-muted: #666668;
    --fc-primary: #c6c2c2ff;
  }

  /* Dark mode variable updates if applicable */
  @media (prefers-color-scheme: dark) {
    :root {
      --fc-bg: #fdfeff;
      --fc-card-bg: #fdfeff;
      --fc-border: #D1D2D4;
      --fc-border-hover: #B8B9BB;
      --fc-text: #111111;
      --fc-muted: #666668;
    }
  }

  .fc-section {
    padding: 60px 0;
    background-color: #ffffff;
    font-family: var(--font-family-sans, 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif);
    overflow: hidden;
  }

  /* Homepage-only dark theme */
  body.template-index .fc-section {
    background-color: #0a0a0a;
    color: #ffffff;
  }

  body.template-index .fc-heading {
    color: #ffffff;
  }

  body.template-index .fc-heading .hp-heading-pair--stack {
    gap: 0.15em;
  }

  body.template-index .fc-subtitle {
    color: #ffffff;
  }

  .fc-container {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 0 var(--homepage-section-gutter, 8px);
    position: relative;
    box-sizing: border-box;
  }

  .fc-header {
    text-align: var(--section-heading-align, left);
  }

  .fc-heading {
    color: var(--fc-text);
    margin: 0;
    word-break: break-word;
    overflow-wrap: break-word;
    line-height: 1.0;
  }

  .fc-heading .hp-heading-line {
    display: inline !important;
  }

  .fc-subtitle {
    margin: 0;
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 19px;
  }

  @media screen and (max-width: 989px) {
    #MainContent #shopify-section-{{ section.id }} .fc-subtitle,
    #shopify-section-{{ section.id }} .fc-subtitle {
      font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
      font-size: 15px !important;
      font-weight: 600 !important;
      font-style: normal !important;
      font-synthesis: none !important;
      -webkit-text-stroke: 0.45px currentColor !important;
      paint-order: stroke fill !important;
      text-shadow: none !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
    }
  }

  /* ─── SCATTERED MOSAIC — exact match to reference image ──────────────
     Layout (desktop):
       Card 1 (large portrait)   → top-left
       Card 2 (small landscape)  → below Card 1, slightly right
       Heading text              → centre, floating free
       Card 3 (small dark card)  → top-right quadrant
       Card 4 (large landscape)  → bottom-right
  ─────────────────────────────────────────────────────────────────── */

  .fc-section {
    padding: 0;
    overflow: visible;
  }

  .fc-container {
    padding: 0 var(--homepage-section-gutter, 32px);
  }

  /* The scattered canvas — fixed height on desktop.
     Must be tall enough to hold two stacked 230px cards + gaps + parallax start offsets.
     Cards: top row at ~20px, bottom row at ~278px, each 230px tall → need ~580px
     Extra 30px for the parallax startY offset (cards begin 120px lower). */
  .fc-scatter {
    position: relative;
    width: 100%;
    height: 560px;
    overflow: visible;
  }

  /* ── Shared card base ────────────────────────────────────────────── */
  .fc-scard {
    position: absolute;
    border-radius: 18px;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    display: block;
    will-change: transform;
    /* NOTE: NO transition on transform — the scroll-parallax rAF loop
       drives transform directly. A CSS transition here would fight the
       requestAnimationFrame updates and make cards appear frozen. */
    transition: box-shadow 0.4s ease; /* only shadow, not transform */
    transform: translateY(var(--fc-parallax-y, 0px));
  }

  .fc-scard:hover {
    box-shadow: 0 24px 60px rgba(0,0,0,0.18);
    z-index: 10;
  }

  .fc-scard .fc-scard-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: hidden;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .fc-scard:hover .fc-scard-img {
    transform: scale(1.05);
  }

  .fc-scard .fc-scard-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Card label (title + count) pinned to bottom-left */
  .fc-scard-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    padding: 14px 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.60) 0%, rgba(0,0,0,0) 100%);
    box-sizing: border-box;
  }

  .fc-scard-name {
    font-family: var(--font-family-sans, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 2px;
    display: block;
    text-shadow: 0 1px 8px rgba(0,0,0,0.5);
  }

  .fc-scard-count {
    font-size: 11px;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    margin: 0;
    display: block;
  }

  /* ── CARD 1: top-left ────────────────────────────────────────────── */
  /* Uniform size for all cards: 25% wide × 230px tall.                 */
  /* Only the top/left/right position differs between cards.            */
  .fc-scard--1 {
    left: 0;
    top: 20px;
    width: 25%;
    height: 230px;
  }

  /* ── CARD 2: bottom-left, offset right ──────────────────────────── */
  .fc-scard--2 {
    left: 6%;
    top: 278px;
    width: 25%;
    height: 230px;
  }

  /* ── Heading text block — floats free in the centre ─────────────── */
  .fc-scatter-text {
    position: absolute;
    left: 31%;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 26%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
  }

  .fc-scatter-text .fc-subtitle {
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #999;
    margin: 0;
  }

  .fc-scatter-text .fc-heading {
    margin: 0;
    line-height: 1.08;
    color: #111;
  }

  /* Dark homepage variant */
  body.template-index .fc-scatter-text .fc-heading { color: #fff; }
  body.template-index .fc-scatter-text .fc-subtitle { color: rgba(255,255,255,0.45); }

  /* ── CARD 3: top-right ───────────────────────────────────────────── */
  .fc-scard--3 {
    right: 1%;
    top: 20px;
    width: 25%;
    height: 230px;
    background-color: #111;
  }

  /* ── CARD 4: bottom-right ────────────────────────────────────────── */
  .fc-scard--4 {
    right: 1%;
    top: 278px;
    width: 25%;
    height: 230px;
  }

  /* ── MOBILE: single column stack ─────────────────────────────────── */
  @media (max-width: 767px) {
    .fc-section {
      padding: 28px 0 8px;
      background-color: #fff;
    }

    body.template-index .fc-section {
      background-color: #0a0a0a;
    }

    .fc-container {
      padding: 0 var(--homepage-section-gutter, 16px);
    }

    /* On mobile, switch to a normal flow layout */
    .fc-scatter {
      position: static;
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Heading sits at top */
    .fc-scatter-text {
      position: static;
      transform: none;
      width: 100%;
      margin-bottom: 16px;
    }

    .fc-scatter-text .fc-heading {
      font-size: clamp(22px, 6vw, 30px) !important;
      line-height: 1.1;
    }

    /* Cards: 2-column grid */
    .fc-mobile-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .fc-scard {
      position: static;
      width: 100% !important;
      height: 0 !important;
      padding-bottom: 100%;
      transform: none !important;
      border-radius: 14px;
    }

    .fc-scard--3 {
      background-color: #111;
    }
  }

  @media (max-width: 380px) {
    .fc-mobile-grid {
      gap: 10px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fc_heading_text = section.settings.heading | default: 'Every Material Deserves the Right Care'
  assign block_1 = section.blocks[0]
  assign block_2 = section.blocks[1]
  assign block_3 = section.blocks[2]
  assign block_4 = section.blocks[3]
-%}

<section class="fc-section" aria-label="Every Material Deserves the Right Care">
  <div class="fc-container">

    <!-- Desktop scattered layout -->
    <div class="fc-scatter" id="fc-scatter-{{ section.id }}">

      <!-- Card 1: Large portrait, top-left -->
      {%- if block_1 -%}
        {%- assign link1 = block_1.settings.link | default: '#' -%}
        <a href="{{ link1 }}" class="fc-scard fc-scard--1" {{ block_1.shopify_attributes }}>
          <div class="fc-scard-img">
            {%- if block_1.settings.image != blank -%}
              <img src="{{ block_1.settings.image | image_url: width: 800 }}" alt="{{ block_1.settings.title }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="fc-scard-info">
            <span class="fc-scard-name">{{ block_1.settings.title }}</span>
            <span class="fc-scard-count">{{ block_1.settings.product_count | default: '0 products' }}</span>
          </div>
        </a>
      {%- endif -%}

      <!-- Card 2: Small landscape, bottom-left -->
      {%- if block_2 -%}
        {%- assign link2 = block_2.settings.link | default: '#' -%}
        <a href="{{ link2 }}" class="fc-scard fc-scard--2" {{ block_2.shopify_attributes }}>
          <div class="fc-scard-img">
            {%- if block_2.settings.image != blank -%}
              <img src="{{ block_2.settings.image | image_url: width: 600 }}" alt="{{ block_2.settings.title }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="fc-scard-info">
            <span class="fc-scard-name">{{ block_2.settings.title }}</span>
            <span class="fc-scard-count">{{ block_2.settings.product_count | default: '0 products' }}</span>
          </div>
        </a>
      {%- endif -%}

      <!-- Heading text — floats free in the centre -->
      <div class="fc-scatter-text">
        {%- if section.settings.subtitle != blank -%}
          <p class="fc-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        <h2 class="fc-heading">{% render 'section-heading-text', text: fc_heading_text, line2: section.settings.heading_line2, line2_color: section.settings.heading_line2_color, accent_last_word: section.settings.accent_line2, accent_color: section.settings.heading_line2_color %}</h2>
      </div>

      <!-- Card 3: Small dark card, top-right -->
      {%- if block_3 -%}
        {%- assign link3 = block_3.settings.link | default: '#' -%}
        <a href="{{ link3 }}" class="fc-scard fc-scard--3" {{ block_3.shopify_attributes }}>
          <div class="fc-scard-img">
            {%- if block_3.settings.image != blank -%}
              <img src="{{ block_3.settings.image | image_url: width: 600 }}" alt="{{ block_3.settings.title }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="fc-scard-info">
            <span class="fc-scard-name">{{ block_3.settings.title }}</span>
            <span class="fc-scard-count">{{ block_3.settings.product_count | default: '0 products' }}</span>
          </div>
        </a>
      {%- endif -%}

      <!-- Card 4: Large landscape, bottom-right -->
      {%- if block_4 -%}
        {%- assign link4 = block_4.settings.link | default: '#' -%}
        <a href="{{ link4 }}" class="fc-scard fc-scard--4" {{ block_4.shopify_attributes }}>
          <div class="fc-scard-img">
            {%- if block_4.settings.image != blank -%}
              <img src="{{ block_4.settings.image | image_url: width: 900 }}" alt="{{ block_4.settings.title }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="fc-scard-info">
            <span class="fc-scard-name">{{ block_4.settings.title }}</span>
            <span class="fc-scard-count">{{ block_4.settings.product_count | default: '0 products' }}</span>
          </div>
        </a>
      {%- endif -%}

    </div><!-- /.fc-scatter -->

    <!-- Mobile: heading + 2-column grid -->
    <!-- (handled purely by CSS on .fc-scatter and .fc-scard) -->

  </div>
</section>

<script>
  (function() {
    function initFcScatterParallax() {
      if (window.innerWidth <= 767) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const scatter = document.getElementById('fc-scatter-{{ section.id }}');
      if (!scatter) return;

      const cards = scatter.querySelectorAll('.fc-scard');
      if (cards.length === 0) return;

      // Each card: how far below its resting point it starts, and how fast it settles
      const cfg = [
        { startY: 70,  finishAt: 0.50 },  // Card 1 — large portrait, fastest
        { startY: 100, finishAt: 0.68 },  // Card 2 — small landscape
        { startY: 85,  finishAt: 0.82 },  // Card 3 — small dark card
        { startY: 120, finishAt: 1.00 },  // Card 4 — large landscape, slowest
      ];

      // Pre-set all cards to their starting Y offset
      cards.forEach((card, i) => {
        const c = cfg[i] || cfg[cfg.length - 1];
        card.style.setProperty('--fc-parallax-y', c.startY + 'px');
      });

      let active = false;
      let rafId;

      const tick = () => {
        if (!active) return;
        const rect = scatter.getBoundingClientRect();
        const wh = window.innerHeight;
        let progress = (wh - rect.top) / (wh * 0.75);
        if (progress < 0) progress = 0;
        if (progress > 1) progress = 1;

        cards.forEach((card, i) => {
          const c = cfg[i] || cfg[cfg.length - 1];
          let sp = progress / c.finishAt;
          if (sp > 1) sp = 1;
          const ease = 1 - Math.pow(1 - sp, 3); // cubic ease-out
          card.style.setProperty('--fc-parallax-y', (c.startY * (1 - ease)) + 'px');
        });

        rafId = requestAnimationFrame(tick);
      };

      new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            active = true;
            rafId = requestAnimationFrame(tick);
          } else {
            active = false;
            if (rafId) cancelAnimationFrame(rafId);
          }
        });
      }, { root: null, threshold: 0, rootMargin: '120px 0px 0px 0px' }).observe(scatter);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFcScatterParallax);
    } else {
      initFcScatterParallax();
    }
    document.addEventListener('shopify:section:load', initFcScatterParallax);
  })();
</script>

