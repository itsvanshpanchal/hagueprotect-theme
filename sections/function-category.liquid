{%- style -%}
  {% render 'section-typography-vars', section: section %}

  .fc-heading .hp-heading-line--2,
  body.template-index #MainContent .fc-heading .hp-heading-line--2 {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
    font-weight: 300 !important;
    font-style: oblique 15deg !important;
    font-synthesis: style !important;
  }

  :root {
    --fc-bg: #fdfeff;
    --fc-card-bg: #fdfeff;
    --fc-border: #D1D2D4;
    --fc-border-hover: #B8B9BB;
    --fc-text: #111111;
    --fc-muted: #666668;
    --fc-primary: #c6c2c2ff;
  }

  /* Dark mode variable updates if applicable */
  @media (prefers-color-scheme: dark) {
    :root {
      --fc-bg: #fdfeff;
      --fc-card-bg: #fdfeff;
      --fc-border: #D1D2D4;
      --fc-border-hover: #B8B9BB;
      --fc-text: #111111;
      --fc-muted: #666668;
    }
  }

  .fc-section {
    padding: 60px 0;
    background-color: #ffffff;
    font-family: var(--font-family-sans, 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif);
    overflow: hidden;
  }

  /* Homepage-only dark theme */
  body.template-index .fc-section {
    background-color: #0a0a0a;
    color: #ffffff;
  }

  body.template-index .fc-heading {
    color: #ffffff;
  }

  body.template-index .fc-heading .hp-heading-pair--stack {
    gap: 0.15em;
  }

  body.template-index .fc-subtitle {
    color: #ffffff;
  }

  .fc-container {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 0 var(--homepage-section-gutter, 8px);
    position: relative;
    box-sizing: border-box;
  }

  .fc-header {
    text-align: var(--section-heading-align, left);
  }

  .fc-heading {
    color: var(--fc-text);
    margin: 0;
    word-break: break-word;
    overflow-wrap: break-word;
    line-height: 1.0;
  }

  .fc-heading .hp-heading-line {
    display: inline !important;
  }

  .fc-subtitle {
    margin: 0;
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 19px;
  }

  @media screen and (max-width: 989px) {
    #MainContent #shopify-section-{{ section.id }} .fc-subtitle,
    #shopify-section-{{ section.id }} .fc-subtitle {
      font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
      font-size: 15px !important;
      font-weight: 600 !important;
      font-style: normal !important;
      font-synthesis: none !important;
      -webkit-text-stroke: 0.45px currentColor !important;
      paint-order: stroke fill !important;
      text-shadow: none !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
    }
  }

  /* ─── DESKTOP MOSAIC ─────────────────────────────────────────────── */
  .fc-mosaic-layout {
    display: grid;
    /* 4 equal columns */
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto;
    gap: 20px;
    align-items: start;
    padding: 50px 0 60px;
    position: relative;
  }

  /* Card sizes & positions — reference: two cards left, text centre, two cards right */
  /* Card 1 — top-left, taller */
  .fc-mosaic-card:nth-child(1) {
    grid-column: 1;
    grid-row: 1 / 2;
    aspect-ratio: 4 / 5;
    margin-top: 0;
    will-change: transform;
    transform: translateY(calc(var(--fc-stagger, 0px) + var(--fc-parallax-y, 0px)));
    --fc-stagger: 0px;
  }

  /* Card 2 — bottom-left, wider */
  .fc-mosaic-card:nth-child(2) {
    grid-column: 2;
    grid-row: 1 / 2;
    aspect-ratio: 4 / 5;
    will-change: transform;
    transform: translateY(calc(var(--fc-stagger, 0px) + var(--fc-parallax-y, 0px)));
    --fc-stagger: 60px;
  }

  /* Heading text block — centre */
  .fc-mosaic-text {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 20px 12px;
    gap: 8px;
    align-self: center;
  }

  /* Card 3 — top-right */
  .fc-mosaic-card:nth-child(3) {
    grid-column: 4;
    grid-row: 1;
    aspect-ratio: 4 / 3.2;
    will-change: transform;
    transform: translateY(calc(var(--fc-stagger, 0px) + var(--fc-parallax-y, 0px)));
    --fc-stagger: -20px;
  }

  /* Card 4 — bottom-right — spans below card 3 */
  .fc-mosaic-card:nth-child(4) {
    grid-column: 4;
    grid-row: 2;
    aspect-ratio: 4 / 3.2;
    will-change: transform;
    transform: translateY(calc(var(--fc-stagger, 0px) + var(--fc-parallax-y, 0px)));
    --fc-stagger: 10px;
  }

  /* Adjust: when we have 4 cards but only 4 columns, make col 3 the text,
     and put card 3+4 in col 4 stacked. Col 2 spans 1 row tall. */
  /* Re-set row spans */
  .fc-mosaic-card:nth-child(1) { grid-row: 1 / 3; }
  .fc-mosaic-card:nth-child(2) { grid-row: 1 / 3; }
  .fc-mosaic-text                { grid-row: 1 / 3; align-self: center; }

  /* ── Shared card styles ────────────────────────────────────────── */
  .fc-mosaic-card {
    position: relative;
    border-radius: var(--homepage-corner, 20px);
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background-color: #1a1a1a;
    transition:
      transform 0.30s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.35s ease;
  }

  .fc-mosaic-card:hover {
    box-shadow: 0 28px 60px rgba(0,0,0,0.22);
  }

  .fc-mosaic-card .fc-category-info {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 3;
    padding: 16px 18px;
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 100%);
    width: 100%;
    box-sizing: border-box;
  }

  .fc-mosaic-card .fc-illustration {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    border-radius: inherit;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .fc-mosaic-card:hover .fc-illustration {
    transform: scale(1.04);
  }

  .fc-mosaic-card .fc-illustration img,
  .fc-mosaic-card .fc-illustration svg {
    width: 100% !important;
    height: 100% !important;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  /* Heading overlaid in mosaic text cell */
  .fc-mosaic-text .fc-subtitle {
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #888;
    margin: 0;
  }

  .fc-mosaic-text .fc-heading {
    margin: 0;
    color: var(--fc-text, #111);
  }

  body.template-index .fc-mosaic-text .fc-heading {
    color: #ffffff;
  }

  body.template-index .fc-mosaic-text .fc-subtitle {
    color: rgba(255,255,255,0.5);
  }

  /* ── Navigation arrow (only shows when cards overflow) ─────────── */
  .fc-nav {
    display: none; /* hidden in mosaic mode */
  }
  .fc-progress-container {
    display: none;
  }

  /* ── MOBILE: 2-column grid ──────────────────────────────────────── */
  @media (max-width: 767px) {
    .fc-section {
      padding: 28px 0 24px;
      background-color: #ffffff;
    }

    body.template-index .fc-section {
      background-color: #0a0a0a;
    }

    .fc-container {
      padding: 0 var(--homepage-section-gutter, 6px);
    }

    .fc-mosaic-layout {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      column-gap: 14px;
      row-gap: 16px;
      padding: 16px 0 0;
    }

    /* Flatten all mosaic overrides for mobile */
    .fc-mosaic-card:nth-child(1),
    .fc-mosaic-card:nth-child(2),
    .fc-mosaic-card:nth-child(3),
    .fc-mosaic-card:nth-child(4) {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: 1 / 1;
      transform: none !important;
      --fc-stagger: 0px;
      --fc-parallax-y: 0px;
      margin-top: 0;
    }

    /* Text block becomes a full-width header row */
    .fc-mosaic-text {
      grid-column: 1 / -1;
      grid-row: auto;
      padding: 0;
      align-items: flex-start;
    }

    .fc-mosaic-text .fc-subtitle {
      font-size: 12px;
    }

    .fc-mosaic-text .fc-heading {
      font-size: clamp(22px, 6vw, 30px) !important;
      line-height: 1.1;
    }

    .fc-category-name {
      font-size: 14px;
    }

    .fc-product-count {
      font-size: 12px;
    }

    .fc-nav,
    .fc-progress-container {
      display: none !important;
    }
  }

  @media (max-width: 380px) {
    .fc-mosaic-layout {
      column-gap: 12px;
      row-gap: 14px;
    }
    .fc-category-name {
      font-size: 13px;
    }
    .fc-mosaic-card .fc-category-info {
      padding: 10px;
    }
  }
{%- endstyle -%}

<section class="fc-section" aria-label="Every Material Deserves the Right Care">
  <div class="fc-container">

    {%- assign fc_heading_text = section.settings.heading | default: 'Every Material Deserves the Right Care' -%}

    <div class="fc-mosaic-layout" id="fc-mosaic-{{ section.id }}">

      {%- for block in section.blocks -%}
        {%- if forloop.index == 3 -%}
          {{- '<!-- text node injected between card 2 and 3 -->' -}}
          <div class="fc-mosaic-text">
            {%- if section.settings.subtitle != blank -%}
              <p class="fc-subtitle">{{ section.settings.subtitle }}</p>
            {%- endif -%}
            <h2 class="fc-heading">{% render 'section-heading-text', text: fc_heading_text, line2: section.settings.heading_line2, line2_color: section.settings.heading_line2_color, accent_last_word: section.settings.accent_line2, accent_color: section.settings.heading_line2_color %}</h2>
          </div>
        {%- endif -%}

        {%- assign link = block.settings.link | default: '#' -%}
        <a href="{{ link }}" class="fc-mosaic-card" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="fc-category-info">
            <h3 class="fc-category-name">{{ block.settings.title }}</h3>
            <p class="fc-product-count">{{ block.settings.product_count | default: '0 products' }}</p>
          </div>
          <div class="fc-illustration">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title }}" loading="lazy" width="900" height="900">
            {%- elsif block.settings.svg_code != blank -%}
              {{ block.settings.svg_code }}
            {%- else -%}
              <svg viewBox="0 0 120 120" width="80" height="80" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="25" y="25" width="70" height="70" rx="12" stroke="currentColor" stroke-width="2"/>
                <circle cx="60" cy="60" r="15" stroke="currentColor" stroke-width="2"/>
              </svg>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}

      {%- comment -%} Fallback: if fewer than 3 blocks, text was never injected — put it after {%- endcomment -%}
      {%- if section.blocks.size < 3 -%}
        <div class="fc-mosaic-text">
          {%- if section.settings.subtitle != blank -%}
            <p class="fc-subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}
          <h2 class="fc-heading">{% render 'section-heading-text', text: fc_heading_text, line2: section.settings.heading_line2, line2_color: section.settings.heading_line2_color, accent_last_word: section.settings.accent_line2, accent_color: section.settings.heading_line2_color %}</h2>
        </div>
      {%- endif -%}

    </div><!-- /.fc-mosaic-layout -->

  </div>
</section>

<script>
  (function() {

    function initFcParallaxMosaic() {
      if (window.innerWidth <= 767) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const mosaic = document.getElementById('fc-mosaic-{{ section.id }}');
      if (!mosaic) return;

      const cards = mosaic.querySelectorAll('.fc-mosaic-card');
      if (cards.length === 0) return;

      // Per-card config: how far below they start, how fast they settle
      const cardConfig = [
        { startY: 80,  finishAt: 0.50 },  // Card 1 — fastest
        { startY: 110, finishAt: 0.65 },  // Card 2
        { startY: 95,  finishAt: 0.80 },  // Card 3
        { startY: 130, finishAt: 1.00 },  // Card 4 — slowest
      ];

      // Initialise cards below their resting position
      cards.forEach((card, i) => {
        const cfg = cardConfig[i] || cardConfig[cardConfig.length - 1];
        card.style.setProperty('--fc-parallax-y', cfg.startY + 'px');
      });

      let isIntersecting = false;
      let rafId;

      const update = () => {
        if (!isIntersecting) return;
        const rect = mosaic.getBoundingClientRect();
        const wh = window.innerHeight;
        let progress = (wh - rect.top) / (wh * 0.75);
        if (progress < 0) progress = 0;
        if (progress > 1) progress = 1;

        cards.forEach((card, i) => {
          const cfg = cardConfig[i] || cardConfig[cardConfig.length - 1];
          let sp = progress / cfg.finishAt;
          if (sp > 1) sp = 1;
          if (sp < 0) sp = 0;
          const easeOut = 1 - Math.pow(1 - sp, 3);
          card.style.setProperty('--fc-parallax-y', (cfg.startY * (1 - easeOut)) + 'px');
        });

        rafId = requestAnimationFrame(update);
      };

      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            isIntersecting = true;
            rafId = requestAnimationFrame(update);
          } else {
            isIntersecting = false;
            if (rafId) cancelAnimationFrame(rafId);
          }
        });
      }, { root: null, threshold: 0, rootMargin: '100px 0px 0px 0px' });

      io.observe(mosaic);

      // Hover zoom on image (subtle)
      cards.forEach(card => {
        card.addEventListener('mouseenter', () => {
          card.style.zIndex = '4';
        });
        card.addEventListener('mouseleave', () => {
          card.style.zIndex = '';
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFcParallaxMosaic);
    } else {
      initFcParallaxMosaic();
    }
    document.addEventListener('shopify:section:load', initFcParallaxMosaic);

  })();
</script>

