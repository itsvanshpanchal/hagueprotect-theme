{%- style -%}
  {% render 'section-typography-vars', section: section %}


  .mat-section {
    box-sizing: border-box !important;
    font-family: var(--font-family-sans, 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif);
    --section-subheading-line-height: 1.05;
  }

  .mat-section *,
  .mat-section *::before,
  .mat-section *::after {
    box-sizing: border-box !important;
  }

  .mat-section .mat-headline {
    font-family: var(--font-family-h2, var(--font-family-heading)) !important;
  }

  .mat-section {
    width: 100% !important;
    position: relative !important;
    isolation: isolate !important;
    background-color: {{ section.settings.bg_color | default: '#111111' }} !important;
    padding-top: {{ section.settings.padding_top | default: 110 }}px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 110 }}px !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    overflow: hidden !important;
    min-height: min(72vh, 720px) !important;
  }

  .mat-container {
    position: relative !important;
    z-index: 3 !important;
    max-width: var(--site-max-width) !important;
    margin: 0 auto !important;
    padding-left: var(--homepage-section-gutter, 8px) !important;
    padding-right: var(--homepage-section-gutter, 8px) !important;
  }

  .mat-grid {
    display: grid !important;
    grid-template-columns: minmax(280px, 520px) 1fr !important;
    align-items: center !important;
    gap: 40px !important;
    min-height: inherit !important;
  }

  .mat-left {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important;
    position: relative !important;
    z-index: 3 !important;
    max-width: 560px !important;
  }

  .mat-right {
    display: none !important;
  }

  .mat-eyebrow {
    display: block !important;
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: var(--section-label-size, 18px) !important;
    font-weight: 400 !important;
    font-synthesis: none !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
  }

  @media screen and (max-width: 989px) {
    #MainContent #shopify-section-{{ section.id }} .mat-eyebrow,
    #shopify-section-{{ section.id }} .mat-eyebrow {
      font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
      font-size: var(--section-label-size, 14px) !important;
      font-weight: 400 !important;
      font-synthesis: none !important;
      -webkit-text-stroke: 0.45px currentColor !important;
      paint-order: stroke fill !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
    }
  }

  .mat-headline {
    color: #ffffff !important;
    margin: 0 !important;
    font-size: var(--section-heading-size) !important;
    line-height: 1.05 !important;
  }

  .mat-section .mat-headline .hp-heading-pair,
  #shopify-section-{{ section.id }} .mat-headline .hp-heading-pair {
    display: inline !important;
    white-space: nowrap !important;
  }

  #shopify-section-{{ section.id }} .hp-heading-pair .hp-heading-line,
  #shopify-section-{{ section.id }} .mat-headline .hp-heading-pair .hp-heading-line {
    display: inline !important;
    white-space: nowrap !important;
  }

  #MainContent #shopify-section-{{ section.id }} .mat-desc,
  #MainContent .shopify-section .mat-section .mat-desc,
  #shopify-section-{{ section.id }} .mat-desc,
  .mat-section .mat-desc {
    color: rgba(255, 255, 255, 0.88) !important;
    line-height: 1.05 !important;
    margin-top: var(--section-label-to-title-gap, var(--section-subheading-spacing-top, 10px)) !important;
    margin-bottom: 0 !important;
  }

  .mat-section .mat-headline,
  .mat-section .mat-headline .hp-heading-line--1 {
    color: #ffffff !important;
  }

  .mat-section .mat-headline .hp-heading-accent,
  #shopify-section-{{ section.id }} .mat-headline .hp-heading-accent,
  #MainContent #shopify-section-{{ section.id }} .mat-headline .hp-heading-accent,
  #MainContent #shopify-section-{{ section.id }} .hp-heading-pair .hp-heading-accent {
    display: inline !important;
    white-space: nowrap !important;
    font-family: 'Luthon Southard Script', 'Brush Script MT', cursive !important;
    font-weight: 400 !important;
    font-style: normal !important;
    color: {{ section.settings.heading_accent_color | default: settings.heading_accent_color | default: '#c9a227' }} !important;
    -webkit-text-fill-color: {{ section.settings.heading_accent_color | default: settings.heading_accent_color | default: '#c9a227' }} !important;
    font-size: var(--heading-accent-size, 1.2em) !important;
    text-transform: none !important;
    letter-spacing: 0.01em !important;
  }

  #shopify-section-{{ section.id }} .hp-heading-pair .hp-heading-line {
    display: inline !important;
  }

  .mat-menu {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    gap: 4px !important;
    margin-top: 28px !important;
    --mat-active-color: {{ section.settings.active_color | default: '#D60000' }};
  }

  .mat-menu-item,
  .mat-menu-item-text {
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
    font-size: min({{ section.settings.menu_font_size | default: 52 }}px, 60px) !important;
    font-weight: 400 !important;
    font-style: normal !important;
    text-transform: none !important;
    text-decoration: none !important;
    cursor: pointer !important;
    position: relative !important;
    line-height: 1.1 !important;
    letter-spacing: -0.03em !important;
    -webkit-font-smoothing: antialiased !important;
  }

  .mat-menu-item {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    color: rgba(255, 255, 255, 0.55) !important;
    padding: 2px 0 !important;
    transition: color 0.35s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
  }

  .mat-menu-item-text {
    display: inline-block !important;
    color: inherit !important;
    transform-origin: left center !important;
    transition:
      color 0.35s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.35s cubic-bezier(0.25, 1, 0.5, 1),
      text-shadow 0.35s cubic-bezier(0.25, 1, 0.5, 1),
      filter 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
    will-change: transform;
  }

  .mat-menu-item:hover,
  .mat-menu-item.active,
  .mat-menu-item:focus-visible {
    color: var(--mat-active-color) !important;
  }

  .mat-menu-item:hover .mat-menu-item-text,
  .mat-menu-item.active .mat-menu-item-text,
  .mat-menu-item:focus-visible .mat-menu-item-text {
    color: var(--mat-active-color) !important;
    transform: scale(1.06) translateX(6px) !important;
    text-shadow:
      0 0 18px color-mix(in srgb, var(--mat-active-color) 45%, transparent),
      0 0 36px color-mix(in srgb, var(--mat-active-color) 22%, transparent) !important;
    filter: brightness(1.08) !important;
  }

  .mat-menu-item:active .mat-menu-item-text {
    transform: scale(1.03) translateX(4px) !important;
  }

  @media (hover: hover) and (pointer: fine) {
    .mat-menu:has(.mat-menu-item:hover) .mat-menu-item:not(:hover) {
      opacity: 0.42 !important;
    }
  }

  .mat-menu-item:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--mat-active-color) 55%, transparent) !important;
    outline-offset: 4px !important;
    border-radius: 2px !important;
  }

  /* Deodrizer + Denim — same size/weight/font as every other material label */
  .mat-menu-item.mat-font--deodrizer,
  .mat-menu-item.mat-font--denim,
  .mat-menu-item-text.mat-font--deodrizer,
  .mat-menu-item-text.mat-font--denim,
  .mat-menu-item.mat-font,
  .mat-menu-item-text.mat-font,
  .mat-menu-item[class*="mat-font--"],
  .mat-menu-item-text[class*="mat-font--"] {
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
    font-size: min({{ section.settings.menu_font_size | default: 52 }}px, 60px) !important;
    font-weight: 400 !important;
    font-style: normal !important;
    letter-spacing: -0.03em !important;
    line-height: 1.1 !important;
    text-transform: none !important;
  }

  .mat-menu-item .mat-menu-item-text {
    font-size: inherit !important;
  }

  .mat-menu-item-text {
    color: inherit !important;
  }

  .mat-menu-arrow {
    display: inline-flex !important;
    align-items: center !important;
    opacity: 0 !important;
    transform: translateX(-10px) scale(0.85) !important;
    transition:
      opacity 0.35s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.35s cubic-bezier(0.25, 1, 0.5, 1) !important;
    margin-left: 10px !important;
    color: var(--mat-active-color, {{ section.settings.active_color | default: '#D60000' }}) !important;
  }

  .mat-menu-item:hover .mat-menu-arrow,
  .mat-menu-item.active .mat-menu-arrow,
  .mat-menu-item:focus-visible .mat-menu-arrow {
    opacity: 1 !important;
    transform: translateX(0) scale(1) !important;
  }

  .mat-menu-arrow svg {
    width: 0.7em !important;
    height: 0.7em !important;
    fill: none !important;
    stroke: currentColor !important;
  }

  .mat-bg-stage {
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    pointer-events: none !important;
  }

  .mat-bg-overlay {
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 2 !important;
    pointer-events: none !important;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.45) 42%,
      rgba(0, 0, 0, 0.18) 72%,
      rgba(0, 0, 0, 0.08) 100%
    ) !important;
  }

  .mat-bg-stage .mat-image-container {
    position: absolute !important;
    inset: 0 !important;
    max-width: none !important;
    width: 100% !important;
    height: 100% !important;
    border-radius: 0 !important;
    overflow: hidden !important;
  }

  .mat-bg-stage .mat-image-layer,
  .mat-bg-stage .mat-image-fallback {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    opacity: 0 !important;
    transform: scale(1.06) !important;
    transition: opacity {{ section.settings.animation_speed | default: 400 }}ms cubic-bezier(0.25, 1, 0.5, 1),
                transform {{ section.settings.animation_speed | default: 500 }}ms cubic-bezier(0.25, 1, 0.5, 1) !important;
    z-index: 1 !important;
  }

  .mat-bg-stage .mat-image-layer {
    object-fit: cover !important;
    object-position: center center !important;
  }
  .mat-image-mobile {
    display: none !important;
  }
  @media screen and (max-width: 768px) {
    .mat-image-desktop:not(.mat-image-both) {
      display: none !important;
    }
    .mat-image-mobile {
      display: block !important;
    }
  }

  .mat-bg-stage .mat-image-fallback {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .mat-bg-stage .mat-image-layer.active,
  .mat-bg-stage .mat-image-fallback.active {
    opacity: 1 !important;
    transform: scale(1) !important;
    z-index: 2 !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .mat-menu-item,
    .mat-menu-item-text,
    .mat-menu-arrow {
      transition: color 0.2s ease !important;
    }

    .mat-menu-item:hover .mat-menu-item-text,
    .mat-menu-item.active .mat-menu-item-text,
    .mat-menu-item:focus-visible .mat-menu-item-text,
    .mat-menu-item:active .mat-menu-item-text {
      transform: none !important;
      filter: none !important;
      text-shadow: none !important;
    }
  }

  @media screen and (max-width: 1200px) {
    .mat-menu-item,
    .mat-menu-item-text {
      font-size: calc(min({{ section.settings.menu_font_size | default: 52 }}px, 60px) * 0.8) !important;
    }
  }

  @media screen and (max-width: 1024px) {
    .mat-grid {
      grid-template-columns: minmax(240px, 1fr) !important;
      gap: 0 !important;
    }
    .mat-menu-item,
    .mat-menu-item-text {
      font-size: calc(min({{ section.settings.menu_font_size | default: 52 }}px, 60px) * 0.7) !important;
    }
  }

  @media screen and (max-width: 768px) {
    .mat-section {
      --mat-mobile-gutter: var(--homepage-section-gutter, 28px);
      min-height: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      overflow-x: clip !important;
      overflow-y: hidden !important;
      width: 100% !important;
      max-width: 100% !important;
    }

    .mat-bg-overlay {
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.42) 45%,
        rgba(0, 0, 0, 0.72) 100%
      ) !important;
    }

    /* Match Best Sellers / homepage column gutter on mobile */
    #shopify-section-{{ section.id }} .mat-container,
    .mat-container {
      max-width: 100% !important;
      width: 100% !important;
      padding-left: var(--mat-mobile-gutter) !important;
      padding-right: var(--mat-mobile-gutter) !important;
      box-sizing: border-box !important;
      min-height: 0 !important;
    }

    .mat-grid {
      display: block !important;
      min-height: 0 !important;
      width: 100% !important;
    }

    .mat-bg-stage,
    .mat-bg-stage .mat-image-container {
      overflow: hidden !important;
      max-width: 100% !important;
    }

    .mat-bg-stage .mat-image-container,
    .mat-bg-stage .mat-image-layer,
    .mat-bg-stage .mat-image-fallback {
      min-height: 100% !important;
    }

    /* Restore ken-burns style switch; overflow:hidden on stage clips side bleed */
    .mat-bg-stage .mat-image-layer,
    .mat-bg-stage .mat-image-fallback {
      transform: scale(1.14) !important;
      object-fit: cover !important;
      object-position: center center !important;
      transition: opacity 650ms cubic-bezier(0.25, 1, 0.5, 1),
                  transform 850ms cubic-bezier(0.25, 1, 0.5, 1) !important;
    }

    .mat-bg-stage .mat-image-layer.active,
    .mat-bg-stage .mat-image-fallback.active {
      transform: scale(1) !important;
    }

    /* Horizontal inset comes from .mat-container only — no nested gutter on .mat-left */
    #shopify-section-{{ section.id }} .mat-left,
    .mat-left {
      align-items: flex-start !important;
      text-align: left !important;
      justify-content: flex-start !important;
      min-height: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      box-sizing: border-box !important;
      --section-text-offset-x: 0px !important;
      transform: none !important;
    }

    #shopify-section-{{ section.id }} .mat-left .section-heading-stack,
    .mat-left .section-heading-stack {
      align-items: flex-start !important;
      text-align: left !important;
      margin-left: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      transform: none !important;
    }

    .mat-eyebrow,
    .mat-headline,
    .mat-desc,
    .mat-menu,
    .mat-menu-item {
      align-self: flex-start !important;
      text-align: left !important;
      width: 100% !important;
      max-width: 100% !important;
      margin-left: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    .section-heading-stack {
      width: 100% !important;
      max-width: 100% !important;
    }

    /*
      Keep "For Every Material" readable on mobile — allow wrap so typewriter
      / sticky overlap never clips mid-word ("Fol").
    */
    .mat-section .mat-headline,
    #shopify-section-{{ section.id }} .mat-headline {
      font-size: clamp(18px, 5.2vw, 24px) !important;
      line-height: 1.15 !important;
      max-width: 100% !important;
      white-space: normal !important;
      overflow: visible !important;
    }

    .mat-section .mat-headline .hp-heading-pair,
    #shopify-section-{{ section.id }} .mat-headline .hp-heading-pair {
      display: inline !important;
      flex-direction: row !important;
      flex-wrap: wrap !important;
      white-space: normal !important;
      max-width: 100% !important;
      overflow: visible !important;
    }

    #shopify-section-{{ section.id }} .hp-heading-pair .hp-heading-line,
    #shopify-section-{{ section.id }} .mat-headline .hp-heading-pair .hp-heading-line,
    .mat-section .mat-headline .hp-heading-line--1 {
      display: inline !important;
      white-space: normal !important;
      overflow: visible !important;
    }

    .mat-section .mat-headline .hp-heading-accent,
    #shopify-section-{{ section.id }} .mat-headline .hp-heading-accent,
    #MainContent #shopify-section-{{ section.id }} .mat-headline .hp-heading-accent,
    #MainContent #shopify-section-{{ section.id }} .hp-heading-pair .hp-heading-accent {
      display: inline !important;
      white-space: nowrap !important;
      font-size: {{ section.settings.heading_accent_font_size_mobile | default: 40 }}px !important;
      line-height: 1 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      vertical-align: baseline !important;
      overflow: visible !important;
    }

    /* Keep eyebrow → title → desc gaps equal on mobile (Best Sellers rhythm) */
    #shopify-section-{{ section.id }} .section-heading-stack,
    .mat-section .section-heading-stack {
      gap: 10px !important;
      row-gap: 10px !important;
    }

    #MainContent #shopify-section-{{ section.id }} .mat-desc,
    #shopify-section-{{ section.id }} .mat-desc,
    .mat-section .mat-desc {
      margin-top: 10px !important;
      margin-bottom: 0 !important;
    }

    .mat-menu-item,
    .mat-menu-item-text,
    .mat-menu-item.mat-font--deodrizer,
    .mat-menu-item.mat-font--denim,
    .mat-menu-item-text.mat-font--deodrizer,
    .mat-menu-item-text.mat-font--denim,
    .mat-menu-item.mat-font,
    .mat-menu-item-text.mat-font,
    .mat-menu-item[class*="mat-font--"],
    .mat-menu-item-text[class*="mat-font--"] {
      font-size: clamp(24px, 6.8vw, 28px) !important;
      line-height: 1.15 !important;
      letter-spacing: -0.02em !important;
      -webkit-text-stroke: 0.45px currentColor !important;
      paint-order: stroke fill !important;
    }

    .mat-menu-item {
      padding: 4px 0 !important;
      min-height: 34px !important;
    }

    .mat-menu-item:hover .mat-menu-item-text,
    .mat-menu-item.active .mat-menu-item-text,
    .mat-menu-item:focus-visible .mat-menu-item-text {
      transform: scale(1.045) translateX(4px) !important;
    }

    .mat-menu-item:active .mat-menu-item-text {
      transform: scale(1.02) translateX(2px) !important;
    }

    @media (hover: hover) and (pointer: fine) {
      .mat-menu:has(.mat-menu-item:hover) .mat-menu-item:not(:hover) {
        opacity: 0.5 !important;
      }
    }

    .mat-menu {
      gap: 2px !important;
      margin-top: 20px !important;
    }

    .mat-menu-arrow {
      margin-left: 6px !important;
    }
  }

{%- endstyle -%}

<section class="mat-section" aria-label="Materials Showcase Section" data-mat-section>
  <div class="mat-bg-stage" aria-hidden="true">
    <div class="mat-image-container">
      {%- for block in section.blocks -%}
        {%- if block.type == 'material_item' -%}
          {%- if block.settings.image != blank or block.settings.image_mobile != blank -%}
            {%- if block.settings.image != blank -%}
              <img class="mat-image-layer mat-image-desktop{% if forloop.first %} active{% endif %}{% if block.settings.image_mobile == blank %} mat-image-both{% endif %}"
                   style="object-fit: {{ block.settings.image_fit | default: 'cover' }} !important; object-position: {{ block.settings.image_position | default: 'center center' }} !important;"
                   src="{{ block.settings.image | image_url: width: 2400 }}"
                   alt=""
                   data-index="{{ forloop.index0 }}"
                   loading="lazy">
            {%- endif -%}
            {%- if block.settings.image_mobile != blank -%}
              <img class="mat-image-layer mat-image-mobile{% if forloop.first %} active{% endif %}{% if block.settings.image == blank %} mat-image-both{% endif %}"
                   style="object-fit: {{ block.settings.image_fit | default: 'cover' }} !important; object-position: {{ block.settings.image_position | default: 'center center' }} !important;"
                   src="{{ block.settings.image_mobile | image_url: width: 1200 }}"
                   alt=""
                   data-index="{{ forloop.index0 }}"
                   loading="lazy">
            {%- endif -%}
          {%- else -%}
            <div class="mat-image-fallback{% if forloop.first %} active{% endif %}"
                 data-index="{{ forloop.index0 }}">
              <svg viewBox="0 0 700 520" preserveAspectRatio="xMidYMid slice" style="width: 100%; height: 100%;">
                <rect width="700" height="520" fill="#1a1a1a"/>
                <circle cx="350" cy="260" r="140" fill="{{ section.settings.active_color | default: '#D60000' }}" opacity="0.12"/>
                <text x="350" y="275" font-size="32" font-weight="900" fill="#ffffff" text-anchor="middle" opacity="0.2" letter-spacing="4px">{{ block.settings.title | uppercase }}</text>
              </svg>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="mat-bg-overlay"></div>
  </div>
  <div class="mat-container">
    <div class="mat-grid">
      <!-- LEFT COLUMN -->
      <div class="mat-left">
        <div class="section-heading-stack">
          {%- if section.settings.eyebrow != blank -%}
            <span class="mat-eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="mat-headline">{% render 'section-heading-text', text: section.settings.heading, line2: section.settings.heading_line2, line2_color: section.settings.heading_line2_color, accent_last_word: true, accent_color: section.settings.heading_accent_color %}</h2>
        </div>
        {%- if section.settings.description != blank -%}
          <p class="mat-desc hp-body-para">{{ section.settings.description }}</p>
        {%- endif -%}
        
        <div class="mat-menu">
          {%- for block in section.blocks -%}
            {%- if block.type == 'material_item' -%}
              {%- liquid
                assign mat_href = '#'
                assign mat_care_handle = ''
                assign mat_care_search = ''

                if block.settings.collection != blank
                  assign mat_href = block.settings.collection.url
                elsif block.settings.product != blank
                  assign mat_href = block.settings.product.url
                elsif block.settings.url != blank
                  assign mat_href = block.settings.url
                else
                  assign mat_key = block.settings.title | downcase | strip
                  case mat_key
                    when 'suede'
                      assign mat_care_handle = 'suede-care-kit'
                      assign mat_care_search = 'Suede Care Kit'
                    when 'nubuck'
                      assign mat_care_handle = 'nubuck-care-kit'
                      assign mat_care_search = 'Nubuck Care Kit'
                    when 'leather'
                      assign mat_care_handle = 'leather-care-kit'
                      assign mat_care_search = 'Leather Care Kit'
                    when 'fabrics', 'fabric'
                      assign mat_care_handle = 'fabric-care-kit'
                      assign mat_care_search = 'Fabric Care Kit'
                    when 'soles', 'sole'
                      assign mat_care_handle = 'soles-care-kit'
                      assign mat_care_search = 'Sole Cleaner'
                  endcase

                  if mat_care_handle != blank
                    assign mat_col = collections[mat_care_handle]
                    if mat_col != blank
                      assign mat_href = mat_col.url
                    else
                      assign mat_search_encoded = mat_care_search | url_encode
                      assign mat_href = routes.search_url | append: '?q=' | append: mat_search_encoded | append: '&type=product'
                    endif
                  endif
                endif
              -%}
              <a href="{{ mat_href }}"
                 class="mat-menu-item {% render 'material-font-class', source: block.settings.title %}{% if forloop.first %} active{% endif %}"
                 data-index="{{ forloop.index0 }}"
                 {% if mat_href != '#' %}data-mat-link{% endif %}
                 {{ block.shopify_attributes }}>
                <span class="mat-menu-item-text {% render 'material-font-class', source: block.settings.title %}">{{ block.settings.title }}</span>
                <span class="mat-menu-arrow">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const matSection = document.querySelector('[data-mat-section]');
    if (!matSection) return;

    const menuItems = matSection.querySelectorAll('.mat-menu-item');
    const mobileQuery = window.matchMedia('(max-width: 768px)');

    function getActiveLayers() {
      return matSection.querySelectorAll('.mat-bg-stage .mat-image-layer, .mat-bg-stage .mat-image-fallback');
    }

    menuItems.forEach(item => {
      item.addEventListener('mouseenter', function() {
        if (mobileQuery.matches) return;
        switchActiveMaterial(this);
      });
      item.addEventListener('touchstart', function() {
        if (!mobileQuery.matches) return;
        switchActiveMaterial(this);
      }, { passive: true });
      item.addEventListener('click', function(e) {
        if (!mobileQuery.matches) return;
        e.preventDefault();
        switchActiveMaterial(this);
      });
      item.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        e.preventDefault();
        switchActiveMaterial(this);
      });
    });

    function switchActiveMaterial(activeItem) {
      const index = activeItem.getAttribute('data-index');

      menuItems.forEach(i => i.classList.remove('active'));
      activeItem.classList.add('active');

      getActiveLayers().forEach(layer => {
        const isMatch = layer.getAttribute('data-index') === index;
        layer.classList.toggle('active', isMatch);
      });

      matSection.classList.add('mat-section--switching');
      window.clearTimeout(matSection._matSwitchTimer);
      matSection._matSwitchTimer = window.setTimeout(function() {
        matSection.classList.remove('mat-section--switching');
      }, 700);
    }
  });
</script>

