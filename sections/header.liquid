{%- liquid
  assign header_logo_gap = section.settings.logo_gap | default: 20
  if section.settings.logo_group_gap != blank
    assign header_logo_gap = section.settings.logo_group_gap
  endif
  assign header_brand_logo_h_desktop = section.settings.partner_logo_height_desktop | default: 40
  assign header_brand_logo_h_mobile = section.settings.partner_logo_height_mobile | default: 28
  assign header_partner_logo_h_desktop = header_brand_logo_h_desktop
  assign header_partner_logo_h_mobile = header_brand_logo_h_mobile
-%}

{{ 'header-brand-logos.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-typography-vars', section: section %}


  .header-wrapper {
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    border-bottom: 1px solid #e5e5e5;
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding-top: 0;
    padding-bottom: 0;
    transition: all 0.2s ease;
  }

  /* Top tier: logos | search | actions */
  .header-top {
    width: 100%;
    border-bottom: 1px solid #ececec;
  }

  .header-top__inner,
  .header-nav-bar__inner {
    display: flex;
    align-items: center;
    max-width: var(--site-max-width);
    margin-left: auto;
    margin-right: auto;
    padding: 12px var(--site-padding, 16px);
    width: 100%;
    box-sizing: border-box;
  }

  .header-top__inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 16px;
  }

  /* Bottom tier: centered nav links */
  .header-nav-bar {
    width: 100%;
    background: {{ section.settings.bg_color | default: '#ffffff' }};
  }

  .header-nav-bar__inner {
    justify-content: center;
    padding-top: 0;
    padding-bottom: 0;
    position: relative;
  }

  .header__search {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .header__search-form {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 10px;
    border: 1px solid #d0d0d0;
    border-radius: 999px;
    padding: 10px 18px;
    background: #ffffff;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .header__search-form:focus-within {
    border-color: #111111;
    box-shadow: 0 0 0 1px #111111;
  }

  .header__search-form svg {
    flex-shrink: 0;
    color: #888888;
  }

  .header__search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    outline: none;
    font-family: var(--font-family-sans);
    font-size: 14px;
    font-weight: var(--font-weight-sans, 500);
    color: #111111;
  }

  .header__search-input::placeholder {
    color: #999999;
  }

  .header__search-input::-webkit-search-decoration,
  .header__search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .header__logo-link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    min-width: 0;
  }

  .header__logo-text {
    font-family: var(--font-family-heading) !important;
    font-size: 21px;
    font-weight: var(--font-weight-heading, 700) !important;
    font-style: var(--font-style-heading, normal) !important;
    color: #000000;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 1px;
    line-height: 1.2;
    white-space: nowrap;
  }

  .header__logo-icon {
    width: 22px;
    height: 22px;
    color: #000000;
    margin: 0 -1px;
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .header__logo-img {
    height: auto;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  .header__logo-group {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--header-logo-gap, 20px);
    flex: 0 0 auto;
    width: max-content;
    max-width: 100%;
    min-width: 0;
  }

  .header__logo-divider {
    flex: 0 0 1px;
    width: 1px;
    height: calc(var(--header-brand-logo-h, 40px) * 0.75);
    min-height: 24px;
    background: #e5e5e5;
    margin: 0;
    padding: 0;
    align-self: center;
  }

  .header__logo-partners {
    display: contents;
  }

  .header__logo-partners .header__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: auto;
    min-width: 0;
    height: var(--header-partner-logo-h, var(--header-brand-logo-h, 40px));
    min-height: var(--header-partner-logo-h, var(--header-brand-logo-h, 40px));
    padding: 0;
    line-height: 0;
    box-sizing: border-box;
  }

  .header__logo-link--primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--header-brand-logo-h, 40px);
    min-height: var(--header-brand-logo-h, 40px);
    padding: 0;
    box-sizing: border-box;
  }

  .header__logo-link--primary .header__logo-img {
    height: var(--header-brand-logo-h, 40px);
    width: auto;
    max-height: var(--header-brand-logo-h, 40px);
    max-width: min(var(--logo-primary-max, 200px), 200px);
    object-fit: contain;
    object-position: center center;
    display: block;
  }

  .header__logo-link--brand .header__logo-img,
  .header__logo-link--partner .header__logo-img,
  .header__logo-link--sor .header__logo-img,
  .header__logo-link--sor-main .header__logo-img,
  .header__logo-partners .header__logo-img {
    height: var(--header-partner-logo-h, var(--header-brand-logo-h, 40px));
    width: auto;
    max-height: var(--header-partner-logo-h, var(--header-brand-logo-h, 40px));
    max-width: none;
    object-fit: contain;
    object-position: center center;
    display: block;
  }

  @media screen and (min-width: 1025px) {
    #shopify-section-{{ section.id }} .header-top__inner .header__logo-group {
      display: inline-flex !important;
      flex: 0 0 auto !important;
      width: max-content !important;
      max-width: calc(100% - 480px);
      align-items: center !important;
      justify-content: flex-start !important;
      gap: var(--header-logo-gap, 20px) !important;
    }

    #shopify-section-{{ section.id }} .header-top__inner .header__logo-divider {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .header-top__inner .header__logo-partners {
      display: contents !important;
    }

    #shopify-section-{{ section.id }} .header-top__inner .header__logo-link,
    #shopify-section-{{ section.id }} .header-top__inner .header__logo-link--primary {
      flex: 0 0 auto;
      margin: 0 !important;
      height: var(--header-brand-logo-h, 40px);
      min-height: var(--header-brand-logo-h, 40px);
      align-items: center;
      justify-content: center;
      padding: 0 !important;
    }

    #shopify-section-{{ section.id }} .header-top__inner .header__logo-partners .header__logo-link {
      height: var(--header-partner-logo-h, var(--header-brand-logo-h, 40px));
      min-height: var(--header-partner-logo-h, var(--header-brand-logo-h, 40px));
      width: auto !important;
      min-width: 0 !important;
      max-width: none !important;
      padding: 0 !important;
    }

    #shopify-section-{{ section.id }} .header-top__inner .header__logo-partners .header__logo-img,
    #shopify-section-{{ section.id }} .header-top__inner .header__logo-link--partner .header__logo-img {
      height: var(--header-partner-logo-h, var(--header-brand-logo-h, 40px)) !important;
      max-height: var(--header-partner-logo-h, var(--header-brand-logo-h, 40px)) !important;
      width: auto !important;
      max-width: none !important;
      object-fit: contain !important;
      object-position: center center !important;
    }

    #shopify-section-{{ section.id }} .header-top__inner .header__logo-link--primary .header__logo-img {
      height: var(--header-brand-logo-h, 40px) !important;
      max-height: var(--header-brand-logo-h, 40px) !important;
      max-width: min(var(--logo-primary-max, 200px), 200px) !important;
    }

    #shopify-section-{{ section.id }} .header-top__inner .header__search {
      flex: 0 0 340px;
      width: 340px;
      max-width: 340px;
      min-width: 340px;
      margin-left: auto;
      position: relative;
      z-index: 2;
    }

    #shopify-section-{{ section.id }} .header-top__inner .header__actions {
      flex: 0 0 auto;
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .header__search-btn {
      display: none !important;
    }
  }

  .header__navigation {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    margin-left: 0;
    width: 100%;
  }

  @media screen and (max-width: 1024px) {
    .header__navigation,
    .header-nav-bar,
    .header__search {
      display: none;
    }
  }

  .nav-item {
    padding: 10px 0;
  }

  .header-nav-bar .menu-link {
    font-size: 12px;
    letter-spacing: 0.06em;
  }

  .header__brand-nav {
    position: relative;
  }

  .header__brand-nav .menu-link {
    gap: 6px;
  }

  .brand-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    min-width: 190px;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
    padding: 12px;
    display: none;
    opacity: 0;
    z-index: 1002;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .header__brand-nav.is-open .brand-dropdown {
    display: block;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .brand-dropdown__item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px 14px;
    border-radius: 8px;
    text-decoration: none;
    color: #111111;
    font-family: var(--font-family-sans) !important;
    font-size: 13px;
    font-weight: var(--font-weight-sans, 700) !important;
    font-style: var(--font-style-sans, normal) !important;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .brand-dropdown__item:hover {
    background-color: #fafafa;
    color: #FF2B2B;
  }

  .brand-dropdown__logo {
    height: 36px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .brand-dropdown__logo--sor {
    height: 40px;
    max-width: 132px;
  }

  .mobile-brand-link {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
    color: #666;
    text-decoration: none;
    font-family: var(--font-family-sans) !important;
    font-size: 14px;
    font-weight: var(--font-weight-sans, 600) !important;
    font-style: var(--font-style-sans, normal) !important;
  }

  .mobile-brand-link img {
    height: 28px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
  }

  .header__menu-link {
    font-family: var(--font-family-sans) !important;
    font-size: 13.5px;
    font-weight: var(--font-weight-sans, 700) !important;
    font-style: var(--font-style-sans, normal) !important;
    color: #111111;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .header__menu-link:hover {
    color: #FF2B2B;
  }

  .menu-pill {
    background-color: #111111;
    color: #ffffff !important;
    padding: 8px 18px;
    border-radius: 4px;
    font-family: var(--font-family-sans) !important;
    font-size: 15px;
    font-weight: var(--font-weight-sans, 800) !important;
    font-style: var(--font-style-sans, normal) !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .menu-pill:hover {
    background-color: #333333;
    transform: translateY(-1px);
    color: #ffffff !important;
  }

  .shop-all-btn {
    background-color: transparent;
    color: #111111 !important;
    padding: 6px 10px;
    border-radius: 0;
    font-family: var(--font-family-sans) !important;
    font-size: 13.5px;
    font-weight: var(--font-weight-sans, 800) !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .shop-all-btn:hover {
    background-color: transparent;
    transform: none;
    color: #FF2B2B !important;
  }

  .menu-link {
    font-family: var(--font-family-sans) !important;
    font-size: 15px;
    font-weight: var(--font-weight-sans, 800) !important;
    font-style: var(--font-style-sans, normal) !important;
    color: #111111 !important;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .menu-link:hover {
    color: #FF2B2B !important;
  }

  /* Full Width Mega Menu Dropdown Panel */
  .megamenu-panel {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #ffffff !important;
    border: none;
    display: none;
    z-index: 99999;
    padding: 0;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    overflow-y: auto;
  }

  .megamenu-panel.is-active {
    display: block;
  }

  .megamenu-panel.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hp-overlay-header {
    display: flex;
    align-items: center;
    padding: 32px 40px 48px;
    max-width: var(--site-max-width);
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .hp-overlay-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin-right: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111;
  }

  .hp-overlay-nav {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .hp-overlay-nav a {
    font-family: var(--font-family-sans) !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    color: #111 !important;
    text-transform: uppercase !important;
    text-decoration: none;
    letter-spacing: 0.05em;
    position: relative;
    padding-bottom: 4px;
  }

  .hp-overlay-nav a.is-active {
    color: #FF2B2B !important;
  }

  .hp-overlay-nav a.is-active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #FF2B2B;
  }

  /* Full-width mega menu - nuuk-style layout */
  .megamenu-grid {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: 0;
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 40px 48px;
    width: 100%;
    align-items: start;
  }

  /* Left label column */
  .megamenu-label-col {
    padding-top: 2px;
    padding-right: 24px;
  }

  .megamenu-section-label {
    font-family: var(--font-family-sans) !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    color: #999999 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.12em !important;
    margin: 0 0 10px 0 !important;
    line-height: 1.2 !important;
  }

  .megamenu-view-all {
    font-family: var(--font-family-sans) !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    color: #FF2B2B !important;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }

  .megamenu-view-all:hover {
    color: #cc2222 !important;
  }

  /* Center category list */
  .megamenu-cat-col {
    padding: 0 40px 0 0;
    border-right: 1px solid #f0f0f0;
  }

  .megamenu-cat-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #f5f5f5;
    cursor: pointer;
  }

  .megamenu-cat-item:first-child {
    border-top: 1px solid #f5f5f5;
  }

  .megamenu-cat-item__name {
    font-family: var(--font-family-sans) !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    color: #666666 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    text-decoration: none;
    transition: color 0.2s;
  }

  .megamenu-cat-item__name:hover {
    color: #111111 !important;
  }

  .megamenu-cat-item__plus {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: #111111;
    line-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, transform 0.2s;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .megamenu-cat-item__plus:hover {
    color: #FF2B2B;
  }

  .megamenu-cat-item__plus svg {
    width: 12px;
    height: 12px;
  }

  .megamenu-cat-sublinks {
    display: none;
    padding: 8px 0 8px 12px;
    border-bottom: 1px solid #f5f5f5;
    flex-direction: column;
    gap: 6px;
  }

  .megamenu-cat-sublinks.is-open {
    display: flex;
  }

  .megamenu-cat-sublinks a {
    font-family: var(--font-family-sans) !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    color: #555555 !important;
    text-decoration: none;
    transition: color 0.2s;
    letter-spacing: 0.04em;
  }

  .megamenu-cat-sublinks a:hover {
    color: #FF2B2B !important;
  }

  /* Right featured images */
  .megamenu-featured-col {
    padding-left: 40px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .megamenu-featured-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 180px;
    flex-shrink: 0;
  }

  .megamenu-featured-img {
    width: 180px;
    height: 260px;
    border-radius: 8px;
    object-fit: cover;
    display: block;
    background: #f5f5f5;
  }

  .megamenu-featured-caption {
    font-family: var(--font-family-sans) !important;
    font-size: 10px !important;
    font-weight: 500 !important;
    color: #111111 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.10em !important;
    text-decoration: none;
    transition: color 0.2s;
  }

  .megamenu-featured-caption:hover {
    color: #FF2B2B !important;
  }

  /* Nuuk-style category rows */
  .hp-megamenu-cat-row {
    border-bottom: 1px solid #f0f0f0;
  }

  .hp-megamenu-cat-row:first-child {
    border-top: 1px solid #f0f0f0;
  }

  .hp-megamenu-cat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    cursor: pointer;
  }

  .hp-megamenu-cat-name {
    font-family: var(--font-family-sans) !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    color: #666666 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    text-decoration: none;
    transition: color 0.2s;
  }

  .hp-megamenu-cat-name:hover {
    color: #111111 !important;
  }

  .hp-megamenu-cat-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: #666666;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    transition: color 0.2s;
  }

  .hp-megamenu-cat-toggle:hover {
    color: #111111;
  }

  .hp-megamenu-cat-toggle.is-open .icon-plus {
    display: none;
  }

  .hp-megamenu-cat-toggle .icon-minus {
    display: none;
  }

  .hp-megamenu-cat-toggle.is-open .icon-minus {
    display: block;
  }

  .hp-megamenu-cat-sub {
    display: none;
    flex-direction: column;
    gap: 7px;
    padding: 0 0 12px 0;
  }

  .hp-megamenu-cat-sub.is-open {
    display: flex;
  }

  .hp-megamenu-cat-sub a {
    font-family: var(--font-family-sans) !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    color: #666666 !important;
    text-decoration: none;
    transition: color 0.2s;
    letter-spacing: 0.03em;
  }

  .hp-megamenu-cat-sub a:hover {
    color: #111111 !important;
  }

  .megamenu-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Mega menu: titles + subcategory links share the same editor font group */
  #shopify-section-{{ section.id }} h3.megamenu-heading,
  #shopify-section-{{ section.id }} .megamenu-heading,
  #shopify-section-{{ section.id }} h4.mobile-accordion-category-heading,
  #shopify-section-{{ section.id }} .mobile-accordion-category-heading,
  .megamenu-heading {
