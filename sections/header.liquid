<script>
  document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('MegaMenuPanel');

    if (panel) {
      let timeoutId;
      let currentBrand = panel.getAttribute('data-default-brand') || 'hague';
      if (currentBrand !== 'vanrosector' && currentBrand !== 'science-of-raw') currentBrand = 'hague';
      const defaultBrand = currentBrand;

      const showBrandMenu = (brand) => {
        let key = 'hague';
        if (brand === 'vanrosector') key = 'vanrosector';
        else if (brand === 'science-of-raw') key = 'science-of-raw';
        currentBrand = key;
        panel.querySelectorAll('[data-brand-menu]').forEach((el) => {
          el.hidden = el.getAttribute('data-brand-menu') !== key;
        });
        panel.classList.toggle('megamenu-panel--vanrosector', key === 'vanrosector');
        panel.classList.toggle('megamenu-panel--science-of-raw', key === 'science-of-raw');
      };

      const openPanel = (brand) => {
        clearTimeout(timeoutId);
        showBrandMenu(brand || defaultBrand);
        panel.style.display = 'block';
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
          panel.style.opacity = '1';
          panel.style.transform = 'translateY(0)';
        }, 10);
      };

      const closePanel = () => {
        timeoutId = setTimeout(() => {
          panel.style.opacity = '0';
          panel.style.transform = 'translateY(12px)';
          setTimeout(() => {
            if (panel.style.opacity === '0') {
              panel.style.display = 'none';
              document.body.style.overflow = '';
            }
          }, 300);
        }, 120);
      };

      /* Shop All button click → open current brand's overlay */
      const shopAllTrigger = document.getElementById('ShopAllTrigger');
      if (shopAllTrigger) {
        shopAllTrigger.addEventListener('click', (e) => {
          e.preventDefault();
          openPanel(currentBrand);
        });
      }
      
      const overlayCloseBtn = document.getElementById('OverlayCloseBtn');
      if (overlayCloseBtn) {
        overlayCloseBtn.addEventListener('click', (e) => {
          e.preventDefault();
          closePanel();
        });
      }
      
      const mobileShopAllTrigger = document.getElementById('MobileShopAllTrigger');
      if (mobileShopAllTrigger) {
        mobileShopAllTrigger.addEventListener('click', (e) => {
          e.preventDefault();
          if (panel.style.display === 'block') {
            closePanel();
          } else {
            openPanel(currentBrand);
          }
        });
      }

      /* The active brand is determined by the Liquid variable active_brand which sets data-default-brand.
         We no longer switch the brand menu on logo hover, keeping it strictly tied to the current page context. */
      showBrandMenu(defaultBrand);

      /* Desktop Megamenu Accordion Toggle */
      const toggleBtns = document.querySelectorAll('.megamenu-toggle-btn');
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const heading = btn.closest('h3, h4');
          if (!heading) return;
          const content = heading.nextElementSibling;
          if (content && content.classList.contains('megamenu-accordion-content')) {
            const isHidden = content.style.display === 'none';
            content.style.display = isHidden ? 'block' : 'none';
            btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
            
            const iconPlus = btn.querySelector('.icon-plus');
            const iconMinus = btn.querySelector('.icon-minus');
            if (iconPlus) iconPlus.style.display = isHidden ? 'none' : 'block';
            if (iconMinus) iconMinus.style.display = isHidden ? 'block' : 'none';
          }
        });
      });

      /* Nuuk-style category row + button toggles */
      document.querySelectorAll('.hp-megamenu-cat-toggle').forEach(toggleBtn => {
        toggleBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const row = toggleBtn.closest('.hp-megamenu-cat-row');
          if (!row) return;
          const sub = row.querySelector('.hp-megamenu-cat-sub');
          const btn = row.querySelector('.hp-megamenu-cat-toggle');
          if (!sub || !btn) return;
          const isOpen = sub.classList.contains('is-open');
          
          /* Close all other accordions */
          document.querySelectorAll('.hp-megamenu-cat-row').forEach(otherRow => {
            if (otherRow !== row) {
              const otherSub = otherRow.querySelector('.hp-megamenu-cat-sub');
              const otherBtn = otherRow.querySelector('.hp-megamenu-cat-toggle');
              if (otherSub) otherSub.classList.remove('is-open');
              if (otherBtn) {
                otherBtn.classList.remove('is-open');
                otherBtn.setAttribute('aria-expanded', 'false');
              }
            }
          });

          sub.classList.toggle('is-open', !isOpen);
          btn.classList.toggle('is-open', !isOpen);
          btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        });
      });
    }

    const brandNav = document.getElementById('BrandNav');
    const brandTrigger = document.getElementById('BrandTrigger');
    const brandDropdown = document.getElementById('BrandDropdown');

    const closeBrandDropdown = () => {
      if (!brandNav || !brandTrigger) return;
      brandNav.classList.remove('is-open');
      brandTrigger.setAttribute('aria-expanded', 'false');
    };

    if (brandNav && brandTrigger && brandDropdown) {
      brandTrigger.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const isOpen = brandNav.classList.toggle('is-open');
        brandTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      document.addEventListener('click', (event) => {
        if (!brandNav.contains(event.target)) {
          closeBrandDropdown();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeBrandDropdown();
        }
      });
    }
  });

  function openMobileMenu() {
    document.getElementById('MobileMenuOverlay').classList.add('is-active');
    document.getElementById('MobileMenuDrawer').classList.add('is-active');
  }
  function closeMobileMenu() {
    document.getElementById('MobileMenuOverlay').classList.remove('is-active');
    document.getElementById('MobileMenuDrawer').classList.remove('is-active');
  }

  function toggleMobileBrandAccordion() {
    const content = document.getElementById('MobileBrandContent');
    if (!content) return;
    const isHidden = window.getComputedStyle(content).display === 'none';
    content.style.display = isHidden ? 'flex' : 'none';
  }

  function handleHeaderLogin(e) {
    // Native Shopify login handles redirects automatically
  }

  function openSearch() {
    const searchView = document.getElementById('ThemeSearchView');
    searchView.style.display = 'block';
    document.body.style.overflow = 'hidden';
    setTimeout(() => {
      document.getElementById('SearchInput').focus();
    }, 100);
  }

  function closeSearch() {
    document.getElementById('ThemeSearchView').style.display = 'none';
    document.body.style.overflow = '';
  }

  // Close search on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
  });

  // Predictive Search Logic
  const searchInput = document.getElementById('SearchInput');
  const predictiveResults = document.getElementById('PredictiveSearchResults');
  const predictiveContainer = document.getElementById('PredictiveSearchContainer');
  let debounceTimer;
  let selectedIndex = -1;

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const query = searchInput.value.trim();
      selectedIndex = -1;

      if (query.length < 2) {
        predictiveContainer.style.display = 'none';
        return;
      }

      debounceTimer = setTimeout(() => {
        fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product,collection&resources[limit]=6`)
          .then(response => response.json())
          .then(suggestions => {
            const products = suggestions.resources.results.products || [];
            const collections = suggestions.resources.results.collections || [];

            if (products.length === 0 && collections.length === 0) {
              const safeQuery = query.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
              predictiveResults.innerHTML = `<p style="padding: 24px; color: #888; text-align: center; font-size: 14px; font-weight: 500;">No suggestions found for "${safeQuery}"</p>`;
              predictiveContainer.style.display = 'block';
              return;
            }

            let html = '';

            if (collections.length > 0) {
              html += '<div style="margin-bottom: 24px;"><h3 style="font-size: 10px; font-weight: 800; text-transform: uppercase; color: #FF2B2B; letter-spacing: 0.15em; margin-bottom: 12px; padding: 0 12px;">Suggested Categories</h3>';
              collections.forEach(col => {
                html += `<a href="${col.url}" class="predictive-item" style="display: block; padding: 12px; color: #111; text-decoration: none; font-size: 15px; font-weight: 700; border-radius: 8px; transition: all 0.2s;">${col.title}</a>`;
              });
              html += '</div>';
            }

            if (products.length > 0) {
              html += '<div><h3 style="font-size: 10px; font-weight: 800; text-transform: uppercase; color: #FF2B2B; letter-spacing: 0.15em; margin-bottom: 12px; padding: 0 12px;">Suggested Products</h3>';
              products.forEach(prod => {
                html += `
                  <a href="${prod.url}" class="predictive-item" style="display: flex; align-items: center; gap: 16px; padding: 12px; text-decoration: none; border-radius: 10px; transition: all 0.2s; margin-bottom: 4px;">
                    <div style="width: 56px; height: 56px; background: #f9f9f9; border-radius: 6px; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                      <img src="${prod.image}" style="max-width: 100%; max-height: 100%; object-fit: contain;" loading="lazy" decoding="async">
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 2px;">
                      <span style="font-size: 15px; font-weight: 700; color: #111; line-height: 1.2;">${prod.title}</span>
                      <span style="font-size: 13px; color: #FF2B2B; font-weight: 800; letter-spacing: 0.02em;">${prod.price}</span>
                    </div>
                  </a>
                `;
              });
              html += '</div>';
            }

            predictiveResults.innerHTML = html;
            predictiveContainer.style.display = 'block';

            // Inject hover styles dynamically
            if (!document.getElementById('PredictiveStyles')) {
              const style = document.createElement('style');
              style.id = 'PredictiveStyles';
              style.innerHTML = `
                .predictive-item:hover, .predictive-item.is-selected { background: #f7f7f7 !important; transform: translateX(4px); }
                #PredictiveSearchResults::-webkit-scrollbar { width: 6px; }
                #PredictiveSearchResults::-webkit-scrollbar-track { background: transparent; }
                #PredictiveSearchResults::-webkit-scrollbar-thumb { background: #eee; border-radius: 10px; }
              `;
              document.head.appendChild(style);
            }
          });
      }, 250);
    });

    // Keyboard Navigation
    searchInput.addEventListener('keydown', (e) => {
      const items = predictiveResults.querySelectorAll('.predictive-item');
      if (items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateSelection(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateSelection(items);
      } else if (e.key === 'Enter' && selectedIndex > -1) {
        e.preventDefault();
        items[selectedIndex].click();
      }
    });

    function updateSelection(items) {
      items.forEach((item, index) => {
        if (index === selectedIndex) {
          item.classList.add('is-selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('is-selected');
        }
      });
    }

    // Close suggestions when clicking outside
    document.addEventListener('click', (e) => {
      if (!predictiveContainer.contains(e.target) && e.target !== searchInput) {
        predictiveContainer.style.display = 'none';
      }
    });
  }

  // Cleaned up localStorage greeting logic as we now use native Liquid customer objects
  document.addEventListener('DOMContentLoaded', () => {
      const dropdown = document.getElementById('ProfileDropdown');
      if (dropdown) {
        dropdown.style.display = 'none'; // Will show on hover due to CSS
      }
  });
</script>

