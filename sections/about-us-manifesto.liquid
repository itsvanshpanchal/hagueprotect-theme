<div class="hpa-section">
  <!-- ══ §2 MANIFESTO ══ -->
  <section class="hpa-manifesto" id="hpaManifesto">
    <div class="hpa-manifesto__eyebrow">{{ section.settings.manifesto_eyebrow }}</div>
    <div class="hpa-manifesto__lines" id="hpaManifestoLines">
      {% assign delay = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'manifesto_line' %}
          <div class="hpa-manifesto__line hpa-up" data-d="{{ delay }}" {{ block.shopify_attributes }}>
            <span class="hpa-manifesto__line-num">{{ block.settings.num }}</span>
            {{ block.settings.text }}
          </div>
          {% assign delay = delay | plus: 1 %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "About Us Manifesto",
  "templates": ["page", "search"],
  "settings": [
    {
      "type": "text",
      "id": "manifesto_eyebrow",
      "label": "Manifesto Eyebrow",
      "default": "Our Manifesto"
    }
  ],
  "blocks": [
    {
      "type": "manifesto_line",
      "name": "Manifesto Line",
      "settings": [
        {
          "type": "text",
          "id": "num",
          "label": "Number (e.g. 01)",
          "default": "01"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "Use <em>...</em> for red highlight",
          "default": "It started with a ruined pair of Jordans."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Manifesto",
      "blocks": [
        { "type": "manifesto_line", "settings": { "num": "01", "text": "It started with a ruined pair of Jordans." } },
        { "type": "manifesto_line", "settings": { "num": "02", "text": "The market offered compromises. We wanted <em>perfection</em>." } },
        { "type": "manifesto_line", "settings": { "num": "03", "text": "So we built our own lab." } }
      ]
    }
  ]
}
{% endschema %}
