{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign protocol_link = section.settings.button_link
  if protocol_link == blank
    assign protocol_link = routes.all_products_collection_url
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-proto-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .hp-sci-proto-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .hp-sci-proto-{{ section.id }}__eyebrow {
    font-family: 'Darker Grotesque', sans-serif;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 20px;
  }

  .hp-sci-proto-{{ section.id }}__title-main {
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    font-size: clamp(36px, 4.5vw, {{ section.settings.title_size }}px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0;
    color: #ffffff !important;
  }

  .hp-sci-proto-{{ section.id }}__title-sub {
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    font-style: italic;
    font-size: clamp(36px, 4.5vw, {{ section.settings.title_size }}px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 clamp(24px, 3vw, 32px);
    color: {{ section.settings.title_accent_color }} !important;
  }

  .hp-sci-proto-{{ section.id }}__body {
    font-family: 'Darker Grotesque', sans-serif;
    font-size: clamp(16px, 1.45vw, 18px);
    line-height: 1.65;
    max-width: 38ch;
    margin: 0 0 clamp(28px, 4vw, 40px);
    color: #ffffff !important;
  }

  .hp-sci-proto-{{ section.id }}__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
    max-width: 360px;
    margin-bottom: clamp(32px, 4vw, 44px);
  }

  .hp-sci-proto-{{ section.id }}__stat-value {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 8px;
    color: {{ section.settings.accent_color }} !important;
  }

  .hp-sci-proto-{{ section.id }}__stat-label {
    font-family: 'Darker Grotesque', sans-serif;
    font-size: 15px;
    line-height: 1.4;
    margin: 0;
    color: #ffffff !important;
  }

  .hp-sci-proto-{{ section.id }}__link {
    display: inline-block;
    font-family: 'Darker Grotesque', sans-serif;
    font-size: 15px;
    color: #ffffff !important;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hp-sci-proto-{{ section.id }}__link:hover {
    opacity: 0.82;
  }

  .hp-sci-proto-{{ section.id }}__chart-wrap {
    width: 100%;
    min-height: clamp(320px, 36vw, 420px);
  }

  .hp-sci-proto-{{ section.id }}__chart-wrap .hp-sci-media,
  .hp-sci-proto-{{ section.id }}__chart-wrap .hp-sci-media__img {
    width: 100%;
    height: auto;
    min-height: clamp(320px, 36vw, 420px);
    object-fit: contain;
  }

  .hp-sci-proto-{{ section.id }}__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .hp-sci-proto-{{ section.id }}__grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-proto-{{ section.id }}">
  <div class="hp-sci__inner">
    <div class="hp-sci-proto-{{ section.id }}__grid">
      <div class="hp-sci-proto-{{ section.id }}__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-sci-proto-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.title_line_1 != blank -%}
          <h2 class="hp-sci-proto-{{ section.id }}__title-main">{{ section.settings.title_line_1 }}</h2>
        {%- endif -%}
        {%- if section.settings.title_line_2 != blank -%}
          <p class="hp-sci-proto-{{ section.id }}__title-sub">{{ section.settings.title_line_2 }}</p>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="hp-sci-proto-{{ section.id }}__body">{{ section.settings.body }}</p>
        {%- endif -%}

        <div class="hp-sci-proto-{{ section.id }}__stats">
          {%- if section.settings.stat_1_value != blank -%}
            <div>
              <p class="hp-sci-proto-{{ section.id }}__stat-value">{{ section.settings.stat_1_value }}</p>
              {%- if section.settings.stat_1_label != blank -%}
                <p class="hp-sci-proto-{{ section.id }}__stat-label">{{ section.settings.stat_1_label }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.stat_2_value != blank -%}
            <div>
              <p class="hp-sci-proto-{{ section.id }}__stat-value">{{ section.settings.stat_2_value }}</p>
              {%- if section.settings.stat_2_label != blank -%}
                <p class="hp-sci-proto-{{ section.id }}__stat-label">{{ section.settings.stat_2_label }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a class="hp-sci-proto-{{ section.id }}__link" href="{{ protocol_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>

      <div class="hp-sci-proto-{{ section.id }}__chart-wrap">
        {%- if section.settings.chart_image != blank -%}
          {{
            section.settings.chart_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 990px) 55vw, 100vw',
              class: 'hp-sci-media__img',
              alt: section.settings.chart_image.alt | default: '75-day protocol graph' | escape
          }}
        {%- else -%}
          <svg class="hp-sci-proto-{{ section.id }}__svg" viewBox="0 0 640 380" role="img" aria-label="{{ section.settings.chart_aria_label | default: 'Protocol results graph' | escape }}">
            <rect width="640" height="380" fill="transparent"/>
            <g fill="none" stroke="#666666" stroke-width="1">
              <line x1="72" y1="48" x2="72" y2="300"/>
              <line x1="72" y1="300" x2="600" y2="300"/>
            </g>
            <g fill="#888888" font-family="Darker Grotesque, sans-serif" font-size="13">
              <text x="48" y="304">0</text>
              <text x="36" y="244">25%</text>
              <text x="36" y="184">50%</text>
              <text x="36" y="124">75%</text>
            </g>
            <g fill="{{ section.settings.accent_color }}" font-family="Darker Grotesque, sans-serif" font-size="12" letter-spacing="0.08em">
              <text x="72" y="328">DAY 0</text>
              <text x="198" y="328">DAY 28</text>
              <text x="360" y="328">DAY 56</text>
              <text x="548" y="328">DAY 75</text>
            </g>
            <path d="M72 292 C140 288, 220 250, 300 190 S480 90, 590 58" stroke="{{ section.settings.accent_color }}" stroke-width="2.5" fill="none"/>
            <circle cx="590" cy="58" r="7" fill="{{ section.settings.accent_color }}"/>
            <text x="470" y="44" fill="{{ section.settings.accent_color }}" font-family="Darker Grotesque, sans-serif" font-size="14">{{ section.settings.primary_line_label | default: 'Structural change' }}</text>
            <path d="M72 278 L590 268" stroke="#777777" stroke-width="1.5" stroke-dasharray="6 6" fill="none"/>
            <text x="470" y="252" fill="#888888" font-family="Darker Grotesque, sans-serif" font-size="13">{{ section.settings.secondary_line_label | default: 'Typical serum' }}</text>
            <g font-family="Darker Grotesque, sans-serif" font-size="13">
              <line x1="170" y1="350" x2="210" y2="350" stroke="{{ section.settings.accent_color }}" stroke-width="2"/>
              <text x="218" y="354" fill="#aaaaaa">{{ section.settings.primary_legend | default: 'LNGVTY' }}</text>
              <line x1="300" y1="350" x2="340" y2="350" stroke="#777777" stroke-width="1.5" stroke-dasharray="6 6"/>
              <text x="348" y="354" fill="#aaaaaa">{{ section.settings.secondary_legend | default: 'Typical serum' }}</text>
            </g>
          </svg>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science — Protocol",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE 75-DAY PROTOCOL"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title line 1",
      "default": "Slow start."
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title line 2",
      "default": "Permanent finish."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Three renewal cycles. Each builds on the last. By day 75 the change is structural, and it holds."
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 value",
      "default": "28"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 label",
      "default": "Days per skin cycle"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 value",
      "default": "3"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "Full cycles in 75 days"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Start the protocol →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Chart"
    },
    {
      "type": "image_picker",
      "id": "chart_image",
      "label": "Chart image override"
    },
    {
      "type": "text",
      "id": "chart_aria_label",
      "label": "Chart accessibility label",
      "default": "75-day protocol results graph"
    },
    {
      "type": "text",
      "id": "primary_line_label",
      "label": "Primary line end label",
      "default": "Structural change"
    },
    {
      "type": "text",
      "id": "secondary_line_label",
      "label": "Secondary line label",
      "default": "Typical serum"
    },
    {
      "type": "text",
      "id": "primary_legend",
      "label": "Primary legend",
      "default": "LNGVTY"
    },
    {
      "type": "text",
      "id": "secondary_legend",
      "label": "Secondary legend",
      "default": "Typical serum"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "title_accent_color",
      "label": "Title line 2 color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (stats + chart)",
      "default": "#e8842c"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 32,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Science — Protocol"
    }
  ]
}
{% endschema %}
