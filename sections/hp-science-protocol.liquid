{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign protocol_link = section.settings.button_link
  if protocol_link == blank
    assign protocol_link = routes.all_products_collection_url
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-proto-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  .hp-sci-proto-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .hp-sci-proto-{{ section.id }}__eyebrow {
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 20px;
  }

  .hp-sci-proto-{{ section.id }}__title-main {
    line-height: 1.05;
    margin: 0;
    color: #ffffff !important;
  }

  .hp-sci-proto-{{ section.id }}__title-sub {
    line-height: 1.05;
    margin: 0 0 clamp(24px, 3vw, 32px);
    color: {{ section.settings.title_accent_color }} !important;
  }

  .hp-sci-proto-{{ section.id }}__body {
    line-height: 1.65;
    max-width: 38ch;
    margin: 0 0 clamp(28px, 4vw, 40px);
    color: #ffffff !important;
  }

  .hp-sci-proto-{{ section.id }}__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 48px);
    max-width: 360px;
    margin-bottom: clamp(32px, 4vw, 44px);
  }

  .hp-sci-proto-{{ section.id }}__stat-value {
    line-height: 1;
    margin: 0 0 8px;
    color: {{ section.settings.accent_color }} !important;
  }

  .hp-sci-proto-{{ section.id }}__stat-label {
    line-height: 1.4;
    margin: 0;
    color: #ffffff !important;
  }

  .hp-sci-proto-{{ section.id }}__link {
    display: inline-block;
    color: #ffffff !important;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hp-sci-proto-{{ section.id }}__link:hover {
    opacity: 0.82;
  }

  .hp-sci-proto-{{ section.id }}__chart-wrap {
    width: 100%;
    min-height: clamp(320px, 36vw, 420px);
  }

  .hp-sci-proto-{{ section.id }}__chart-wrap .hp-sci-media,
  .hp-sci-proto-{{ section.id }}__chart-wrap .hp-sci-media__img {
    width: 100%;
    height: auto;
    min-height: clamp(320px, 36vw, 420px);
    object-fit: contain;
  }

  .hp-sci-proto-{{ section.id }}__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .hp-sci-proto-{{ section.id }}__svg .animated-dot,
  .hp-sci-proto-{{ section.id }}__svg .animated-text {
    opacity: 0;
    transition: opacity 0.5s ease-out 2s;
  }
  
  .hp-sci-proto-{{ section.id }}__svg .animated-fade {
    opacity: 0;
    transition: opacity 1s ease-out 1s;
  }
  
  .hp-sci-proto-{{ section.id }}__svg.animate-chart .animated-dot,
  .hp-sci-proto-{{ section.id }}__svg.animate-chart .animated-text,
  .hp-sci-proto-{{ section.id }}__svg.animate-chart .animated-fade {
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    .hp-sci-proto-{{ section.id }}__grid {
      grid-template-columns: 1fr;
    }
  }
  {% render 'hp-science-section-typography-styles', section: section %}
{%- endstyle -%}

<section class="hp-sci hp-sci-proto-{{ section.id }}">
  <div class="hp-sci__inner">
    <div class="hp-sci-proto-{{ section.id }}__grid">
      <div class="hp-sci-proto-{{ section.id }}__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-sci-proto-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.title_line_1 != blank -%}
          <h2 class="hp-sci-proto-{{ section.id }}__title-main">{{ section.settings.title_line_1 }}</h2>
        {%- endif -%}
        {%- if section.settings.title_line_2 != blank -%}
          <p class="hp-sci-proto-{{ section.id }}__title-sub">{{ section.settings.title_line_2 }}</p>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <p class="hp-sci-proto-{{ section.id }}__body">{{ section.settings.body }}</p>
        {%- endif -%}

        <div class="hp-sci-proto-{{ section.id }}__stats">
          {%- if section.settings.stat_1_value != blank -%}
            <div>
              <p class="hp-sci-proto-{{ section.id }}__stat-value">{{ section.settings.stat_1_value }}</p>
              {%- if section.settings.stat_1_label != blank -%}
                <p class="hp-sci-proto-{{ section.id }}__stat-label">{{ section.settings.stat_1_label }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.stat_2_value != blank -%}
            <div>
              <p class="hp-sci-proto-{{ section.id }}__stat-value">{{ section.settings.stat_2_value }}</p>
              {%- if section.settings.stat_2_label != blank -%}
                <p class="hp-sci-proto-{{ section.id }}__stat-label">{{ section.settings.stat_2_label }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a class="hp-sci-proto-{{ section.id }}__link" href="{{ protocol_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>

      <div class="hp-sci-proto-{{ section.id }}__chart-wrap">
        {%- if section.settings.chart_image != blank -%}
          {{
            section.settings.chart_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 990px) 55vw, 100vw',
              class: 'hp-sci-media__img',
              alt: section.settings.chart_image.alt | default: '75-day protocol graph' | escape
          }}
        {%- else -%}
          <svg class="hp-sci-proto-{{ section.id }}__svg" viewBox="0 0 640 380" role="img" aria-label="{{ section.settings.chart_aria_label | default: 'Protocol results graph' | escape }}">
            <rect width="640" height="380" fill="transparent"/>
            <g fill="none" stroke="#666666" stroke-width="1">
              <line x1="72" y1="48" x2="72" y2="300"/>
              <line x1="72" y1="300" x2="600" y2="300"/>
            </g>
            <g fill="#888888" font-family="Darker Grotesque, sans-serif" font-size="13">
              <text x="48" y="304">0</text>
              <text x="36" y="244">25%</text>
              <text x="36" y="184">50%</text>
              <text x="36" y="124">75%</text>
            </g>
            <g fill="{{ section.settings.accent_color }}" font-family="Darker Grotesque, sans-serif" font-size="12" letter-spacing="0.08em">
              <text x="72" y="328">DAY 0</text>
              <text x="198" y="328">DAY 28</text>
              <text x="360" y="328">DAY 56</text>
              <text x="548" y="328">DAY 75</text>
            </g>
            <path class="animated-path" d="M72 292 C140 288, 220 250, 300 190 S480 90, 590 58" stroke="{{ section.settings.accent_color }}" stroke-width="2.5" fill="none"/>
            <circle class="animated-dot" cx="590" cy="58" r="7" fill="{{ section.settings.accent_color }}"/>
            <text class="animated-text" x="470" y="44" fill="{{ section.settings.accent_color }}" font-family="Darker Grotesque, sans-serif" font-size="14">{{ section.settings.primary_line_label | default: 'Structural change' }}</text>
            <path class="animated-fade" d="M72 278 L590 268" stroke="#777777" stroke-width="1.5" stroke-dasharray="6 6" fill="none"/>
            <text class="animated-fade" x="470" y="252" fill="#888888" font-family="Darker Grotesque, sans-serif" font-size="13">{{ section.settings.secondary_line_label | default: 'Typical serum' }}</text>
            <g font-family="Darker Grotesque, sans-serif" font-size="13">
              <line x1="170" y1="350" x2="210" y2="350" stroke="{{ section.settings.accent_color }}" stroke-width="2"/>
              <text x="218" y="354" fill="#aaaaaa">{{ section.settings.primary_legend | default: 'LNGVTY' }}</text>
              <line x1="300" y1="350" x2="340" y2="350" stroke="#777777" stroke-width="1.5" stroke-dasharray="6 6"/>
              <text x="348" y="354" fill="#aaaaaa">{{ section.settings.secondary_legend | default: 'Typical serum' }}</text>
            </g>
          </svg>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const statObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          if (el.dataset.animated) return;
          el.dataset.animated = 'true';
          
          const text = el.textContent.trim();
          const match = text.match(/^([^0-9.-]*)([0-9,.]+)(.*)$/);
          if (match) {
            const prefix = match[1];
            const numberStr = match[2].replace(/,/g, '');
            const suffix = match[3];
            const targetNum = parseFloat(numberStr);
            if (isNaN(targetNum)) return;
            const isFloat = numberStr.includes('.');
            const decimals = isFloat ? numberStr.split('.')[1].length : 0;
            
            const duration = 2000;
            const startTime = performance.now();
            
            const animate = (currentTime) => {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              
              const easeOutQuart = 1 - Math.pow(1 - progress, 4);
              const currentNum = targetNum * easeOutQuart;
              
              el.textContent = prefix + currentNum.toFixed(decimals) + suffix;
              
              if (progress < 1) {
                requestAnimationFrame(animate);
              } else {
                el.textContent = text;
              }
            };
            
            requestAnimationFrame(animate);
          }
        }
      });
    }, { threshold: 0.2 });
    
    document.querySelectorAll('.hp-sci-proto-{{ section.id }}__stat-value').forEach(el => statObserver.observe(el));
    
    const chartObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const chart = entry.target;
          if (chart.dataset.animated) return;
          chart.dataset.animated = 'true';
          
          const path = chart.querySelector('.animated-path');
          if (path) {
            const length = path.getTotalLength();
            path.style.strokeDasharray = length + ' ' + length;
            path.style.strokeDashoffset = length;
            path.getBoundingClientRect(); 
            path.style.transition = 'stroke-dashoffset 2s ease-in-out';
            path.style.strokeDashoffset = '0';
          }
          
          chart.classList.add('animate-chart');
        }
      });
    }, { threshold: 0.3 });
    
    const chart = document.querySelector('.hp-sci-proto-{{ section.id }}__svg');
    if (chart) {
      chartObserver.observe(chart);
    }
  });
</script>

