      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_desktop",
      "label": "Vertical offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_x_mobile",
      "label": "Horizontal offset \u2014 mobile",
      "min": -200,
      "max": 200,
