{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_color = section.settings.background_color
  if bg_color == '#ffffff' or bg_color == '#fff' or bg_color == blank or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = '#1a1a1a'
  endif
-%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    background: {{ bg_color }};
  }

  .hp-sci-headlines-{{ section.id }}__system {
    text-align: center;
    background: {{ bg_color }};
    color: {{ section.settings.heading_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .hp-sci-headlines-{{ section.id }}__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hp-sci-headlines-{{ section.id }}__eyebrow {
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 18px;
  }

  .hp-sci-headlines-{{ section.id }}__rule {
    display: block;
    width: 1px;
    height: {{ section.settings.rule_height }}px;
    background: {{ section.settings.rule_color }};
    opacity: {{ section.settings.rule_opacity | default: 100 | times: 0.01 }};
    margin: 0 auto clamp(28px, 4vw, 40px);
  }

  .hp-sci-headlines-{{ section.id }}__heading {
    line-height: 1.08;
    margin: 0 0 clamp(28px, 4vw, 40px);
    color: inherit;
  }

  .hp-sci-headlines-{{ section.id }}__heading-line {
    display: block;
  }

  .hp-sci-headlines-{{ section.id }}__subtext {
    line-height: 1.65;
    color: {{ section.settings.subtext_color }};
    opacity: {{ section.settings.subtext_opacity | default: 88 | times: 0.01 }};
    margin: 0;
    max-width: 36ch;
  }

  .hp-sci-headlines-{{ section.id }}__formula {
    text-align: center;
    background: {{ section.settings.formula_bg }};
    color: {{ section.settings.formula_heading_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    box-sizing: border-box;
    padding-top: {{ section.settings.formula_padding_top }}px;
    padding-bottom: {{ section.settings.formula_padding_bottom | default: 112 }}px;
  }

  .hp-sci-headlines-{{ section.id }}__formula-inner {
    max-width: {{ section.settings.formula_content_max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 100%;
  }

  .hp-sci-headlines-{{ section.id }}__formula-eyebrow {
    text-transform: uppercase;
    color: {{ section.settings.formula_eyebrow_color }};
    margin: 0 0 clamp(32px, 4.5vw, 48px);
  }

  .hp-sci-headlines-{{ section.id }}__formula-title {
    line-height: 1.04 !important;
    text-transform: none !important;
    margin: 0 0 clamp(32px, 4.5vw, 48px) !important;
    color: inherit !important;
  }

  .hp-sci-headlines-{{ section.id }}__formula-title-line {
    display: block;
  }

  .hp-sci-headlines-{{ section.id }}__formula-title-line + .hp-sci-headlines-{{ section.id }}__formula-title-line {
    margin-top: 0.06em;
  }

  .hp-sci-headlines-{{ section.id }}__formula-accent {
    color: {{ section.settings.formula_accent_color }};
  }

  .hp-sci-headlines-{{ section.id }}__formula-subtext {
    line-height: 1.7;
    color: {{ section.settings.formula_subtext_color }};
    opacity: {{ section.settings.formula_subtext_opacity | default: 92 | times: 0.01 }};
    margin: 0;
    max-width: min(44ch, 92%);
  }
  {%- if section.settings.text_offset_x_desktop != 0 or section.settings.text_offset_y_desktop != 0 -%}


  .hp-sci-headlines-{{ section.id }}__text-position {
    transform: translate({{ section.settings.text_offset_x_desktop | default: 0 }}px, {{ section.settings.text_offset_y_desktop | default: 0 }}px);
  }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    .hp-sci-headlines-{{ section.id }}__formula {
      min-height: 0;
    }

    .hp-sci-headlines-{{ section.id }}__formula-subtext {
      max-width: 34ch;
    }
    {%- if section.settings.text_offset_x_mobile != 0 or section.settings.text_offset_y_mobile != 0 -%}
  
    .hp-sci-headlines-{{ section.id }}__text-position {
      transform: translate({{ section.settings.text_offset_x_mobile | default: 0 }}px, {{ section.settings.text_offset_y_mobile | default: 0 }}px);
    }
    {%- endif -%}
}

  #shopify-section-{{ section.id }} .hp-sci .hp-sci-headlines-{{ section.id }}__heading {
    font-size: {{ section.settings.heading_size_desktop | default: 52 }}px !important;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .hp-sci .hp-sci-headlines-{{ section.id }}__heading {
      font-size: {{ section.settings.heading_size_mobile | default: 24 }}px !important;
    }
  }
  {% render 'hp-science-section-typography-styles', section: section %}

  /* Force remove bottom gap even if set in typography settings */
  #shopify-section-{{ section.id }},
  .hp-sci-headlines-{{ section.id }} {
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
  }

  /* HIGH-SPECIFICITY eyebrow override — matches asset CSS specificity (0,1,3,1) but is LATER in document so wins */
  body.template-page-hague #shopify-section-{{ section.id }} .hp-sci [class*="__eyebrow"],
  body.template-search-hague #shopify-section-{{ section.id }} .hp-sci [class*="__eyebrow"] {
    font-size: 32px !important;
  }
  @media screen and (max-width: 989px) {
    body.template-page-hague #shopify-section-{{ section.id }} .hp-sci [class*="__eyebrow"],
    body.template-search-hague #shopify-section-{{ section.id }} .hp-sci [class*="__eyebrow"] {
      font-size: 24px !important;
    }
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-headlines-{{ section.id }}">
  <div class="hp-sci-headlines-{{ section.id }}__system">
    <div class="hp-sci-headlines-{{ section.id }}__inner hp-sci-headlines-{{ section.id }}__text-position">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-sci-headlines-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.show_rule -%}
        <span class="hp-sci-headlines-{{ section.id }}__rule" aria-hidden="true"></span>
      {%- endif -%}

      {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank or section.settings.heading_line_3 != blank or section.settings.heading_line_4 != blank -%}
        <h2 class="hp-sci-headlines-{{ section.id }}__heading">
          {%- if section.settings.heading_line_1 != blank -%}
            <span class="hp-sci-headlines-{{ section.id }}__heading-line">{{ section.settings.heading_line_1 }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_2 != blank -%}
            <span class="hp-sci-headlines-{{ section.id }}__heading-line">{{ section.settings.heading_line_2 }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_3 != blank -%}
            <span class="hp-sci-headlines-{{ section.id }}__heading-line">{{ section.settings.heading_line_3 }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_4 != blank -%}
            <span class="hp-sci-headlines-{{ section.id }}__heading-line">{{ section.settings.heading_line_4 }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="hp-sci-headlines-{{ section.id }}__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_formula_band -%}
    <div class="hp-sci-headlines-{{ section.id }}__formula">
      <div class="hp-sci-headlines-{{ section.id }}__formula-inner">
        {%- if section.settings.formula_eyebrow != blank -%}
          <p class="hp-sci-headlines-{{ section.id }}__formula-eyebrow">{{ section.settings.formula_eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.formula_title_line_1 != blank or section.settings.formula_title_line_2 != blank or section.settings.formula_title_accent != blank -%}
          <h2 class="hp-sci-headlines-{{ section.id }}__formula-title">
            {%- if section.settings.formula_title_line_1 != blank -%}
              <span class="hp-sci-headlines-{{ section.id }}__formula-title-line">{{ section.settings.formula_title_line_1 }}</span>
            {%- endif -%}
            {%- if section.settings.formula_title_line_2 != blank or section.settings.formula_title_accent != blank -%}
              <span class="hp-sci-headlines-{{ section.id }}__formula-title-line">
                {{- section.settings.formula_title_line_2 -}}
                {%- if section.settings.formula_title_accent != blank -%}
                  <span class="hp-sci-headlines-{{ section.id }}__formula-accent">{{ section.settings.formula_title_accent }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}
          </h2>
        {%- endif -%}

        {%- if section.settings.formula_subtext != blank -%}
          <p class="hp-sci-headlines-{{ section.id }}__formula-subtext">{{ section.settings.formula_subtext }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
