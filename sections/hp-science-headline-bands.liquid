{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-headlines-{{ section.id }}__band {
    text-align: center;
    padding: {{ section.settings.band1_padding }}px var(--hp-sci-gutter, 28px);
  }

  .hp-sci-headlines-{{ section.id }}__band--dark {
    background: {{ section.settings.band1_bg }};
    color: {{ section.settings.band1_color }};
  }

  .hp-sci-headlines-{{ section.id }}__band--light {
    background: {{ section.settings.band2_bg }};
    color: {{ section.settings.band2_color }};
    padding-top: {{ section.settings.band2_padding_top }}px;
    padding-bottom: {{ section.settings.band2_padding_bottom }}px;
  }

  .hp-sci-headlines-{{ section.id }}__line1 {
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    font-size: clamp(22px, 3vw, {{ section.settings.band1_size }}px);
    line-height: 1.2;
    margin: 0;
    max-width: 24ch;
    margin-left: auto;
    margin-right: auto;
  }

  .hp-sci-headlines-{{ section.id }}__line2 {
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    font-size: clamp(36px, 6vw, {{ section.settings.band2_size }}px);
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.03em;
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-headlines-{{ section.id }}">
  {%- if section.settings.statement != blank -%}
    <div class="hp-sci-headlines-{{ section.id }}__band hp-sci-headlines-{{ section.id }}__band--dark">
      <p class="hp-sci-headlines-{{ section.id }}__line1">{{ section.settings.statement }}</p>
    </div>
  {%- endif -%}

  {%- if section.settings.system_title != blank -%}
    <div class="hp-sci-headlines-{{ section.id }}__band hp-sci-headlines-{{ section.id }}__band--light">
      <h2 class="hp-sci-headlines-{{ section.id }}__line2">{{ section.settings.system_title }}</h2>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Science — Headline bands",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "textarea",
      "id": "statement",
      "label": "Statement (dark band)",
      "default": "We didn't build another product. We built a skin longevity formula."
    },
    {
      "type": "text",
      "id": "system_title",
      "label": "System title (light band)",
      "default": "Skin Longevity System 5"
    },
    {
      "type": "color",
      "id": "band1_bg",
      "label": "Dark band background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "band1_color",
      "label": "Dark band text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "band1_size",
      "label": "Dark band text size",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "band1_padding",
      "label": "Dark band padding",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "color",
      "id": "band2_bg",
      "label": "Light band background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "band2_color",
      "label": "Light band text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "band2_size",
      "label": "System title size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "band2_padding_top",
      "label": "Light band padding top",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "band2_padding_bottom",
      "label": "Light band padding bottom",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Science — Headline bands"
    }
  ]
}
{% endschema %}
