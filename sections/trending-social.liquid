<script>
  (function () {
    /* ── 3-D Fan Layout for Trending Social ── */

    /*
     * LINEAR INTERPOLATION FAN — replaces the old bucket/Math.round() approach.
     *
     * Each card gets t = absDist / maxDist, where:
     *   t = 0  → center card  (no rotation, no drop)
     *   t = 1  → outermost card (full rotation, full drop)
     *
     * Because t is computed from the RAW distance (not rounded into buckets),
     * symmetric cards at equal distance from center always get exactly equal
     * t values — guaranteeing a smooth, symmetric U-curve for any card count.
     *
     * Outermost card targets (t=1):
     *   rotY  = 25 deg  (inward-cup concave direction)
     *   transY = 60 px  (drop down)
     *   transZ = 40 px  (closer to viewer)
     */
    var MAX_ROT_Y  = 25;  // deg at outermost card
    var MAX_DROP_Y = 60;  // px translateY at outermost card
    var MAX_DEPTH  = 40;  // px translateZ at outermost card

    function applyFanTransforms(slider) {
      if (window.innerWidth < 750) {
        /* Mobile: clear any desktop inline styles so scroll-snap works cleanly */
        Array.from(slider.querySelectorAll('.trending-social__slide')).forEach(function (s) {
          s.style.removeProperty('--fan-rotY');
          s.style.removeProperty('--fan-transX');
          s.style.removeProperty('--fan-transY');
          s.style.removeProperty('--fan-transZ');
          s.style.removeProperty('z-index');
        });
        return;
      }

      var slides  = Array.from(slider.querySelectorAll('.trending-social__slide'));
      var total   = slides.length;
      if (total < 2) return;

      var center  = (total - 1) / 2;  // e.g. 2.0 for 5 cards, 2.5 for 6 cards
      var maxDist = center;            // maximum possible absDist

      slides.forEach(function (slide, i) {
        var dist    = i - center;              // raw signed distance from center
        var absDist = Math.abs(dist);          // always non-negative
        var side    = dist >= 0 ? 1 : -1;     // +1 = right of center, -1 = left

        /*
         * t: normalized position, 0 at center → 1 at outermost.
         * Cards at equal |dist| from center get identical t values —
         * no rounding, no bucket asymmetry, guaranteed smooth arc.
         */
        var t = absDist / maxDist;

        /*
         * Concave U-cup direction:
         *   right-side cards (side=+1) get NEGATIVE rotY so their RIGHT
         *   (outer) edge comes toward the viewer.
         *   left-side cards  (side=-1) get POSITIVE rotY so their LEFT
         *   (outer) edge comes toward the viewer.
         */
        var rotY   = -side * MAX_ROT_Y  * t;
        var transY =         MAX_DROP_Y * t;   /* positive = downward, forms U */
        var transZ =         MAX_DEPTH  * t;   /* positive = closer to viewer  */

        /* z-index: center on top (value 50), outermost at 30 */
        slide.style.zIndex = String(Math.round(50 - 20 * t));

        slide.style.setProperty('--fan-rotY',   rotY.toFixed(2)   + 'deg');
        slide.style.setProperty('--fan-transX', '0px');
        slide.style.setProperty('--fan-transY', transY.toFixed(2) + 'px');
        slide.style.setProperty('--fan-transZ', transZ.toFixed(2) + 'px');
      });
    }

    function initSocialSlider() {
      var slider      = document.getElementById('trending-social-slider-{{ section.id }}');
      var sectionRoot = document.getElementById('shopify-section-{{ section.id }}');

      if (!slider) return;

      /* Apply fan transforms on desktop */
      applyFanTransforms(slider);

      /* Re-apply on resize (desktop ↔ mobile switch) */
      var resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          applyFanTransforms(slider);
        }, 120);
      });

      /* Mobile: keep swipe-drag behaviour intact */
      var isDragging = false;
      var startX, scrollLeft;

      slider.addEventListener('mousedown', function (e) {
        if (window.innerWidth >= 750) return; // fan view — no drag-scroll
        isDragging = true;
        slider.classList.add('active');
        startX     = e.pageX - slider.offsetLeft;
        scrollLeft = slider.scrollLeft;
      });
      slider.addEventListener('mouseleave', function () {
        isDragging = false;
        slider.classList.remove('active');
      });
      slider.addEventListener('mouseup', function () {
        isDragging = false;
        slider.classList.remove('active');
      });
      slider.addEventListener('mousemove', function (e) {
        if (!isDragging) return;
        e.preventDefault();
        var x    = e.pageX - slider.offsetLeft;
        var walk = (x - startX) * 2;
        slider.scrollLeft = scrollLeft - walk;
      });

      /* Ensure all videos autoplay */
      var allVideos = document.querySelectorAll(
        '#shopify-section-{{ section.id }} .trending-social__media video'
      );
      allVideos.forEach(function (v) {
        v.muted = true;
        v.setAttribute('autoplay', 'true');
        v.setAttribute('playsinline', 'true');
        v.setAttribute('loop', 'true');
        v.play().catch(function (err) {
          console.log('Video play caught:', err);
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initSocialSlider);
    document.addEventListener('shopify:section:load', initSocialSlider);

    document.addEventListener('shopify:block:select', function (e) {
      var video = e.target.querySelector('video');
      if (video) {
        video.muted = true;
        video.play().catch(function (err) {
          console.log('Autoplay handled:', err);
        });
      }
    });
  })();
</script>

