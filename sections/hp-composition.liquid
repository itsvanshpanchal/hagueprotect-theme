            "subtitle": "Numbered. Then never again."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "312 G",
            "subtitle": "Featherweight at a US 9"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "8 MM DROP",
            "subtitle": "Tuned for all-day wear"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "WAXED LACES",
            "subtitle": "Volt dip finish"
          }
        }
      ]
    }
  ]
}
{% endschema %}
