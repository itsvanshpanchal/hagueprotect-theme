{%- style -%}
  {% render 'section-typography-vars', section: section %}

  #shopify-section-{{ section.id }} .hp-composition-section {
    background-color: {{ section.settings.bg_color | default: '#F2EFE8' }};
    position: relative;
    height: 150vh;
    font-family: var(--font-family-sans, 'Inter', sans-serif);
  }

  .hp-comp__sticky {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .hp-composition-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    height: 800px;
  }

  .hp-composition-heading {
    position: absolute;
    top: -60px;
    left: 0;
    width: 100%;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.02em;
    color: #111;
    z-index: 10;
    margin: 0;
  }
  
  .hp-composition-heading .highlight {
    background-color: {{ section.settings.accent_color | default: '#d2fa3c' }};
    padding: 0 10px;
    display: inline-block;
  }

  .hp-comp-center-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    max-width: 90vw;
    z-index: 5;
  }
  
  .hp-comp-center-img img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .hp-comp-card {
    position: absolute;
    background: #fff;
    border-radius: 12px;
    padding: 24px;
    width: 280px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    z-index: 10;
    opacity: 0;
    will-change: transform, opacity;
  }
  
  .hp-comp-card-line {
    width: 20px;
    height: 3px;
    background-color: {{ section.settings.accent_color | default: '#d2fa3c' }};
    margin-bottom: 16px;
  }

  .hp-comp-card-title {
    font-family: 'Inter', sans-serif;
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #111;
    margin-bottom: 8px;
    text-transform: uppercase;
  }
  
  .hp-comp-card-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 300;
    color: #6a6a6a;
    line-height: 1.4;
  }

  .hp-comp-hover-text {
    position: absolute;
    bottom: 12px;
    right: 12px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #999;
    text-transform: uppercase;
  }

  /* Fixed Positions - Desktop */
  /* Top Left */
  .hp-comp-card-0 { top: 100px; left: 80px; }
  /* Mid Left */
  .hp-comp-card-1 { top: 350px; left: 40px; }
  /* Bottom Left */
  .hp-comp-card-2 { bottom: 100px; left: 100px; }
  /* Top Right */
  .hp-comp-card-3 { top: 120px; right: 80px; }
  /* Mid Right */
  .hp-comp-card-4 { top: 400px; right: 40px; }
  /* Bottom Right */
  .hp-comp-card-5 { bottom: 80px; right: 120px; }

  @media screen and (max-width: 989px) {
    .hp-composition-section {
      height: auto;
      padding: 100px 20px;
    }
    .hp-comp__sticky {
      position: relative !important;
      height: auto;
    }
    .hp-composition-container {
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 30px;
    }
    .hp-composition-heading {
      position: relative;
      top: 0;
      margin-bottom: 40px;
    }
    .hp-comp-center-img {
      position: relative;
      top: 0;
      left: 0;
      transform: none;
      margin-bottom: 40px;
    }
    .hp-comp-card {
      position: relative;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      width: 100%;
      max-width: 400px;
      opacity: 1 !important;
      transform: none !important;
    }
  }
{%- endstyle -%}

<section class="hp-composition-section hp-composition-{{ section.id }}">
  <div class="hp-comp__sticky">
    <div class="hp-composition-container">

      {%- if section.settings.heading != blank -%}
        <h2 class="hp-composition-heading" data-no-typewriter>
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      
      {%- if section.settings.center_image != blank -%}
        <div class="hp-comp-center-img">
          <img src="{{ section.settings.center_image | image_url: width: 1000 }}" alt="Composition" loading="lazy">
        </div>
      {%- else -%}
        <div class="hp-comp-center-img" style="display:flex;align-items:center;justify-content:center;background:#e5e5e5;border-radius:24px;aspect-ratio:1;color:#666;">
          UPLOAD SHOE IMAGE
        </div>
      {%- endif -%}

      {%- for block in section.blocks limit: 6 -%}
        {%- assign card_class = 'hp-comp-card hp-comp-card-' | append: forloop.index0 -%}
        
        <div class="{{ card_class }}" 
             style="background-color: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};" 
             {{ block.shopify_attributes }}>
          
          {%- if block.settings.show_line -%}
            <div class="hp-comp-card-line" {% if block.settings.bg_color == section.settings.accent_color %}style="background-color: #111;"{% endif %}></div>
          {%- endif -%}
          
          <div class="hp-comp-card-title">
            {{ block.settings.title | replace: '\n', '<br>' }}
          </div>
          
          {%- if block.settings.subtitle != blank -%}
            <div class="hp-comp-card-subtitle" {% if block.settings.bg_color == section.settings.accent_color %}style="color: #444;"{% endif %}>
              {{ block.settings.subtitle }}
            </div>
          {%- endif -%}
          
          <div class="hp-comp-hover-text" {% if block.settings.bg_color == section.settings.accent_color %}style="color: #666;"{% endif %}>
            HOVER ⟳
          </div>
          
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var section = document.querySelector('.hp-composition-{{ section.id }}');
  if (!section) return;
  var stickyEl = section.querySelector('.hp-comp__sticky');
  
  var cards = [];
  for (var i = 0; i < 6; i++) {
    var el = section.querySelector('.hp-comp-card-' + i);
    if (el) cards.push(el);
  }

  var targetProgress = 0;
  var currentProgress = 0;
  var isPinned = false;
  var hasScrolledPast = false;

  function updateTargetProgress() {
    if (window.innerWidth <= 989) {
      if (isPinned || hasScrolledPast) {
        stickyEl.style.position = '';
        stickyEl.style.top = '';
        stickyEl.style.bottom = '';
        stickyEl.style.zIndex = '';
        isPinned = false;
        hasScrolledPast = false;
      }
      return; 
    }

    var rect = section.getBoundingClientRect();
    var maxScroll = rect.height - window.innerHeight;
    
    if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
      if (!isPinned) {
        stickyEl.style.position = 'fixed';
        stickyEl.style.top = '0px';
        stickyEl.style.bottom = 'auto';
        stickyEl.style.zIndex = '9';
        isPinned = true;
      }
      hasScrolledPast = false;
      targetProgress = Math.abs(rect.top) / maxScroll;
      targetProgress = Math.max(0, Math.min(1, targetProgress));

    } else if (rect.top > 0) {
      if (isPinned || hasScrolledPast) {
        stickyEl.style.position = 'absolute';
        stickyEl.style.top = '0px';
        stickyEl.style.bottom = 'auto';
        stickyEl.style.zIndex = '2';
        isPinned = false;
        hasScrolledPast = false;
      }
      targetProgress = 0; 
    } else if (rect.bottom < window.innerHeight) {
      if (isPinned || !hasScrolledPast) {
        stickyEl.style.position = 'absolute';
        stickyEl.style.top = 'auto';
        stickyEl.style.bottom = '0px';
        stickyEl.style.zIndex = '2';
        isPinned = false;
        hasScrolledPast = true;
      }
      targetProgress = 1; 
    }
  }

  function renderLoop() {
    if (window.innerWidth > 989) {
      currentProgress += (targetProgress - currentProgress) * 0.05;

      var introProgress = Math.min(1, currentProgress * 2);
      
      cards.forEach(function(card, idx) {
        if (!card) return;
        
        var scatterY = 0;
        if (currentProgress > 0.5) {
            var scatterProgress = (currentProgress - 0.5) * 2;
            var xDir = (idx < 3) ? -1 : 1;
            var yDir = (idx % 3 === 0) ? -1 : (idx % 3 === 2) ? 1 : 0;
            
            card.style.transform = 'translate(' + (xDir * scatterProgress * 300) + 'px, ' + (yDir * scatterProgress * 200) + 'px)';
        } else {
             var yOffset = 40 - (introProgress * 40);
             card.style.transform = 'translateY(' + yOffset + 'px)';
        }
        
        card.style.opacity = introProgress;
      });
    }

    window.requestAnimationFrame(renderLoop);
  }

  window.addEventListener('scroll', updateTargetProgress, { passive: true });
  window.addEventListener('resize', updateTargetProgress, { passive: true });
  
  updateTargetProgress();
  window.requestAnimationFrame(renderLoop);
});
</script>

{% schema %}
{
  "name": "Composition Scattered",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2EFE8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#d2fa3c"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "ONE SHOE. ONE DROP. <span class='highlight'>NO RESTOCK.</span>"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Image"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
