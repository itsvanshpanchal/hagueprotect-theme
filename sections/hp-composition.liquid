        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Composition Scattered",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "SR-FOAM™",
            "subtitle": "Dual-density · 34% rebound"
