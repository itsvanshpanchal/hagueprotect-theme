{%- style -%}
  {% render 'section-typography-vars', section: section %}

  #shopify-section-{{ section.id }} .hp-composition-section {
    background-color: {{ section.settings.bg_color | default: '#F2EFE8' }};
    position: relative;
    height: 200vh;
    font-family: var(--font-family-sans, 'Inter', sans-serif);
  }

  .hp-comp__sticky {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .hp-composition-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    height: 600px; /* Fixed height for absolute positioning on desktop */
  }

  .hp-composition-eyebrow {
    position: absolute;
    top: -40px;
    left: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'Darker Grotesque', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6a6a6a;
    z-index: 10;
  }

  .hp-composition-eyebrow-dot {
    width: 8px;
    height: 8px;
    background-color: {{ section.settings.accent_color | default: '#d2fa3c' }};
    border-radius: 50%;
  }

  .hp-composition-heading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: left;
    margin: 0;
    font-family: var(--font-family-sans, 'Inter', sans-serif);
    font-size: clamp(32px, 5vw, 68px);
    font-weight: 400;
    line-height: 1.1;
    color: #8c8b89;
    z-index: 1;
    width: 100%;
    max-width: 800px;
    will-change: transform;
  }

  .hp-comp-card {
    position: absolute;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 5;
    will-change: transform;
  }

  .hp-comp-card--image {
    padding: 0;
  }

  .hp-comp-card--image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp-comp-card--text {
    padding: 40px;
    align-items: flex-start;
  }

  .hp-comp-card-title {
    font-family: var(--font-family-sans, 'Inter', sans-serif);
    font-size: clamp(24px, 3vw, 42px);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
  }

  .hp-comp-card-line {
    width: 30px;
    height: 4px;
    background-color: currentColor;
    margin-bottom: auto;
  }

  /* Desktop Fixed Positions - Hardcoded to match screenshot */
  /* Top Left Image */
  .hp-comp-card-0 {
    top: 0;
    left: 5%;
    width: 340px;
    height: 280px;
  }
  
  /* Bottom Left Text */
  .hp-comp-card-1 {
    bottom: -40px;
    left: 15%;
    width: 280px;
    height: 220px;
  }
  
  /* Top Right Text */
  .hp-comp-card-2 {
    top: 40px;
    right: 15%;
    width: 320px;
    height: 240px;
  }
  
  /* Bottom Right Image */
  .hp-comp-card-3 {
    bottom: -60px;
    right: 0%;
    width: 360px;
    height: 280px;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .hp-composition-section {
      height: auto;
      padding: 80px 20px;
    }
    
    .hp-comp__sticky {
      position: relative !important;
      height: auto !important;
      overflow: visible;
      padding: 0;
      top: auto !important;
      bottom: auto !important;
    }

    .hp-composition-container {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 30px;
      align-items: center;
    }

    .hp-composition-eyebrow {
      position: relative;
      top: 0;
      width: 100%;
      margin-bottom: 20px;
    }

    .hp-composition-heading {
      position: relative;
      top: 0;
      left: 0;
      transform: none !important;
      margin-bottom: 40px;
    }

    .hp-comp-card {
      position: relative;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      max-width: 400px;
      height: auto !important;
      aspect-ratio: 4/3;
      transform: none !important;
    }
  }
{%- endstyle -%}

<section class="hp-composition-section hp-composition-{{ section.id }}">
  <div class="hp-comp__sticky">
    <div class="hp-composition-container">
      {%- if section.settings.eyebrow != blank -%}
        <div class="hp-composition-eyebrow">
          <div class="hp-composition-eyebrow-dot"></div>
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hp-composition-heading" data-no-typewriter>
          {{ section.settings.heading | replace: '\n', '<br>' }}
        </h2>
      {%- endif -%}

      {%- for block in section.blocks limit: 4 -%}
        {%- assign card_class = 'hp-comp-card hp-comp-card-' | append: forloop.index0 -%}
        
        <div class="{{ card_class }} {% if block.settings.image != blank %}hp-comp-card--image{% else %}hp-comp-card--text{% endif %}" 
             style="background-color: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};" 
             {{ block.shopify_attributes }}>
          
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" 
                 alt="{{ block.settings.image.alt | default: 'Composition detail' }}" 
                 loading="lazy" width="800" height="600">
          {%- else -%}
            {%- if block.settings.show_line -%}
              <div class="hp-comp-card-line"></div>
            {%- endif -%}
            <div class="hp-comp-card-title" style="margin-top: {% if block.settings.show_line %}20px{% else %}auto{% endif %}; margin-bottom: {% if block.settings.show_line %}0{% else %}auto{% endif %};">
              {{ block.settings.title | replace: '\n', '<br>' }}
            </div>
          {%- endif -%}
          
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var section = document.querySelector('.hp-composition-{{ section.id }}');
  if (!section) return;
  var stickyEl = section.querySelector('.hp-comp__sticky');
  
  // Select all 4 scattered cards
  var cards = [];
  for (var i = 0; i < 4; i++) {
    var el = section.querySelector('.hp-comp-card-' + i);
    if (el) cards.push(el);
  }

  // We will lerp (smooth) the progress value
  var targetProgress = 0;
  var currentProgress = 0;
  var isPinned = false;
  var hasScrolledPast = false;

  function updateTargetProgress() {
    if (window.innerWidth <= 989) {
      if (isPinned || hasScrolledPast) {
        stickyEl.style.position = '';
        stickyEl.style.top = '';
        stickyEl.style.bottom = '';
        stickyEl.style.zIndex = '';
        isPinned = false;
        hasScrolledPast = false;
      }
      return; // No JS pinning on mobile for this section
    }

    var rect = section.getBoundingClientRect();
    var maxScroll = rect.height - window.innerHeight;
    
    // Check pinning state for layout
    if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
      if (!isPinned) {
        stickyEl.style.position = 'fixed';
        stickyEl.style.top = '0px';
        stickyEl.style.bottom = 'auto';
        stickyEl.style.zIndex = '9';
        isPinned = true;
      }
      hasScrolledPast = false;
      // Target progress is based on actual scroll position
      targetProgress = Math.abs(rect.top) / maxScroll;
      targetProgress = Math.max(0, Math.min(1, targetProgress));

    } else if (rect.top > 0) {
      if (isPinned || hasScrolledPast) {
        stickyEl.style.position = 'absolute';
        stickyEl.style.top = '0px';
        stickyEl.style.bottom = 'auto';
        stickyEl.style.zIndex = '2';
        isPinned = false;
        hasScrolledPast = false;
      }
      targetProgress = 0; // Above section
    } else if (rect.bottom < window.innerHeight) {
      if (isPinned || !hasScrolledPast) {
        stickyEl.style.position = 'absolute';
        stickyEl.style.top = 'auto';
        stickyEl.style.bottom = '0px';
        stickyEl.style.zIndex = '2';
        isPinned = false;
        hasScrolledPast = true;
      }
      targetProgress = 1; // Below section
    }
  }

  function renderLoop() {
    if (window.innerWidth > 989) {
      // Lerp formula
      currentProgress += (targetProgress - currentProgress) * 0.08;

      // Cards slide INWARDS towards the center text as you scroll down.
      // currentProgress goes from 0 to 1.
      if (cards[0]) cards[0].style.transform = 'translate(' + (currentProgress * 250) + 'px, ' + (currentProgress * 200) + 'px)'; // Top Left -> Moves Right/Down
      if (cards[1]) cards[1].style.transform = 'translate(' + (currentProgress * 200) + 'px, ' + (-currentProgress * 150) + 'px)'; // Bottom Left -> Moves Right/Up
      if (cards[2]) cards[2].style.transform = 'translate(' + (-currentProgress * 250) + 'px, ' + (currentProgress * 200) + 'px)'; // Top Right -> Moves Left/Down
      if (cards[3]) cards[3].style.transform = 'translate(' + (-currentProgress * 250) + 'px, ' + (-currentProgress * 200) + 'px)'; // Bottom Right -> Moves Left/Up
    }

    // Loop forever
    window.requestAnimationFrame(renderLoop);
  }

  // Update target on scroll and resize
  window.addEventListener('scroll', updateTargetProgress, { passive: true });
  window.addEventListener('resize', updateTargetProgress, { passive: true });
  
  // Kickoff
  updateTargetProgress();
  window.requestAnimationFrame(renderLoop);
});
</script>

{% schema %}
{
  "name": "Composition Scattered",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2EFE8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Dot Color",
      "default": "#d2fa3c"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "09 — THE COMPOSITION"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "EVERY PART,\nCONSIDERED.",
      "info": "Use \\n for line breaks"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background",
          "default": "#d2fa3c"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#111111"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "If an image is uploaded, text settings below will be ignored."
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Text",
          "default": "CUT\nONCE.",
          "info": "Use \\n for line breaks"
        },
        {
          "type": "checkbox",
          "id": "show_line",
          "label": "Show top line accent",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Composition Scattered",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "bg_color": "#d2fa3c",
            "image": ""
          }
        },
        {
          "type": "card",
          "settings": {
            "bg_color": "#d2fa3c",
            "text_color": "#111111",
            "title": "EDITION\n001–300",
            "show_line": true
          }
        },
        {
          "type": "card",
          "settings": {
            "bg_color": "#111111",
            "text_color": "#ffffff",
            "title": "CUT\nONCE.",
            "show_line": false
          }
        },
        {
          "type": "card",
          "settings": {
            "bg_color": "#d2fa3c",
            "image": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
