{%- style -%}
  {% render 'section-typography-vars', section: section %}

  #shopify-section-{{ section.id }} .hp-composition-section {
    background-color: {{ section.settings.bg_color | default: '#F2EFE8' }};
    position: relative;
    height: 150vh;
    font-family: var(--font-family-sans, 'Inter', sans-serif);
  }

  .hp-comp__sticky {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .hp-composition-container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    height: 800px;
  }

  @media screen and (max-height: 900px) and (min-width: 990px) {
    .hp-composition-container {
      transform: scale(0.85);
      transform-origin: center center;
    }
  }

  @media screen and (max-height: 750px) and (min-width: 990px) {
    .hp-composition-container {
      transform: scale(0.75);
      transform-origin: center center;
    }
  }

  .hp-composition-heading {
    position: absolute;
    top: 40px;
    left: 0;
    width: 100%;
    text-align: center;
    font-family: 'Inter Light', 'Inter', sans-serif !important;
    font-size: 52px;
    font-weight: 100 !important;
    letter-spacing: -0.02em;
    color: #111;
    z-index: 10;
    margin: 0;
  }
  
  .hp-composition-heading .highlight {
    background-color: {{ section.settings.accent_color | default: '#d2fa3c' }};
    padding: 5px 20px;
    display: inline-block;
    border-radius: 8px;
    color: #111;
    font-weight: 300 !important;
  }

  .hp-comp-center-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 650px;
    max-width: 90vw;
    z-index: 5;
  }
  
  @keyframes floatShoe {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }
  
  .hp-comp-center-img img {
    width: 100%;
    height: auto;
    object-fit: contain;
    animation: floatShoe 3s ease-in-out infinite;
  }

  .hp-comp-card-wrapper {
    position: absolute;
    width: 280px;
    height: 130px;
    z-index: 10;
    perspective: 1000px;
    will-change: transform;
  }
  
  .hp-comp-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: left;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }
  
  .hp-comp-card-wrapper:hover .hp-comp-card-inner {
    transform: rotateY(180deg);
  }
  
  .hp-comp-card-front, .hp-comp-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    background: #fff;
  }
  
  .hp-comp-card-back {
    transform: rotateY(180deg);
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hp-comp-card-line {
    width: 20px;
    height: 3px;
    background-color: {{ section.settings.accent_color | default: '#d2fa3c' }};
    margin-bottom: 16px;
  }

  .hp-comp-card-title {
    font-family: 'Inter 18pt', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
    font-size: 24px;
    font-weight: 400 !important;
    letter-spacing: -0.01em;
    color: inherit;
    margin-bottom: 8px;
    text-transform: uppercase;
  }
  
  .hp-comp-card-subtitle {
    font-family: 'Inter 18pt', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
    font-size: 13px;
    font-weight: 500 !important;
    color: #6a6a6a;
    line-height: 1.4;
  }

  .hp-comp-hover-text {
    position: absolute;
    bottom: 12px;
    right: 12px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #999;
    text-transform: uppercase;
  }

  /* Fixed Positions - Desktop */
  /* Top Left */
  .hp-comp-card-0 { top: 150px; left: 40px; }
  /* Mid Left */
  .hp-comp-card-1 { top: 380px; left: 20px; }
  /* Bottom Left */
  .hp-comp-card-2 { bottom: 60px; left: 60px; }
  /* Top Right */
  .hp-comp-card-3 { top: 170px; right: 40px; }
  /* Mid Right */
  .hp-comp-card-4 { top: 410px; right: 20px; }
  /* Bottom Right */
  .hp-comp-card-5 { bottom: 40px; right: 80px; }

  @media screen and (max-width: 989px) {
    .hp-composition-section {
      height: auto;
      padding: 60px 15px;
    }
    .hp-comp__sticky {
      position: relative !important;
      height: auto;
    }
    .hp-composition-container {
      height: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      align-items: stretch;
    }
    .hp-composition-heading {
      grid-column: 1 / -1;
      position: relative;
      top: 0;
      margin-bottom: 20px;
      font-size: 34px !important;
    }
    .hp-comp-center-img {
      grid-column: 1 / -1;
      position: relative;
      top: 0;
      left: 0;
      transform: none;
      margin-bottom: 30px;
    }
    .hp-comp-card-wrapper {
      position: relative;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      width: 100%;
      max-width: none;
      height: 150px;
      transform: none !important;
    }
    .hp-comp-card-front, .hp-comp-card-back {
      padding: 16px;
    }
    .hp-comp-card-title {
      font-size: 16px !important;
      margin-bottom: 6px;
    }
    .hp-comp-card-subtitle {
      font-size: 11px !important;
      line-height: 1.3;
    }
    .hp-comp-hover-text {
      font-size: 8px;
      bottom: 10px;
      right: 10px;
    }
  }
{%- endstyle -%}

<section class="hp-composition-section hp-composition-{{ section.id }}">
  <div class="hp-comp__sticky">
    <div class="hp-composition-container">

      {%- if section.settings.heading != blank -%}
        <h2 class="hp-composition-heading" data-no-typewriter>
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      
      {%- if section.settings.center_image != blank -%}
        <div class="hp-comp-center-img">
          <img src="{{ section.settings.center_image | image_url: width: 1000 }}" alt="Composition" loading="lazy">
        </div>
      {%- else -%}
        <div class="hp-comp-center-img" style="display:flex;align-items:center;justify-content:center;background:#e5e5e5;border-radius:24px;aspect-ratio:1;color:#666;">
          UPLOAD SHOE IMAGE
        </div>
      {%- endif -%}

      {%- for block in section.blocks limit: 6 -%}
        {%- assign card_class = 'hp-comp-card-wrapper hp-comp-card-' | append: forloop.index0 -%}
        
        <div class="{{ card_class }}" {{ block.shopify_attributes }}>
          <div class="hp-comp-card-inner">
            <div class="hp-comp-card-front" style="background-color: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};">
              {%- if block.settings.show_line -%}
                <div class="hp-comp-card-line" {% if block.settings.bg_color == section.settings.accent_color %}style="background-color: #111;"{% endif %}></div>
              {%- endif -%}
              
              <div class="hp-comp-card-title">
                {{ block.settings.title | replace: '\n', '<br>' }}
              </div>
              
              {%- if block.settings.subtitle != blank -%}
                <div class="hp-comp-card-subtitle" {% if block.settings.bg_color == section.settings.accent_color %}style="color: #444;"{% endif %}>
                  {{ block.settings.subtitle }}
                </div>
              {%- endif -%}
              
              <div class="hp-comp-hover-text" {% if block.settings.bg_color == section.settings.accent_color %}style="color: #666;"{% endif %}>
                HOVER ⟳
              </div>
            </div>
            
            <div class="hp-comp-card-back" style="background-color: {{ block.settings.text_color }}; color: {{ block.settings.bg_color }};">
              {%- if block.settings.back_text != blank -%}
                <div class="hp-comp-card-title" style="margin: auto; font-size: 16px; text-transform: none; line-height: 1.4;">{{ block.settings.back_text | replace: '\n', '<br>' }}</div>
              {%- else -%}
                <div class="hp-comp-card-title" style="margin: auto; font-size: 18px;">{{ block.settings.title }}</div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var section = document.querySelector('.hp-composition-{{ section.id }}');
  if (!section) return;
  var stickyEl = section.querySelector('.hp-comp__sticky');
  
  var cards = [];
  for (var i = 0; i < 6; i++) {
    var el = section.querySelector('.hp-comp-card-' + i);
    if (el) cards.push(el);
  }

  var targetProgress = 0;
  var currentProgress = 0;
  var isPinned = false;
  var hasScrolledPast = false;

  function updateTargetProgress() {
    if (window.innerWidth <= 989) {
      if (isPinned || hasScrolledPast) {
        stickyEl.style.position = '';
        stickyEl.style.top = '';
        stickyEl.style.bottom = '';
        stickyEl.style.zIndex = '';
        isPinned = false;
        hasScrolledPast = false;
      }
      return; 
    }

    var rect = section.getBoundingClientRect();
    var maxScroll = rect.height - window.innerHeight;
    
    if (rect.top <= 0 && rect.bottom >= window.innerHeight) {
      if (!isPinned) {
        stickyEl.style.position = 'fixed';
        stickyEl.style.top = '0px';
        stickyEl.style.bottom = 'auto';
        stickyEl.style.zIndex = '9';
        isPinned = true;
      }
      hasScrolledPast = false;
      targetProgress = Math.abs(rect.top) / maxScroll;
      targetProgress = Math.max(0, Math.min(1, targetProgress));

    } else if (rect.top > 0) {
      if (isPinned || hasScrolledPast) {
        stickyEl.style.position = 'absolute';
        stickyEl.style.top = '0px';
        stickyEl.style.bottom = 'auto';
        stickyEl.style.zIndex = '2';
        isPinned = false;
        hasScrolledPast = false;
      }
      targetProgress = 0; 
    } else if (rect.bottom < window.innerHeight) {
      if (isPinned || !hasScrolledPast) {
        stickyEl.style.position = 'absolute';
        stickyEl.style.top = 'auto';
        stickyEl.style.bottom = '0px';
        stickyEl.style.zIndex = '2';
        isPinned = false;
        hasScrolledPast = true;
      }
      targetProgress = 1; 
    }
  }

  function renderLoop() {
    if (window.innerWidth > 989) {
      currentProgress += (targetProgress - currentProgress) * 0.02;
      
      cards.forEach(function(card, idx) {
        if (!card) return;
        
        var p = Math.min(1, currentProgress / 0.7);
        var easeOut = 1 - Math.pow(1 - p, 3); // Cubic ease out
        var scatterProgress = Math.max(0, 1 - easeOut);
        
        var xDir = (idx < 3) ? -1 : 1;
        var yDir = (idx % 3 === 0) ? -1 : (idx % 3 === 2) ? 1 : 0;
        
        var xDist = xDir * scatterProgress * 800; // start slightly further out for a grander entrance
        var yDist = yDir * scatterProgress * 400;
        
        card.style.transform = 'translate(' + xDist + 'px, ' + yDist + 'px)';
      });
    }

    window.requestAnimationFrame(renderLoop);
  }

  window.addEventListener('scroll', updateTargetProgress, { passive: true });
  window.addEventListener('resize', updateTargetProgress, { passive: true });
  
  updateTargetProgress();
  window.requestAnimationFrame(renderLoop);
});
</script>

{% schema %}
{
  "name": "Composition Scattered",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2EFE8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#d2fa3c"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "ONE SHOE. ONE DROP. <span class='highlight'>NO RESTOCK.</span>"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Image"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#111111"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "SR-FOAM™"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Dual-density 34% rebound"
        },
        {
          "type": "textarea",
          "id": "back_text",
          "label": "Back of Card Text",
          "info": "Text to show when hovered. Leave blank to show Title."
        },
        {
          "type": "checkbox",
          "id": "show_line",
          "label": "Show top line accent",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Composition Scattered"
    }
  ]
}
{% endschema %}
