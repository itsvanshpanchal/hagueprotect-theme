{%- style -%}
  .htu-steps-{{ section.id }} {
    padding: clamp(60px, 8vw, 100px) 20px;
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
  }

  .htu-steps-{{ section.id }} .htu-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .htu-steps-{{ section.id }} .htu-header {
    margin-bottom: 48px;
    text-align: left;
  }

  .htu-steps-{{ section.id }} .htu-eyebrow {
    font-family: var(--font-family-sans, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888888;
    margin-bottom: 16px;
  }

  .htu-steps-{{ section.id }} .htu-title {
    font-family: "Anton", "Bebas Neue", var(--font-family-heading, sans-serif);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #000000;
    margin: 0;
    line-height: 1.1;
  }

  .htu-steps-{{ section.id }} .htu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .htu-steps-{{ section.id }} .htu-card {
    display: flex;
    flex-direction: column;
  }

  .htu-steps-{{ section.id }} .htu-card-image-wrapper {
    width: 100%;
    aspect-ratio: 1 / 1.1;
    background-color: #f9f9f9;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .htu-steps-{{ section.id }} .htu-card-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .htu-steps-{{ section.id }} .htu-card-title {
    font-family: "Anton", "Bebas Neue", var(--font-family-heading, sans-serif);
    font-size: 24px;
    font-weight: 800;
    text-transform: uppercase;
    color: #000000;
    margin: 0 0 12px 0;
    letter-spacing: 0.03em;
  }

  .htu-steps-{{ section.id }} .htu-card-text {
    font-family: var(--font-family-sans, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.6;
    color: #666666;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .htu-steps-{{ section.id }} .htu-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
{%- endstyle -%}

<section class="htu-steps-{{ section.id }}" data-no-typewriter="true">
  <div class="htu-container">
    <div class="htu-header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="htu-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="htu-title" data-no-typewriter="true">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    <div class="htu-grid">
      {%- for block in section.blocks -%}
        <div class="htu-card" {{ block.shopify_attributes }}>
          <div class="htu-card-image-wrapper">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | img_url: 'master' }}" alt="{{ block.settings.title | escape }}" class="htu-card-image" loading="lazy">
            {%- else -%}
              <div style="padding: 20px; color: #ccc; text-align: center;">Upload Image</div>
            {%- endif -%}
          </div>
          {%- assign default_title = 'APPLY' -%}
          {%- assign default_text = 'Place dirty shoes on the Shoozas cleaning mat. Shake well and pump the foam cleaner directly onto soiled areas. Always test on a small area first.' -%}
          
          {%- if forloop.index == 2 -%}
            {%- assign default_title = 'SCRUB' -%}
            {%- assign default_text = 'Scrub the shoes in circular motions with the all-purpose brush. Start with the upper and work your way down to the soles.' -%}
          {%- elsif forloop.index == 3 -%}
            {%- assign default_title = 'DRY' -%}
            {%- assign default_text = 'Wipe away excess foam with the microfiber towel and let the shoes air dry indoors. Rinse the brush and cleaning mat with water before storing.' -%}
          {%- endif -%}

          {%- assign actual_title = block.settings.title | default: default_title -%}
          {%- if actual_title == blank -%}{%- assign actual_title = default_title -%}{%- endif -%}
          
          {%- assign actual_text = block.settings.text | default: default_text -%}
          {%- if actual_text == blank -%}{%- assign actual_text = default_text -%}{%- endif -%}

          <h3 class="htu-card-title">{{ actual_title }}</h3>
          <p class="htu-card-text">{{ actual_text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How to Use Steps",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HOW TO USE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "THE SHOOZAS METHOD."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "APPLY"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Place dirty shoes on the Shoozas cleaning mat. Shake well and pump the foam cleaner directly onto soiled areas. Always test on a small area first."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How to Use Steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "APPLY",
            "text": "Place dirty shoes on the Shoozas cleaning mat. Shake well and pump the foam cleaner directly onto soiled areas. Always test on a small area first."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "SCRUB",
            "text": "Scrub the shoes in circular motions with the all-purpose brush. Start with the upper and work your way down to the soles."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "DRY",
            "text": "Wipe away excess foam with the microfiber towel and let the shoes air dry indoors. Rinse the brush and cleaning mat with water before storing."
          }
        }
      ]
    }
  ]
}
{% endschema %}
