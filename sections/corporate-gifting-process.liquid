{%- assign corp_occasions_id = 'corp-occasions-' | append: section.id -%}
<style>
  #{{ corp_occasions_id }}.corp-occasions {
    position: relative;
    z-index: 2;
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  #{{ corp_occasions_id }} .corp-occasions__title-line1 {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
    font-size: clamp(34px, 4.8vw, 56px);
    font-weight: 700 !important;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #111111 !important;
  }

  #{{ corp_occasions_id }} .corp-occasions__title-line2 {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
    font-size: clamp(24px, 3.2vw, 40px);
    font-weight: 300 !important;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #111111 !important;
  }

  #{{ corp_occasions_id }} .corp-occasions__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.2vw, 28px);
  }

  #{{ corp_occasions_id }} .corp-occasions__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: inherit;
  }

  #{{ corp_occasions_id }} .corp-occasions__media {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(145deg, #f3f3f3, #e8e8e8);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  #{{ corp_occasions_id }} .corp-occasions__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(17, 17, 17, 0.28);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ corp_occasions_id }} .corp-occasions__label {
    margin: 18px 0 0;
    font-family: 'Inter', sans-serif !important;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700 !important;
    color: #111111 !important;
    line-height: 1.2;
  }

  #{{ corp_occasions_id }} .corp-occasions__caption {
    margin: 8px 0 0;
    font-family: var(--font-family-heading-accent, 'Luthon Southard Script', cursive);
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.35;
    color: #2563eb !important;
  }

  @media screen and (max-width: 1024px) {
    #{{ corp_occasions_id }} .corp-occasions__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 20px;
    }
  }

  @media screen and (max-width: 560px) {
    #{{ corp_occasions_id }} .corp-occasions__grid {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin: 0 auto;
    }

    #{{ corp_occasions_id }} .corp-occasions__header {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

<section class="corp-occasions" id="{{ corp_occasions_id }}" data-no-typewriter="true" data-corp-occasions="true">
  <div class="corp-occasions__container" style="max-width: var(--site-max-width); margin: 0 auto; padding: clamp(72px, 9vw, 110px) max(20px, var(--site-padding, 24px)); background: #ffffff;">
    <header class="corp-occasions__header" style="max-width: 720px; margin: 0 0 clamp(40px, 5vw, 56px);">
      <h2 class="corp-occasions__title" style="margin: 0; display: flex; flex-direction: column; gap: 4px;">
        <span class="corp-occasions__title-line1">{{ section.settings.occasions_heading_line1 | default: 'Gifts people keep.' }}</span>
        <span class="corp-occasions__title-line2">{{ section.settings.occasions_heading_line2 | default: 'Not re-gift.' }}</span>
      </h2>
    </header>

    <div class="corp-occasions__grid">
      <div class="corp-occasions__card">
        <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Corporate</div></div>
        <p class="corp-occasions__label">Corporate</p>
      </div>
      <div class="corp-occasions__card">
        <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Weddings</div></div>
        <p class="corp-occasions__label">Weddings</p>
      </div>
      <div class="corp-occasions__card">
        <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Celebrations</div></div>
        <p class="corp-occasions__label">Celebrations</p>
        <p class="corp-occasions__caption">(Birthday, Housewarming, Anniversary)</p>
      </div>
      <div class="corp-occasions__card">
        <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Collaborations</div></div>
        <p class="corp-occasions__label">Collaborations</p>
      </div>
    </div>
  </div>
</section>

{%- style -%}
  {% render 'section-typography-vars', section: section %}


  .corp-process {
    --corp-process-accent: #2563eb;
    padding: clamp(80px, 10vw, 120px) 0;
    background: #fafafa;
    font-family: var(--font-family-sans);
  }

  .corp-process__container {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 0 max(20px, var(--site-padding, 24px));
  }

  .corp-process__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(48px, 6vw, 72px);
  }

  .corp-process__eyebrow {
    color: #e74c3c;
    margin: 0 0 12px;
  }

  .corp-process__title,
  .corp-process__title span,
  .corp-process__title b,
  .corp-process__title strong {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
    color: #111111;
    margin: 0 0 16px;
    font-weight: 300 !important;
    font-style: normal !important;
    font-synthesis: none !important;
    -webkit-font-smoothing: antialiased !important;
    letter-spacing: -0.02em;
  }

  .corp-process__desc {
    color: #565656;
    margin: 0;
  }

  .corp-process__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    position: relative;
  }

  .corp-process__grid::before {
    content: '';
    position: absolute;
    top: 36px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: #2563eb;
    z-index: 0;
  }

  .corp-process__step {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 16px;
    opacity: 1 !important;
    visibility: visible !important;
    transform: none !important;
  }

  .corp-process__num,
  .corp-process__thumb {
    width: 72px;
    height: 72px;
    margin: 0 auto 24px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #111111;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-heading);
    font-size: 28px;
    color: #111111;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    overflow: hidden;
  }

  .corp-process__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .corp-process__step:hover .corp-process__num {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
    transform: scale(1.08);
  }

  .corp-process__step:hover .corp-process__thumb {
    border-color: #2563eb;
    transform: scale(1.08);
  }

  .corp-process__step-title {
    font-family: 'Inter', sans-serif !important;
    font-size: 15px;
    font-weight: 300 !important;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #111111 !important;
    margin: 0 0 10px;
  }

  .corp-process__step-text {
    font-family: 'Inter', sans-serif !important;
    font-weight: 400 !important;
    font-size: 14px;
    line-height: 1.55;
    color: #666666 !important;
    margin: 0;
  }

  @media screen and (max-width: 900px) {
    .corp-process__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
    }

    .corp-process__grid::before {
      display: none;
    }
  }

  @media screen and (max-width: 520px) {
    .corp-process__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  #shopify-section-{{ section.id }} .corp-process__grid::before {
    background: #2563eb !important;
  }

  #shopify-section-{{ section.id }} .corp-process__step:hover .corp-process__num {
    background: #2563eb !important;
    border-color: #2563eb !important;
    color: #ffffff !important;
  }

  #shopify-section-{{ section.id }} .corp-process__step:hover .corp-process__thumb {
    border-color: #2563eb !important;
  }
{%- endstyle -%}

<section class="corp-process" data-no-typewriter="true">
  <div class="corp-process__container">
    <div class="corp-process__header">
      <p class="corp-process__eyebrow">{{ section.settings.eyebrow | default: 'How It Works' }}</p>
      <h2 class="corp-process__title">{{ section.settings.heading | default: 'From Brief to Doorstep' }}</h2>
      <p class="corp-process__desc">{{ section.settings.description | default: 'A seamless four-step process designed for busy teams. We handle everything Ã¢â‚¬â€ you take the credit.' }}</p>
    </div>

    <div class="corp-process__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="corp-process__step" data-corp-step {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="corp-process__thumb">
                <img
                  src="{{ block.settings.image | image_url: width: 144 }}"
                  alt="{{ block.settings.title | escape }}"
                  width="72"
                  height="72"
                  loading="lazy"
                >
              </div>
            {%- else -%}
              <div class="corp-process__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
            {%- endif -%}
            <h3 class="corp-process__step-title">{{ block.settings.title }}</h3>
            <p class="corp-process__step-text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="corp-process__step" data-corp-step>
          <div class="corp-process__num">01</div>
          <h3 class="corp-process__step-title">Share Your Brief</h3>
          <p class="corp-process__step-text">Tell us quantity, budget, branding needs, and delivery timeline.</p>
        </div>
        <div class="corp-process__step" data-corp-step>
          <div class="corp-process__num">02</div>
          <h3 class="corp-process__step-title">Custom Proposal</h3>
          <p class="corp-process__step-text">Receive curated kit options, mockups, and volume pricing within 48 hours.</p>
        </div>
        <div class="corp-process__step" data-corp-step>
          <div class="corp-process__num">03</div>
          <h3 class="corp-process__step-title">Approve & Produce</h3>
          <p class="corp-process__step-text">Co-branded packaging, custom inserts, and quality checks at every stage.</p>
        </div>
        <div class="corp-process__step" data-corp-step>
          <div class="corp-process__num">04</div>
          <h3 class="corp-process__step-title">Deliver & Delight</h3>
          <p class="corp-process__step-text">Pan-India shipping with tracking. Your recipients get a gift they'll remember.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

