{%- liquid
  assign coverflow_id = 'corp-coverflow-' | append: section.id
  assign start_index = section.blocks.size | divided_by: 2
-%}

{%- render 'corporate-gifting-coverflow-carousel',
  carousel_id: coverflow_id,
  heading: section.settings.heading,
  blocks: section.blocks,
  spacing: section.settings.card_spacing,
  start_index: start_index,
  autoplay: section.settings.autoplay,
  card_width: 200,
  is_standalone: true
-%}

{% schema %}
{
  "name": "Corporate Coverflow",
  "enabled_on": {
    "groups": ["custom.all", "header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gifts that outlast the occasion"
    },
    {
      "type": "range",
      "id": "card_spacing",
      "label": "Spacing between slides",
      "min": 140,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay carousel",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge label",
          "default": "@ Gift Set",
          "info": "e.g. @ Dhurandhar 2 Set"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Corporate Coverflow",
      "blocks": [
        { "type": "slide", "settings": { "badge": "@ Gift Set 1" } },
        { "type": "slide", "settings": { "badge": "@ Gift Set 2" } },
        { "type": "slide", "settings": { "badge": "@ Dhurandhar 2 Set" } },
        { "type": "slide", "settings": { "badge": "@ Gift Set 4" } },
        { "type": "slide", "settings": { "badge": "@ Gift Set 5" } }
      ]
    }
  ]
}
{% endschema %}
