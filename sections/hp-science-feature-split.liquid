  "blocks": [
    {
      "type": "compare_row",
      "name": "Compare row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "LABEL"
        },
        {
          "type": "textarea",
          "id": "text",
