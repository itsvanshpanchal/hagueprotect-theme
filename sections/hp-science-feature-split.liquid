{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-feature-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_color }};
  }

  .hp-sci-feature-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
  }

  .hp-sci-feature-{{ section.id }}__grid--reverse .hp-sci-feature-{{ section.id }}__copy {
    order: 2;
  }

  .hp-sci-feature-{{ section.id }}__grid--reverse .hp-sci-feature-{{ section.id }}__media {
    order: 1;
  }

  .hp-sci-feature-{{ section.id }}__copy {
    background: {{ section.settings.card_background }};
    color: {{ section.settings.text_color }};
    padding: clamp(40px, 6vw, 88px) clamp(28px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  .hp-sci-feature-{{ section.id }}__eyebrow {
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 clamp(20px, 3vw, 28px);
  }

  .hp-sci-feature-{{ section.id }}__title {
    line-height: 1.1;
    margin: 0 0 clamp(20px, 3vw, 28px);
    max-width: none;
    color: inherit;
  }

  .hp-sci-feature-{{ section.id }}__text {
    line-height: 1.65;
    margin: 0 0 clamp(36px, 5vw, 52px);
    max-width: 38ch;
    color: {{ section.settings.body_color }};
  }

  .hp-sci-feature-{{ section.id }}__compare {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.5vw, 24px);
    max-width: 46ch;
  }

  .hp-sci-feature-{{ section.id }}__compare-row {
    display: grid;
    grid-template-columns: minmax(88px, 112px) minmax(0, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
    align-items: start;
  }

  .hp-sci-feature-{{ section.id }}__compare-label {
    text-transform: uppercase;
    color: {{ section.settings.compare_label_color }};
    margin: 0;
    padding-top: 2px;
  }

  .hp-sci-feature-{{ section.id }}__compare-text {
    line-height: 1.55;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .hp-sci-feature-{{ section.id }}__media {
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.media_min_height_desktop | default: 520 }}px;
  }

  .hp-sci-feature-{{ section.id }}__media .hp-sci-media,
  .hp-sci-feature-{{ section.id }}__media .hp-sci-media__img,
  .hp-sci-feature-{{ section.id }}__media .hp-sci-media__video,
  .hp-sci-feature-{{ section.id }}__media .hp-sci-media__placeholder {
    height: 100%;
    min-height: {{ section.settings.media_min_height_desktop | default: 520 }}px;
  }

  @media screen and (max-width: 989px) {
    .hp-sci-feature-{{ section.id }}__media,
    .hp-sci-feature-{{ section.id }}__media .hp-sci-media,
    .hp-sci-feature-{{ section.id }}__media .hp-sci-media__img,
    .hp-sci-feature-{{ section.id }}__media .hp-sci-media__video,
    .hp-sci-feature-{{ section.id }}__media .hp-sci-media__placeholder {
      min-height: {{ section.settings.media_min_height_mobile | default: 320 }}px;
    }
  }
  {%- if section.settings.text_offset_x_desktop != 0 or section.settings.text_offset_y_desktop != 0 -%}


  .hp-sci-feature-{{ section.id }}__text-position {
    transform: translate({{ section.settings.text_offset_x_desktop | default: 0 }}px, {{ section.settings.text_offset_y_desktop | default: 0 }}px);
  }
  {%- endif -%}

  @media screen and (max-width: 989px) {
    .hp-sci-feature-{{ section.id }}__grid,
    .hp-sci-feature-{{ section.id }}__grid--reverse {
      grid-template-columns: 1fr;
    }

    .hp-sci-feature-{{ section.id }}__grid--reverse .hp-sci-feature-{{ section.id }}__copy,
    .hp-sci-feature-{{ section.id }}__grid--reverse .hp-sci-feature-{{ section.id }}__media {
      order: unset;
    }

    .hp-sci-feature-{{ section.id }}__title {
      max-width: none;
    }
    {%- if section.settings.text_offset_x_mobile != 0 or section.settings.text_offset_y_mobile != 0 -%}
  
    .hp-sci-feature-{{ section.id }}__text-position {
      transform: translate({{ section.settings.text_offset_x_mobile | default: 0 }}px, {{ section.settings.text_offset_y_mobile | default: 0 }}px);
    }
    {%- endif -%}
}

  @media screen and (max-width: 576px) {
    .hp-sci-feature-{{ section.id }}__compare-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }

  #shopify-section-{{ section.id }} .hp-sci .hp-sci-feature-{{ section.id }}__title {
    font-size: {{ section.settings.heading_size_desktop | default: 52 }}px !important;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .hp-sci .hp-sci-feature-{{ section.id }}__title {
      font-size: {{ section.settings.heading_size_mobile | default: 24 }}px !important;
    }
  }
  {% render 'hp-science-section-typography-styles', section: section %}

  /* Preserve this section's own padding settings — prevent external override */
  #shopify-section-{{ section.id }} {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin: 0 !important;
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-feature-{{ section.id }}">
  <div class="hp-sci-feature-{{ section.id }}__grid{% if section.settings.reverse_layout %} hp-sci-feature-{{ section.id }}__grid--reverse{% endif %}">
    <div class="hp-sci-feature-{{ section.id }}__copy hp-sci-feature-{{ section.id }}__text-position">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hp-sci-feature-{{ section.id }}__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-sci-feature-{{ section.id }}__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hp-sci-feature-{{ section.id }}__text hp-sci__body">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="hp-sci-feature-{{ section.id }}__compare">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'compare_row' -%}
              <div class="hp-sci-feature-{{ section.id }}__compare-row" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <p class="hp-sci-feature-{{ section.id }}__compare-label">{{ block.settings.label }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="hp-sci-feature-{{ section.id }}__compare-text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="hp-sci-feature-{{ section.id }}__compare-row">
            <p class="hp-sci-feature-{{ section.id }}__compare-label">ANTI-AGEING</p>
            <p class="hp-sci-feature-{{ section.id }}__compare-text">Reacts to visible signs. Temporary result.</p>
          </div>
          <div class="hp-sci-feature-{{ section.id }}__compare-row">
            <p class="hp-sci-feature-{{ section.id }}__compare-label">REGENERATIVE</p>
            <p class="hp-sci-feature-{{ section.id }}__compare-text">Restores biological function. Result compounds. Skin maintains independently.</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="hp-sci-feature-{{ section.id }}__media">
      {% render 'hp-science-media',
        image: section.settings.image,
        video: section.settings.video,
        animation_url: section.settings.animation_url,
        show_placeholder: section.settings.show_media_placeholder,
        placeholder_label: section.settings.placeholder_label,
        min_height: section.settings.media_min_height_desktop | default: 520,
        aspect_ratio: '',
        light_placeholder: true
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science \u2014 Feature split",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "header",
      "content": "Text position"
    },
    {
      "type": "range",
      "id": "text_offset_x_desktop",
      "label": "Horizontal offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_desktop",
      "label": "Vertical offset \u2014 desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_x_mobile",
      "label": "Horizontal offset \u2014 mobile",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text left (negative) or right (positive)"
    },
    {
      "type": "range",
      "id": "text_offset_y_mobile",
      "label": "Vertical offset \u2014 mobile",
      "min": -200,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "Move text up (negative) or down (positive)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR APPROACH"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "We use regenerative science in beauty."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Most beauty reacts to what you can see. We work a layer beneath, restoring the conditions under which skin repairs itself."
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout (media left)",
      "default": false
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "url",
      "id": "animation_url",
      "label": "Animation file URL"
    },
    {
      "type": "checkbox",
      "id": "show_media_placeholder",
      "label": "Show placeholder when empty",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "Upload approach image or animation"
    },
    {
      "type": "range",
      "id": "media_min_height_desktop",
      "label": "Media min height (desktop)",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "media_min_height_mobile",
      "label": "Media min height (mobile)",
      "min": 240,
      "max": 560,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Text panel background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & compare text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Description color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#9a9a9a"
    },
    {
      "type": "color",
      "id": "compare_label_color",
      "label": "Compare label color",
      "default": "#9a9a9a"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (Desktop)",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (Mobile)",
