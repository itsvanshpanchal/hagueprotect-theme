{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-feature-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .hp-sci-feature-{{ section.id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0;
    align-items: stretch;
  }

  .hp-sci-feature-{{ section.id }}__grid--reverse .hp-sci-feature-{{ section.id }}__copy {
    order: 2;
  }

  .hp-sci-feature-{{ section.id }}__grid--reverse .hp-sci-feature-{{ section.id }}__media {
    order: 1;
  }

  .hp-sci-feature-{{ section.id }}__copy {
    background: {{ section.settings.card_background }};
    color: {{ section.settings.text_color }};
    padding: clamp(32px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hp-sci-feature-{{ section.id }}__title {
    font-size: clamp(26px, 3vw, {{ section.settings.title_size }}px);
    margin-bottom: 16px;
    color: inherit;
  }

  .hp-sci-feature-{{ section.id }}__text {
    font-size: 18px;
    line-height: 1.55;
    opacity: 0.85;
    margin: 0;
  }

  .hp-sci-feature-{{ section.id }}__media {
    min-height: {{ section.settings.media_min_height }}px;
  }

  @media screen and (max-width: 989px) {
    .hp-sci-feature-{{ section.id }}__grid,
    .hp-sci-feature-{{ section.id }}__grid--reverse {
      grid-template-columns: 1fr;
    }

    .hp-sci-feature-{{ section.id }}__grid--reverse .hp-sci-feature-{{ section.id }}__copy,
    .hp-sci-feature-{{ section.id }}__grid--reverse .hp-sci-feature-{{ section.id }}__media {
      order: unset;
    }
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-feature-{{ section.id }}">
  <div class="hp-sci__inner" style="padding-left: 0; padding-right: 0; max-width: none;">
    <div class="hp-sci-feature-{{ section.id }}__grid{% if section.settings.reverse_layout %} hp-sci-feature-{{ section.id }}__grid--reverse{% endif %}">
      <div class="hp-sci-feature-{{ section.id }}__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-sci__eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="hp-sci__title hp-sci-feature-{{ section.id }}__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="hp-sci-feature-{{ section.id }}__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      <div class="hp-sci-feature-{{ section.id }}__media">
        {% render 'hp-science-media',
          image: section.settings.image,
          video: section.settings.video,
          animation_url: section.settings.animation_url,
          show_placeholder: section.settings.show_media_placeholder,
          placeholder_label: section.settings.placeholder_label,
          min_height: section.settings.media_min_height,
          light_placeholder: true
        %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science — Feature split",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Precise responsive science in results."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Each step in Skin Longevity System 5 is calibrated to a biological process — not a trend cycle."
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse layout (media left)",
      "default": false
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "url",
      "id": "animation_url",
      "label": "Animation file URL"
    },
    {
      "type": "checkbox",
      "id": "show_media_placeholder",
      "label": "Show placeholder when empty",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "Upload feature image or animation"
    },
    {
      "type": "range",
      "id": "media_min_height",
      "label": "Media min height",
      "min": 240,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#f5f0e8"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#a8894a"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Science — Feature split"
    }
  ]
}
{% endschema %}
