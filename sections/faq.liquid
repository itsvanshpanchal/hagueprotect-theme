{%- liquid
  assign layout_style = section.settings.layout_style | default: 'compact'
  assign is_page_layout = false
  if layout_style == 'page'
    assign is_page_layout = true
  endif
  assign accent = section.settings.accent_color | default: '#FF2B2B'
  assign wa_raw = section.settings.cta_whatsapp | default: settings.floating_whatsapp | default: '917009205008' | strip
  assign wa_digits = wa_raw | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', ''
-%}

{%- style -%}
  {% render 'section-typography-vars', section: section %}

  #shopify-section-{{ section.id }} .faq-custom {
    background-color: {{ section.settings.bg_color | default: '#F7F7F8' }};
    padding: {% if is_page_layout %}clamp(56px, 8vw, 96px){% else %}clamp(60px, 8vw, 100px){% endif %} 0;
    font-family: var(--font-family-sans);
  }

  #shopify-section-{{ section.id }} .faq-custom__container {
    max-width: {% if is_page_layout %}860px{% else %}var(--site-max-width){% endif %};
    margin: 0 auto;
    padding: 0 max(20px, var(--homepage-section-gutter, 24px));
    display: flex;
    flex-direction: column;
    align-items: {% if is_page_layout %}stretch{% else %}center{% endif %};
    gap: {% if is_page_layout %}36px{% else %}40px{% endif %};
  }

  #shopify-section-{{ section.id }} .faq-custom__header {
    text-align: {% if is_page_layout %}left{% else %}var(--section-heading-align, left){% endif %};
    display: flex;
    flex-direction: column;
    align-items: {% if is_page_layout %}flex-start{% else %}var(--section-heading-items, flex-start){% endif %};
    gap: {% if is_page_layout %}12px{% else %}16px{% endif %};
    margin-bottom: {% if is_page_layout %}4px{% else %}8px{% endif %};
    width: 100%;
  }

  #shopify-section-{{ section.id }} .faq-custom__eyebrow {
    font-family: var(--font-family-eyebrow, var(--font-family-sans));
    font-size: var(--section-label-size, 13px);
    font-weight: var(--font-weight-eyebrow, 700);
    font-style: var(--font-style-eyebrow, normal);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: {{ accent }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .faq-custom__page-title {
    font-family: 'Bahnschrift', var(--font-family-heading), sans-serif !important;
    font-size: clamp(34px, 5vw, 52px) !important;
    font-weight: 400 !important;
    font-style: normal !important;
    color: #111111 !important;
    margin: 0;
    line-height: 1.08 !important;
    letter-spacing: -0.02em !important;
    text-transform: none !important;
  }

  #shopify-section-{{ section.id }} .faq-custom__page-description {
    font-family: var(--font-family-sans);
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: var(--font-weight-sans, 400);
    font-style: var(--font-style-sans, normal);
    color: #5c5c5c;
    line-height: 1.55;
    margin: 0;
    max-width: 620px;
  }

  #shopify-section-{{ section.id }} .faq-custom__heading {
    font-family: var(--font-family-h2, var(--font-family-sans)) !important;
    font-size: {% if is_page_layout %}var(--section-heading-size){% else %}clamp(18px, 2.2vw, 22px){% endif %} !important;
    font-weight: var(--font-weight-h2, 600) !important;
    font-style: var(--font-style-h2, normal) !important;
    color: {{ accent }} !important;
    margin: 0;
    padding-bottom: 6px;
    position: relative;
    letter-spacing: -0.01em !important;
    line-height: 1.3 !important;
    text-transform: capitalize !important;
  }

  #shopify-section-{{ section.id }} .faq-custom__heading::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 48px;
    height: 3px;
    background-color: {{ accent }};
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .faq-custom:not(.faq-custom--page) .faq-custom__header {
    align-items: flex-start;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .faq-custom:not(.faq-custom--page) .faq-custom__items {
    max-width: 920px;
  }

  #shopify-section-{{ section.id }} .faq-custom:not(.faq-custom--page) .faq-custom__question {
    font-size: clamp(14px, 1.5vw, 16px) !important;
    font-weight: 600 !important;
  }

  #shopify-section-{{ section.id }} .faq-custom:not(.faq-custom--page) .faq-custom__answer {
    font-size: clamp(13px, 1.4vw, 15px);
  }

  #shopify-section-{{ section.id }} .faq-custom__items {
    background: #ffffff;
    border-radius: {% if is_page_layout %}12px{% else %}16px{% endif %};
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: {% if is_page_layout %}none{% else %}0 4px 20px rgba(0, 0, 0, 0.03){% endif %};
    width: 100%;
    padding: {% if is_page_layout %}8px 28px{% else %}16px 40px{% endif %};
    box-sizing: border-box;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .faq-custom__items {
      padding: {% if is_page_layout %}4px 16px{% else %}12px 20px{% endif %};
    }
  }

  #shopify-section-{{ section.id }} .faq-custom__item {
    border-bottom: 1px solid #ececec;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .faq-custom__item:last-child {
    border-bottom: none;
  }

  #shopify-section-{{ section.id }} .faq-custom__trigger {
    width: 100%;
    background: none;
    border: none;
    padding: {% if is_page_layout %}22px 0{% else %}24px 0{% endif %};
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    text-align: left;
    color: #000000;
    outline: none;
  }

  #shopify-section-{{ section.id }} .faq-custom__trigger:focus-visible {
    outline: 2px solid {{ accent }};
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .faq-custom__question {
    font-family: var(--font-family-sans) !important;
    font-size: {% if is_page_layout %}clamp(15px, 1.5vw, 17px){% else %}var(--section-subheading-size, var(--body-font-size)){% endif %} !important;
    font-weight: 600 !important;
    font-style: var(--font-style-sans, normal) !important;
    color: #111111 !important;
    margin: 0;
    line-height: 1.4 !important;
    padding-right: 12px;
    letter-spacing: -0.01em !important;
    text-transform: none !important;
  }

  #shopify-section-{{ section.id }} .faq-custom__icon-wrapper {
    width: 28px;
    height: 28px;
    background-color: #111111;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .faq-custom__icon-wrapper span {
    font-size: 18px;
    font-weight: 500;
    line-height: 1;
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .faq-custom__item.active .faq-custom__icon-wrapper {
    background-color: {{ accent }};
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .faq-custom__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  #shopify-section-{{ section.id }} .faq-custom__answer {
    padding-bottom: 22px;
    font-family: var(--font-family-sans);
    font-size: {% if is_page_layout %}15px{% else %}var(--body-font-size, 15px){% endif %};
    font-weight: var(--font-weight-sans, 400);
    font-style: var(--font-style-sans, normal);
    color: #555555;
    line-height: 1.65;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .faq-custom__answer p {
    margin: 0 0 12px;
  }

  #shopify-section-{{ section.id }} .faq-custom__answer p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .faq-custom__answer a {
    color: {{ accent }};
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .faq-custom__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    margin-top: 8px;
    padding: 28px 32px;
    background: #111111;
    color: #ffffff;
    border-radius: 12px;
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 420px;
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-title {
    margin: 0;
    font-family: 'Bahnschrift', var(--font-family-heading), sans-serif;
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-btn--primary {
    background: {{ accent }};
    color: #ffffff;
    border: 1px solid {{ accent }};
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-btn--primary:hover {
    background: #e02424;
    border-color: #e02424;
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-btn--ghost {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  #shopify-section-{{ section.id }} .faq-custom__cta-btn--ghost:hover {
    border-color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .faq-custom__cta {
      padding: 24px 20px;
    }

    #shopify-section-{{ section.id }} .faq-custom__cta-actions {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .faq-custom__cta-btn {
      flex: 1 1 auto;
    }
  }
{%- endstyle -%}

<div class="faq-custom{% if is_page_layout %} faq-custom--page{% endif %}" data-no-typewriter data-faq-section="{{ section.id }}">
  <div class="faq-custom__container">
    <div class="faq-custom__header">
      {%- if is_page_layout -%}
        {%- if section.settings.eyebrow != blank -%}
          <p class="faq-custom__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.page_title != blank -%}
          <h1 class="faq-custom__page-title">{{ section.settings.page_title }}</h1>
        {%- elsif section.settings.heading != blank -%}
          <h1 class="faq-custom__page-title">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.page_description != blank -%}
          <p class="faq-custom__page-description">{{ section.settings.page_description }}</p>
        {%- endif -%}
      {%- elsif section.settings.heading != blank -%}
        <h2 class="faq-custom__heading">{{ section.settings.heading }}</h2>
      {%- else -%}
        <h2 class="faq-custom__heading">Frequently asked questions</h2>
      {%- endif -%}
    </div>

    <div class="faq-custom__items">
      {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="faq-custom__item" {{ block.shopify_attributes }}>
            <button type="button" class="faq-custom__trigger" data-faq-trigger aria-expanded="false">
            <h3 class="faq-custom__question">{{ block.settings.question }}</h3>
              <div class="faq-custom__icon-wrapper" aria-hidden="true">
                <span>+</span>
              </div>
            </button>
            <div class="faq-custom__panel" data-faq-panel hidden>
              <div class="faq-custom__answer">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Compact defaults for product/collection pages with no blocks yet {%- endcomment -%}
        <div class="faq-custom__item">
          <button type="button" class="faq-custom__trigger" data-faq-trigger aria-expanded="false">
            <h3 class="faq-custom__question">Are Hague Protect formulas safe for my sneakers?</h3>
            <div class="faq-custom__icon-wrapper" aria-hidden="true"><span>+</span></div>
          </button>
          <div class="faq-custom__panel" data-faq-panel hidden>
            <div class="faq-custom__answer"><p>Yes. Our formulas are pH-balanced and made for premium footwear materials including leather, suede, nubuck, mesh, canvas, and rubber. Always follow the care steps on the product page.</p></div>
          </div>
        </div>
          <div class="faq-custom__item">
          <button type="button" class="faq-custom__trigger" data-faq-trigger aria-expanded="false">
            <h3 class="faq-custom__question">Will this change the color or finish?</h3>
            <div class="faq-custom__icon-wrapper" aria-hidden="true"><span>+</span></div>
          </button>
          <div class="faq-custom__panel" data-faq-panel hidden>
            <div class="faq-custom__answer"><p>No. Hague Protect systems are designed to clean and protect without stripping color or damaging finishes when used as directed.</p></div>
          </div>
              </div>
        <div class="faq-custom__item">
          <button type="button" class="faq-custom__trigger" data-faq-trigger aria-expanded="false">
            <h3 class="faq-custom__question">How long does delivery take in India?</h3>
            <div class="faq-custom__icon-wrapper" aria-hidden="true"><span>+</span></div>
            </button>
          <div class="faq-custom__panel" data-faq-panel hidden>
            <div class="faq-custom__answer"><p>Orders placed before 12pm IST on business days usually ship the same day. Delivery across India typically takes 2 to 5 business days depending on your location.</p></div>
          </div>
            </div>
        <div class="faq-custom__item">
          <button type="button" class="faq-custom__trigger" data-faq-trigger aria-expanded="false">
            <h3 class="faq-custom__question">What if I need help choosing a kit?</h3>
            <div class="faq-custom__icon-wrapper" aria-hidden="true"><span>+</span></div>
          </button>
          <div class="faq-custom__panel" data-faq-panel hidden>
            <div class="faq-custom__answer"><p>Match the kit to your material, or message us on WhatsApp with a photo of your shoes and we’ll recommend the right care system.</p></div>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if is_page_layout and section.settings.show_cta -%}
      <div class="faq-custom__cta">
        <div class="faq-custom__cta-copy">
          {%- if section.settings.cta_title != blank -%}
            <h2 class="faq-custom__cta-title">{{ section.settings.cta_title }}</h2>
          {%- endif -%}
          {%- if section.settings.cta_text != blank -%}
            <p class="faq-custom__cta-text">{{ section.settings.cta_text }}</p>
          {%- endif -%}
        </div>
        <div class="faq-custom__cta-actions">
          {%- if wa_digits != blank -%}
            <a class="faq-custom__cta-btn faq-custom__cta-btn--primary" href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener noreferrer">
              WhatsApp us
            </a>
          {%- endif -%}
          {%- if section.settings.cta_link != blank -%}
            <a class="faq-custom__cta-btn faq-custom__cta-btn--ghost" href="{{ section.settings.cta_link }}">
              {{ section.settings.cta_link_label | default: 'Contact support' }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  {%- comment -%} FAQPage schema — Q&As must match the visible on-page content {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | strip | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<script>
  (function () {
    const root = document.querySelector('[data-faq-section="{{ section.id }}"]');
    if (!root) return;

    root.querySelectorAll('[data-faq-trigger]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const item = btn.closest('.faq-custom__item');
        const panel = item.querySelector('[data-faq-panel]');
    const isActive = item.classList.contains('active');
    
        root.querySelectorAll('.faq-custom__item').forEach(function (entry) {
          entry.classList.remove('active');
          const entryPanel = entry.querySelector('[data-faq-panel]');
          const entryBtn = entry.querySelector('[data-faq-trigger]');
          if (entryPanel) {
            entryPanel.style.maxHeight = '0px';
            entryPanel.hidden = true;
          }
          if (entryBtn) entryBtn.setAttribute('aria-expanded', 'false');
        });

        if (!isActive && panel) {
      item.classList.add('active');
          panel.hidden = false;
          panel.style.maxHeight = 'none';
          var height = panel.scrollHeight;
          panel.style.maxHeight = '0px';
          // Force reflow before expanding
          void panel.offsetHeight;
          panel.style.maxHeight = height + 'px';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        {
          "value": "compact",
          "label": "Compact (product/collection pages)"
        },
        {
          "value": "page",
          "label": "Full page (FAQ page)"
        }
      ],
      "default": "compact"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f7f7f8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#FF2B2B"
    },
    {
      "type": "header",
      "content": "Full page header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Tiny text above title",
      "default": "Hague Protect Support"
    },
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "page_description",
      "label": "Page description",
      "default": "Answers about our formulas, materials, shipping across India, and how to care for your sneakers the Hague Protect way."
    },
    {
      "type": "header",
      "content": "Page contact CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show contact CTA on FAQ page",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA title",
      "default": "Still need help?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Message our team for product advice, order help, or care tips for leather, suede, and sneakers."
    },
    {
      "type": "text",
      "id": "cta_whatsapp",
      "label": "WhatsApp number",
      "default": "917009205008",
      "info": "Country code + number, digits only."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "text",
      "id": "cta_link_label",
      "label": "Secondary CTA label",
      "default": "Contact support"
    },
    {
      "type": "header",
      "content": "Compact section label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section label",
      "default": "Product",
      "info": "Shown on compact layout only (e.g. below products on collection pages)."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading — second line",
      "info": "Optional. Shown under the main heading in a different color (sentence case)."
    },
    {
      "type": "color",
      "id": "heading_line2_color",
      "label": "Heading second line color",
      "default": "#6b6b6b"
    },
    {
      "type": "header",
      "content": "Text spacing"
    },
    {
      "type": "paragraph",
      "content": "Space between the main title and the description/subheading below it. Does not change fonts — only the gap. Applies on every screen size for this section."
    },
    {
      "type": "range",
      "id": "heading_subheading_spacing_desktop",
      "label": "Title to description — computer",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "heading_subheading_spacing_mobile",
      "label": "Title to description — phone",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "eyebrow_title_spacing_desktop",
      "label": "Eyebrow to title — computer",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_title_spacing_mobile",
      "label": "Eyebrow to title — phone",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
        {
      "type": "header",
      "content": "Text position (laptop)"
    },
    {
      "type": "range",
      "id": "text_offset_x_desktop",
      "label": "Horizontal",
      "min": -100,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Move text left (-) or right (+)."
    },
