{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  .hp-sci-results-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .hp-sci-results-{{ section.id }}__stack {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hp-sci-results-{{ section.id }}__pillar {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: stretch;
    min-height: clamp(460px, 52vh, 680px);
  }

  .hp-sci-results-{{ section.id }}__pillar--dark {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: #0a0a0a;
  }

  .hp-sci-results-{{ section.id }}__pillar--equal {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .hp-sci-results-{{ section.id }}__pillar--reverse {
    direction: rtl;
  }

  .hp-sci-results-{{ section.id }}__pillar--reverse > * {
    direction: ltr;
  }

  .hp-sci-results-{{ section.id }}__panel--dark {
    background: #0a0a0a !important;
    color: #ffffff !important;
  }

  .hp-sci-results-{{ section.id }}__pillar--dark .hp-sci-results-{{ section.id }}__pillar-num,
  .hp-sci-results-{{ section.id }}__pillar--dark .hp-sci-results-{{ section.id }}__stat-label {
    color: rgba(255, 255, 255, 0.55);
  }

  .hp-sci-results-{{ section.id }}__pillar--dark .hp-sci-results-{{ section.id }}__pillar-title,
  .hp-sci-results-{{ section.id }}__pillar--dark .hp-sci-results-{{ section.id }}__stat-value,
  .hp-sci-results-{{ section.id }}__pillar--dark .hp-sci-results-{{ section.id }}__para {
    color: #ffffff !important;
  }

  .hp-sci-results-{{ section.id }}__pillar--dark .hp-sci-results-{{ section.id }}__footnote {
    color: rgba(255, 255, 255, 0.42);
  }

  .hp-sci-results-{{ section.id }}__pillar--dark .hp-sci-results-{{ section.id }}__rule {
    background: #ffffff;
    opacity: 0.18;
  }

  .hp-sci-results-{{ section.id }}__media {
    min-height: clamp(320px, 52vh, 680px);
    background: #0a0a0a;
  }

  .hp-sci-results-{{ section.id }}__media .hp-sci-media,
  .hp-sci-results-{{ section.id }}__media .hp-sci-media__img,
  .hp-sci-results-{{ section.id }}__media .hp-sci-media__video {
    height: 100%;
    min-height: inherit;
  }

  .hp-sci-results-{{ section.id }}__panel {
    background: {{ section.settings.panel_background }};
    color: {{ section.settings.panel_text_color }};
    padding: clamp(40px, 6vw, 72px) clamp(28px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  .hp-sci-results-{{ section.id }}__pillar-num {
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-size: {{ section.settings.pillar_num_size }}px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: {{ section.settings.pillar_num_color }};
    margin: 0 0 16px;
  }

  .hp-sci-results-{{ section.id }}__pillar-title {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-weight: 500;
    font-size: clamp(34px, 4.5vw, {{ section.settings.pillar_title_size }}px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 clamp(24px, 3vw, 32px);
  }

  .hp-sci-results-{{ section.id }}__para {
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(16px, 1.45vw, {{ section.settings.pillar_body_size }}px);
    line-height: 1.65;
    margin: 0 0 18px;
    max-width: 42ch;
    color: inherit;
  }

  .hp-sci-results-{{ section.id }}__para:last-of-type {
    margin-bottom: 0;
  }

  .hp-sci-results-{{ section.id }}__rule {
    display: block;
    width: 100%;
    max-width: 42ch;
    height: 1px;
    border: 0;
    margin: clamp(24px, 3vw, 32px) 0;
    background: {{ section.settings.divider_color }};
    opacity: 0.35;
  }

  .hp-sci-results-{{ section.id }}__stat-wrap {
    margin-top: clamp(28px, 4vw, 40px);
  }

  .hp-sci-results-{{ section.id }}__stat-value {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: clamp(44px, 6vw, {{ section.settings.stat_size }}px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0 0 10px;
  }

  .hp-sci-results-{{ section.id }}__stat-label {
    font-family: 'Darker Grotesque', sans-serif;
    font-size: {{ section.settings.stat_label_size }}px;
    letter-spacing: 0.06em;
    color: {{ section.settings.pillar_num_color }};
    margin: 0 0 clamp(20px, 3vw, 28px);
  }

  .hp-sci-results-{{ section.id }}__footnote {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Monaco, Consolas, monospace;
    font-size: {{ section.settings.footnote_size }}px;
    line-height: 1.55;
    color: {{ section.settings.footnote_color }};
    margin: 0;
    max-width: 46ch;
  }

  @media screen and (max-width: 989px) {
    .hp-sci-results-{{ section.id }}__pillar,
    .hp-sci-results-{{ section.id }}__pillar--reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      min-height: 0;
    }

    .hp-sci-results-{{ section.id }}__media {
      min-height: {{ section.settings.media_min_height_mobile }}px;
    }

    .hp-sci-results-{{ section.id }}__panel {
      padding: 40px 24px 48px;
    }
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-results-{{ section.id }}">
  <div class="hp-sci__inner" style="padding-left: 0; padding-right: 0; max-width: none;">
    <div class="hp-sci-results-{{ section.id }}__stack">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'pillar' -%}
            {%- liquid
              assign pillar_style = block.settings.panel_style | default: 'light'
              assign pillar_panel_bg = block.settings.panel_background
              if pillar_panel_bg == blank
                if pillar_style == 'dark'
                  assign pillar_panel_bg = '#0a0a0a'
                else
                  assign pillar_panel_bg = section.settings.panel_background
                endif
              endif
              assign pillar_accent = block.settings.accent_color
              if pillar_style == 'dark'
                if pillar_accent == blank or pillar_accent == '#008667'
                  assign pillar_accent = '#ffffff'
                endif
              elsif pillar_accent == blank
                assign pillar_accent = '#008667'
              endif
            -%}
            <article
              class="hp-sci-results-{{ section.id }}__pillar{% if pillar_style == 'dark' %} hp-sci-results-{{ section.id }}__pillar--dark{% endif %}{% if block.settings.equal_columns %} hp-sci-results-{{ section.id }}__pillar--equal{% endif %}{% if block.settings.reverse_layout %} hp-sci-results-{{ section.id }}__pillar--reverse{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="hp-sci-results-{{ section.id }}__media">
                {% render 'hp-science-media',
                  image: block.settings.image,
                  video: block.settings.video,
                  animation_url: block.settings.animation_url,
                  show_placeholder: block.settings.show_media_placeholder,
                  placeholder_label: block.settings.placeholder_label,
                  min_height: section.settings.media_min_height_desktop
                %}
              </div>

              <div class="hp-sci-results-{{ section.id }}__panel{% if pillar_style == 'dark' %} hp-sci-results-{{ section.id }}__panel--dark{% endif %}" style="background: {{ pillar_panel_bg }};{% if block.settings.panel_text_color != blank %} color: {{ block.settings.panel_text_color }};{% endif %}">
                {%- if block.settings.pillar_number != blank -%}
                  <p class="hp-sci-results-{{ section.id }}__pillar-num">{{ block.settings.pillar_number }}</p>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="hp-sci-results-{{ section.id }}__pillar-title" style="color: {{ pillar_accent }};">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.paragraph_1 != blank -%}
                  <p class="hp-sci-results-{{ section.id }}__para">{{ block.settings.paragraph_1 }}</p>
                {%- endif -%}

                {%- if block.settings.show_divider -%}
                  <hr class="hp-sci-results-{{ section.id }}__rule" aria-hidden="true">
                {%- endif -%}

                {%- if block.settings.paragraph_2 != blank -%}
                  <p class="hp-sci-results-{{ section.id }}__para">{{ block.settings.paragraph_2 }}</p>
                {%- endif -%}

                {%- if block.settings.stat_value != blank or block.settings.stat_label != blank -%}
                  <div class="hp-sci-results-{{ section.id }}__stat-wrap">
                    {%- if block.settings.stat_value != blank -%}
                      <p class="hp-sci-results-{{ section.id }}__stat-value" style="color: {{ pillar_accent }};">{{ block.settings.stat_value }}</p>
                    {%- endif -%}
                    {%- if block.settings.stat_label != blank -%}
                      <p class="hp-sci-results-{{ section.id }}__stat-label">{{ block.settings.stat_label }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.footnote != blank -%}
                  <p class="hp-sci-results-{{ section.id }}__footnote">{{ block.settings.footnote }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {% render 'hp-science-pillar-default', section_id: section.id, panel_bg: section.settings.panel_background, accent: '#008667', num_color: section.settings.pillar_num_color, footnote_color: section.settings.footnote_color %}
        {% render 'hp-science-pillar-recovery-default', section_id: section.id %}
        {% render 'hp-science-pillar-structure-default', section_id: section.id, panel_bg: section.settings.panel_background, num_color: section.settings.pillar_num_color, footnote_color: section.settings.footnote_color %}
        {% render 'hp-science-pillar-hydration-default', section_id: section.id, panel_bg: section.settings.panel_background, num_color: section.settings.pillar_num_color, footnote_color: section.settings.footnote_color %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Science — Results pillars",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Default panel background",
      "default": "#fcfaf2"
    },
    {
      "type": "color",
      "id": "panel_text_color",
      "label": "Panel text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "pillar_num_color",
      "label": "Pillar number / stat label color",
      "default": "#9a9a9a"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "footnote_color",
      "label": "Footnote color",
      "default": "#888888"
    },
    {
      "type": "range",
      "id": "pillar_title_size",
      "label": "Pillar title size",
      "min": 28,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "pillar_body_size",
      "label": "Body text size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "pillar_num_size",
      "label": "Pillar number size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "stat_size",
      "label": "Stat value size",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "stat_label_size",
      "label": "Stat label size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "footnote_size",
      "label": "Footnote size",
      "min": 10,
      "max": 14,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "media_min_height_desktop",
      "label": "Media min height (desktop)",
      "min": 360,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "media_min_height_mobile",
      "label": "Media min height (mobile)",
      "min": 240,
      "max": 480,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Result pillar",
      "settings": [
        {
          "type": "text",
          "id": "pillar_number",
          "label": "Pillar number",
          "default": "Pillar 01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Vitality"
        },
        {
          "type": "textarea",
          "id": "paragraph_1",
          "label": "Paragraph 1",
          "default": "Cell renewal. The foundation of everything else. Without consistent renewal, nothing that's applied to the surface reaches the cells that need it."
        },
        {
          "type": "checkbox",
          "id": "show_divider",
          "label": "Show divider line",
          "default": true
        },
        {
          "type": "textarea",
          "id": "paragraph_2",
          "label": "Paragraph 2",
          "default": "Sun-safe bio-retinoids accelerate the renewal cycle without stripping the barrier. Active day and night, no sun restriction."
        },
        {
          "type": "text",
          "id": "stat_value",
          "label": "Stat value",
          "default": "+38%*"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Stat label",
          "default": "Cell Proliferation · At 48 Hours"
        },
        {
          "type": "textarea",
          "id": "footnote",
          "label": "Footnote",
          "default": "* In Vitro Study Conducted to Test Effect of Bio-Retinoids on Human Dermal Fibroblasts."
        },
        {
          "type": "color",
          "id": "accent_color",
          "label": "Accent color (title + stat)",
          "default": "#008667"
        },
        {
          "type": "select",
          "id": "panel_style",
          "label": "Panel style",
          "options": [
            { "value": "light", "label": "Light (cream)" },
            { "value": "dark", "label": "Dark (black)" }
          ],
          "default": "light"
        },
        {
          "type": "color",
          "id": "panel_background",
          "label": "Panel background override"
        },
        {
          "type": "color",
          "id": "panel_text_color",
          "label": "Panel text color override"
        },
        {
          "type": "checkbox",
          "id": "reverse_layout",
          "label": "Reverse layout (image right)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "equal_columns",
          "label": "Equal 50/50 columns",
          "default": false
        },
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "url",
          "id": "animation_url",
          "label": "Animation URL"
        },
        {
          "type": "checkbox",
          "id": "show_media_placeholder",
          "label": "Show placeholder when empty",
          "default": true
        },
        {
          "type": "text",
          "id": "placeholder_label",
          "label": "Placeholder label",
          "default": "Upload pillar image or animation"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Science — Results pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "pillar_number": "Pillar 01",
            "title": "Vitality",
            "panel_style": "light",
            "accent_color": "#008667"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "pillar_number": "Pillar 02",
            "title": "Recovery",
            "panel_style": "dark",
            "reverse_layout": true,
            "paragraph_1": "Skin is always healing something. A breakout, a barrier stripped by actives, the small daily damage you never notice. Recovery is how fast skin closes those gaps and repairs itself before they show.",
            "paragraph_2": "The serum speeds up how quickly cells move in to close a wound. Faster migration means less time spent visibly healing, and damage that resolves before it leaves a mark.",
            "stat_value": "+74.7%*",
            "stat_label": "Cell Migration · In 24 Hours",
            "footnote": "* Wound Healing in Normal Human Dermal Fibroblast using Scratch Assay for SKIN LONGEVITY SYSTEM 5.",
            "accent_color": "#ffffff",
            "placeholder_label": "Recovery scratch assay image / animation"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "pillar_number": "Pillar 03",
            "title": "Structure",
            "panel_style": "light",
            "reverse_layout": true,
            "equal_columns": true,
            "paragraph_1": "Collagen. The protein that makes skin bounce back. Production declines from 25 onwards. A peptide complex signals the biology to support what's slowing.",
            "paragraph_2": "Each peptide targets a specific biological function: synthesis, repair, inflammation control, moisture signalling. Simultaneously. Because the signals are interconnected.",
            "stat_value": "+132.4%*",
            "stat_label": "Collagen Production",
            "footnote": "* Increase in Collagen 1 Levels in NHDF Cells Treated with SKIN LONGEVITY SYSTEM 3.",
            "accent_color": "#a8724a",
            "placeholder_label": "Structure / collagen image / animation"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "pillar_number": "Pillar 04",
            "title": "Hydration",
            "panel_style": "light",
            "reverse_layout": false,
            "equal_columns": true,
            "paragraph_1": "Not topical hydration. Biological hydration. The difference between skin that holds moisture because it's producing its own hyaluronic acid, and skin that's borrowing moisture from the air.",
            "paragraph_2": "High and low molecular weight HA working together. High MW seals the surface. Low MW penetrates deep to signal production. The serum teaches the skin to do what the serum is doing.",
            "stat_value": "+254%*",
            "stat_label": "Hyaluronic Acid Production",
            "footnote": "* Hyaluronan Synthase - 2 Promotion in NHDF Cells After 48-Hour Exposure to SKIN LONGEVITY SYSTEM S.",
            "accent_color": "#c07a38",
            "placeholder_label": "Hydration / HA cells image / animation"
          }
        }
      ]
    }
  ]
}
{% endschema %}
