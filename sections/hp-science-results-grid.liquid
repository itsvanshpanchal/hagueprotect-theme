{{ 'hp-science-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_color = section.settings.background_color
  if bg_color == '#ffffff' or bg_color == '#fff' or bg_color == blank or bg_color == 'rgba(0,0,0,0)'
    assign bg_color = '#242424'
  endif
-%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
    background: {{ bg_color }};
  }

  .hp-sci-results-{{ section.id }} {
    margin: 0 !important;
    padding-top: 0 !important;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ bg_color }};
    padding: 0 0 {{ section.settings.padding_bottom }}px;
    width: 100%;
    max-width: none;
    box-sizing: border-box;
  }

  .hp-sci-results-{{ section.id }}__stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: none;
  }

  .hp-sci-results-{{ section.id }}__pillar {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: stretch;
    width: 100%;
  }

  .hp-sci-results-{{ section.id }}__pillar--dark {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: #0a0a0a;
  }

  .hp-sci-results-{{ section.id }}__pillar--equal {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .hp-sci-results-{{ section.id }}__pillar--reverse {
    direction: rtl;
  }

  .hp-sci-results-{{ section.id }}__pillar--reverse > * {
    direction: ltr;
  }

  .hp-sci-results-{{ section.id }}__panel--dark {
    background: #0a0a0a !important;
    color: #ffffff !important;
  }

  .hp-sci-results-{{ section.id }}__pillar--dark .hp-sci-results-{{ section.id }}__rule,
  .hp-sci-results-{{ section.id }}__panel--dark .hp-sci-results-{{ section.id }}__rule {
    background: #ffffff;
    opacity: 0.18;
  }

  .hp-sci-results-{{ section.id }}__media {
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.media_min_height_desktop }}px;
    background: #0a0a0a;
  }

  .hp-sci-results-{{ section.id }}__media .hp-sci-media,
  .hp-sci-results-{{ section.id }}__media .hp-sci-media__img,
  .hp-sci-results-{{ section.id }}__media .hp-sci-media__video,
  .hp-sci-results-{{ section.id }}__media .hp-sci-media__placeholder {
    height: 100%;
    min-height: {{ section.settings.media_min_height_desktop }}px;
  }

  @media screen and (max-width: 989px) {
    .hp-sci-results-{{ section.id }}__media {
      min-height: {{ section.settings.media_min_height_mobile }}px;
    }
    .hp-sci-results-{{ section.id }}__media .hp-sci-media,
    .hp-sci-results-{{ section.id }}__media .hp-sci-media__img,
    .hp-sci-results-{{ section.id }}__media .hp-sci-media__video,
    .hp-sci-results-{{ section.id }}__media .hp-sci-media__placeholder {
      min-height: {{ section.settings.media_min_height_mobile }}px;
    }
  }

  .hp-sci-results-{{ section.id }}__panel {
    background: {{ section.settings.panel_background }};
    color: {{ section.settings.panel_text_color }};
    padding: clamp(40px, 6vw, 72px) clamp(28px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
  }

  .hp-sci-results-{{ section.id }}__pillar-num {
    color: {{ section.settings.pillar_num_color }};
    margin: 0 0 16px;
  }

  .hp-sci-results-{{ section.id }}__pillar-title {
    line-height: 1.05;
    margin: 0 0 clamp(24px, 3vw, 32px);
  }

  .hp-sci-results-{{ section.id }}__para {
    line-height: 1.65;
    margin: 0 0 18px;
    max-width: 42ch;
    color: inherit;
  }

  .hp-sci-results-{{ section.id }}__para:last-of-type {
    margin-bottom: 0;
  }

  .hp-sci-results-{{ section.id }}__rule {
    display: block;
    width: 100%;
    max-width: 42ch;
    height: 1px;
    border: 0;
    margin: clamp(24px, 3vw, 32px) 0;
    background: {{ section.settings.divider_color }};
    opacity: 0.35;
  }

  .hp-sci-results-{{ section.id }}__para + .hp-sci-results-{{ section.id }}__rule {
    margin-top: calc(clamp(24px, 3vw, 32px) - 18px);
  }

  .hp-sci-results-{{ section.id }}__stat-wrap {
    margin-top: clamp(28px, 4vw, 40px);
  }

  .hp-sci-results-{{ section.id }}__stat-value {
    line-height: 1;
    margin: 0 0 10px;
  }

  .hp-sci-results-{{ section.id }}__stat-label {
    color: {{ section.settings.pillar_num_color }};
    margin: 0 0 clamp(20px, 3vw, 28px);
  }

  .hp-sci-results-{{ section.id }}__footnote {
    line-height: 1.55;
    color: {{ section.settings.footnote_color }};
    margin: 0;
    max-width: 46ch;
  }
  {%- if section.settings.text_offset_x_desktop != 0 or section.settings.text_offset_y_desktop != 0 -%}


  .hp-sci-results-{{ section.id }}__text-position {
    transform: translate({{ section.settings.text_offset_x_desktop | default: 0 }}px, {{ section.settings.text_offset_y_desktop | default: 0 }}px);
  }
  {%- endif -%}

  @media screen and (max-width: 989px) {
    .hp-sci-results-{{ section.id }}__pillar,
    .hp-sci-results-{{ section.id }}__pillar--reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      min-height: 0;
    }

    .hp-sci-results-{{ section.id }}__panel {
      padding: 40px 24px 48px;
    }
    {%- if section.settings.text_offset_x_mobile != 0 or section.settings.text_offset_y_mobile != 0 -%}
  
    .hp-sci-results-{{ section.id }}__text-position {
      transform: translate({{ section.settings.text_offset_x_mobile | default: 0 }}px, {{ section.settings.text_offset_y_mobile | default: 0 }}px);
    }
    {%- endif -%}
}

  #shopify-section-{{ section.id }} .hp-sci .hp-sci-results-{{ section.id }}__pillar-title {
    font-size: {{ section.settings.heading_size_desktop | default: 52 }}px !important;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .hp-sci .hp-sci-results-{{ section.id }}__pillar-title {
      font-size: {{ section.settings.heading_size_mobile | default: 24 }}px !important;
    }
  }
  {% render 'hp-science-section-typography-styles', section: section %}

  /* Clean CSS variable override for eyebrow size */
  #shopify-section-{{ section.id }} {
    --hp-sci-sec-eyebrow-size: 21px !important;
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} {
      --hp-sci-sec-eyebrow-size: 20px !important;
    }
  }


  /* Force remove top gap even if set in typography settings */
  #shopify-section-{{ section.id }},
  .hp-sci-results-{{ section.id }} {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  /* Dark pillar panels only — must come after typography (which sets section body color).
     Triple-ID specificity to guarantee override of typography snippet's body-color rule. */
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__pillar-num"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__stat-label"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__pillar-title"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__para"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__stat-value"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__footnote"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__closing"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__subtext"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__col-text"],
  #MainContent #shopify-section-{{ section.id }} .hp-sci [class*="__panel--dark"] [class*="__card-text"] {
    color: #ffffff !important;
  }
{%- endstyle -%}

<section class="hp-sci hp-sci-results-{{ section.id }}">
  <div class="hp-sci-results-{{ section.id }}__stack">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'pillar' -%}
            {%- liquid
              assign pillar_style = block.settings.panel_style | default: 'light'
              assign pillar_panel_bg = block.settings.panel_background
              if pillar_panel_bg == blank
                if pillar_style == 'dark'
                  assign pillar_panel_bg = '#0a0a0a'
                else
                  assign pillar_panel_bg = section.settings.panel_background
                endif
              endif
              assign pillar_accent = block.settings.accent_color
              if pillar_style == 'dark'
                if pillar_accent == blank or pillar_accent == '#008667'
                  assign pillar_accent = '#ffffff'
                endif
              elsif pillar_accent == blank
                assign pillar_accent = '#008667'
              endif
            -%}
            <article
              class="hp-sci-results-{{ section.id }}__pillar{% if pillar_style == 'dark' %} hp-sci-results-{{ section.id }}__pillar--dark{% endif %}{% if block.settings.equal_columns %} hp-sci-results-{{ section.id }}__pillar--equal{% endif %}{% if block.settings.reverse_layout %} hp-sci-results-{{ section.id }}__pillar--reverse{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="hp-sci-results-{{ section.id }}__media">
                {% render 'hp-science-media',
                  image: block.settings.image,
                  video: block.settings.video,
                  animation_url: block.settings.animation_url,
                  show_placeholder: block.settings.show_media_placeholder,
                  placeholder_label: block.settings.placeholder_label,
                  min_height: section.settings.media_min_height_desktop,
                  aspect_ratio: ''
                %}
              </div>

              <div class="hp-sci-results-{{ section.id }}__panel{% if pillar_style == 'dark' %} hp-sci-results-{{ section.id }}__panel--dark{% endif %}" style="background: {{ pillar_panel_bg }};{% if block.settings.panel_text_color != blank %} color: {{ block.settings.panel_text_color }};{% endif %}">
                {%- if block.settings.pillar_number != blank -%}
                  <p class="hp-sci-results-{{ section.id }}__pillar-num"{% if pillar_style == 'dark' %} style="color: #ffffff !important;"{% endif %}>{{ block.settings.pillar_number }}</p>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="hp-sci-results-{{ section.id }}__pillar-title" style="color: {{ pillar_accent }};">{{ block.settings.title }}</h3>
                {%- endif -%}

                {%- if block.settings.paragraph_1 != blank -%}
                  <p class="hp-sci-results-{{ section.id }}__para"{% if pillar_style == 'dark' %} style="color: #ffffff !important;"{% endif %}>{{ block.settings.paragraph_1 }}</p>
                {%- endif -%}

                {%- if block.settings.show_divider -%}
                  <hr class="hp-sci-results-{{ section.id }}__rule" aria-hidden="true">
                {%- endif -%}

                {%- if block.settings.paragraph_2 != blank -%}
                  <p class="hp-sci-results-{{ section.id }}__para"{% if pillar_style == 'dark' %} style="color: #ffffff !important;"{% endif %}>{{ block.settings.paragraph_2 }}</p>
                {%- endif -%}

                {%- if block.settings.stat_value != blank or block.settings.stat_label != blank -%}
                  <div class="hp-sci-results-{{ section.id }}__stat-wrap">
                    {%- if block.settings.stat_value != blank -%}
                      <p class="hp-sci-results-{{ section.id }}__stat-value" style="color: {{ pillar_accent }};">{{ block.settings.stat_value }}</p>
                    {%- endif -%}
                    {%- if block.settings.stat_label != blank -%}
                      <p class="hp-sci-results-{{ section.id }}__stat-label"{% if pillar_style == 'dark' %} style="color: #ffffff !important;"{% endif %}>{{ block.settings.stat_label }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.footnote != blank -%}
                  <p class="hp-sci-results-{{ section.id }}__footnote"{% if pillar_style == 'dark' %} style="color: #ffffff !important;"{% endif %}>{{ block.settings.footnote }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {% render 'hp-science-pillar-default', section_id: section.id, panel_bg: section.settings.panel_background, accent: '#008667', num_color: section.settings.pillar_num_color, footnote_color: section.settings.footnote_color %}
        {% render 'hp-science-pillar-recovery-default', section_id: section.id %}
        {% render 'hp-science-pillar-structure-default', section_id: section.id, panel_bg: section.settings.panel_background, num_color: section.settings.pillar_num_color, footnote_color: section.settings.footnote_color %}
        {% render 'hp-science-pillar-hydration-default', section_id: section.id, panel_bg: section.settings.panel_background, num_color: section.settings.pillar_num_color, footnote_color: section.settings.footnote_color %}
      {%- endif -%}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const statObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target;
          if (el.dataset.animated) return;
          el.dataset.animated = 'true';
          
          const text = el.textContent.trim();
          const match = text.match(/^([^0-9.-]*)([0-9,.]+)(.*)$/);
          if (match) {
            const prefix = match[1];
            const numberStr = match[2].replace(/,/g, '');
            const suffix = match[3];
            const targetNum = parseFloat(numberStr);
            if (isNaN(targetNum)) return;
            const isFloat = numberStr.includes('.');
            const decimals = isFloat ? numberStr.split('.')[1].length : 0;
            
            const duration = 2000;
            const startTime = performance.now();
            
            const animate = (currentTime) => {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              
              const easeOutQuart = 1 - Math.pow(1 - progress, 4);
              const currentNum = targetNum * easeOutQuart;
              
              el.textContent = prefix + currentNum.toFixed(decimals) + suffix;
              
              if (progress < 1) {
                requestAnimationFrame(animate);
              } else {
                el.textContent = text;
              }
            };
            
            requestAnimationFrame(animate);
          }
        }
      });
    }, { threshold: 0.2 });
    
    document.querySelectorAll('.hp-sci-results-{{ section.id }}__stat-value').forEach(el => statObserver.observe(el));
  });
</script>

{% schema %}
{
  "name": "Science \u2014 Results pillars",
  "tag": "section",
  "class": "hp-science-section",
  "settings": [
    {
      "type": "header",
      "content": "Text position"
