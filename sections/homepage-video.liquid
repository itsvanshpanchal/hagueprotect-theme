<div class="homepage-video-wrapper">
  {% if section.settings.video != blank %}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'homepage-video-element' }}
  {% else %}
    <div class="placeholder-video">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}
</div>

<style>
  .homepage-video-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    /* Optional: add background color if the video doesn't perfectly match the screen aspect ratio */
    background-color: transparent; 
  }

  .homepage-video-element {
    width: 100%;
    max-width: 100%;
    height: auto;
    /* object-fit: contain ensures the video scales to fit without cutting off any parts */
    object-fit: contain; 
    display: block;
  }
  
  .placeholder-video {
    width: 100%;
    background: #f4f4f4;
  }
  
  .placeholder-video svg {
    width: 100%;
    height: auto;
    max-height: 600px;
  }
  
  /* Mobile-specific optimizations */
  @media screen and (max-width: 768px) {
    .homepage-video-wrapper {
      width: 100%;
      padding: 0;
      margin: 0;
      display: block;
      line-height: 0;
      font-size: 0;
    }
    .homepage-video-element {
      width: 100vw;
      max-width: 100%;
      height: auto !important;
      object-fit: contain !important;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Select the video element
    const video = document.querySelector('.homepage-video-wrapper .homepage-video-element');
    
    if (video) {
      // Ensure playsinline is present for iOS autoplay
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');

      // Create an intersection observer
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // When the video comes into view, try to turn audio ON
            video.muted = false;
            
            // Force play and catch if browser blocks unmuted autoplay
            let playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch(error => {
                // If browser blocks unmuted autoplay, mute it and play so it doesn't freeze
                video.muted = true;
                video.play();
              });
            }
          } else {
            // When it scrolls out of view, turn audio OFF and pause
            video.muted = true;
            video.pause();
          }
        });
      }, {
        threshold: 0.5 // Adjust this value to trigger earlier or later (0.5 means 50% visible)
      });
      
      // Start observing the video element
      observer.observe(video);
    }
  });
</script>

{% schema %}
{
  "name": "Homepage Video",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Upload Video",
      "info": "Upload a video directly to Shopify. It will cover the section without cropping."
    }
  ],
  "presets": [
    {
      "name": "Homepage Video"
    }
  ]
}
{% endschema %}
