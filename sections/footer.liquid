{%- style -%}
  {% render 'section-typography-vars', section: section %}

  .footer-wrapper {
    background-color: #f7f7f7 !important;
    color: #333333 !important;
    padding-top: clamp(64px, 8vw, 120px);
    padding-bottom: clamp(32px, 4vw, 48px);
    position: relative;
    overflow: hidden;
    font-family: var(--font-family-sans);
  }

  .footer-wrapper .container {
    position: relative;
    z-index: 10;
  }

  /* Grid Layout */
  .footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: 60px;
  }

  .footer-left-area {
    display: flex;
    gap: clamp(32px, 5vw, 80px);
    flex-wrap: wrap;
    flex: 1;
  }

  .footer-right-area {
    width: 320px;
    flex-shrink: 0;
    position: relative;
  }

  @media screen and (max-width: 991px) {
    .footer-grid {
      flex-direction: column;
    }
    .footer-left-area {
      width: 100%;
    }
    .footer-right-area {
      width: 100%;
      display: flex;
      justify-content: center;
      margin-top: 40px;
    }
  }

  /* Columns */
  .footer-col-menu {
    display: flex;
    flex-direction: column;
  }

  .footer__title {
    font-family: var(--font-family-sans) !important;
    font-size: var(--body-font-size, 15px) !important;
    font-weight: 700 !important;
    color: #111111 !important;
    margin-bottom: 16px;
    letter-spacing: 0;
    text-transform: none;
  }

  .footer__menu {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__link,
  .footer__link-text {
    font-family: var(--font-family-sans) !important;
    font-size: var(--body-font-size, 13px) !important;
    font-weight: 400 !important;
    color: #555555 !important;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__link:hover {
    color: #111111 !important;
  }

  /* Social Icons */
  .footer__socials {
    display: flex;
    gap: 12px;
    margin-top: 8px;
  }

  .footer__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: #333333;
    transition: opacity 0.2s;
  }

  .footer__social-icon:hover {
    opacity: 0.7;
  }

  /* Newsletter Diamond */
  .footer__newsletter-wrapper {
    position: absolute;
    top: -240px;
    right: 0;
  }

  .footer__newsletter-diamond {
    width: 360px;
    height: 360px;
    background: #ffffff;
    transform: rotate(45deg);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
  }

  .footer__newsletter-diamond-content {
    transform: rotate(-45deg);
    width: 260px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer__newsletter-diamond-content .footer__title {
    margin-bottom: 8px;
    text-align: center;
  }

  .footer__newsletter-desc {
    font-family: var(--font-family-sans) !important;
    font-size: 13px !important;
    color: #666666 !important;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .footer__form {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0;
  }

  .footer__input {
    width: 100%;
    font-family: var(--font-family-sans);
    font-size: 13px;
    padding: 12px 16px;
    border: 1px solid #333333;
    background: transparent;
    color: #333333;
    outline: none;
    text-align: left;
    margin-bottom: 10px;
  }

  .footer__form-btn {
    width: 100%;
    padding: 14px;
    background-color: #222222;
    color: #ffffff;
    border: none;
    cursor: pointer;
    font-family: var(--font-family-sans);
    font-weight: 700;
    font-size: 13px;
    transition: background-color 0.2s;
  }

  .footer__form-btn:hover {
    background-color: #000000;
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 48px;
    font-family: var(--font-family-sans);
    font-size: 12px;
    color: #555555 !important;
    flex-wrap: wrap;
    gap: 20px;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-bottom-links a {
    color: #555555;
    text-decoration: none;
  }

  .footer-bottom-links a:hover {
    color: #111111;
  }

  .footer-payment-icons {
    display: flex;
    gap: 8px;
  }

  /* Decorative Flower */
  @keyframes rotate-flower-footer {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .footer__decorative-flower {
    position: absolute;
    bottom: -150px;
    right: -150px;
    width: 450px;
    height: 450px;
    pointer-events: none;
    z-index: 0;
    color: rgba(0, 0, 0, 0.03);
    animation: rotate-flower-footer 40s linear infinite;
  }

  @media screen and (max-width: 989px) {
    .footer-wrapper {
      padding-top: 64px;
    }
    
    .footer__newsletter-wrapper {
      position: relative;
      top: 0;
      display: flex;
      justify-content: center;
      width: 100%;
    }
    
    .footer__newsletter-diamond {
      width: 100%;
      max-width: 320px;
      height: 320px;
      transform: none;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }
    
    .footer__newsletter-diamond-content {
      transform: none;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }
  }

{%- endstyle -%}

