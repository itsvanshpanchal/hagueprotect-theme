{%- liquid
  assign occasions_section_id = 'corp-occasions-' | append: section.id
-%}
{%- render 'corporate-gifting-occasions-grid',
  heading_line1: section.settings.heading_line1,
  heading_line2: section.settings.heading_line2,
  blocks: section.blocks,
  section_id: occasions_section_id
-%}

{%- if template == 'search.corporate-gifting' or template.suffix == 'corporate' or page.handle == 'corporate' -%}
  {%- assign coverflow_fallback_id = 'corp-coverflow-fallback-' | append: section.id -%}
  {%- render 'corporate-gifting-coverflow-fallback', fallback_id: coverflow_fallback_id -%}
  <script>
    (function () {
      var root = document.getElementById('{{ coverflow_fallback_id }}');
      if (!root) return;
      if (document.querySelector('[data-corp-coverflow-section="true"]')) {
        root.remove();
        return;
      }
      root.hidden = false;
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Corporate Occasions",
  "enabled_on": {
    "templates": [
      "search.corporate-gifting",
      "page.corporate"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "Gifts people keep."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "Not re-gift."
    }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Occasion"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Optional. Shown below the title (e.g. celebration types)."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Corporate Occasions",
      "blocks": [
        {
          "type": "occasion",
          "settings": {
            "title": "Corporate"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Weddings"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Celebrations",
            "caption": "(Birthday, Housewarming, Anniversary)"
          }
        },
        {
          "type": "occasion",
          "settings": {
            "title": "Collaborations"
          }
        }
      ]
    }
  ]
}
{% endschema %}
