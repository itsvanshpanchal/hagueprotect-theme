<!DOCTYPE html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
	<!-- Added by APP PLAZA -->
	{% include 'app-plaza' %}
	<!-- /Added by APP PLAZA -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script>
      (function () {
        var lock = false;
        function setMobileVh(force) {
          if (lock && !force) return;
          var h = Math.round(window.innerHeight || document.documentElement.clientHeight || 0);
          if (h < 320) return;
          document.documentElement.style.setProperty('--hp-mobile-vh', h + 'px');
          document.documentElement.style.setProperty('--hp-mobile-vh-num', String(h));
          lock = true;
        }
        setMobileVh(true);
        if (window.matchMedia('(max-width: 749px)').matches) {
          document.documentElement.classList.add('hp-float-mobile', 'hp-float-native-scroll');
        }
        window.addEventListener('orientationchange', function () {
          lock = false;
          setTimeout(function () { setMobileVh(true); }, 120);
        }, { passive: true });
        window.hpSyncMobileVh = setMobileVh;
      })();
    </script>
    {%- endif -%}
    <meta name="theme-color" content="#FF2B2B">
    
    <!-- Security Headers -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-Frame-Options" content="SAMEORIGIN">
    <link rel="canonical" href="{{ canonical_url }}">
    
    {%- capture seo_title -%}
      {%- if template == 'search.how-to-use' -%}
        How to Use
      {%- elsif template == 'search.hague' -%}
        Skin Longevity Science
      {%- else -%}
        {{ page_title }}
      {%- endif -%}
      {%- if current_tags %} – tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
    {%- endcapture -%}
    <title>{{ seo_title | strip | strip_html | escape | truncate: 55, "" }}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | strip_html | strip | escape | truncate: 120, "" }}">
    {%- else -%}
      <meta name="description" content="Premium sneaker care solutions for professional-grade cleaning, protection, and restoration.">
    {%- endif -%}

    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-hp.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-hp.png' | asset_url }}">
    <link rel="shortcut icon" type="image/png" href="{{ 'favicon-hp.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'favicon-hp.png' | asset_url }}">

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">
    <link rel="alternate" hreflang="{{ request.locale.iso_code | downcase }}" href="{{ canonical_url }}">
    {%- if request.locale.iso_code != 'en' -%}
      <link rel="alternate" hreflang="en" href="{{ canonical_url }}">
    {%- endif -%}

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "http://schema.org",
        "@type": "Organization",
        "name": "{{ shop.name }}",
        "url": "{{ shop.url }}",
        "logo": "{{ 'favicon-hp.png' | asset_url }}",
        "sameAs": [
          "{{ settings.social_facebook_link }}",
          "{{ settings.social_twitter_link }}",
          "https://www.instagram.com/hagueprotect/",
          "https://www.youtube.com/@HagueProtect"
        ]
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "http://schema.org",
        "@type": "WebSite",
        "name": "{{ shop.name }}",
        "url": "{{ shop.url }}"
      }
    </script>

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json">
      {
        "@context": "http://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ shop.url }}"
          }
          {%- if request.page_type == 'product' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": "{{ product.title | escape }}",
              "item": "{{ shop.url }}{{ product.url }}"
            }
          {%- elsif request.page_type == 'collection' and collection.handle -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": "{{ collection.title | escape }}",
              "item": "{{ shop.url }}{{ collection.url }}"
            }
          {%- elsif request.page_type == 'page' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": "{{ page.title | escape }}",
              "item": "{{ shop.url }}{{ page.url }}"
            }
          {%- endif -%}
        ]
      }
    </script>

    {%- if request.page_type == 'product' -%}
      <script type="application/ld+json">
        {
          "@context": "http://schema.org",
          "@type": "Product",
          "name": "{{ product.title | escape }}",
          "url": "{{ shop.url }}{{ product.url }}",
          {%- if product.featured_media -%}
            "image": [
              "https:{{ product.featured_media | image_url: width: 1920 }}"
            ],
          {%- endif -%}
          "description": "{{ product.description | strip_html | escape | truncate: 150 }}",
          "sku": "{{ product.selected_or_first_available_variant.sku }}",
          "brand": {
            "@type": "Brand",
            "name": "{{ product.vendor | escape }}"
          },
          "offers": {
            "@type": "Offer",
            "url": "{{ shop.url }}{{ product.url }}",
            "priceCurrency": "{{ cart.currency.iso_code }}",
            "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | replace: ',', '.' }}",
            "availability": "http://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}"
          }
        }
      </script>
    {%- endif -%}

    <!-- Performance Resource Hints -->
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton:wght@400&family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800;900&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Oswald:wght@300;400;500;600;700&family=Poppins:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
    {% render 'hp-custom-font-faces' %}
    <link rel="preload" href="{{ 'bahnschrift-regular.otf' | asset_url }}" as="font" type="font/otf" crossorigin>
    <link rel="preload" href="{{ 'bahnschrift-bold.otf' | asset_url }}" as="font" type="font/otf" crossorigin>
    <link rel="preload" href="{{ 'inter-18pt-regular.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="{{ 'inter-18pt-bold.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>
    <link rel="preload" href="{{ 'calisto-mt-regular.ttf' | asset_url }}" as="font" type="font/ttf" crossorigin>
