  </head>
  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    {% section 'cart-drawer' %}
    
    <style>
      .template-index #hp-header-group,
      .template-collection-vanrosector #hp-header-group {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 2000;
        transform: translateY(-100%);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .template-index.is-scrolled #hp-header-group,
      .template-collection-vanrosector.is-scrolled #hp-header-group {
        transform: translateY(0);
      }
      .template-index #hp-header-group .header-wrapper,
      .template-collection-vanrosector #hp-header-group .header-wrapper {
        position: relative !important;
      }
    </style>

    <div id="hp-header-group">
      {% section 'announcement-bar' %}
      {% section 'header' %}
    </div>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'heading-typewriter.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'corporate-gifting.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'hp-story-banner.js' | asset_url }}" defer="defer"></script>
    {%- if template.name == 'index' -%}
      <script>
        window.hpMobileFloatConfig = {
          enabled: {{ settings.mobile_float_snap_enable | default: false | json }},
          swipePx: {{ settings.mobile_float_swipe_px | default: 52 }},
          swipeVelocity: 0.38,
          coolMs: {{ settings.mobile_float_cool_ms | default: 520 }},
          idleMs: 220,
          lockNativeScroll: {{ settings.mobile_float_lock_scroll | default: false | json }}
        };
      </script>
      <script src="{{ 'hp-floating-cards.js' | asset_url | append: '&v=2' }}" defer="defer"></script>
    {%- endif -%}
    {%- if template.name == 'product' -%}
      <script src="{{ 'hp-hide-bulk-offers.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    <script src="{{ 'video-lazyload.js' | asset_url }}" defer="defer"></script>
    {%- if template.name == 'search' and template.suffix == 'business' -%}
      <script src="{{ 'business-page.js' | asset_url }}" defer="defer"></script>
    {%- elsif template.name == 'page' and page.handle == 'contact' -%}
      <script src="{{ 'business-page.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {% render 'theme-login-overlay' %}
    {% render 'theme-dashboard-overlay' %}

    <script>
      function checkView() {
        const hash = window.location.hash;
        const loginView = document.getElementById('ThemeLoginView');
        const dashboardView = document.getElementById('ThemeDashboardView');
        const greeting = document.getElementById('ThemeUserGreeting');

        if (hash === '#login') {
          if (loginView) loginView.style.display = 'block';
          if (dashboardView) dashboardView.style.display = 'none';
          document.body.style.overflow = 'hidden';
        } else if (hash === '#dashboard') {
          if (loginView) loginView.style.display = 'none';
          if (dashboardView) dashboardView.style.display = 'block';
          document.body.style.overflow = 'hidden';
          
          const email = localStorage.getItem('customer_email');
          if (email && greeting) {
            const parts = email.split('@');
            greeting.textContent = parts[0].toUpperCase();
          }
        } else {
          if (loginView) loginView.style.display = 'none';
          if (dashboardView) dashboardView.style.display = 'none';
          document.body.style.overflow = '';
        }
      }

      function handleThemeLogin(e) {
        e.preventDefault();
        const btn = document.getElementById('ThemeSubmitBtn');
        const emailInput = document.getElementById('ThemeLoginEmail');
        if (!btn || !emailInput) return;

        const email = emailInput.value;
        btn.disabled = true;
        btn.textContent = 'Signing in...';

        localStorage.setItem('customer_email', email);

        setTimeout(() => {
          btn.disabled = false;
          btn.innerHTML = 'Sign In <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>';
          window.location.hash = '#dashboard';
          checkView();
        }, 800);
      }

      function handleGoogleSignIn() {
        const btn = document.getElementById('GoogleSignInBtn');
        if (!btn) return;
        btn.disabled = true;
        btn.innerHTML = '<span style="color:#666;">Signing in...</span>';

        localStorage.setItem('customer_email', 'google.user@gmail.com');

        setTimeout(() => {
          btn.disabled = false;
          window.location.hash = '#dashboard';
          checkView();
        }, 900);
      }

      window.addEventListener('hashchange', checkView);
      window.addEventListener('load', checkView);
    </script>

    {% render 'floating-contact' %}
    <script>
      (function() {
        if (document.body.classList.contains('template-index') || document.body.classList.contains('template-collection-vanrosector')) {
          var onScroll = function() {
            if (window.scrollY > window.innerHeight * 0.75) {
              document.body.classList.add('is-scrolled');
            } else {
              document.body.classList.remove('is-scrolled');
            }
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      })();
    </script>
  </body>
</html>
