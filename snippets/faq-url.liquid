{%- comment -%}
  Canonical FAQ URL for Hague Protect.
  Prefers a real Online Store page (handle: faq or faqs) with the faq template.
  Falls back to the search alternate template that ships with this theme.
{%- endcomment -%}
{%- liquid
  if pages['faq'] != blank
    echo pages['faq'].url
  elsif pages['faqs'] != blank
    echo pages['faqs'].url
  else
    echo routes.search_url | append: '?view=faq'
  endif
-%}
