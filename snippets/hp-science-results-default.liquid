{%- comment -%}
  Default results grid tiles when no blocks are configured.
  Accepts: section_id
{%- endcomment -%}

<div class="hp-sci-results-{{ section_id }}__tile">
  {% render 'hp-science-media', show_placeholder: true, placeholder_label: 'Upload vitality image or animation', min_height: 280 %}
</div>
<div class="hp-sci-results-{{ section_id }}__tile">
  <div class="hp-sci-results-{{ section_id }}__stat" style="background:#ffffff;color:#111111;">
    <p class="hp-sci-results-{{ section_id }}__label" style="color:#2d8a4e;">VITALITY</p>
    <p class="hp-sci-results-{{ section_id }}__value" style="color:#2d8a4e;">+120%</p>
    <p class="hp-sci-results-{{ section_id }}__desc">Measured improvement in skin vitality markers over 75 days.</p>
  </div>
</div>
