{%- comment -%}
  Page-wide typography variables for Science Longevity templates.
  Fixed font sizes/weights — spacing is controlled per section in the theme editor.
{%- endcomment -%}
{% style %}
  body.template-page-science-longevity,
  body.template-search-science-longevity {
    --hp-sci-lead-heading-size: 52px;
    --hp-sci-base-heading-size: 52px;
    --hp-sci-subheading-size: 52px;
    --hp-sci-body-size: 23px;
    --hp-sci-eyebrow-size: 19px;
    --hp-sci-stat-number-size: 52px;
    --hp-sci-heading-weight: 300;
    --hp-sci-subheading-weight: 300;
    --hp-sci-eyebrow-weight: 300;
    --hp-sci-body-weight: 300;
    --hp-sci-heading-style: normal;
    --hp-sci-heading-letter-spacing: -0.02em;
    --hp-sci-eyebrow-letter-spacing: 0.12em;
    --hp-sci-lead-heading-line-height: 1.12;
    --hp-sci-base-heading-line-height: 1.12;
    --hp-sci-body-line-height: 1.55;
  }

  @media screen and (max-width: 989px) {
    body.template-page-science-longevity,
    body.template-search-science-longevity {
      --hp-sci-lead-heading-size: 24px;
      --hp-sci-base-heading-size: 24px;
      --hp-sci-subheading-size: 24px;
      --hp-sci-body-size: 17px;
      --hp-sci-eyebrow-size: 12px;
      --hp-sci-stat-number-size: 24px;
    }
  }
{% endstyle %}
