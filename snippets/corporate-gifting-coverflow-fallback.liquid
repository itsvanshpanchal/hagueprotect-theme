{%- liquid
  assign cf_id = fallback_id | default: 'corp-coverflow-fallback'
  assign cf_carousel_id = cf_id | append: '-carousel'
-%}

<div id="{{ cf_id }}" class="corp-coverflow-fallback-root" data-corp-coverflow-fallback="true" hidden>
  {%- render 'corporate-gifting-coverflow-carousel',
    carousel_id: cf_carousel_id,
    heading: 'The Gifts that outlast the occasion',
    spacing: 200,
    start_index: 2,
    autoplay: false,
    card_width: 200,
    is_standalone: false
  -%}
</div>
