{%- liquid
  assign site_max_width = settings.site_max_width | default: 1600
  assign homepage_label_color = settings.homepage_label_color | default: '#2563eb'
  assign section_heading_align = settings.section_heading_align | default: 'left'
  assign section_heading_align_mobile = settings.section_heading_align_mobile | default: section_heading_align | default: 'left'
  assign heading_line2_color = settings.heading_line2_color | default: '#6b6b6b'
  assign eyebrow_title_spacing_desktop = settings.eyebrow_title_spacing_desktop | default: 12
  assign eyebrow_title_spacing_mobile = settings.eyebrow_title_spacing_mobile | default: 10
  assign heading_subheading_spacing_desktop = settings.heading_subheading_spacing_desktop | default: 12
  assign heading_subheading_spacing_mobile = settings.heading_subheading_spacing_mobile | default: 10

  if section_heading_align == 'center'
    assign section_heading_items = 'center'
    assign section_heading_margin_left = 'auto'
    assign section_heading_margin_right = 'auto'
  elsif section_heading_align == 'right'
    assign section_heading_items = 'flex-end'
    assign section_heading_margin_left = 'auto'
    assign section_heading_margin_right = '0'
  else
    assign section_heading_items = 'flex-start'
    assign section_heading_margin_left = '0'
    assign section_heading_margin_right = 'auto'
  endif

  if section_heading_align_mobile == 'center'
    assign section_heading_items_mobile = 'center'
    assign section_heading_margin_left_mobile = 'auto'
    assign section_heading_margin_right_mobile = 'auto'
  elsif section_heading_align_mobile == 'right'
    assign section_heading_items_mobile = 'flex-end'
    assign section_heading_margin_left_mobile = 'auto'
    assign section_heading_margin_right_mobile = '0'
  else
    assign section_heading_items_mobile = 'flex-start'
    assign section_heading_margin_left_mobile = '0'
    assign section_heading_margin_right_mobile = 'auto'
  endif
-%}
<style>
  :root {
    --site-max-width: {{ site_max_width }}px;
    --section-heading-align: {{ section_heading_align }};
    --section-heading-items: {{ section_heading_items }};
    --section-heading-margin-left: {{ section_heading_margin_left }};
    --section-heading-margin-right: {{ section_heading_margin_right }};
    --section-heading-align-mobile: {{ section_heading_align_mobile }};
    --section-heading-items-mobile: {{ section_heading_items_mobile }};
    --section-heading-margin-left-mobile: {{ section_heading_margin_left_mobile }};
    --section-heading-margin-right-mobile: {{ section_heading_margin_right_mobile }};
    --section-heading-line2-color: {{ heading_line2_color }};
    --section-label-to-title-gap: {{ eyebrow_title_spacing_desktop }}px;
    --section-label-margin-bottom: {{ eyebrow_title_spacing_desktop }}px;
    --section-subheading-spacing-top: {{ heading_subheading_spacing_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    :root {
      --section-heading-align: {{ section_heading_align_mobile }};
      --section-heading-items: {{ section_heading_items_mobile }};
      --section-heading-margin-left: {{ section_heading_margin_left_mobile }};
      --section-heading-margin-right: {{ section_heading_margin_right_mobile }};
    }
  }

  @media screen and (max-width: 989px) {
    :root {
      --section-label-to-title-gap: {{ eyebrow_title_spacing_mobile }}px;
      --section-label-margin-bottom: {{ eyebrow_title_spacing_mobile }}px;
      --section-subheading-spacing-top: {{ heading_subheading_spacing_mobile }}px;
    }
  }

  .template-index {
    --section-label-color: {{ homepage_label_color }};
  }

  /*
    Homepage: ONE content column for every section heading + subheading.
    Same max-width, same gutter, same left edge on every section.
  */
  body.template-index {
    --homepage-section-gutter: 48px;
    --homepage-section-gutter-right: 48px;
    --homepage-text-inset: var(--homepage-section-gutter);
    /* Content is anchored flush-left with the gutter on every screen size,
       including big monitors — never centered. */
    --homepage-edge: var(--homepage-section-gutter);
    --homepage-edge-right: var(--homepage-section-gutter-right);
  }

  @media screen and (max-width: 989px) {
    body.template-index {
      --homepage-section-gutter: 32px;
      --homepage-section-gutter-right: 32px;
    }
  }

  /* Full width, flush-left with the gutter on big monitors — content stays on
     the left, every section shares the same left edge (one vertical line). */
  body.template-index #MainContent .bs-coverflow__container,
  body.template-index #MainContent .trending-social-section .container,
  body.template-index #MainContent .fc-container,
  body.template-index #MainContent .feature-grid__container,
  body.template-index #MainContent .promo-banner__container,
  body.template-index #MainContent .hp-fam-sec__container,
  body.template-index #MainContent .hp-dna__container,
  body.template-index #MainContent .comm-container,
  body.template-index #MainContent .mat-container,
  body.template-index #MainContent .fb__header,
  body.template-index #MainContent .fb__grid,
  body.template-index #MainContent .brandsel__inner,
  body.template-index #MainContent [class*="featured-brands-"] .fb__header,
  body.template-index #MainContent [class*="featured-brands-"] .fb__grid {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: var(--homepage-section-gutter) !important;
    padding-right: var(--homepage-section-gutter-right) !important;
    box-sizing: border-box !important;
  }

  /* Featured brands section padding was doubling the gutter */
  body.template-index [class*="featured-brands-"] {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  /* Headers inside the shared column: no extra inset / centering */
  body.template-index .bs-coverflow__header,
  body.template-index .trending-social-header,
  body.template-index .fc-header,
  body.template-index .mat-left,
  body.template-index .feature-grid__header,
  body.template-index .promo-banner__content,
  body.template-index .hp-dna__heading,
  body.template-index .hp-fam-sec__heading,
  body.template-index .comm-top,
  body.template-index .brandsel__head,
  body.template-index .fb__header .section-heading-stack,
  body.template-index .section-heading-stack {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    text-align: left !important;
    align-items: flex-start !important;
  }

  /* fb__header is itself a column box — keep its gutter, zero nested stack */
  body.template-index .fb__header {
    text-align: left !important;
  }

  body.template-index .fb__header.section-heading-stack {
    max-width: none !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: var(--homepage-section-gutter) !important;
    padding-right: var(--homepage-section-gutter-right) !important;
  }

  /* Heading + subheading text: flush left, same edge */
  body.template-index .bs-coverflow__heading,
  body.template-index .bs-coverflow__eyebrow,
  body.template-index .fb__title,
  body.template-index .fb__eyebrow,
  body.template-index .fb__subtitle,
  body.template-index .trending-social__heading,
  body.template-index .trending-social__eyebrow,
  body.template-index .mat-headline,
  body.template-index .mat-eyebrow,
  body.template-index .mat-desc,
  body.template-index .fc-heading,
  body.template-index .fc-subtitle,
  body.template-index .feature-grid__heading,
  body.template-index .feature-grid__eyebrow,
  body.template-index .promo-banner__heading,
  body.template-index .promo-banner__eyebrow,
  body.template-index .hp-fam-sec__heading,
  body.template-index .hp-dna__heading,
  body.template-index .comm-headline,
  body.template-index .comm-eyebrow,
  body.template-index .comm-desc,
  body.template-index .brandsel__heading,
  body.template-index .brandsel__eyebrow,
  body.template-index .brandsel__sub,
  body.template-index .story-banner__heading,
  body.template-index .story-banner__subheading,
  body.template-index .story-banner__eyebrow,
  body.template-index .story-banner__paragraph,
  body.template-index [class*="ai-story-banner-heading-"],
  body.template-index [class*="ai-story-banner-subheading-"],
  body.template-index .hero-fullscreen__heading,
  body.template-index .hero-fullscreen__subheading,
  body.template-index .hero-fullscreen__eyebrow,
  body.template-index .hp-heading-line,
  body.template-index .hero-heading-line {
    text-align: left !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  body.template-index .hp-heading-line,
  body.template-index .hero-heading-line {
    display: block !important;
    width: 100% !important;
  }

  body.template-index .fc-header .fc-subtitle {
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  /* Hero: text starts on the same column edge as every other section */
  body.template-index .hero-fullscreen__content {
    left: var(--homepage-edge) !important;
    right: auto !important;
    transform: none !important;
    width: calc(100% - var(--homepage-edge) - var(--homepage-edge-right)) !important;
    max-width: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    text-align: left !important;
    align-items: flex-start !important;
  }

  @media screen and (max-width: 989px) {
    body.template-index .hero-fullscreen__content {
      left: var(--homepage-edge) !important;
      width: calc(100% - var(--homepage-edge) - var(--homepage-edge-right)) !important;
    }
  }

  /* Story / AI banners: text starts on the same column edge */
  body.template-index .story-banner__content {
    left: 0 !important;
    right: 0 !important;
    padding-left: var(--homepage-edge) !important;
    padding-right: var(--homepage-edge-right) !important;
    align-items: flex-start !important;
    text-align: left !important;
    box-sizing: border-box !important;
  }

  body.template-index [class*="ai-story-banner-content-"] {
    left: var(--homepage-edge) !important;
    margin-left: 0 !important;
    padding-left: 0 !important;
    text-align: left !important;
    box-sizing: border-box !important;
  }

  /* Kill forced center stacks on homepage */
  body.template-index .section-heading-stack--center,
  body.template-index .section-heading-stack--center > * {
    text-align: left !important;
    align-items: flex-start !important;
  }

  @media screen and (max-width: 767px) {
    body.template-index {
      --homepage-section-gutter: 28px;
      --homepage-section-gutter-right: 28px;
      --homepage-mobile-gutter: 28px;
      --homepage-edge: 28px;
      --homepage-edge-right: 28px;
    }

    body.template-index .fc-heading,
    body.template-index .fc-subtitle {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    /* One shared left/right inset for every homepage heading column */
    body.template-index #MainContent .bs-coverflow__container,
    body.template-index #MainContent .mat-container,
    body.template-index #MainContent .mat-left,
    body.template-index #MainContent .fc-container,
    body.template-index #MainContent .hp-fam-sec__container,
    body.template-index #MainContent .hp-dna__container,
    body.template-index #MainContent .comm-container,
    body.template-index #MainContent .trending-social-section .container,
    body.template-index #MainContent .feature-grid__container,
    body.template-index #MainContent .promo-banner__container,
    body.template-index #MainContent .fb__header,
    body.template-index #MainContent section[class*="split-cta-"] {
      padding-left: var(--homepage-section-gutter) !important;
      padding-right: var(--homepage-section-gutter-right) !important;
      box-sizing: border-box !important;
    }

    body.template-index #MainContent .story-banner__content {
      padding-left: var(--homepage-section-gutter) !important;
      padding-right: var(--homepage-section-gutter-right) !important;
    }

    /* Headings sit flush inside the shared column — no extra horizontal inset */
    body.template-index #MainContent .hp-dna__heading,
    body.template-index #MainContent .section-heading-stack,
    body.template-index #MainContent .hp-fam-sec__heading,
    body.template-index #MainContent .fc-header,
    body.template-index #MainContent .trending-social-header,
    body.template-index #MainContent .bs-coverflow__header,
    body.template-index #MainContent .comm-top,
    body.template-index #MainContent .mat-left .section-heading-stack,
    body.template-index #MainContent [class*="split-cta-"][class*="__copy"] {
      padding-left: 0 !important;
      padding-right: 0 !important;
      --section-text-offset-x: 0px !important;
      transform: translate(0, var(--section-text-offset-y, 0px)) !important;
    }
  }

  .template-index .hero-fullscreen__eyebrow,
  .template-index .hero-fullscreen__subheading,
  .template-index .fb__eyebrow,
  .template-index .bs-coverflow__eyebrow,
  .template-index .trending-social__eyebrow,
  .template-index .mat-eyebrow,
  .template-index .fc-subtitle,
  .template-index .story-banner__eyebrow,
  .template-index .feature-grid__eyebrow,
  .template-index .section-heading-stack__label,
  .template-index [class*="ai-story-banner-subheading-"] {
    color: {{ homepage_label_color }} !important;
  }

  /* Community eyebrow follows section text color (white on black), not blue label */
  .template-index .comm-eyebrow,
  .template-index .comm-headline,
  .template-index .comm-headline-number,
  .template-index .comm-headline-logo,
  .template-index .comm-desc {
    color: var(--comm-text-color, #ffffff) !important;
    -webkit-text-fill-color: var(--comm-text-color, #ffffff) !important;
  }

  /* Hero tagline stays white on the photo (same size/weight as BEST SELLERS) */
  .template-index .hero-fullscreen__subheading {
    color: #ffffff !important;
  }
</style>
