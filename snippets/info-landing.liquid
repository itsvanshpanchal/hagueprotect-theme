{%- liquid
  assign page_key = page_key | default: 'collabs'
  assign wa = settings.floating_whatsapp | default: '917009205008' | strip | replace: '+', '' | replace: ' ', '' | replace: '-', ''

  case page_key
    when 'collabs'
      assign eyebrow = 'Partnerships'
      assign title = 'Collabs'
      assign lead = 'Partner with Hague Protect on creator drops, retail activations, and co-branded care kits that put premium footwear first.'
      assign body_1_title = 'Who we work with'
      assign body_1 = 'Creators, athletes, boutiques, and lifestyle brands looking for a care partner that matches the quality of their product.'
      assign body_2_title = 'What we offer'
      assign body_2 = 'Co-branded kits, launch support, content assets, and flexible wholesale or white-label options built around your audience.'
      assign cta_label = 'Start a collab'
    when 'certified-corporation'
      assign eyebrow = 'Trust & Standards'
      assign title = 'Certified Corporation'
      assign lead = 'Hague Protect is built around accountable product standards — safer formulas, clear care guidance, and transparent customer support.'
      assign body_1_title = 'Our standard'
      assign body_1 = 'We design material-specific systems for leather, suede, nubuck, mesh, and canvas, with usage guidance that protects premium finishes.'
      assign body_2_title = 'Accountability'
      assign body_2 = 'From shipping and returns to product advice, our support team is here to stand behind every kit you order.'
      assign cta_label = 'Talk to support'
    when 'student-offer'
      assign eyebrow = 'Campus & Students'
      assign title = 'Student Offer'
      assign lead = 'Students get access to Hague Protect care essentials at a sharper entry point — keep your rotation clean through exams, travel, and weekend wear.'
      assign body_1_title = 'How it works'
      assign body_1 = 'Message us on WhatsApp with a valid student ID or campus email. Our team will share the current student kit offer and checkout guidance.'
      assign body_2_title = 'What you get'
      assign body_2 = 'Selected care kits and essentials designed for daily wear — easy to use, travel-friendly, and built for real-life dirt, not just studio photos.'
      assign cta_label = 'Claim student offer'
    else
      assign eyebrow = 'Hague Protect'
      assign title = 'Information'
      assign lead = 'Learn more about Hague Protect and how we can help.'
      assign body_1_title = 'Support'
      assign body_1 = 'Reach out for product advice, wholesale, or order help.'
      assign body_2_title = 'Shop'
      assign body_2 = 'Explore kits for leather, suede, fabric, and soles.'
      assign cta_label = 'Contact us'
  endcase

  capture contact_href
    render 'contact-url'
  endcapture
  assign contact_href = contact_href | strip
-%}

<section class="hp-info-page" style="font-family: var(--font-family-sans, 'Inter', sans-serif); background:#f7f7f8; padding: clamp(56px, 8vw, 96px) 20px; min-height: 70vh;">
  <div style="max-width: 920px; margin: 0 auto;">
    <p style="margin:0 0 10px; font-size:13px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#FF2B2B;">{{ eyebrow }}</p>
    <h1 style="margin:0 0 16px; font-family:'Bahnschrift', var(--font-family-heading), sans-serif; font-size:clamp(34px,5vw,52px); font-weight:400; letter-spacing:-0.02em; color:#111; line-height:1.08;">{{ title }}</h1>
    <p style="margin:0 0 40px; max-width:680px; font-size:clamp(15px,1.6vw,18px); line-height:1.55; color:#555;">{{ lead }}</p>

    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:20px; margin-bottom:40px;">
      <div style="background:#fff; border:1px solid rgba(0,0,0,0.08); border-radius:14px; padding:28px;">
        <h2 style="margin:0 0 10px; font-size:20px; font-weight:700; color:#111;">{{ body_1_title }}</h2>
        <p style="margin:0; font-size:15px; line-height:1.6; color:#555;">{{ body_1 }}</p>
      </div>
      <div style="background:#fff; border:1px solid rgba(0,0,0,0.08); border-radius:14px; padding:28px;">
        <h2 style="margin:0 0 10px; font-size:20px; font-weight:700; color:#111;">{{ body_2_title }}</h2>
        <p style="margin:0; font-size:15px; line-height:1.6; color:#555;">{{ body_2 }}</p>
      </div>
    </div>

    <div style="display:flex; flex-wrap:wrap; gap:12px;">
      {%- if wa != blank -%}
        <a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; justify-content:center; min-height:46px; padding:0 22px; border-radius:999px; background:#FF2B2B; color:#fff; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; text-decoration:none;">{{ cta_label }}</a>
      {%- endif -%}
      <a href="{{ contact_href }}" style="display:inline-flex; align-items:center; justify-content:center; min-height:46px; padding:0 22px; border-radius:999px; background:#111; color:#fff; font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; text-decoration:none;">Contact</a>
      <a href="/collections/all" style="display:inline-flex; align-items:center; justify-content:center; min-height:46px; padding:0 22px; border-radius:999px; background:transparent; color:#111; border:1px solid rgba(0,0,0,0.18); font-size:13px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; text-decoration:none;">Shop kits</a>
    </div>
  </div>
</section>
