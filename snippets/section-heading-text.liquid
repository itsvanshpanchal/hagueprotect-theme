{%- comment -%}
  Section heading text — sentence case + optional second line color.
  Optional accent_last_word: last word in script handwriting (inline, same line).
  Params: text, line2 (optional), line2_color (optional), accent_last_word (optional), accent_color (optional)
{%- endcomment -%}
{%- liquid
  assign line1 = text | strip
  assign line2_raw = line2 | default: '' | strip
  assign accent_last = accent_last_word | default: false

  if line2_raw == blank and line1 != blank
    assign tmp = line1 | replace: '<br />', '|||' | replace: '<br/>', '|||' | replace: '<br>', '|||'
    assign parts = tmp | split: '|||'
    if parts.size > 1
      assign line1 = parts[0] | strip
      assign line2_raw = parts[1] | strip
      assign accent_last = false
    endif
  endif

  assign line1_main = line1
  assign accent_word = ''

  if accent_last and line2_raw == blank and line1 != blank
    assign words = line1 | split: ' '
    if words.size > 1
      assign accent_raw = words | last
      assign main_count = words.size | minus: 1
      assign main_words = words | slice: 0, main_count
      assign line1_main = main_words | join: ' '

      comment
        Accent stays a SIBLING of the sentence-case line (not nested),
        so parent text-transform: lowercase cannot reshape it.
        Keep authored casing: MATERIAL stays MATERIAL, Care stays Care.
      endcomment
      assign accent_letters = accent_raw | replace: '.', '' | replace: '!', '' | replace: '?', '' | replace: ',', '' | replace: ';', ''
      assign accent_up = accent_letters | upcase
      assign accent_down = accent_letters | downcase
      if accent_letters == accent_up and accent_letters != blank
        assign accent_word = accent_raw | upcase
      elsif accent_letters == accent_down and accent_letters != blank
        assign accent_word = accent_raw | downcase | capitalize
      else
        assign accent_word = accent_raw
      endif
    endif
  endif

  assign c2 = line2_color | default: settings.heading_line2_color | default: '#6b6b6b'
  assign accent_c = accent_color | default: settings.heading_accent_color | default: '#c9a227'
-%}
{%- if line2_raw != blank -%}
  <span class="hp-heading-line hp-heading-line--1">{{ line1 }}</span><span class="hp-heading-line hp-heading-line--2" style="--section-heading-line2-color: {{ c2 }};">{{ line2_raw }}</span>
{%- elsif accent_word != blank -%}
  <span class="hp-heading-pair"><span class="hp-heading-line hp-heading-line--1">{{ line1_main }} </span><span class="hp-heading-accent" style="font-family:'Luthon Southard Script','Brush Script MT',cursive;color:{{ accent_c }};text-transform:none;-webkit-text-fill-color:{{ accent_c }};">{{ accent_word }}</span></span>
{%- else -%}
  <span class="hp-heading-line hp-heading-line--1">{{ line1 }}</span>
{%- endif -%}
