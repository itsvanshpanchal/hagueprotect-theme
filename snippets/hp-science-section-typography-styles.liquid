{%- comment -%}
  Science Longevity — fixed typography + spacing (do not vary per legacy section settings).
  Render once at the END of each section {%- style -%} block.
{%- endcomment -%}
{%- liquid
  assign sec = '#shopify-section-' | append: section.id

  assign inter_stack = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
  assign dg_stack = "'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif"

  assign typo_body_color = section.settings.sci_typo_body_color | strip
  if typo_body_color == 'rgba(0,0,0,0)' or typo_body_color == 'rgba(0, 0, 0, 0)' or typo_body_color == 'transparent'
    assign typo_body_color = blank
  endif

  assign body_color = typo_body_color
  if body_color == blank
    assign body_color = section.settings.body_color
  endif
  if body_color == blank
    assign body_color = section.settings.subtext_color
  endif
  if body_color == blank
    assign body_color = section.settings.formula_subtext_color
  endif
  if body_color == blank
    assign body_color = section.settings.card_text_color
  endif
  if body_color == blank
    assign body_color = section.settings.panel_text_color
  endif
  if body_color == blank
    assign body_color = section.settings.text_color
  endif
-%}

{{ sec }} {
  --hp-sci-sec-heading-size: 52px;
  --hp-sci-sec-subheading-size: 52px;
  --hp-sci-sec-body-size: 23px;
  --hp-sci-sec-eyebrow-size: 19px;
  --hp-sci-sec-heading-weight: 300;
  --hp-sci-sec-subheading-weight: 300;
  --hp-sci-sec-eyebrow-weight: 300;
  --hp-sci-sec-body-weight: 300;
  --hp-sci-sec-heading-font: {{ inter_stack }};
  --hp-sci-sec-subheading-font: {{ inter_stack }};
  --hp-sci-sec-eyebrow-font: {{ dg_stack }};
  --hp-sci-sec-body-font: {{ dg_stack }};
  --hp-sci-sec-heading-style: normal;
  --hp-sci-sec-heading-letter-spacing: -0.02em;
  --hp-sci-sec-eyebrow-letter-spacing: 0.12em;
  --hp-sci-sec-heading-line-height: 1.12;
  --hp-sci-sec-body-line-height: 1.55;
  --hp-sci-sec-pad-top: 96px;
  --hp-sci-sec-pad-bottom: 96px;
  --hp-sci-sec-gutter: 28px;
  --hp-sci-sec-eyebrow-gap: 12px;
  {%- if body_color != blank -%}
  --hp-sci-sec-body-color: {{ body_color }};
  {%- endif -%}
}

#MainContent {{ sec }} .hp-sci,
{{ sec }} .hp-sci {
  padding-top: 96px !important;
  padding-bottom: 96px !important;
  text-align: left;
}

#MainContent {{ sec }} .hp-sci[class*="hp-sci-banner-"],
#MainContent {{ sec }} .hp-sci[class*="hp-sci-headlines-"],
{{ sec }} .hp-sci[class*="hp-sci-banner-"],
{{ sec }} .hp-sci[class*="hp-sci-headlines-"] {
