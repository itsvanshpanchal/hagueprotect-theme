{%- comment 
  assign typo_heading_color = section.settings.sci_typo_heading_color | strip
  if typo_heading_color == 'rgba(0,0,0,0)' or typo_heading_color == 'rgba(0, 0, 0, 0)' or typo_heading_color == 'transparent'
    assign typo_heading_color = blank
  endif

  assign typo_eyebrow_color = section.settings.sci_typo_eyebrow_color | strip
  if typo_eyebrow_color == 'rgba(0,0,0,0)' or typo_eyebrow_color == 'rgba(0, 0, 0, 0)' or typo_eyebrow_color == 'transparent'
    assign typo_eyebrow_color = blank
  endif
-%}
  Science Longevity — fixed typography (fonts, sizes, weights). Spacing is controlled per section.
  Render once at the END of each section {%- style -%} block.
{%- endcomment -%}
{%- liquid
  assign sec = '#shopify-section-' | append: section.id

  assign inter_stack = "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
  assign dg_stack = "'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif"

  assign typo_body_color = section.settings.sci_typo_body_color | strip
  if typo_body_color == 'rgba(0,0,0,0)' or typo_body_color == 'rgba(0, 0, 0, 0)' or typo_body_color == 'transparent'
    assign typo_body_color = blank
  endif

  assign body_color = typo_body_color
  if body_color == blank
    assign body_color = section.settings.body_color
  endif
  if body_color == blank
    assign body_color = section.settings.subtext_color
  endif
  if body_color == blank
    assign body_color = section.settings.formula_subtext_color
  endif
  if body_color == blank
    assign body_color = section.settings.card_text_color
  endif
  if body_color == blank
    assign body_color = section.settings.panel_text_color
  endif
  if body_color == blank
    assign body_color = section.settings.text_color
  endif
-%}

/* Force Shopify Section wrappers to zero to prevent gap bleeding from theme.css */
{{ sec }} {
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}

{{ sec }} {
  --hp-sci-sec-heading-size: var(--hp-sci-lead-heading-size);
  --hp-sci-sec-subheading-size: var(--hp-sci-subheading-size);
  --hp-sci-sec-body-size: {{ section.settings.paragraph_size_desktop | default: 21 }}px;
  --hp-sci-sec-eyebrow-size: var(--hp-sci-eyebrow-size);
  --hp-sci-sec-heading-weight: var(--hp-sci-heading-weight);
  --hp-sci-sec-subheading-weight: var(--hp-sci-subheading-weight);
  --hp-sci-sec-eyebrow-weight: var(--hp-sci-eyebrow-weight);
  --hp-sci-sec-body-weight: var(--hp-sci-body-weight);
  --hp-sci-sec-heading-font: {{ inter_stack }};
  --hp-sci-sec-subheading-font: {{ inter_stack }};
  --hp-sci-sec-eyebrow-font: {{ dg_stack }};
  --hp-sci-sec-body-font: {{ dg_stack }};
  --hp-sci-sec-heading-style: var(--hp-sci-heading-style);
  --hp-sci-sec-heading-letter-spacing: var(--hp-sci-heading-letter-spacing);
  --hp-sci-sec-eyebrow-letter-spacing: var(--hp-sci-eyebrow-letter-spacing);
  --hp-sci-sec-heading-line-height: var(--hp-sci-lead-heading-line-height);
  --hp-sci-sec-body-line-height: var(--hp-sci-body-line-height);
  
  {%- if typo_heading_color != blank -%}
  --hp-sci-sec-heading-color: {{ typo_heading_color }};
  {%- endif -%}
  {%- if typo_eyebrow_color != blank -%}
  --hp-sci-sec-eyebrow-color: {{ typo_eyebrow_color }};
  {%- endif -%}

  {%- if body_color != blank -%}
  --hp-sci-sec-body-color: {{ body_color }};
  {%- endif -%}
}

