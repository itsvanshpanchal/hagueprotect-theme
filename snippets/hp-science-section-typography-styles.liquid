{%- comment -%}
  Per-section typography: CSS variables + direct apply rules (theme editor settings).
  Render once at the END of each section {%- style -%} block.
{%- endcomment -%}
{%- liquid
  assign heading_desktop = section.settings.sci_typo_heading_desktop | default: section.settings.title_size_desktop | default: section.settings.heading_size | default: section.settings.title_size | default: 44
  assign heading_mobile = section.settings.sci_typo_heading_mobile | default: section.settings.title_size_mobile | default: 32
  assign sub_desktop = section.settings.sci_typo_subheading_desktop | default: section.settings.column_title_size | default: section.settings.subheading_size | default: 24
  assign sub_mobile = section.settings.sci_typo_subheading_mobile | default: 20
  assign body_desktop = section.settings.sci_typo_body_desktop | default: section.settings.column_text_size | default: section.settings.body_size | default: 18
  assign body_mobile = section.settings.sci_typo_body_mobile | default: 16
  assign eyebrow_desktop = section.settings.sci_typo_eyebrow_desktop | default: section.settings.eyebrow_size | default: section.settings.rail_size | default: 16
  assign eyebrow_mobile = section.settings.sci_typo_eyebrow_mobile | default: 14

  assign pad_top_desktop = section.settings.sci_typo_padding_top_desktop | default: section.settings.padding_top | default: 80
  assign pad_top_mobile = section.settings.sci_typo_padding_top_mobile | default: 56
  assign pad_bottom_desktop = section.settings.sci_typo_padding_bottom_desktop | default: section.settings.padding_bottom | default: 80
  assign pad_bottom_mobile = section.settings.sci_typo_padding_bottom_mobile | default: 56
  assign gutter_desktop = section.settings.sci_typo_gutter_desktop | default: 28
  assign gutter_mobile = section.settings.sci_typo_gutter_mobile | default: 20
  assign eyebrow_gap_desktop = section.settings.sci_typo_eyebrow_gap_desktop | default: 12
  assign eyebrow_gap_mobile = section.settings.sci_typo_eyebrow_gap_mobile | default: 10

  assign heading_weight = section.settings.sci_typo_heading_weight | default: '300'
  assign subheading_weight = section.settings.sci_typo_subheading_weight | default: '400'
  assign eyebrow_weight = section.settings.sci_typo_eyebrow_weight | default: '500'
  assign body_weight = section.settings.sci_typo_body_weight | default: '400'
  assign heading_style = section.settings.sci_typo_heading_style | default: 'normal'
  assign heading_font = section.settings.sci_typo_heading_font | default: 'inter_light'
  assign subheading_font = section.settings.sci_typo_subheading_font | default: 'inter'
  assign eyebrow_font = section.settings.sci_typo_eyebrow_font | default: 'darker_grotesque_medium'
  assign body_font = section.settings.sci_typo_body_font | default: 'darker_grotesque'

  assign typo_body_color = section.settings.sci_typo_body_color | strip
  if typo_body_color == 'rgba(0,0,0,0)' or typo_body_color == 'rgba(0, 0, 0, 0)' or typo_body_color == 'transparent'
    assign typo_body_color = blank
  endif

  assign body_color = typo_body_color
  if body_color == blank
    assign body_color = section.settings.body_color
  endif
  if body_color == blank
    assign body_color = section.settings.column_text_color
  endif
  if body_color == blank
    assign body_color = section.settings.subtext_color
  endif
  if body_color == blank
    assign body_color = section.settings.formula_subtext_color
  endif
  if body_color == blank
    assign body_color = section.settings.card_text_color
  endif
  if body_color == blank
    assign body_color = section.settings.panel_text_color
  endif
  if body_color == blank
    assign body_color = section.settings.text_color
  endif

  assign heading_ls = section.settings.sci_typo_heading_letter_spacing | default: -2 | times: 0.01
  assign eyebrow_ls = section.settings.sci_typo_eyebrow_letter_spacing | default: 12 | times: 0.01
  assign heading_lh = section.settings.sci_typo_heading_line_height | default: 112 | times: 0.01
  assign body_lh = section.settings.sci_typo_body_line_height | default: 155 | times: 0.01

  assign sec = '#shopify-section-' | append: section.id
-%}
{%- capture heading_font_stack -%}{% render 'hp-font-stack', font_key: heading_font %}{%- endcapture -%}
{%- capture subheading_font_stack -%}{% render 'hp-font-stack', font_key: subheading_font %}{%- endcapture -%}
{%- capture eyebrow_font_stack -%}{% render 'hp-font-stack', font_key: eyebrow_font %}{%- endcapture -%}
{%- capture body_font_stack -%}{% render 'hp-font-stack', font_key: body_font %}{%- endcapture -%}

{{ sec }} {
  --hp-sci-sec-heading-size: {{ heading_desktop }}px;
  --hp-sci-sec-subheading-size: {{ sub_desktop }}px;
  --hp-sci-sec-body-size: {{ body_desktop }}px;
  --hp-sci-sec-eyebrow-size: {{ eyebrow_desktop }}px;
  --hp-sci-sec-heading-weight: {{ heading_weight }};
  --hp-sci-sec-subheading-weight: {{ subheading_weight }};
  --hp-sci-sec-eyebrow-weight: {{ eyebrow_weight }};
  --hp-sci-sec-body-weight: {{ body_weight }};
  --hp-sci-sec-heading-font: {{ heading_font_stack | strip }};
  --hp-sci-sec-subheading-font: {{ subheading_font_stack | strip }};
  --hp-sci-sec-eyebrow-font: {{ eyebrow_font_stack | strip }};
  --hp-sci-sec-body-font: {{ body_font_stack | strip }};
  {%- if body_color != blank -%}
  --hp-sci-sec-body-color: {{ body_color }};
  {%- endif -%}
  --hp-sci-sec-heading-style: {{ heading_style }};
  --hp-sci-sec-heading-letter-spacing: {{ heading_ls }}em;
  --hp-sci-sec-eyebrow-letter-spacing: {{ eyebrow_ls }}em;
  --hp-sci-sec-heading-line-height: {{ heading_lh }};
  --hp-sci-sec-body-line-height: {{ body_lh }};
  --hp-sci-sec-pad-top: {{ pad_top_desktop }}px;
  --hp-sci-sec-pad-bottom: {{ pad_bottom_desktop }}px;
  --hp-sci-sec-gutter: {{ gutter_desktop }}px;
  --hp-sci-sec-eyebrow-gap: {{ eyebrow_gap_desktop }}px;
}

#MainContent {{ sec }} .hp-sci,
{{ sec }} .hp-sci {
  padding-top: {{ pad_top_desktop }}px !important;
  padding-bottom: {{ pad_bottom_desktop }}px !important;
}

#MainContent {{ sec }} .hp-sci__inner,
{{ sec }} .hp-sci__inner {
  padding-left: {{ gutter_desktop }}px !important;
  padding-right: {{ gutter_desktop }}px !important;
}

#MainContent {{ sec }} .hp-sci .hp-sci__eyebrow,
#MainContent {{ sec }} .hp-sci [class*="__eyebrow"],
#MainContent {{ sec }} .hp-sci [class*="__rail-text"],
#MainContent {{ sec }} .hp-sci [class*="__category"],
#MainContent {{ sec }} .hp-sci [class*="__pillar-num"],
#MainContent {{ sec }} .hp-sci [class*="__formula-eyebrow"],
{{ sec }} .hp-sci .hp-sci__eyebrow,
{{ sec }} .hp-sci [class*="__eyebrow"],
{{ sec }} .hp-sci [class*="__rail-text"],
{{ sec }} .hp-sci [class*="__category"],
{{ sec }} .hp-sci [class*="__pillar-num"],
{{ sec }} .hp-sci [class*="__formula-eyebrow"] {
  font-family: {{ eyebrow_font_stack | strip }} !important;
  font-size: {{ eyebrow_desktop }}px !important;
  font-weight: {{ eyebrow_weight }} !important;
  letter-spacing: {{ eyebrow_ls }}em !important;
  margin-bottom: {{ eyebrow_gap_desktop }}px !important;
  text-transform: uppercase !important;
}

#MainContent {{ sec }} .hp-sci h1,
#MainContent {{ sec }} .hp-sci h2,
#MainContent {{ sec }} .hp-sci h3,
#MainContent {{ sec }} .hp-sci .hp-sci__title,
#MainContent {{ sec }} .hp-sci [class*="__heading"],
#MainContent {{ sec }} .hp-sci [class*="__heading-line"],
#MainContent {{ sec }} .hp-sci [class*="__heading-accent"],
#MainContent {{ sec }} .hp-sci [class*="__formula-title"],
#MainContent {{ sec }} .hp-sci [class*="__formula-title-line"],
#MainContent {{ sec }} .hp-sci [class*="__formula-accent"],
#MainContent {{ sec }} .hp-sci [class*="__title-main"],
#MainContent {{ sec }} .hp-sci [class*="__pillar-title"],
{{ sec }} .hp-sci h1,
{{ sec }} .hp-sci h2,
{{ sec }} .hp-sci h3,
{{ sec }} .hp-sci .hp-sci__title,
{{ sec }} .hp-sci [class*="__heading"],
{{ sec }} .hp-sci [class*="__heading-line"],
{{ sec }} .hp-sci [class*="__heading-accent"],
{{ sec }} .hp-sci [class*="__formula-title"],
{{ sec }} .hp-sci [class*="__formula-title-line"],
{{ sec }} .hp-sci [class*="__formula-accent"],
{{ sec }} .hp-sci [class*="__title-main"],
{{ sec }} .hp-sci [class*="__pillar-title"] {
  font-family: {{ heading_font_stack | strip }} !important;
  font-size: {{ heading_desktop }}px !important;
  font-weight: {{ heading_weight }} !important;
  font-style: {{ heading_style }} !important;
  line-height: {{ heading_lh }} !important;
  letter-spacing: {{ heading_ls }}em !important;
}

#MainContent {{ sec }} .hp-sci [class*="__title-sub"],
{{ sec }} .hp-sci [class*="__title-sub"] {
  font-family: {{ subheading_font_stack | strip }} !important;
  font-size: {{ sub_desktop }}px !important;
  font-weight: {{ subheading_weight }} !important;
  line-height: {{ heading_lh }} !important;
  letter-spacing: {{ heading_ls }}em !important;
}

#MainContent {{ sec }} .hp-sci [class*="__col-title"],
#MainContent {{ sec }} .hp-sci [class*="__card-title"],
#MainContent {{ sec }} .hp-sci [class*="__num"],
{{ sec }} .hp-sci [class*="__col-title"],
{{ sec }} .hp-sci [class*="__card-title"],
{{ sec }} .hp-sci [class*="__num"] {
  font-family: {{ subheading_font_stack | strip }} !important;
  font-size: {{ sub_desktop }}px !important;
  font-weight: {{ subheading_weight }} !important;
  line-height: {{ heading_lh }} !important;
}

#MainContent {{ sec }} .hp-sci .hp-sci__body,
#MainContent {{ sec }} .hp-sci [class*="__col-text"],
#MainContent {{ sec }} .hp-sci [class*="__subtext"],
#MainContent {{ sec }} .hp-sci [class*="__graph-sub"],
#MainContent {{ sec }} .hp-sci [class*="__footnote"],
#MainContent {{ sec }} .hp-sci [class*="__feature-"][class*="__text"],
#MainContent {{ sec }} .hp-sci [class*="-proto-"][class*="__body"],
#MainContent {{ sec }} .hp-sci [class*="-cta-"][class*="__body"],
#MainContent {{ sec }} .hp-sci [class*="__card-text"],
#MainContent {{ sec }} .hp-sci [class*="__card-text"] p,
{{ sec }} .hp-sci .hp-sci__body,
{{ sec }} .hp-sci [class*="__col-text"],
{{ sec }} .hp-sci [class*="__subtext"],
{{ sec }} .hp-sci [class*="__graph-sub"],
{{ sec }} .hp-sci [class*="__footnote"],
{{ sec }} .hp-sci [class*="__feature-"][class*="__text"],
{{ sec }} .hp-sci [class*="-proto-"][class*="__body"],
{{ sec }} .hp-sci [class*="-cta-"][class*="__body"],
{{ sec }} .hp-sci [class*="__card-text"],
{{ sec }} .hp-sci [class*="__card-text"] p {
  font-family: {{ body_font_stack | strip }} !important;
  font-size: {{ body_desktop }}px !important;
  font-weight: {{ body_weight }} !important;
  line-height: {{ body_lh }} !important;
  {%- if body_color != blank -%}
  color: {{ body_color }} !important;
  {%- endif -%}
}

@media screen and (max-width: 989px) {
  {{ sec }} {
    --hp-sci-sec-heading-size: {{ heading_mobile }}px;
    --hp-sci-sec-subheading-size: {{ sub_mobile }}px;
    --hp-sci-sec-body-size: {{ body_mobile }}px;
    --hp-sci-sec-eyebrow-size: {{ eyebrow_mobile }}px;
    --hp-sci-sec-pad-top: {{ pad_top_mobile }}px;
    --hp-sci-sec-pad-bottom: {{ pad_bottom_mobile }}px;
    --hp-sci-sec-gutter: {{ gutter_mobile }}px;
    --hp-sci-sec-eyebrow-gap: {{ eyebrow_gap_mobile }}px;
  }

  #MainContent {{ sec }} .hp-sci,
  {{ sec }} .hp-sci {
    padding-top: {{ pad_top_mobile }}px !important;
    padding-bottom: {{ pad_bottom_mobile }}px !important;
  }

  #MainContent {{ sec }} .hp-sci__inner,
  {{ sec }} .hp-sci__inner {
    padding-left: {{ gutter_mobile }}px !important;
    padding-right: {{ gutter_mobile }}px !important;
  }

  #MainContent {{ sec }} .hp-sci .hp-sci__eyebrow,
  #MainContent {{ sec }} .hp-sci [class*="__eyebrow"],
  #MainContent {{ sec }} .hp-sci [class*="__rail-text"],
  #MainContent {{ sec }} .hp-sci [class*="__category"],
  #MainContent {{ sec }} .hp-sci [class*="__pillar-num"],
  #MainContent {{ sec }} .hp-sci [class*="__formula-eyebrow"],
  {{ sec }} .hp-sci .hp-sci__eyebrow,
  {{ sec }} .hp-sci [class*="__eyebrow"],
  {{ sec }} .hp-sci [class*="__rail-text"],
  {{ sec }} .hp-sci [class*="__category"],
  {{ sec }} .hp-sci [class*="__pillar-num"],
  {{ sec }} .hp-sci [class*="__formula-eyebrow"] {
    font-size: {{ eyebrow_mobile }}px !important;
    margin-bottom: {{ eyebrow_gap_mobile }}px !important;
  }

  #MainContent {{ sec }} .hp-sci h1,
  #MainContent {{ sec }} .hp-sci h2,
  #MainContent {{ sec }} .hp-sci h3,
  #MainContent {{ sec }} .hp-sci .hp-sci__title,
  #MainContent {{ sec }} .hp-sci [class*="__heading"],
  #MainContent {{ sec }} .hp-sci [class*="__heading-line"],
  #MainContent {{ sec }} .hp-sci [class*="__heading-accent"],
  #MainContent {{ sec }} .hp-sci [class*="__formula-title"],
  #MainContent {{ sec }} .hp-sci [class*="__formula-title-line"],
  #MainContent {{ sec }} .hp-sci [class*="__formula-accent"],
  #MainContent {{ sec }} .hp-sci [class*="__title-main"],
  #MainContent {{ sec }} .hp-sci [class*="__pillar-title"],
  {{ sec }} .hp-sci h1,
  {{ sec }} .hp-sci h2,
  {{ sec }} .hp-sci h3,
  {{ sec }} .hp-sci .hp-sci__title,
  {{ sec }} .hp-sci [class*="__heading"],
  {{ sec }} .hp-sci [class*="__heading-line"],
  {{ sec }} .hp-sci [class*="__heading-accent"],
  {{ sec }} .hp-sci [class*="__formula-title"],
  {{ sec }} .hp-sci [class*="__formula-title-line"],
  {{ sec }} .hp-sci [class*="__formula-accent"],
  {{ sec }} .hp-sci [class*="__title-main"],
  {{ sec }} .hp-sci [class*="__pillar-title"] {
    font-size: {{ heading_mobile }}px !important;
  }

  #MainContent {{ sec }} .hp-sci [class*="__title-sub"],
  {{ sec }} .hp-sci [class*="__title-sub"],
  #MainContent {{ sec }} .hp-sci [class*="__col-title"],
  #MainContent {{ sec }} .hp-sci [class*="__card-title"],
  #MainContent {{ sec }} .hp-sci [class*="__num"],
  {{ sec }} .hp-sci [class*="__col-title"],
  {{ sec }} .hp-sci [class*="__card-title"],
  {{ sec }} .hp-sci [class*="__num"] {
    font-size: {{ sub_mobile }}px !important;
  }

  #MainContent {{ sec }} .hp-sci .hp-sci__body,
  #MainContent {{ sec }} .hp-sci [class*="__col-text"],
  #MainContent {{ sec }} .hp-sci [class*="__subtext"],
  #MainContent {{ sec }} .hp-sci [class*="__graph-sub"],
  #MainContent {{ sec }} .hp-sci [class*="__footnote"],
  #MainContent {{ sec }} .hp-sci [class*="__feature-"][class*="__text"],
  #MainContent {{ sec }} .hp-sci [class*="-proto-"][class*="__body"],
  #MainContent {{ sec }} .hp-sci [class*="-cta-"][class*="__body"],
  #MainContent {{ sec }} .hp-sci [class*="__card-text"],
  #MainContent {{ sec }} .hp-sci [class*="__card-text"] p,
  {{ sec }} .hp-sci .hp-sci__body,
  {{ sec }} .hp-sci [class*="__col-text"],
  {{ sec }} .hp-sci [class*="__subtext"],
  {{ sec }} .hp-sci [class*="__graph-sub"],
  {{ sec }} .hp-sci [class*="__footnote"],
  {{ sec }} .hp-sci [class*="__feature-"][class*="__text"],
  {{ sec }} .hp-sci [class*="-proto-"][class*="__body"],
  {{ sec }} .hp-sci [class*="-cta-"][class*="__body"],
