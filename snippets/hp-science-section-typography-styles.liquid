    {% if section.settings.sci_typo_gutter_mobile != blank %}
    padding-left: {{ section.settings.sci_typo_gutter_mobile }}px !important;
    padding-right: {{ section.settings.sci_typo_gutter_mobile }}px !important;
    {% endif %}
  }
}
