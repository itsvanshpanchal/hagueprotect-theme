{%- liquid
  assign occasions_heading_line1 = heading_line1 | default: 'Gifts people keep.'
  assign occasions_heading_line2 = heading_line2 | default: 'Not re-gift.'
  assign occasions_section_id = section_id | default: 'corp-occasions'
-%}

<style>
  #{{ occasions_section_id }}.corp-occasions {
    position: relative;
    z-index: 2;
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  #{{ occasions_section_id }} .corp-occasions__title-line1,
  #{{ occasions_section_id }} .corp-occasions__title-line2 {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
    font-size: 52px !important;
    font-weight: 300 !important;
    font-style: normal !important;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #111111 !important;
  }

  #{{ occasions_section_id }} .corp-occasions__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2.2vw, 28px);
  }

  #{{ occasions_section_id }} .corp-occasions__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }

  #{{ occasions_section_id }} .corp-occasions__media {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(145deg, #f3f3f3, #e8e8e8);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  #{{ occasions_section_id }} .corp-occasions__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  #{{ occasions_section_id }} .corp-occasions__card:hover .corp-occasions__media img {
    transform: scale(1.03);
  }

  #{{ occasions_section_id }} .corp-occasions__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(17, 17, 17, 0.28);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ occasions_section_id }} .corp-occasions__label {
    margin: 18px 0 0;
    font-family: 'Darker Grotesque', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif !important;
    font-size: 24px !important;
    font-weight: 400 !important;
    font-style: normal !important;
    color: #111111 !important;
    line-height: 1.2;
  }

  #{{ occasions_section_id }} .corp-occasions__caption {
    margin: 8px 0 0;
    font-family: var(--font-family-heading-accent, 'Luthon Southard Script', cursive);
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.35;
    color: #2563eb !important;
  }

  @media screen and (max-width: 1024px) {
    #{{ occasions_section_id }} .corp-occasions__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 20px;
    }
  }

  @media screen and (max-width: 560px) {
    #{{ occasions_section_id }} .corp-occasions__grid {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin: 0 auto;
    }

    #{{ occasions_section_id }} .corp-occasions__header {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

<section class="corp-occasions" id="{{ occasions_section_id }}" data-no-typewriter="true" data-corp-occasions-section="true">
  <div class="corp-occasions__container" style="width: 100%; max-width: var(--site-max-width); margin: 0 auto; padding: clamp(72px, 9vw, 110px) max(20px, var(--site-padding, 24px)); background: #ffffff;">
    <header class="corp-occasions__header" style="max-width: 720px; margin: 0 0 clamp(40px, 5vw, 56px);">
      <h2 class="corp-occasions__title" style="margin: 0; display: flex; flex-direction: column; gap: 4px;">
        <span class="corp-occasions__title-line1">{{ occasions_heading_line1 }}</span>
        <span class="corp-occasions__title-line2">{{ occasions_heading_line2 }}</span>
      </h2>
    </header>

    <div class="corp-occasions__grid">
      {%- if blocks != blank and blocks.size > 0 -%}
        {%- for block in blocks -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="corp-occasions__card" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="corp-occasions__card" {{ block.shopify_attributes }}>
          {%- endif -%}
            <div class="corp-occasions__media">
              {%- if block.settings.image != blank -%}
                {%- assign card_alt = block.settings.title | default: 'Occasion' | escape -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', widths: '300, 450, 600, 750, 900', sizes: '(min-width: 1024px) 22vw, (min-width: 560px) 42vw, 88vw', alt: card_alt, class: 'corp-occasions__image'
                }}
              {%- else -%}
                <div class="corp-occasions__placeholder" aria-hidden="true">{{ block.settings.title | default: 'Add image' }}</div>
              {%- endif -%}
            </div>
            {%- if block.settings.title != blank -%}
              <p class="corp-occasions__label">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="corp-occasions__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="corp-occasions__card">
          <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Corporate</div></div>
          <p class="corp-occasions__label">Corporate</p>
        </div>
        <div class="corp-occasions__card">
          <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Weddings</div></div>
          <p class="corp-occasions__label">Weddings</p>
        </div>
        <div class="corp-occasions__card">
          <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Celebrations</div></div>
          <p class="corp-occasions__label">Celebrations</p>
          <p class="corp-occasions__caption">(Birthday, Housewarming, Anniversary)</p>
        </div>
        <div class="corp-occasions__card">
          <div class="corp-occasions__media"><div class="corp-occasions__placeholder">Collaborations</div></div>
          <p class="corp-occasions__label">Collaborations</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
