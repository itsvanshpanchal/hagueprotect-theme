{%- comment -%}
  Clickable megamenu / mobile category heading linking to a collection page.
  @param menu_collection {Collection} optional — pick in Header theme settings
  @param handle {String} fallback Shopify collection handle
  @param search {String} fallback search query when collection is not created yet
  @param label {String} visible heading text
  @param accent {Boolean} optional red accent style
  @param variant {String} 'desktop' (default) or 'mobile'
  @param style {String} optional inline style on the heading wrapper
{%- endcomment -%}
{%- liquid
  assign menu_template = 'menu-category'

  if menu_collection != blank
    assign heading_href = menu_collection.url
    if menu_template != blank
      if heading_href contains '?'
        assign heading_href = heading_href | append: '&view=' | append: menu_template
      else
        assign heading_href = heading_href | append: '?view=' | append: menu_template
      endif
    endif
  else
    capture heading_href
      render 'care-kit-collection-url', handle: handle, search_query: search, label: label, template: menu_template
    endcapture
    assign heading_href = heading_href | strip
  endif
-%}

{%- if variant == 'mobile' -%}
  <h4 class="mobile-accordion-category-heading megamenu-heading-link{% if accent %} megamenu-heading-link--accent{% endif %}"{% if style != blank %} style="{{ style }}"{% endif %}>
    <a href="{{ heading_href }}" class="megamenu-heading-link__a">{{ label }}</a>
  </h4>
{%- else -%}
  <h3 class="megamenu-heading megamenu-heading-link{% if accent %} megamenu-heading-link--accent{% endif %}"{% if style != blank %} style="{{ style }} display: flex; align-items: center; justify-content: space-between;"{% else %} style="margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between;"{% endif %}>
    <a href="{{ heading_href }}" class="megamenu-heading-link__a">{{ label }}</a>
    <button type="button" class="megamenu-toggle-btn" aria-expanded="false" aria-label="Toggle {{ label }}" style="background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center; justify-content: center; color: currentColor;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12h14" stroke-linecap="round" stroke-linejoin="round" class="icon-plus"/>
        <path d="M5 12h14" stroke-linecap="round" stroke-linejoin="round" class="icon-minus" style="display:none;"/>
      </svg>
    </button>
  </h3>
{%- endif -%}
