{%- comment -%}
  Clickable golden heading for Vanrosector Shop All — goes to collection page.
  @param handle {String} collection handle
  @param search {String} fallback search query
  @param label {String} heading text
  @param variant {String} 'desktop' (default) or 'mobile'
{%- endcomment -%}
{%- capture heading_href -%}
  {%- render 'vanrosector-menu-url', handle: handle, search_query: search, label: label, link_type: 'collection' -%}
{%- endcapture -%}
{%- assign heading_href = heading_href | strip -%}

{%- if variant == 'mobile' -%}
  <h4 class="mobile-accordion-category-heading megamenu-heading-link megamenu-heading-link--vr-gold">
    <a href="{{ heading_href }}" class="megamenu-heading-link__a">{{ label }}</a>
  </h4>
{%- else -%}
  <h3 class="megamenu-heading megamenu-heading--vr megamenu-heading-link" style="display: flex; align-items: center; justify-content: space-between;">
    <a href="{{ heading_href }}" class="megamenu-heading-link__a">{{ label }}</a>
    <button type="button" class="megamenu-toggle-btn" aria-expanded="false" aria-label="Toggle {{ label }}" style="background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center; justify-content: center; color: currentColor;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 5v14M5 12h14" stroke-linecap="round" stroke-linejoin="round" class="icon-plus"/>
        <path d="M5 12h14" stroke-linecap="round" stroke-linejoin="round" class="icon-minus" style="display:none;"/>
      </svg>
    </button>
  </h3>
{%- endif -%}
