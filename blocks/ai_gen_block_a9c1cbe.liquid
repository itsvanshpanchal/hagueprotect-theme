{% doc %}
  Story banner with editable overlay text + per-block typography.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- liquid
  assign heading_family = block.settings.heading_font_family | default: 'bebas_neue'
  assign subheading_family = block.settings.subheading_font_family | default: 'inter'
  assign text_family = block.settings.text_font_family | default: 'inter'
  assign button_family = block.settings.button_font_family | default: 'inter'

  comment
    Always honor Theme Editor Weight / Style for Story Banner.
  endcomment
  assign heading_weight = block.settings.heading_font_weight | default: '400'
  assign subheading_weight = block.settings.subheading_font_weight | default: '700'
  assign text_weight = block.settings.text_font_weight | default: '400'
  assign button_weight = block.settings.button_font_weight | default: '600'

  assign heading_style = block.settings.heading_font_style | default: 'normal'
  assign subheading_style = block.settings.subheading_font_style | default: 'normal'
  assign text_style = block.settings.text_font_style | default: 'normal'

  assign accent_family = block.settings.heading_accent_font_family | default: settings.font_heading_accent_family | default: 'luthon_southard_script'
  if accent_family == blank or accent_family == 'theme_default'
    assign accent_family = settings.font_heading_accent_family | default: 'luthon_southard_script'
  endif
  assign accent_weight = block.settings.heading_accent_font_weight | default: settings.font_heading_accent_weight | default: '400'
  assign accent_style = block.settings.heading_accent_font_style | default: settings.font_heading_accent_style | default: 'normal'
  assign accent_size = block.settings.heading_accent_font_size_desktop | default: settings.font_heading_accent_size_desktop | default: 62
  assign accent_size_mobile = block.settings.heading_accent_font_size_mobile | default: settings.font_heading_accent_size_mobile | default: 40
  assign accent_color = block.settings.heading_accent_color | default: settings.heading_accent_color | default: '#c9a227'
-%}

{%- capture heading_stack -%}{% render 'hp-font-stack', font_key: heading_family %}{%- endcapture -%}
{%- capture subheading_stack -%}{% render 'hp-font-stack', font_key: subheading_family %}{%- endcapture -%}
{%- capture text_stack -%}{% render 'hp-font-stack', font_key: text_family %}{%- endcapture -%}
{%- capture button_stack -%}{% render 'hp-font-stack', font_key: button_family %}{%- endcapture -%}
{%- capture accent_stack -%}{% render 'hp-font-stack', font_key: accent_family %}{%- endcapture -%}
{%- liquid
  assign heading_stack = heading_stack | strip
  assign subheading_stack = subheading_stack | strip
  assign text_stack = text_stack | strip
  assign button_stack = button_stack | strip
  assign accent_stack = accent_stack | strip
-%}

{% style %}
  .ai-story-banner-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    display: block;
  }

  /*
    Curtain reveal:
    - Banner pins sticky
    - Following sections slide up and cover it (lower curtain)
    - No extra white padding / empty runway (that caused the blank white screen)
  */
  #MainContent {
    position: relative;
    isolation: isolate;
    background-color: #ffffff;
  }

  .shopify-section:has(.ai-story-sticky-track-{{ ai_gen_id }}) {
    position: relative !important;
    z-index: 1 !important;
    height: 200vh !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    background: transparent !important;
    isolation: auto !important;
    transform: none !important;
    pointer-events: none;
  }

  /* Section ABOVE — stays above the pin while it scrolls away */
  .shopify-section:has(+ .shopify-section:has(.ai-story-sticky-track-{{ ai_gen_id }})),
  .shopify-section.hp-story-curtain-prev-{{ ai_gen_id }} {
    position: relative !important;
    z-index: 3 !important;
    isolation: isolate !important;
    background-color: #ffffff !important;
    padding-bottom: 0 !important;
  }

  /* Immediate next section starts early so it can cover the pin */
  .shopify-section:has(.ai-story-sticky-track-{{ ai_gen_id }}) + .shopify-section {
    position: relative !important;
    z-index: 3 !important;
    isolation: isolate !important;
    margin-top: -100vh !important;
  }

  /* Later following sections also sit above the pin (no extra pull) */
  .shopify-section.hp-story-curtain-next-{{ ai_gen_id }} {
    position: relative !important;
    z-index: 3 !important;
    isolation: isolate !important;
  }

  .ai-story-sticky-track-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    background: transparent;
    pointer-events: none;
  }

  .ai-story-sticky-pin-{{ ai_gen_id }} {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    z-index: 1;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #0a0a0a;
    pointer-events: auto;
  }

  .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-{{ ai_gen_id }},
  .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-image-{{ ai_gen_id }},
  .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-mobile-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-placeholder-{{ ai_gen_id }} {
    min-height: 100%;
    height: 100%;
  }

  .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-content-{{ ai_gen_id }} {
    /* Match other homepage sections (~28–48px), not a large % of the viewport */
    top: {% if block.settings.content_offset_top > 0 %}{{ block.settings.content_offset_top }}px{% else %}clamp(28px, 4.5vw, 48px){% endif %};
    left: max({{ block.settings.content_offset_left }}px, var(--homepage-section-gutter, 8px), 20px);
    padding: {{ block.settings.content_padding | default: 20 }}px;
    transform: none;
  }

  @media screen and (max-width: 749px) {
    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-content-{{ ai_gen_id }} {
      top: clamp(20px, 4vw, 32px);
      left: 16px;
      padding: 16px;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shopify-section:has(.ai-story-sticky-track-{{ ai_gen_id }}) {
      height: auto !important;
      margin-top: 0 !important;
      pointer-events: auto;
    }

    .ai-story-sticky-track-{{ ai_gen_id }} {
      height: auto;
      background: transparent;
      pointer-events: auto;
    }

    .ai-story-sticky-pin-{{ ai_gen_id }} {
      position: relative;
      top: auto;
      height: auto;
      z-index: auto;
    }

    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-{{ ai_gen_id }},
    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-wrapper-{{ ai_gen_id }} {
      height: auto;
    }

    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-image-{{ ai_gen_id }},
    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-mobile-image-{{ ai_gen_id }} {
      height: auto;
    }

    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-content-{{ ai_gen_id }} {
      top: {{ block.settings.content_offset_top }}px;
      transform: none;
    }

    .shopify-section:has(+ .shopify-section:has(.ai-story-sticky-track-{{ ai_gen_id }})),
    .shopify-section:has(.ai-story-sticky-track-{{ ai_gen_id }}) + .shopify-section,
    .shopify-section.hp-story-curtain-prev-{{ ai_gen_id }},
    .shopify-section.hp-story-curtain-next-{{ ai_gen_id }} {
      box-shadow: none !important;
      margin-top: 0 !important;
      padding-bottom: 0 !important;
    }
  }

  .ai-story-banner-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    background-color: {{ block.settings.background_color }};
  }

  .ai-story-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    opacity: {{ block.settings.image_opacity }};
  }

  .ai-story-banner-mobile-image-{{ ai_gen_id }} {
    display: none;
  }

  .ai-story-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 500px;
  }

  .ai-story-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-story-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-story-banner-content-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
    max-width: {{ block.settings.content_max_width }}px;
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.content_align | default: 'left' }};
    left: {{ block.settings.content_offset_left }}px;
    top: {{ block.settings.content_offset_top }}px;
    display: flex;
    flex-direction: column;
    align-items: {% case block.settings.content_align %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
    gap: 0;
  }

  #MainContent .shopify-section .ai-story-banner-subheading-{{ ai_gen_id }},
  .ai-story-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }} !important;
    font-family: {{ subheading_stack }} !important;
    font-size: {{ block.settings.subheading_size }}px !important;
    font-weight: {{ subheading_weight }} !important;
    font-style: {{ subheading_style }} !important;
    margin: 0 0 {{ block.settings.subheading_spacing }}px !important;
    line-height: 1.4 !important;
    letter-spacing: 0.14em !important;
    text-transform: none !important;
  }

  #MainContent .shopify-section .ai-story-banner-heading-{{ ai_gen_id }},
  #MainContent .shopify-section h2.ai-story-banner-heading-{{ ai_gen_id }},
  .ai-story-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }} !important;
    font-family: {{ heading_stack }} !important;
    font-size: {{ block.settings.heading_size }}px !important;
    font-weight: {{ heading_weight }} !important;
    font-style: {{ heading_style }} !important;
    margin: 0 0 {{ block.settings.heading_spacing }}px !important;
    line-height: 1.05 !important;
    letter-spacing: -0.02em !important;
    text-transform: none !important;
  }

  #MainContent .shopify-section .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-line,
  #MainContent .shopify-section .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-pair,
  #MainContent .shopify-section .ai-story-banner-heading-{{ ai_gen_id }} .hp-typewriter-text,
  .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-line,
  .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-pair,
  .ai-story-banner-heading-{{ ai_gen_id }} .hp-typewriter-text {
    font-family: inherit !important;
    font-size: inherit !important;
    font-weight: {{ heading_weight }} !important;
    font-style: inherit !important;
    letter-spacing: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
    margin: 0 !important;
    text-transform: none !important;
  }

  .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-line {
    display: block;
  }

  .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-line--with-accent {
    white-space: normal;
  }

  .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-line::first-letter {
    text-transform: none !important;
  }

  .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-line--2 {
    color: {{ block.settings.heading_line2_color | default: settings.heading_line2_color | default: '#6b6b6b' }} !important;
  }

  .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-accent {
    display: inline !important;
    font-family: {{ accent_stack }} !important;
    font-weight: {{ accent_weight }} !important;
    font-style: {{ accent_style }} !important;
    color: {{ accent_color }} !important;
    -webkit-text-fill-color: {{ accent_color }} !important;
    -webkit-text-stroke: 0;
    paint-order: normal;
    -webkit-font-smoothing: antialiased;
    font-size: {{ accent_size }}px !important;
    text-transform: none !important;
    letter-spacing: 0.01em !important;
  }

  .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-pair--stack .hp-heading-accent {
    display: block !important;
  }

  @media screen and (max-width: 989px) {
    .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-accent {
      font-size: {{ accent_size_mobile }}px !important;
    }
  }

  #MainContent .shopify-section .ai-story-banner-text-{{ ai_gen_id }},
  #MainContent .shopify-section .ai-story-banner-text-{{ ai_gen_id }} p,
  .ai-story-banner-text-{{ ai_gen_id }},
  .ai-story-banner-text-{{ ai_gen_id }} p {
    color: {{ block.settings.text_color }} !important;
    font-family: {{ text_stack }} !important;
    font-size: {{ block.settings.text_size }}px !important;
    font-weight: {{ text_weight }} !important;
    font-style: {{ text_style }} !important;
    line-height: 1.15 !important;
    margin: 0 !important;
    letter-spacing: normal !important;
    text-transform: none !important;
  }

  .ai-story-banner-button-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.button_spacing }}px;
  }

  #MainContent .shopify-section .ai-story-banner-button-{{ ai_gen_id }},
  .ai-story-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }} !important;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-family: {{ button_stack }} !important;
    font-size: {{ block.settings.button_text_size }}px !important;
    font-weight: {{ button_weight }} !important;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .ai-story-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-story-banner-image-{{ ai_gen_id }} {
      display: none;
    }

    .ai-story-banner-wrapper-{{ ai_gen_id }} {
      min-height: min(56vw, 340px);
      overflow: hidden;
    }

    .ai-story-banner-mobile-image-{{ ai_gen_id }} {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: right center;
      opacity: {{ block.settings.image_opacity }};
    }

    /* Keep copy in the left clear zone — avoid overlapping the photo collage */
    .ai-story-banner-content-{{ ai_gen_id }} {
      padding: 18px 12px 18px 16px;
      left: {{ block.settings.content_offset_left_mobile | default: 16 }}px;
      right: auto;
      top: {{ block.settings.content_offset_top_mobile | default: 24 }}px;
      bottom: auto;
      transform: none;
      max-width: {{ block.settings.content_max_width_mobile | default: 200 }}px;
      width: {{ block.settings.content_max_width_mobile | default: 200 }}px;
      box-sizing: border-box;
      justify-content: flex-start;
      text-align: {{ block.settings.content_align_mobile | default: 'left' }};
      align-items: {% case block.settings.content_align_mobile %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
      z-index: 3;
    }

    #MainContent .shopify-section .ai-story-banner-heading-{{ ai_gen_id }},
    #MainContent .shopify-section h2.ai-story-banner-heading-{{ ai_gen_id }},
    .ai-story-banner-heading-{{ ai_gen_id }} {
      font-size: clamp(20px, 5.8vw, 28px) !important;
      margin: 0 0 6px !important;
      line-height: 1.1 !important;
    }

    #MainContent .shopify-section .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-line,
    #MainContent .shopify-section .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-pair,
    #MainContent .shopify-section .ai-story-banner-heading-{{ ai_gen_id }} .hp-typewriter-text,
    .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-line,
    .ai-story-banner-heading-{{ ai_gen_id }} .hp-heading-pair,
    .ai-story-banner-heading-{{ ai_gen_id }} .hp-typewriter-text {
      font-size: inherit !important;
    }

    #MainContent .shopify-section .ai-story-banner-subheading-{{ ai_gen_id }},
    .ai-story-banner-subheading-{{ ai_gen_id }} {
      font-size: clamp(10px, 2.8vw, 12px) !important;
      margin: 0 0 8px !important;
      letter-spacing: 0.08em !important;
      line-height: 1.25 !important;
    }

    #MainContent .shopify-section .ai-story-banner-text-{{ ai_gen_id }},
    #MainContent .shopify-section .ai-story-banner-text-{{ ai_gen_id }} p,
    .ai-story-banner-text-{{ ai_gen_id }},
    .ai-story-banner-text-{{ ai_gen_id }} p {
      font-size: clamp(12px, 3.2vw, 14px) !important;
      line-height: 1.35 !important;
    }

    .ai-story-banner-button-wrapper-{{ ai_gen_id }} {
      margin-top: 10px;
    }

    .ai-story-banner-button-{{ ai_gen_id }} {
      padding: 8px 16px;
      font-size: 13px;
    }

    /* Sticky Tell Your Story keeps full-bleed cover + its own content offsets */
    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-wrapper-{{ ai_gen_id }} {
      min-height: 100%;
    }

    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-mobile-image-{{ ai_gen_id }} {
      position: absolute;
      inset: 0;
      min-height: 100%;
      height: 100%;
      object-position: center center;
    }

    .ai-story-sticky-pin-{{ ai_gen_id }} .ai-story-banner-content-{{ ai_gen_id }} {
      top: {{ block.settings.content_offset_top_mobile | default: 24 }}px;
      left: {{ block.settings.content_offset_left_mobile | default: 16 }}px;
      bottom: auto;
      padding: 16px;
      transform: none;
      max-width: min(88%, {{ block.settings.content_max_width_mobile | default: 200 | times: 1.6 | round }}px);
      width: auto;
      justify-content: flex-start;
      text-align: {{ block.settings.content_align_mobile | default: 'left' }};
      align-items: {% case block.settings.content_align_mobile %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
    }
  }
{% endstyle %}

{%- if block.settings.enable_sticky_scroll -%}
<div class="ai-story-sticky-track-{{ ai_gen_id }}" data-hp-story-sticky-track="{{ ai_gen_id }}">
  <div class="ai-story-sticky-pin-{{ ai_gen_id }}" data-hp-story-sticky-pin="{{ ai_gen_id }}">
{%- endif -%}
<div class="ai-story-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-story-banner-wrapper-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2400 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
        class="ai-story-banner-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-story-banner-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.mobile_image %}
      <img
        src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
        alt="{{ block.settings.mobile_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.mobile_image.width }}"
        height="{{ block.settings.mobile_image.height }}"
        class="ai-story-banner-mobile-image-{{ ai_gen_id }}"
      >
    {% elsif block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 1200 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
        class="ai-story-banner-mobile-image-{{ ai_gen_id }}"
      >
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-story-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-story-banner-content-{{ ai_gen_id }}">
      {% if block.settings.subheading != blank %}
        <div class="ai-story-banner-subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <div class="ai-story-banner-heading-{{ ai_gen_id }}" role="heading" aria-level="2">
          {% render 'section-heading-text', text: block.settings.heading, line2: block.settings.heading_line2, line2_color: block.settings.heading_line2_color, accent_last_word: true, accent_last_count: block.settings.heading_accent_word_count, accent_color: block.settings.heading_accent_color %}
        </div>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="ai-story-banner-text-{{ ai_gen_id }}">
          {{ block.settings.text }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <div class="ai-story-banner-button-wrapper-{{ ai_gen_id }}">
          <a
            href="{{ block.settings.button_link }}"
            class="ai-story-banner-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{%- if block.settings.enable_sticky_scroll -%}
  </div>
</div>
<script>
  (function() {
    var track = document.querySelector('[data-hp-story-sticky-track="{{ ai_gen_id }}"]');
    if (!track || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var section = track.closest('.shopify-section');
    var pin = section && section.querySelector('[data-hp-story-sticky-pin="{{ ai_gen_id }}"]');
    if (!section || !pin) return;

    var main = section.closest('#MainContent') || document.getElementById('MainContent');
    if (main) {
      main.style.setProperty('position', 'relative');
      main.style.setProperty('isolation', 'isolate');
      var mainBg = window.getComputedStyle(main).backgroundColor;
      if (!mainBg || mainBg === 'transparent' || mainBg === 'rgba(0, 0, 0, 0)') {
        main.style.setProperty('background-color', '#ffffff');
      }
    }

    // Unblock sticky (overflow hidden on ancestors breaks it)
    var node = track;
    while (node && node !== document.documentElement) {
      if (node.nodeType === 1) {
        var cs = window.getComputedStyle(node);
        if (cs.overflow === 'hidden' || cs.overflowX === 'hidden' || cs.overflowY === 'hidden') {
          node.style.setProperty('overflow-x', 'clip', 'important');
          node.style.setProperty('overflow-y', 'visible', 'important');
        }
      }
      node = node.parentElement;
    }

    var prev = section.previousElementSibling;
    var next = section.nextElementSibling;

    function isTransparent(color) {
      return !color || color === 'transparent' || color === 'rgba(0, 0, 0, 0)';
    }

    function paintOpaque(el, fallback) {
      if (!el) return;
      if (isTransparent(window.getComputedStyle(el).backgroundColor)) {
        el.style.setProperty('background-color', fallback, 'important');
      }
      var inners = el.querySelectorAll(':scope > section, :scope > div, .fc-section, .corp-marquee');
      for (var i = 0; i < Math.min(inners.length, 8); i++) {
        if (isTransparent(window.getComputedStyle(inners[i]).backgroundColor)) {
          inners[i].style.setProperty('background-color', fallback, 'important');
        }
      }
    }

    function layoutCurtain() {
      var vh = window.innerHeight || document.documentElement.clientHeight || 800;

      if (prev && prev.classList && prev.classList.contains('shopify-section')) {
        prev.classList.add('hp-story-curtain-prev-{{ ai_gen_id }}');
        prev.style.setProperty('position', 'relative', 'important');
        prev.style.setProperty('z-index', '3', 'important');
        prev.style.setProperty('isolation', 'isolate', 'important');
        // Clear any leftover white padding from older curtain attempts
        prev.style.setProperty('padding-bottom', '0px', 'important');
        paintOpaque(prev, '#ffffff');
      }

      section.style.setProperty('position', 'relative', 'important');
      section.style.setProperty('z-index', '1', 'important');
      section.style.setProperty('margin-top', '0px', 'important');
      section.style.setProperty('height', vh * 2 + 'px', 'important');
      section.style.setProperty('overflow', 'visible', 'important');
      section.style.setProperty('background', 'transparent', 'important');
      section.style.setProperty('pointer-events', 'none', 'important');

      track.style.setProperty('background', 'transparent', 'important');
      track.style.removeProperty('z-index');

      pin.style.setProperty('z-index', '1', 'important');
      pin.style.setProperty('height', vh + 'px', 'important');
      pin.style.setProperty('pointer-events', 'auto', 'important');

      // Raise following sections so the lower curtain covers cleanly
      var sib = next;
      var idx = 0;
      while (sib && idx < 4) {
        if (sib.classList && sib.classList.contains('shopify-section')) {
          sib.classList.add('hp-story-curtain-next-{{ ai_gen_id }}');
          sib.style.setProperty('position', 'relative', 'important');
          sib.style.setProperty('z-index', '3', 'important');
          sib.style.setProperty('isolation', 'isolate', 'important');
          if (idx === 0) {
            sib.style.setProperty('margin-top', -vh + 'px', 'important');
          }
          var fallback = idx === 0 ? '#111111' : '#ffffff';
          paintOpaque(sib, fallback);
          idx += 1;
        }
        sib = sib.nextElementSibling;
      }
    }

    layoutCurtain();
    window.addEventListener('resize', layoutCurtain, { passive: true });
  })();
</script>
{%- endif -%}

