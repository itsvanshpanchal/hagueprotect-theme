{% doc %}
  Story banner with editable overlay text + per-block typography.
  Simplified markup: image always paints via inline background + <img>.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- liquid
  assign heading_family = block.settings.heading_font_family | default: 'bebas_neue'
  assign subheading_family = block.settings.subheading_font_family | default: 'darker_grotesque'
  assign text_family = block.settings.text_font_family | default: 'inter'
  assign button_family = block.settings.button_font_family | default: 'inter'

  assign heading_weight = block.settings.heading_font_weight | default: '400'
  assign subheading_weight = block.settings.subheading_font_weight | default: '400'
  assign text_weight = block.settings.text_font_weight | default: '400'
  assign button_weight = block.settings.button_font_weight | default: '600'

  assign heading_style = block.settings.heading_font_style | default: 'normal'
  assign subheading_style = block.settings.subheading_font_style | default: 'normal'
  assign text_style = block.settings.text_font_style | default: 'normal'

  assign accent_family = block.settings.heading_accent_font_family | default: settings.font_heading_accent_family | default: 'luthon_southard_script'
  if accent_family == blank or accent_family == 'theme_default'
    assign accent_family = settings.font_heading_accent_family | default: 'luthon_southard_script'
  endif
  assign accent_weight = block.settings.heading_accent_font_weight | default: settings.font_heading_accent_weight | default: '400'
  assign accent_style = block.settings.heading_accent_font_style | default: settings.font_heading_accent_style | default: 'normal'
  assign accent_size = block.settings.heading_accent_font_size_desktop | default: settings.font_heading_accent_size_desktop | default: 62
  assign accent_size_mobile = block.settings.heading_accent_font_size_mobile | default: settings.font_heading_accent_size_mobile | default: 40
  assign accent_color = block.settings.heading_accent_color | default: settings.heading_accent_color | default: '#c9a227'

  assign desk_bg = ''
  assign mobile_bg = ''
  if block.settings.background_image != blank
    assign desk_bg = block.settings.background_image | image_url: width: 2400
  endif
  if block.settings.mobile_image != blank
    assign mobile_bg = block.settings.mobile_image | image_url: width: 1200
  elsif block.settings.background_image != blank
    assign mobile_bg = block.settings.background_image | image_url: width: 1200
  endif
-%}

{%- capture heading_stack -%}{% render 'hp-font-stack', font_key: heading_family %}{%- endcapture -%}
{%- capture subheading_stack -%}{% render 'hp-font-stack', font_key: subheading_family %}{%- endcapture -%}
{%- capture text_stack -%}{% render 'hp-font-stack', font_key: text_family %}{%- endcapture -%}
{%- capture button_stack -%}{% render 'hp-font-stack', font_key: button_family %}{%- endcapture -%}
{%- capture accent_stack -%}{% render 'hp-font-stack', font_key: accent_family %}{%- endcapture -%}
{%- liquid
  assign heading_stack = heading_stack | strip
  assign subheading_stack = subheading_stack | strip
  assign text_stack = text_stack | strip
  assign button_stack = button_stack | strip
  assign accent_stack = accent_stack | strip
-%}

{%- comment -%}
  No <style> tags here — Shopify was stripping them and dumping CSS as visible page text.
  All paint uses inline styles + assets/hp-story-banner.css.
{%- endcomment -%}
{%- liquid
  assign story_sticky = block.settings.enable_sticky_scroll
-%}
<div
  class="ai-story-sticky-track ai-story-sticky-track-{{ ai_gen_id }}{% unless story_sticky %} ai-story-sticky-track--flow{% endunless %}"
  data-hp-story-sticky-track="{{ ai_gen_id }}"
  data-hp-story-flow="{% if story_sticky %}false{% else %}true{% endif %}"
  style="display:block;width:100%;margin:0;padding:0;position:relative;"
>
  <div
    class="ai-story-sticky-pin ai-story-sticky-pin-{{ ai_gen_id }}"
    data-hp-story-sticky-pin="{{ ai_gen_id }}"
    style="display:block;width:100%;margin:0;padding:0;position:relative;"
  >
    <div
      class="ai-story-banner ai-story-banner-{{ ai_gen_id }}"
      {{ block.shopify_attributes }}
      style="position:relative;width:100%;max-width:100%;display:block;overflow:hidden;"
    >
      <div
        class="ai-story-banner-wrapper ai-story-banner-wrapper-{{ ai_gen_id }}"
        data-hp-story-wrap
        style="
          position:relative;
          width:100%;
          {% if story_sticky %}
          min-height:100vh;
          min-height:100dvh;
          {% else %}
          height:auto;
          min-height:0;
          max-height:none;
          {% endif %}
          overflow:hidden;
          background-color:#111111;
          background-size:cover;
          background-position:center center;
          background-repeat:no-repeat;
          {% if story_sticky %}
            {% if mobile_bg != blank %}
              background-image:url({{ mobile_bg | json }});
            {% elsif desk_bg != blank %}
              background-image:url({{ desk_bg | json }});
            {% endif %}
          {% endif %}
        "
        {% if mobile_bg != blank %}data-mobile-bg="{{ mobile_bg | escape }}"{% endif %}
        {% if desk_bg != blank %}data-desktop-bg="{{ desk_bg | escape }}"{% endif %}
      >
        {% if block.settings.background_video != blank or block.settings.mobile_video != blank %}
          {% assign video_style = "position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center center;z-index:1;opacity:" | append: block.settings.image_opacity %}
          {% unless story_sticky %}
            {% assign video_style = "position:relative;width:100%;height:auto;display:block;z-index:1;opacity:" | append: block.settings.image_opacity %}
          {% endunless %}
          
          <style>
            .hp-story-vid-desk-{{ ai_gen_id }} { display: block; }
            .hp-story-vid-mob-{{ ai_gen_id }} { display: none; }
            @media (max-width: 749px) {
              .hp-story-vid-desk-{{ ai_gen_id }} { display: none !important; }
              .hp-story-vid-mob-{{ ai_gen_id }} { display: block !important; }
            }
          </style>

          {% if block.settings.background_video != blank %}
            {% assign desktop_video_class = 'ai-story-banner-video ai-story-banner-cover hp-story-vid-desk-' | append: ai_gen_id %}
            {% if block.settings.mobile_video == blank %}
              {% assign desktop_video_class = 'ai-story-banner-video ai-story-banner-cover' %}
            {% endif %}
            {{ block.settings.background_video | video_tag: class: desktop_video_class, autoplay: true, loop: true, muted: true, controls: false, style: video_style }}
          {% endif %}
          
          {% if block.settings.mobile_video != blank %}
            {% assign mobile_video_class = 'ai-story-banner-video ai-story-banner-cover hp-story-vid-mob-' | append: ai_gen_id %}
            {% if block.settings.background_video == blank %}
              {% assign mobile_video_class = 'ai-story-banner-video ai-story-banner-cover' %}
            {% endif %}
            {{ block.settings.mobile_video | video_tag: class: mobile_video_class, autoplay: true, loop: true, muted: true, controls: false, style: video_style }}
          {% endif %}
        {% elsif block.settings.background_image or block.settings.mobile_image %}
          <picture
            class="ai-story-banner-picture ai-story-banner-picture-{{ ai_gen_id }}"
            style="{% if story_sticky %}position:absolute;inset:0;width:100%;height:100%;{% else %}position:relative;display:block;width:100%;height:auto;min-height:600px;max-height:100vh;{% endif %}display:block;z-index:1;margin:0;padding:0;"
          >
            {% if mobile_bg != blank %}
              <source media="(max-width: 749px)" srcset="{{ mobile_bg }}">
            {% endif %}
            {% if desk_bg != blank %}
              <source media="(min-width: 750px)" srcset="{{ desk_bg }}">
            {% endif %}
            <img
              src="{% if mobile_bg != blank %}{{ mobile_bg }}{% else %}{{ desk_bg }}{% endif %}"
              alt="{% if block.settings.mobile_image %}{{ block.settings.mobile_image.alt | escape }}{% elsif block.settings.background_image %}{{ block.settings.background_image.alt | escape }}{% endif %}"
              class="ai-story-banner-image ai-story-banner-cover ai-story-banner-image-{{ ai_gen_id }}"
              data-hp-story-cover
              loading="eager"
              fetchpriority="high"
              decoding="async"
              style="{% if story_sticky %}position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center center;{% else %}position:relative;display:block;width:100%;height:auto;min-height:600px;max-height:100vh;object-fit:cover;object-position:center center;{% endif %}z-index:1;display:block;opacity:{{ block.settings.image_opacity | default: 1 }};"
            >
          </picture>
        {% else %}
          <div
            class="ai-story-banner-placeholder ai-story-banner-placeholder-{{ ai_gen_id }}"
            style="min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;background:#f4f4f4;"
          >
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if block.settings.show_overlay %}
          <div
            class="ai-story-banner-overlay ai-story-banner-overlay-{{ ai_gen_id }}"
            style="position:absolute;inset:0;z-index:2;pointer-events:none;background-color:{{ block.settings.overlay_color }};opacity:{{ block.settings.overlay_opacity }};"
          ></div>
        {% endif %}

        <div
          class="ai-story-banner-content ai-story-banner-content-{{ ai_gen_id }}"
          data-hp-story-content
          style="
            position:absolute;
            z-index:3;
            max-width:{{ block.settings.content_max_width | default: 650 }}px;
            padding:{{ block.settings.content_padding | default: 20 }}px;
            text-align:{{ block.settings.content_align | default: 'left' }};
            left:{{ block.settings.content_offset_left | default: 20 }}px;
            top:{{ block.settings.content_offset_top | default: 56 }}px;
            display:flex;
            flex-direction:column;
            align-items:{% case block.settings.content_align %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %};
          "
          data-pad-m="16"
          data-left-m="{{ block.settings.content_offset_left_mobile | default: 28 }}"
          data-top-m="{{ block.settings.content_offset_top_mobile | default: 28 }}"
          data-max-m="{{ block.settings.content_max_width_mobile | default: 280 }}"
          data-align-m="{{ block.settings.content_align_mobile | default: 'left' }}"
          data-left-d="{{ block.settings.content_offset_left | default: 20 }}"
          data-top-d="{{ block.settings.content_offset_top | default: 56 }}"
          data-max-d="{{ block.settings.content_max_width | default: 650 }}"
          data-align-d="{{ block.settings.content_align | default: 'left' }}"
        >
          {%- liquid
            assign story_stack_center = false
            if block.settings.content_align == 'center'
              assign story_stack_center = true
            endif
          -%}
          {%- if block.settings.subheading != blank or block.settings.heading != blank -%}
            <div class="section-heading-stack{% if story_stack_center %} section-heading-stack--center{% endif %}">
              {%- if block.settings.subheading != blank -%}
                <span
                  class="ai-story-banner-subheading ai-story-banner-subheading-{{ ai_gen_id }}"
                  style="color:{{ block.settings.subheading_color }};"
                >
                  {{ block.settings.subheading }}
                </span>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <div
                  class="ai-story-banner-heading ai-story-banner-heading-{{ ai_gen_id }}"
                  role="heading"
                  aria-level="2"
                  style="color:{{ block.settings.heading_color }};font-family:{{ heading_stack }};font-weight:{{ heading_weight }};font-style:{{ heading_style }};margin:0 0 {{ block.settings.heading_spacing }}px;line-height:1.05;"
                  data-accent-size="{{ accent_size }}"
                  data-accent-size-m="{{ accent_size_mobile }}"
                  data-accent-color="{{ accent_color }}"
                  data-accent-stack="{{ accent_stack | escape }}"
                  data-accent-weight="{{ accent_weight }}"
                  data-accent-style="{{ accent_style }}"
                >
                  {% render 'section-heading-text',
                    text: block.settings.heading,
                    line2: block.settings.heading_line2,
                    line2_color: block.settings.heading_line2_color,
                    accent_last_word: true,
                    accent_last_count: block.settings.heading_accent_word_count,
                    accent_color: block.settings.heading_accent_color
                  %}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {% if block.settings.text != blank %}
            <div
              class="ai-story-banner-text ai-story-banner-text-{{ ai_gen_id }} hp-body-para"
              style="color:{{ block.settings.text_color }};margin:0;"
            >
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.button_text != blank %}
            <div
              class="ai-story-banner-button-wrapper ai-story-banner-button-wrapper-{{ ai_gen_id }}{% if block.settings.hide_button_mobile %} ai-story-banner-button-wrapper--hide-mobile{% endif %}"
              style="margin-top:{{ block.settings.button_spacing }}px;"
            >
              <a
                href="{% if block.settings.button_link != blank %}{{ block.settings.button_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
                class="ai-story-banner-button ai-story-banner-button-{{ ai_gen_id }}"
                style="display:inline-block;padding:{{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;background-color:{{ block.settings.button_background_color }};color:{{ block.settings.button_text_color }};text-decoration:none;border-radius:{{ block.settings.button_border_radius }}px;font-family:{{ button_stack }};font-size:{{ block.settings.button_text_size }}px;font-weight:{{ button_weight }};"
              >
                {{ block.settings.button_text }}
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Story banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_scroll",
      "label": "Sticky scroll reveal (not recommended)",
      "default": false,
      "info": "Off by default — sticky runways make the banner feel stuck and require multiple scroll wheels to pass."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Upload a video to use as the desktop background. Overrides image."
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile video",
      "info": "Upload a separate portrait video for phones."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop image",
      "info": "Wide / landscape image for laptop and desktop screens."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Upload a separate portrait image for phones (recommended 1080×1920 or 9:16). This image is used only on screens under 750px wide. If empty, the desktop image is used."
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Image opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Content position"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "header",
      "content": "Content position (laptop)"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "content_offset_left",
      "label": "Left position",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "content_offset_top",
      "label": "Top position",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content position (mobile)"
    },
    {
      "type": "range",
      "id": "content_offset_left_mobile",
      "label": "Left position",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_offset_top_mobile",
      "label": "Top position",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_max_width_mobile",
      "label": "Text max width",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 200,
      "info": "Keeps overlay text from covering the photo collage on phones."
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Banner text"
    },
    {
      "type": "paragraph",
      "content": "Edit overlay text here. Order on the banner: Subheading (eyebrow) → Heading → Body. Scroll down for Typography (font family / weight)."
    },
    {
      "type": "header",
      "content": "4. Tiny text above title"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Tiny text above title",
      "default": "Share your brand's journey",
      "info": "Small label shown above the main heading."
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Tiny text color",
      "default": "#2563eb"
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Space below tiny text",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "1. Biggest title"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Biggest title",
      "default": "Tell Your Story"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Biggest title — second line",
      "info": "Optional. Shown under the title in a different color (sentence case)."
    },
    {
      "type": "color",
      "id": "heading_line2_color",
      "label": "Second line color",
      "default": "#6b6b6b"
    },
    {
      "type": "header",
      "content": "Heading accent word (script)"
    },
    {
      "type": "paragraph",
      "content": "Font and size for the highlighted last word only (e.g. Care, Material, Story, Best, Media). Leave font on theme default to use Theme settings > Typography."
    },
    {
      "type": "select",
      "id": "heading_accent_font_family",
      "label": "Accent word font",
      "options": [
        {
          "value": "theme_default",
          "label": "Use theme Typography setting"
        },
        {
          "value": "luthon_southard_script",
          "label": "Luthon Southard Script"
        },
        {
          "value": "luthon_southard_serif",
          "label": "Luthon Southard Serif"
        },
        {
          "value": "jacques_gilles",
          "label": "Jacques Gilles"
        },
        {
          "value": "calisto_mt",
          "label": "Calisto MT Regular"
        },
        {
          "value": "calisto_mt_italic",
          "label": "Calisto MT Italic"
        },
        {
          "value": "calisto_mt_bold",
          "label": "Calisto MT Bold"
        },
        {
          "value": "bahnschrift",
          "label": "Bahnschrift Regular"
        },
        {
          "value": "bahnschrift_semibold",
          "label": "Bahnschrift Semibold"
        },
        {
          "value": "freight_text_pro",
          "label": "FreightText Pro Book"
        },
        {
          "value": "darker_grotesque",
          "label": "Darker Grotesque Regular"
        },
        {
          "value": "darker_grotesque_semibold",
          "label": "Darker Grotesque Semibold"
        },
        {
          "value": "inter_18pt",
          "label": "Inter 18pt Regular"
        },
        {
          "value": "montserrat",
          "label": "Montserrat Regular"
        },
        {
          "value": "montserrat_semibold",
          "label": "Montserrat Semibold"
        }
      ],
      "default": "theme_default"
    },
    {
      "type": "select",
      "id": "heading_accent_font_weight",
      "label": "Accent word weight",
      "options": [
        {
          "value": "400",
          "label": "Regular (400)"
        },
        {
          "value": "500",
          "label": "Medium (500)"
        },
        {
          "value": "600",
          "label": "Semibold (600)"
        },
        {
          "value": "700",
          "label": "Bold (700)"
        }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "heading_accent_font_style",
      "label": "Accent word style",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "italic",
          "label": "Italic"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "heading_accent_font_size_desktop",
      "label": "Accent word size — computer",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 62
    },
    {
      "type": "range",
      "id": "heading_accent_font_size_mobile",
      "label": "Accent word size — phone",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_accent_word_count",
      "label": "Script accent last words",
      "min": 1,
      "max": 3,
